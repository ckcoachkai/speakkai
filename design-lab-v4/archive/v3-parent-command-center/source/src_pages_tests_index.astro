---
import { experiments, legacyExperiments, missingExperiments } from "../../data/experimentLab";
import { averageReviewScore, experimentReviewById } from "../../data/experimentReviews";

const filters = ["all", "parent", "student", "customer", "mixed", "single-screen", "premium", "youth", "experimental", "minimal", "cinematic", "institutional"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="SpeakKai homepage experiment gallery for stakeholder-led design tests." />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Homepage Experiment Lab | SpeakKai</title>
    <style>
      * { box-sizing: border-box; }
      html { min-width: 320px; background: #0b1020; }
      body { min-height: 100vh; margin: 0; color: #f8fafc; background: #0b1020; font-family: Manrope, ui-sans-serif, system-ui, sans-serif; }
      a { color: inherit; }
      .topbar { display: flex; min-height: 58px; align-items: center; justify-content: space-between; gap: 20px; padding: 10px max(18px, calc((100vw - 1440px) / 2)); border-bottom: 1px solid #26334e; }
      .topbar a { font-weight: 900; text-decoration: none; }
      .topbar span { color: #8ca0c4; font-size: 11px; }
      main { width: min(100% - 36px, 1440px); margin: 0 auto; padding: 72px 0 100px; }
      .intro { display: grid; grid-template-columns: 1.3fr .7fr; align-items: end; gap: 40px; }
      .eyebrow { margin: 0; color: #ffcc00; font-size: 11px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
      h1 { max-width: 920px; margin: 15px 0 0; font-size: clamp(50px, 7vw, 102px); letter-spacing: -.07em; line-height: .9; }
      .intro-copy { margin: 0; color: #9eacc4; font-size: 15px; line-height: 1.7; }
      .source-gap { margin: 40px 0 0; padding: 16px 18px; border-left: 4px solid #ffcc00; color: #d9e2f2; background: #121d34; font-size: 12px; line-height: 1.65; }
      .filters { display: flex; flex-wrap: wrap; gap: 7px; margin: 36px 0 20px; }
      .filters button { min-height: 38px; padding: 8px 12px; border: 1px solid #364665; border-radius: 999px; color: #dce6f5; background: transparent; cursor: pointer; font: 800 10px/1.2 inherit; text-transform: uppercase; }
      .filters button:hover, .filters button[aria-pressed="true"] { border-color: #ffcc00; color: #0b1020; background: #ffcc00; }
      .filters button:focus-visible, .card:focus-visible { outline: 3px solid #ffcc00; outline-offset: 3px; }
      .result-count { min-height: 22px; margin: 0 0 14px; color: #8295b6; font-size: 11px; }
      .gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
      .card { position: relative; display: flex; min-height: 320px; overflow: hidden; border: 1px solid #2b3a59; color: #fff; background: #111d33; text-decoration: none; }
      .card img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; opacity: .34; transition: transform .25s ease, opacity .25s ease; }
      .card::after { position: absolute; inset: 0; background: linear-gradient(0deg, rgb(4 9 20 / 96%), rgb(4 9 20 / 10%) 75%); content: ""; }
      .card:hover img { opacity: .5; transform: scale(1.03); }
      .card-body { position: relative; z-index: 2; display: flex; width: 100%; flex-direction: column; justify-content: flex-end; padding: 19px; }
      .number { color: #ffcc00; font-size: 11px; font-weight: 900; }
      .status { position: absolute; top: 15px; right: 15px; padding: 5px 7px; border: 1px solid #7585a1; border-radius: 999px; color: #d6e1f1; background: rgb(5 11 24 / 72%); font-size: 8px; font-weight: 900; text-transform: uppercase; }
      .card h2 { margin: 10px 0 0; font-size: 25px; letter-spacing: -.04em; line-height: 1.05; }
      .card p { margin: 10px 0 0; color: #afbdd3; font-size: 11px; line-height: 1.5; }
      .meta { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 14px; }
      .meta span { padding: 4px 6px; border: 1px solid #425270; border-radius: 99px; color: #b7c7df; font-size: 7px; font-weight: 900; text-transform: uppercase; }
      .legacy { min-height: 220px; }
      .missing { min-height: 220px; border-style: dashed; opacity: .68; background: #0d172a; }
      .missing::after { display: none; }
      .missing .card-body { justify-content: space-between; }
      .missing .number { color: #f59e0b; }
      .missing h2 { font-size: 19px; }
      .missing p { color: #9aa9c1; }
      .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin: 68px 0 17px; padding-bottom: 13px; border-bottom: 1px solid #2b3a59; }
      .section-heading h2 { margin: 0; font-size: 26px; }
      .section-heading p { margin: 0; color: #8295b6; font-size: 10px; }
      [hidden] { display: none !important; }
      @media (max-width: 1100px) { .gallery { grid-template-columns: repeat(3, 1fr); } }
      @media (max-width: 760px) { .intro { grid-template-columns: 1fr; }.gallery { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 480px) { main { width: min(100% - 24px, 430px); padding-top: 48px; }.gallery { grid-template-columns: 1fr; }.card { min-height: 280px; } }
      @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; } }
    </style>
  </head>
  <body>
    <header class="topbar">
      <a href="/">SpeakKai</a>
      <span>Private design experiment / noindex</span>
      <a href="/concept-lab/home/">Original gallery</a>
    </header>
    <main>
      <section class="intro">
        <div>
          <p class="eyebrow">Homepage Experiment Lab V3</p>
          <h1>50 positions in the gallery. 30 new stakeholder hypotheses.</h1>
        </div>
        <p class="intro-copy">Browse parent-first, student-first, customer-first, and mixed concepts. Tests 40–50 are intentionally single-screen on desktop and reflow on smaller devices.</p>
      </section>
      <p class="source-gap"><strong>Source boundary:</strong> Tests 1–7, A, 9, and 10 are preserved from the available repository. Numeric Test 8 and Tests 11–20 were not present in local or remote source, so the gallery marks them as Missing rather than inventing replacements.</p>

      <div class="filters" aria-label="Filter homepage experiments">
        {filters.map((filter) => <button type="button" data-filter={filter} aria-pressed={filter === "all" ? "true" : "false"}>{filter.replace("-", " ")}</button>)}
      </div>
      <p class="result-count" aria-live="polite"></p>

      <div class="section-heading"><h2>Tests 21–50</h2><p>Built V3 experiments</p></div>
      <section class="gallery" aria-label="New homepage experiments">
        {experiments.map((experiment) => (
          <a class="card" href={`/tests/${experiment.id}/`} data-tags={experiment.tags.join(" ")} data-single={String(experiment.singleScreen)}>
            <img src={experiment.image} alt="" width="480" height="360" loading="lazy" decoding="async" />
            <div class="card-body">
              <span class="status">Internal review {averageReviewScore(experimentReviewById.get(experiment.id)!).toFixed(1)}</span>
              <span class="number">Test {experiment.id}</span>
              <h2>{experiment.name}</h2>
              <p>{experiment.hypothesis}</p>
              <div class="meta"><span>{experiment.primary}</span><span>{experiment.secondary}</span>{experiment.singleScreen && <span>single screen</span>}{experiment.tags.slice(2, 4).map((tag) => <span>{tag}</span>)}</div>
            </div>
          </a>
        ))}
      </section>

      <div class="section-heading"><h2>Preserved and Missing</h2><p>Existing-source audit</p></div>
      <section class="gallery" aria-label="Existing and missing homepage experiments">
        {legacyExperiments.map((experiment) => experiment.href ? (
          <a class="card legacy" href={experiment.href} data-tags="legacy">
            <img src="/images/coach-kai-headshot.webp" alt="" width="480" height="360" loading="lazy" decoding="async" />
            <div class="card-body"><span class="status">preserved</span><span class="number">Test {experiment.id}</span><h2>Original concept lab</h2><p>Open the reviewed experiment in its preserved route.</p><div class="meta"><span>legacy</span></div></div>
          </a>
        ) : (
          <article class="card missing" data-tags="missing">
            <div class="card-body"><span class="status">Missing</span><span class="number">Test {experiment.id}</span><div><h2>Source not available</h2><p>No route or experiment was found in the available repository.</p></div></div>
          </article>
        ))}
        {missingExperiments.map((experiment) => (
          <article class="card missing" data-tags="missing">
            <div class="card-body"><span class="status">Missing</span><span class="number">Test {experiment.id}</span><div><h2>Source not available</h2><p>No route or experiment was found in the available repository.</p></div></div>
          </article>
        ))}
      </section>
    </main>
    <script is:inline>
      const buttons = Array.from(document.querySelectorAll('[data-filter]'));
      const cards = Array.from(document.querySelectorAll('[data-tags]'));
      const count = document.querySelector('.result-count');
      function applyFilter(filter) {
        let visible = 0;
        cards.forEach((card) => {
          const tags = `${card.dataset.tags || ''} ${card.dataset.single === 'true' ? 'single-screen' : ''}`;
          const show = filter === 'all' || tags.split(/\s+/).includes(filter);
          card.hidden = !show;
          if (show) visible += 1;
        });
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)));
        if (count) count.textContent = `${visible} gallery items shown`;
      }
      buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter || 'all')));
      applyFilter('all');
    </script>
  </body>
</html>

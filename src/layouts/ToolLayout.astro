---
import { ChevronsDown, ChevronsUp } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";

interface Props {
  pageTitle: string;
  description: string;
  toolTitle: string;
  toolSrc: string;
}

const { pageTitle, description, toolTitle, toolSrc } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" />
    <style>
      :global(*) { box-sizing: border-box; }
      :global(html), :global(body) { width: 100%; height: 100%; margin: 0; }
      :global(body) { display: flex; flex-direction: column; overflow: hidden; background: #090d14; font-family: system-ui, sans-serif; }
      .site-header { position: relative; z-index: 10; flex-shrink: 0; display: flex; min-height: 48px; align-items: center; justify-content: center; padding: 0 48px 0 8px; border-bottom: 1px solid #d5deed; background: white; }
      .nav-toggle { position: absolute; right: 8px; display: grid; width: 32px; height: 32px; place-items: center; border: 1px solid #c7d3e5; border-radius: 5px; background: white; color: #173d70; cursor: pointer; }
      .nav-toggle:hover { background: #eef5ff; }
      .nav-toggle:focus-visible { outline: 3px solid #80d6d1; outline-offset: 2px; }
      .expand-icon { display: none; }
      .tool-frame { display: block; width: 100%; flex: 1; min-height: 0; border: 0; background: #090d14; }
      :global(body.nav-collapsed) .site-header { min-height: 32px; }
      :global(body.nav-collapsed) .site-header :global(.site-nav) { display: none; }
      :global(body.nav-collapsed) .collapse-icon { display: none; }
      :global(body.nav-collapsed) .expand-icon { display: block; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <SiteNavigation current="resources" compact />
      <button
        class="nav-toggle"
        type="button"
        aria-label="Hide navigation"
        aria-expanded="true"
        title="Hide navigation"
      >
        <ChevronsUp class="collapse-icon" size={18} stroke-width={2.2} aria-hidden="true" />
        <ChevronsDown class="expand-icon" size={18} stroke-width={2.2} aria-hidden="true" />
      </button>
    </header>
    <iframe
      class="tool-frame"
      src={toolSrc}
      title={toolTitle}
      allow="autoplay"
      allowfullscreen
    ></iframe>
    <SiteFooter />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");

      toggle?.addEventListener("click", () => {
        const collapsed = document.body.classList.toggle("nav-collapsed");
        toggle.setAttribute("aria-expanded", String(!collapsed));
        toggle.setAttribute("aria-label", collapsed ? "Show navigation" : "Hide navigation");
        toggle.title = collapsed ? "Show navigation" : "Hide navigation";
      });
    </script>
  </body>
</html>

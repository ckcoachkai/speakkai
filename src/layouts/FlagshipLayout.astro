---
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "../styles/flagship.css";
import { structuredData } from "../lib/structuredData.mjs";
interface Props {
  title?: string;
  description?: string;
  current?: string;
  contactHref?: string;
  service?: string;
  breadcrumb?: string;
  noindex?: boolean;
}
const {
  title = "SpeakKai | Communication Coaching, Keynotes & Training",
  description = "Build the speaker, not just the speech. Kai Liu offers public speaking coaching, school programs, keynotes and communication training in Shanghai and online.",
  current = "home",
  contactHref = "/#connect",
  service,
  breadcrumb,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://speakkai.com").href;
const navigation = [
  { href: "/#work", label: "Work with Kai" },
  { href: "/#story", label: "Meet Kai" },
  { href: "/resources/", label: "Resources" },
  { href: "/schedule/", label: "Schedule" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <meta name="speakkai-version" content="09" />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <script
          type="application/ld+json"
          set:html={structuredData({
            path: Astro.url.pathname,
            title,
            description,
            service,
            breadcrumb,
            pageType: current === "contact" ? "ContactPage" : "WebPage",
          })}
        />
      )
    }
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SpeakKai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://speakkai.com/images/coach-kai-headshot.webp"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://speakkai.com/images/coach-kai-headshot.webp"
    />
    <title>{title}</title>
  </head>
  <body class="flagship" data-version="09">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="SpeakKai home"
        ><span class="brand-image" aria-hidden="true"
          ><img
            src="/images/speakkai-logo-header-source.png"
            width="1254"
            height="1254"
            alt=""
          /></span
        ><span lang="zh-CN">说开</span></a
      >
      <nav class="desktop-navigation" aria-label="Main navigation">
        {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <a class="header-cta" href={contactHref}
        >Let’s talk <span aria-hidden="true">↗</span></a
      >
      <details class="mobile-navigation">
        <summary>Menu <span aria-hidden="true">+</span></summary>
        <nav aria-label="Main navigation">
          {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
      </details>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <a href="/" class="footer-brand"
          >SpeakKai<span lang="zh-CN">说开</span></a
        ><p>Clear thinking. Purposeful practice. Human connection.</p>
      </div><nav aria-label="Footer navigation">
        <a href="/#work">Coaching & training</a><a href="/schedule/">Schedule</a
        ><a href="/resources/">Practice resources</a><a href="/contact/"
          >Contact Kai</a
        ><span class="footer-social">Xiaohongshu: CKcoachkai</span><a
          href="https://kr.pinterest.com/ckcoachkai/"
          target="_blank"
          rel="noreferrer">Pinterest ↗</a
        >
      </nav><p class="footer-note">
        © {new Date().getFullYear()} SpeakKai · Shanghai & online
      </p>
    </footer>
  </body>
</html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-navigation");
  const summary = menu?.querySelector("summary");
  menu?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      summary?.focus();
    }
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const destination = new URL(link.href);
      if (destination.pathname === location.pathname && destination.hash) {
        const target = document.getElementById(destination.hash.slice(1));
        menu.open = false;
        if (target) {
          const originalTabindex = target.getAttribute("tabindex");
          target.setAttribute("tabindex", "-1");
          target.focus({ preventScroll: true });
          target.addEventListener("blur", () => {
            if (originalTabindex === null) target.removeAttribute("tabindex");
            else target.setAttribute("tabindex", originalTabindex);
          }, { once: true });
        }
      }
    });
  });
</script>

---
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-600.css";
import "@fontsource/manrope/latin-700.css";
import { Image } from "astro:assets";
import logo from "../assets/brand/speakkai-logo.png";
import "../styles/flagship.css";
import { structuredData } from "../lib/structuredData.mjs";
import { pageAlternates, languageChoices, localizedPath, destinationLabel } from "../lib/siteLanguage.mjs";
interface Props {
  title?: string;
  description?: string;
  current?: string;
  contactHref?: string;
  service?: string;
  breadcrumb?: string;
  noindex?: boolean;
  language?: "en" | "zh-CN";
  alternates?: Array<{ lang: string; href: string }>;
}
const {
  title = "SpeakKai | Communication Coaching, Keynotes & Training",
  description = "Build the speaker, not just the speech. Kai Liu offers public speaking coaching, school programs, keynotes and communication training in Shanghai and online.",
  current = "home",
  contactHref = "/#connect",
  service,
  breadcrumb,
  noindex = false,
  language = "en",
  alternates: explicitAlternates = [],
} = Astro.props;
const chinese = language === "zh-CN";
const alternates = explicitAlternates.length ? explicitAlternates : pageAlternates(Astro.url.pathname);
const choices = languageChoices(Astro.url.pathname, language);
const homeHref = chinese ? "/zh/" : "/";
const contactTarget = chinese && contactHref === "/#connect" ? "/zh/#connect" : contactHref;
const canonical = new URL(Astro.url.pathname, "https://speakkai.com").href;
const navigation = [
  { href: "/#work", label: chinese ? "课程与培训" : "Work with Kai" },
  { href: "/#story", label: chinese ? "认识 Kai" : "Meet Kai" },
  { href: "/resources/", label: chinese ? "练习资源" : "Resources" },
  { href: "/schedule/", label: chinese ? "时间安排" : "Schedule" },
].map(item => ({ href: localizedPath(item.href,language), label: destinationLabel(item.label,item.href,language) }));
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <meta name="speakkai-version" content="23" />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <script
          type="application/ld+json"
          set:html={structuredData({
            path: Astro.url.pathname,
            title,
            description,
            service,
            breadcrumb,
            language,
            pageType: current === "contact" ? "ContactPage" : "WebPage",
          })}
        />
      )
    }
    <link rel="canonical" href={canonical} />
    {alternates.map(item => <link rel="alternate" hreflang={item.lang} href={new URL(item.href, "https://speakkai.com").href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, "https://speakkai.com").href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SpeakKai" />
    <meta property="og:locale" content={chinese ? "zh_CN" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://speakkai.com/images/coach-kai-headshot.webp"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://speakkai.com/images/coach-kai-headshot.webp"
    />
    <title>{title}</title>
  </head>
  <body class="flagship" data-version="23">
    <a class="skip-link" href="#main">{chinese ? "跳到正文" : "Skip to content"}</a>
    <div class="site-language-bar">
      <div class="wrap site-language" role="group" aria-label={chinese ? "页面语言" : "Page language"}>
        {choices.map(choice => <a href={choice.href} lang={choice.lang} aria-current={choice.current ? "page" : undefined}>{choice.label}</a>)}
      </div>
    </div>
    <header class="site-header">
      <a class="brand" href={homeHref} aria-label={chinese ? "SpeakKai 首页" : "SpeakKai home"}
        ><span class="brand-image" aria-hidden="true"
          ><Image
            src={logo}
            width={480}
            height={480}
            widths={[160, 320, 480]}
            sizes="(max-width: 760px) 126px, 158px"
            format="webp"
            quality={90}
            loading="eager"
            alt=""
          /></span
        ><span lang="zh-CN">说开</span></a
      >
      <nav class="desktop-navigation" aria-label={chinese ? "主导航" : "Main navigation"}>
        {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <a class="header-cta" href={contactTarget}
        >{chinese ? "联系 Kai" : "Let’s talk"} <span aria-hidden="true">↗</span></a
      >
      <details class="mobile-navigation">
        <summary>{chinese ? "菜单" : "Menu"} <span aria-hidden="true">+</span></summary>
        <nav aria-label={chinese ? "主导航" : "Main navigation"}>
          {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
      </details>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <a href={homeHref} class="footer-brand"
          >SpeakKai<span lang="zh-CN">说开</span></a
        ><p>{chinese ? "清楚地思考。有目的地练习。真诚地连接。" : "Clear thinking. Purposeful practice. Human connection."}</p>
      </div><nav aria-label={chinese ? "页脚导航" : "Footer navigation"}>
        <a href={localizedPath("/#work",language)}>{chinese ? "辅导与培训" : "Coaching & training"}</a><a href="/schedule/">{chinese ? "时间安排（英文）" : "Schedule"}</a
        ><a href={localizedPath("/resources/",language)}>{destinationLabel(chinese ? "练习资源" : "Practice resources","/resources/",language)}</a><a href={chinese ? "/zh/#connect" : "/contact/"}
          >{chinese ? "联系 Kai" : "Contact Kai"}</a
        ><span class="footer-social">{chinese ? "小红书" : "Xiaohongshu"}: <span lang="en">CKcoachkai</span></span><a
          href="https://kr.pinterest.com/ckcoachkai/"
          target="_blank"
          rel="noreferrer">Pinterest ↗</a
        >
      </nav><p class="footer-note">
        © {new Date().getFullYear()} SpeakKai · {chinese ? "上海与线上" : "Shanghai & online"}
      </p>
    </footer>
  </body>
</html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-navigation");
  const summary = menu?.querySelector("summary");
  menu?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      summary?.focus();
    }
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const destination = new URL(link.href);
      if (destination.pathname === location.pathname && destination.hash) {
        const target = document.getElementById(destination.hash.slice(1));
        menu.open = false;
        if (target) {
          const originalTabindex = target.getAttribute("tabindex");
          target.setAttribute("tabindex", "-1");
          target.focus({ preventScroll: true });
          target.addEventListener("blur", () => {
            if (originalTabindex === null) target.removeAttribute("tabindex");
            else target.setAttribute("tabindex", originalTabindex);
          }, { once: true });
        }
      }
    });
  });
</script>

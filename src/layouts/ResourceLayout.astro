---
import SiteFooter from "../components/SiteFooter.astro";
import SpatialSiteHeader from "../components/SpatialSiteHeader.astro";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/700.css";
import "@fontsource/space-mono/400.css";

interface Props {
  pageTitle: string;
  description: string;
}

const { pageTitle, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://speakkai.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <style>
      :global(*) { box-sizing: border-box; }

      :global(html) {
        min-width: 320px;
        min-height: 100%;
        background: #eaf1f9;
        color: #14233b;
        font-family: "Manrope", Inter, system-ui, sans-serif;
      }

      :global(body) {
        display: flex;
        min-height: 100vh;
        margin: 0;
        flex-direction: column;
      }

      .site-header {
        display: flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #d5deed;
        background: #fff;
      }

      .site-nav {
        display: flex;
        width: min(100%, 720px);
        align-items: center;
        justify-content: center;
        gap: clamp(14px, 2.8vw, 38px);
      }

      .site-nav a {
        padding: 14px 3px 12px;
        border-bottom: 2px solid transparent;
        color: #294568;
        font-size: 16px;
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
      }

      .site-nav a:hover,
      .site-nav a[aria-current="page"] {
        border-bottom-color: #19a9c5;
        color: #0a5f91;
      }

      .site-nav a:focus-visible {
        border-radius: 3px;
        outline: 3px solid #80d6d1;
        outline-offset: 2px;
      }

      main {
        width: min(100% - 40px, 1120px);
        margin: 0 auto;
        flex: 1 0 auto;
        padding: clamp(34px, 6vw, 68px) 0 72px;
      }

      @media (max-width: 700px) {
        .site-header { min-height: 46px; }
        .site-nav { width: 100%; gap: 0; }
        .site-nav a {
          flex: 1 1 16.666%;
          padding: 13px 1px 11px;
          font-size: clamp(10px, 3.2vw, 13px);
          text-align: center;
        }
        main { width: min(100% - 28px, 620px); padding-top: 32px; }
      }
    </style>
  </head>
  <body>
    <SpatialSiteHeader current="resources" />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

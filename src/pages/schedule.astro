---
import { RefreshCw } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SpatialSiteHeader from "../components/SpatialSiteHeader.astro";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/700.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href="https://speakkai.com/schedule/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="View Coach Kai's general availability and contact him to confirm a suitable coaching time."
    />
    <title>Coach Kai's Availability | SpeakKai</title>
    <style is:global>
      :root {
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", "Microsoft YaHei", sans-serif;
        color: #17233d;
        background: #f4f7fb;
        font-synthesis: none;
      }

      * { box-sizing: border-box; }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        background: #f4f7fb;
      }

      button, a { font: inherit; }

      .coach-banner {
        position: relative;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 1;
        overflow: hidden;
        border-bottom: 1px solid #224d83;
        background: #06142f;
      }

      .coach-banner picture {
        display: block;
        width: 100%;
        height: 100%;
      }

      .coach-banner img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .banner-socials {
        position: absolute;
        right: clamp(14px, 3vw, 44px);
        bottom: 14px;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 8px 12px;
        border-left: 3px solid #36b8ff;
        border-radius: 4px;
        color: #fff;
        background: rgb(3 15 42 / 82%);
        font-size: 13px;
        line-height: 1.2;
        text-shadow: 0 1px 3px rgb(0 0 0 / 55%);
      }

      .banner-socials strong { font-weight: 800; }

      .page-header {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) auto minmax(44px, 1fr);
        min-height: 52px;
        align-items: center;
        gap: 20px;
        padding: 6px clamp(14px, 2.5vw, 36px);
        border-bottom: 1px solid #d5deed;
        background: #fff;
      }

      .identity { min-width: 0; }

      .identity h1 {
        margin: 0;
        font-size: 18px;
        font-weight: 760;
        letter-spacing: 0;
      }

      .identity p {
        margin: 3px 0 0;
        color: #65718a;
        font-size: 11px;
      }

      .site-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(18px, 3vw, 42px);
      }

      .site-nav a {
        padding: 12px 4px 10px;
        border-bottom: 2px solid transparent;
        color: #294568;
        font-size: 16px;
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
      }

      .site-nav a:hover,
      .site-nav a[aria-current="page"] {
        border-bottom-color: #19a9c5;
        color: #0a5f91;
      }

      .site-nav a:focus-visible {
        border-radius: 3px;
        outline: 3px solid #80d6d1;
        outline-offset: 2px;
      }

      .refresh-button {
        display: inline-grid;
        width: 36px;
        height: 36px;
        justify-self: end;
        place-items: center;
        border: 1px solid #c7d3e5;
        border-radius: 6px;
        color: #173d70;
        background: #fff;
        cursor: pointer;
      }

      .refresh-button:hover { background: #eef5ff; }

      .refresh-button:focus-visible,
      .sheet-tab:focus-visible {
        outline: 3px solid #80d6d1;
        outline-offset: 2px;
      }

      main { padding: 12px clamp(10px, 1.7vw, 26px) 20px; }

      .availability-note {
        display: flex;
        width: min(100%, 920px);
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin: 0 auto 12px;
        padding: 12px 16px;
        border: 1px solid #c5d5e8;
        border-radius: 6px;
        color: #40546f;
        background: #fff;
        font-size: 13px;
        line-height: 1.5;
      }

      .availability-note p { margin: 0; }

      .availability-note a {
        flex: 0 0 auto;
        padding: 9px 13px;
        border-radius: 5px;
        color: #fff;
        background: #0b5fc7;
        font-weight: 800;
        text-decoration: none;
      }

      .availability-note a:hover { background: #074a9f; }
      .availability-note a:focus-visible { outline: 3px solid #80d6d1; outline-offset: 2px; }

      .schedule-legend {
        display: flex;
        width: min(1140px, calc(100% - 36px));
        flex-wrap: wrap;
        gap: 6px 12px;
        margin: -4px auto 12px;
        color: #334155;
        font-size: 11px;
        line-height: 1.3;
      }

      .legend-item { display: inline-flex; align-items: center; gap: 5px; }
      .legend-swatch {
        width: 11px;
        height: 11px;
        border: 2px solid currentColor;
        border-radius: 2px;
        background: currentColor;
      }

      .schedule-toolbar {
        display: flex;
        min-height: 40px;
        align-items: end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 8px;
      }

      .month-heading {
        margin: 0;
        padding-bottom: 5px;
        font-size: 20px;
        font-weight: 780;
        letter-spacing: 0;
      }

      .sheet-tabs {
        display: flex;
        gap: 2px;
        overflow-x: auto;
        scrollbar-width: thin;
      }

      .sheet-tab {
        position: relative;
        min-width: max-content;
        padding: 8px 12px 9px;
        border: 1px solid #cbd6e7;
        border-bottom: 0;
        color: #65718a;
        background: transparent;
        cursor: pointer;
      }

      .sheet-tab[aria-selected="true"] {
        color: #173d70;
        font-weight: 720;
        background: #fff;
      }

      .sheet-tab[aria-selected="true"]::after {
        position: absolute;
        right: 8px;
        bottom: 0;
        left: 8px;
        height: 3px;
        background: #17a6a0;
        content: "";
      }

      .calendar-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(230px, 18vw);
        gap: 10px;
        align-items: stretch;
      }

      .table-shell {
        min-width: 0;
        overflow: hidden;
        border: 2px solid #244f83;
        background: #fff;
      }

      table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
      }

      th, td {
        border: 1px solid #9eb0c8;
      }

      th:last-child, td:last-child { border-right: 0; }
      tbody tr:last-child td { border-bottom: 0; }

      th {
        height: 29px;
        padding: 4px 3px;
        color: #fff;
        background: #173d70;
        font-size: 11px;
        font-weight: 720;
        text-align: center;
      }

      td {
        height: auto;
        padding: 0;
        overflow: visible;
        vertical-align: top;
        background: #fff;
        font-size: 9px;
        line-height: 1.24;
        letter-spacing: 0;
      }

      .cell-content {
        display: flex;
        min-width: 0;
        min-height: var(--week-height, 110px);
        height: auto;
        flex-direction: column;
        align-items: stretch;
        gap: 4px;
        padding: 4px 5px 5px;
        overflow: visible;
      }

      td.is-empty { background: #e9eeec !important; }

      .date-line {
        display: inline-flex;
        min-width: 24px;
        min-height: 22px;
        align-items: center;
        align-self: flex-start;
        justify-content: center;
        margin: 0 0 4px;
        padding: 2px 6px;
        border-radius: 4px;
        color: #fff;
        background: #17a6a0;
        font-size: 10px;
        font-weight: 800;
        line-height: 1.15;
      }

      .event-line {
        display: block;
        min-width: 0;
        margin: 0;
        padding: 3px 4px;
        position: relative;
        overflow-wrap: anywhere;
        border-left: 4px solid #4b5563;
        border-radius: 2px;
        color: #1f2937;
        background: #f1f5f9;
      }

      .event-line.kind-group, .legend-item.kind-group { color: #9a3412; }
      .event-line.kind-group { border-left-color: #c2410c; background: #ffedd5; }
      .event-line.kind-vip, .legend-item.kind-vip { color: #6d28d9; }
      .event-line.kind-vip { border-left-color: #7c3aed; background: #f3e8ff; }
      .event-line.kind-sas, .legend-item.kind-sas { color: #075cbe; }
      .event-line.kind-sas { border-left-color: #0b66d4; background: #e0f2fe; }
      .event-line.kind-tmc, .legend-item.kind-tmc { color: #9a3412; }
      .event-line.kind-tmc { border-left-color: #c2410c; background: #ffedd5; }
      .event-line.kind-travel, .legend-item.kind-travel { color: #7a4b00; }
      .event-line.kind-travel { border-left-color: #a16207; background: #fef3c7; }
      .event-line.kind-availability, .legend-item.kind-availability { color: #0f766e; }
      .event-line.kind-availability { border-left-color: #0f857d; background: #d9f7f4; }
      .event-line.kind-reserved, .legend-item.kind-reserved { color: #475569; }
      .event-line.kind-reserved { border-left-color: #64748b; background: #f1f5f9; }
      .event-line.kind-free, .legend-item.kind-free { color: #166534; }
      .event-line.kind-free {
        border-left-color: #22c55e;
        color: #12340e;
        background: #b7ff3c;
        box-shadow: inset 0 0 0 1px rgb(34 197 94 / 30%);
      }
      .event-line.kind-special {
        border-left-color: #0284c7;
        color: #0c4a6e;
        background: #e0f2fe;
      }

      .event-time {
        display: block;
        color: currentColor;
        font-size: 8px;
        font-weight: 800;
        line-height: 1.2;
      }

      .event-title {
        display: block;
        margin-top: 2px;
        font-weight: 750;
        line-height: 1.3;
      }

      .notes-rail {
        min-width: 0;
        border: 1px solid #a0aaa6;
        background: #fff;
      }

      .notes-section + .notes-section { border-top: 1px solid #a0aaa6; }

      .notes-heading {
        margin: 0;
        padding: 7px 9px;
        color: #fff;
        background: #173d70;
        font-size: 11px;
        font-weight: 750;
      }

      .notes-list {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .note-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 6px;
        padding: 6px 8px;
        border-top: 1px solid #d8dddb;
        font-size: 9px;
        line-height: 1.3;
      }

      .note-item:nth-child(odd) { background: #f2f6fb; }

      .note-item:first-child { border-top: 0; }
      .note-label { color: #34413e; }
      .note-value { color: #6a7471; font-weight: 700; }
      .note-item.highlight-travel { border-left: 4px solid #d6a800; background: #fff6cc; }
      .note-item.highlight-holiday { border-left: 4px solid #2e7d32; background: #e8f5e9; }
      .note-item.highlight-makeup { border-left: 4px solid #9aa1a8; background: #eef1f3; }
      .note-item[class*="highlight-"] .note-label,
      .note-item[class*="highlight-"] .note-value { color: #20304f; font-weight: 800; }
      .school-note { display: block; }

      .contact-qr-wrap {
        position: relative;
        width: calc(100% - 20px);
        max-width: 200px;
        aspect-ratio: 1;
        margin: 12px auto 14px;
        overflow: hidden;
        border: 1px solid #d5deed;
        border-radius: 5px;
        background: #fff;
        box-shadow: 0 8px 22px rgb(23 48 78 / 12%);
      }

      .contact-qr {
        position: absolute;
        top: -68.33%;
        left: -28.33%;
        display: block;
        width: 156.33%;
        max-width: none;
        height: auto;
      }

      .status {
        display: grid;
        min-height: 45vh;
        place-items: center;
        padding: 40px 20px;
        text-align: center;
      }

      .status strong { display: block; margin-bottom: 8px; font-size: 18px; }
      .status span { color: #68736f; font-size: 14px; }
      [hidden] { display: none !important; }

      @media (max-width: 900px) {
        .calendar-layout { grid-template-columns: 1fr; }
        .table-shell { overflow-x: auto; }
        table { min-width: 720px; }
        .notes-rail { display: grid; grid-template-columns: 1fr 1fr; }
        .notes-section + .notes-section { border-top: 0; border-left: 1px solid #a0aaa6; }
        .contact-section { grid-column: 1 / -1; border-top: 1px solid #a0aaa6 !important; border-left: 0 !important; }
      }

      @media (max-width: 640px) {
        .coach-banner { aspect-ratio: 1683 / 935; }
        .banner-socials {
          right: 8px;
          bottom: 8px;
          left: 8px;
          justify-content: center;
          gap: 12px;
          padding: 7px 8px;
          font-size: 11px;
        }
        .page-header {
          grid-template-columns: minmax(0, 1fr) 36px;
          gap: 7px 12px;
          min-height: 56px;
          padding: 8px 10px 0;
        }
        .identity h1 { font-size: 16px; }
        .site-nav {
          grid-column: 1 / -1;
          grid-row: 2;
          width: calc(100% + 20px);
          margin-left: -10px;
          gap: 0;
          border-top: 1px solid #e2e8f1;
        }
        .site-nav a {
          flex: 1 1 16.666%;
          padding: 12px 2px 10px;
          font-size: clamp(10px, 3.2vw, 13px);
          text-align: center;
        }
        .refresh-button { grid-column: 2; grid-row: 1; }
        main { padding: 8px 0 0; }
        .availability-note {
          width: calc(100% - 18px);
          align-items: flex-start;
          flex-direction: column;
          gap: 10px;
          margin-bottom: 10px;
        }
        .schedule-legend { width: calc(100% - 18px); margin-bottom: 10px; font-size: 10px; }
        .schedule-toolbar { align-items: center; padding: 0 9px; }
        .month-heading { font-size: 17px; }
        .sheet-tab { padding-right: 9px; padding-left: 9px; }
        .table-shell, .notes-rail { border-right: 0; border-left: 0; }
        .cell-content { min-height: 108px; }
        .notes-rail { grid-template-columns: 1fr; }
        .contact-section { grid-column: auto; }
        .notes-section + .notes-section { border-top: 1px solid #a0aaa6; border-left: 0; }
      }

      body { font-family: "Manrope", Inter, system-ui, sans-serif; background: #eaf1f9; }
      .spatial-schedule-context h1 { margin: 0; color: #10224a; font-size: 15px; letter-spacing: -.02em; }
      .spatial-schedule-context p { margin: 2px 0 0; color: #65758a; font-size: 9px; }
      .refresh-button { border-color: #d4a900; border-radius: 999px; color: #10224a; background: #ffcc00; }
      .refresh-button:hover { background: #ffdf57; }
      .refresh-button:focus-visible, .sheet-tab:focus-visible { outline-color: #ffcc00; }
      main { position: relative; padding-top: 18px; background: radial-gradient(circle at 88% 0, rgb(94 136 199 / 20%), transparent 34%); }
      .availability-note { border: 1px solid #b8cbe2; border-left: 6px solid #ffcc00; border-radius: 0; background: rgb(255 255 255 / 92%); box-shadow: 0 14px 34px rgb(16 34 74 / 8%); }
      .availability-note a { border-radius: 999px; color: #10224a; background: #ffcc00; }
      .availability-note a:hover { background: #ffdf57; }
      .schedule-toolbar { min-height: 46px; padding: 0 12px; color: white; background: #10224a; }
      .sheet-tab { color: #d6e3f5; border-color: #58749a; }
      .sheet-tab[aria-selected="true"] { color: #10224a; background: #f8fbff; }
      .sheet-tab[aria-selected="true"]::after { background: #ffcc00; }
      .table-shell { border-color: #10224a; box-shadow: 0 22px 54px rgb(16 34 74 / 13%); }
      th { background: #10224a; }
      .date-line { background: #28518d; }
      .notes-rail { border-color: #9fb4ce; background: rgb(255 255 255 / 88%); }
      @media (max-width: 760px) {
        .spatial-schedule-context { display: none; }
        main { padding-top: 10px; }
        .schedule-toolbar { padding-inline: 9px; }
      }
    </style>
  </head>
  <body>
    <SpatialSiteHeader current="schedule">
      <div slot="context" class="spatial-schedule-context">
        <h1 id="schedule-title">Coach Kai's Availability</h1>
        <p id="updated-time">正在载入 Loading</p>
      </div>
      <button slot="action" class="refresh-button" type="button" title="Refresh" aria-label="Refresh schedule">
        <RefreshCw size={17} stroke-width={2} aria-hidden="true" />
      </button>
    </SpatialSiteHeader>

    <main>
      <div class="availability-note">
        <p>
          Bright green times are available. Other displayed times are already booked.
          Please contact Coach Kai to confirm an available coaching time.
        </p>
        <a href="/contact/">Confirm a time</a>
      </div>
      <div class="schedule-legend" aria-label="Schedule colour legend">
        <span class="legend-item kind-free"><i class="legend-swatch" aria-hidden="true"></i>Free</span>
        <span class="legend-item kind-group"><i class="legend-swatch" aria-hidden="true"></i>Class booked</span>
        <span class="legend-item kind-reserved"><i class="legend-swatch" aria-hidden="true"></i>Time booked</span>
        <span class="legend-item kind-tmc"><i class="legend-swatch" aria-hidden="true"></i>TMC</span>
        <span class="legend-item kind-travel"><i class="legend-swatch" aria-hidden="true"></i>Travel</span>
      </div>
      <div class="status" id="status" role="status">
        <div><strong>正在载入</strong><span>Loading schedule</span></div>
      </div>
      <section id="schedule" hidden>
        <div class="schedule-toolbar">
          <h2 class="month-heading" id="month-heading"></h2>
          <div class="sheet-tabs" id="sheet-tabs" role="tablist" aria-label="Schedule months"></div>
        </div>
        <div class="calendar-layout">
          <div class="table-shell" id="table-shell"></div>
          <aside class="notes-rail" id="notes-rail" aria-label="Schedule notes"></aside>
        </div>
      </section>
    </main>
    <SiteFooter />

    <script>
      import { weeklyScheduleBlocks } from "../lib/weeklySchedule";

      type Cell = { value?: string };
      type Sheet = {
        id: number;
        title: string;
        columns: Array<{ hidden?: boolean }>;
        rows: Array<{ hidden?: boolean; cells?: Cell[] }>;
      };
      type ScheduleData = {
        status: string;
        updatedAt: string | null;
        privacyMode?: string;
        sheets: Sheet[];
      };

      const statusElement = document.querySelector<HTMLElement>("#status");
      const scheduleElement = document.querySelector<HTMLElement>("#schedule");
      const tabsElement = document.querySelector<HTMLElement>("#sheet-tabs");
      const tableShell = document.querySelector<HTMLElement>("#table-shell");
      const notesRail = document.querySelector<HTMLElement>("#notes-rail");
      const monthHeading = document.querySelector<HTMLElement>("#month-heading");
      const updatedTime = document.querySelector<HTMLElement>("#updated-time");
      const refreshButton = document.querySelector<HTMLButtonElement>(".refresh-button");

      refreshButton?.addEventListener("click", () => window.location.reload());

      function showStatus(title: string, detail: string) {
        if (!statusElement || !scheduleElement) return;
        statusElement.replaceChildren();
        const wrapper = document.createElement("div");
        const strong = document.createElement("strong");
        const span = document.createElement("span");
        strong.textContent = title;
        span.textContent = detail;
        wrapper.append(strong, span);
        statusElement.append(wrapper);
        statusElement.hidden = false;
        scheduleElement.hidden = true;
      }

      function cellValue(sheet: Sheet, row: number, column: number) {
        return sheet.rows[row]?.cells?.[column]?.value?.trim() ?? "";
      }

      const nonNameCapitalizedWords = new Set([
        "Class", "Demo", "Training", "Kunshan", "SAS", "TMC", "JH", "SH", "US", "Weds", "Thursday",
        "Reserved", "Time", "Office", "Work", "Block", "Online", "Offline",
      ]);

      function calendarDisplayEventKind(label: string) {
        if (/\bVIP\b|\b1\s*(?:-|v)\s*1\b|\b1\s*-?\s*on\s*-?\s*1\b|一对一/i.test(label)) return "vip";
        if (/班课|年级|\bgroup\b|\bLogan\s*班\b/i.test(label)) return "group";
        const words = label.match(/\b[A-Z][a-z]{1,}\b/g) ?? [];
        if (
          words.some((word) => !nonNameCapitalizedWords.has(word)) ||
          /\b[A-Z][a-z]+(?:[A-Z][a-z]+)+\b/.test(label) ||
          /[-–—]\s*[a-z][a-z]+(?:\.[a-z])?\b/.test(label)
        ) return "vip";
        if (/\bSAS\b/i.test(label)) return "sas";
        if (/\bTMC\b|\(TMC\)/i.test(label)) return "tmc";
        if (/班课|\bclass\b|\bgroup\b|\bJH\b|龙柏/i.test(label)) return "group";
        return "reserved";
      }

      function availabilityKind(value: string) {
        if (/^Holiday$/i.test(value)) return "availability";
        if (/^Unavailable$/i.test(value)) return "availability";
        if (/^Limited availability$/i.test(value)) return "availability";
        if (/^Online available$/i.test(value)) return "availability";
        if (/^In-person: Malaysia only$/i.test(value)) return "travel";
        if (/^Travel: Malaysia$/i.test(value)) return "travel";
        const eventMatch = value.match(/^(?:[01]\d|2[0-3]):[0-5]\d(?:–(?:[01]\d|2[0-3]):[0-5]\d)? · (.+)$/);
        return eventMatch ? calendarDisplayEventKind(eventMatch[1]) : "";
      }

      function makePublicEvent(kind: string, timeText: string, titleText: string) {
        const event = document.createElement("span");
        event.className = `event-line kind-${kind}`;

        if (timeText) {
          const time = document.createElement("span");
          time.className = "event-time";
          time.textContent = timeText;
          const title = document.createElement("span");
          title.className = "event-title";
          title.textContent = titleText;
          event.append(time, title);
        } else {
          event.textContent = titleText;
        }

        return event;
      }

      function appendLines(
        cell: HTMLTableCellElement,
        value: string,
        column: number,
        monthTitle: string,
      ) {
        const lines = value.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
        const content = document.createElement("div");
        content.className = "cell-content";
        content.style.cssText =
          "display:flex;min-width:0;min-height:var(--week-height,110px);height:auto;flex-direction:column;align-items:stretch;gap:4px;padding:4px 5px 5px;overflow:visible";
        if (lines.length === 0) {
          cell.classList.add("is-empty");
          cell.append(content);
          return;
        }

        const date = document.createElement("span");
        date.className = "date-line";
        date.textContent = lines[0].replace(/\s*\(\s*\d+(?:\.\d+)?h\s*\)\s*/gi, "").trim();
        date.style.cssText =
          "display:inline-flex;align-self:flex-start;align-items:center;justify-content:center;min-width:24px;min-height:22px;margin:0;padding:2px 6px;border-radius:4px;color:#fff;background:#17a6a0;font-size:10px;font-weight:800;line-height:1.15";
        content.append(date);

        for (const block of weeklyScheduleBlocks(column, lines, monthTitle)) {
          content.append(makePublicEvent(block.kind, block.timeText, block.title));
        }

        for (const line of lines.slice(1)) {
          if (/^(?:Limited availability|In-person: Malaysia only|Travel: Malaysia)$/i.test(line)) continue;

          const eventMatch = line.match(/^((?:[01]\d|2[0-3]):[0-5]\d(?:[–-](?:[01]\d|2[0-3]):[0-5]\d)?) · (.+)$/);
          if (eventMatch) {
            const originalKind = calendarDisplayEventKind(eventMatch[2]);
            const isTmc = /\bTMC\b|\(TMC\)/i.test(eventMatch[2]);
            const isClass = originalKind === "group" || originalKind === "sas";
            content.append(
              makePublicEvent(
                isTmc ? "tmc" : isClass ? "group" : "reserved",
                eventMatch[1],
                isTmc ? eventMatch[2] : isClass ? "Class booked" : "Time booked",
              ),
            );
            continue;
          }

          if (/^(?:Free|Available)$/i.test(line)) {
            content.append(makePublicEvent("free", "", "Free"));
          } else if (/^Online available$/i.test(line)) {
            continue;
          } else if (/^(?:Holiday|Unavailable)$/i.test(line)) {
            content.append(makePublicEvent("reserved", "", "Unavailable"));
          } else if (/^(?:Travel:|In-person:)/i.test(line)) {
            content.append(makePublicEvent("travel", "", "Travel"));
          }
        }
        cell.append(content);
      }

      function makeContactSection() {
        const section = document.createElement("section");
        section.className = "notes-section contact-section";
        const heading = document.createElement("h3");
        heading.className = "notes-heading";
        heading.textContent = "Contact Coach Kai";
        const imageWrap = document.createElement("div");
        imageWrap.className = "contact-qr-wrap";
        const qrImage = document.createElement("img");
        qrImage.className = "contact-qr";
        qrImage.src = "/images/coach-kai-wechat-qr.png";
        qrImage.alt = "WeChat QR code for Coach Kai";
        qrImage.width = 938;
        qrImage.height = 1340;
        qrImage.loading = "eager";
        qrImage.decoding = "async";
        imageWrap.append(qrImage);
        section.append(heading, imageWrap);
        return section;
      }

      function renderSheet(sheet: Sheet) {
        if (!tableShell || !notesRail || !monthHeading) return;
        tableShell.replaceChildren();
        notesRail.replaceChildren();
        monthHeading.textContent = sheet.title;

        const weekdayRow = sheet.rows.findIndex((_, index) =>
          /^Sunday$/i.test(cellValue(sheet, index, 0)),
        );
        if (weekdayRow < 0) {
          showStatus("无法显示此月份", "This month does not contain a calendar grid");
          return;
        }

        const calendarRows = sheet.rows.slice(weekdayRow + 1).filter((row) =>
          row.cells?.slice(0, 7).some((cell) => cell.value?.trim()),
        );
        const availableHeight = Math.max(420, window.innerHeight - 164);
        const weekHeight = Math.min(
          142,
          Math.max(72, Math.floor(availableHeight / Math.max(calendarRows.length, 1))),
        );
        tableShell.style.setProperty("--week-height", `${weekHeight}px`);

        const table = document.createElement("table");
        table.setAttribute("aria-label", `${sheet.title} calendar`);
        table.style.cssText =
          "width:100%;border-collapse:collapse;border-spacing:0;table-layout:fixed;background:#fff";
        const thead = document.createElement("thead");
        const headerRow = document.createElement("tr");
        for (let column = 0; column < 7; column += 1) {
          const th = document.createElement("th");
          th.scope = "col";
          th.textContent = cellValue(sheet, weekdayRow, column);
          th.style.cssText =
            "height:29px;padding:4px 3px;border:1px solid #8da3bf;color:#fff;background:#173d70;font-size:11px;font-weight:720;text-align:center";
          if (column === 0 || column === 6) th.classList.add("is-weekend");
          headerRow.append(th);
        }
        thead.append(headerRow);

        const tbody = document.createElement("tbody");
        for (const row of calendarRows) {
          const tr = document.createElement("tr");
          for (let column = 0; column < 7; column += 1) {
            const td = document.createElement("td");
            td.style.cssText = "height:auto;padding:0;overflow:visible;border:1px solid #9eb0c8;vertical-align:top;background:#fff;font-size:9px;line-height:1.24";
            if (column === 0 || column === 6) td.classList.add("is-weekend");
            appendLines(td, row.cells?.[column]?.value ?? "", column, sheet.title);
            tr.append(td);
          }
          tbody.append(tr);
        }
        table.append(thead, tbody);
        tableShell.append(table);

        notesRail.append(makeContactSection());
        notesRail.hidden = notesRail.childElementCount === 0;

      }

      function renderSchedule(data: ScheduleData) {
        if (!tabsElement || !scheduleElement || !statusElement || !updatedTime) return;
        if (data.privacyMode !== "calendar-display-event-details") {
          showStatus("暂时无法显示时间", "Availability is temporarily unavailable");
          updatedTime.textContent = "";
          return;
        }
        const visibleSheets = data.sheets;
        if (data.status !== "ready" || visibleSheets.length === 0) {
          showStatus("时间表尚未发布", "Schedule setup is not complete");
          updatedTime.textContent = "等待首次同步 Waiting for first sync";
          return;
        }

        updatedTime.textContent = data.updatedAt
          ? `最后更新 Updated ${new Intl.DateTimeFormat(undefined, {
              dateStyle: "medium",
              timeStyle: "short",
            }).format(new Date(data.updatedAt))}`
          : "";

        tabsElement.replaceChildren();
        visibleSheets.forEach((sheet, index) => {
          const button = document.createElement("button");
          button.className = "sheet-tab";
          button.type = "button";
          button.role = "tab";
          button.textContent = sheet.title;
          button.ariaSelected = String(index === 0);
          button.addEventListener("click", () => {
            tabsElement.querySelectorAll(".sheet-tab").forEach((tab) => {
              tab.setAttribute("aria-selected", String(tab === button));
            });
            renderSheet(sheet);
          });
          tabsElement.append(button);
        });

        statusElement.hidden = true;
        scheduleElement.hidden = false;
        renderSheet(visibleSheets[0]);
      }

      const scheduleDataUrl = "/data/schedule.json";

      fetch(scheduleDataUrl, { cache: "no-store" })
        .then((response) => {
          if (!response.ok) throw new Error("Schedule data is unavailable.");
          return response.json() as Promise<ScheduleData>;
        })
        .then(renderSchedule)
        .catch(() => {
          showStatus("暂时无法载入时间表", "The schedule could not be loaded");
          if (updatedTime) updatedTime.textContent = "";
        });
    </script>
  </body>
</html>


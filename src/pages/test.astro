---
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/playfair-display/600.css";
import "@fontsource/playfair-display/600-italic.css";
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";

const stages = [
  {
    id: "speak",
    number: "01",
    name: "Speak",
    eyebrow: "Begin at the center",
    title: "Make the idea clear.",
    copy: "Find the words, structure the thought, and deliver it with control.",
    detail: "Speeches · interviews · presentations",
  },
  {
    id: "connect",
    number: "02",
    name: "Connect",
    eyebrow: "Reach another person",
    title: "Turn attention into trust.",
    copy: "Read the room, include the audience, and make every message feel human.",
    detail: "Students · parents · teams",
  },
  {
    id: "influence",
    number: "03",
    name: "Influence",
    eyebrow: "Move the moment",
    title: "Help people see what you see.",
    copy: "Combine story, evidence, and presence so ideas become memorable and persuasive.",
    detail: "Debate · leadership · advocacy",
  },
  {
    id: "build",
    number: "04",
    name: "Build",
    eyebrow: "Make growth repeatable",
    title: "Give confidence a system.",
    copy: "Use purposeful rehearsal and exact feedback to turn one good performance into a dependable skill.",
    detail: "Prepare · perform · review",
  },
  {
    id: "reputation",
    number: "05",
    name: "Reputation",
    eyebrow: "Let the effect compound",
    title: "Become known for how you communicate.",
    copy: "Clear, credible moments accumulate into the opportunities, relationships, and reputation that arrive next.",
    detail: "Voice · visibility · victory",
  },
];
---

<!doctype html>
<html lang="en" data-stage="0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Travel through the complete SpeakKai ripple: Speak, Connect, Influence, Build, and Reputation."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3f1e9" />
    <title>SpeakKai Test | Inside the Ripple</title>
    <style>
      :root {
        color-scheme: light;
        font-family: "DM Sans", sans-serif;
        --night: #080a08;
        --ink: #11130f;
        --paper: #f3f1e9;
        --paper-bright: #fff;
        --muted: #666a61;
        --line: rgb(17 19 15 / 21%);
        --acid: #c9ff36;
        --ring-shift: 0deg;
        --world-scale: 1;
      }

      * { box-sizing: border-box; }
      html { min-width: 320px; overflow-x: clip; scroll-behavior: smooth; }
      body { margin: 0; overflow-x: clip; color: var(--ink); background: var(--paper); }
      a { color: inherit; }
      button { color: inherit; font: inherit; }

      html[data-stage="1"] { --ring-shift: 13deg; --world-scale: 1.04; }
      html[data-stage="2"] { --ring-shift: 31deg; --world-scale: 1.08; }
      html[data-stage="3"] { --ring-shift: 57deg; --world-scale: 1.13; }
      html[data-stage="4"] { --ring-shift: 88deg; --world-scale: 1.19; }

      .skip-link {
        position: fixed;
        z-index: 100;
        top: 12px;
        left: 12px;
        padding: 10px 14px;
        border-radius: 50%;
        color: var(--ink);
        background: var(--acid);
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transform: translateY(-180%);
      }
      .skip-link:focus { transform: translateY(0); }

      .brand,
      .experiment-picks,
      .scroll-cue {
        position: fixed;
        z-index: 40;
      }
      .brand {
        top: 22px;
        left: 24px;
        display: grid;
        width: 76px;
        height: 76px;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: rgb(255 255 255 / 70%);
        font-size: 16px;
        font-weight: 700;
        letter-spacing: -.05em;
        text-decoration: none;
        backdrop-filter: blur(14px);
      }
      .brand span { color: #719400; }
      .experiment-picks {
        top: 22px;
        right: 24px;
        display: flex;
        gap: 7px;
      }
      .experiment-picks a {
        display: grid;
        width: 76px;
        height: 76px;
        place-items: center;
        border: 1px solid var(--ink);
        border-radius: 50%;
        color: var(--paper);
        background: var(--ink);
        font-family: "Space Mono", monospace;
        font-size: 8px;
        font-weight: 700;
        line-height: 1.25;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
        transition: color .25s ease, background .25s ease, transform .25s ease;
      }
      .experiment-picks a:last-child { color: var(--ink); background: var(--acid); }
      .experiment-picks a:hover { transform: rotate(8deg) scale(1.04); }

      .world {
        position: fixed;
        z-index: 0;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
      }
      .world::before {
        position: absolute;
        inset: -25%;
        background:
          radial-gradient(circle at 50% 50%, #070907 0 6%, #151813 7% 12%, rgb(36 40 32 / 65%) 16%, rgb(224 223 214 / 64%) 32%, #f5f3ec 55% 100%);
        content: "";
        transform: scale(calc(.94 + (var(--world-scale) - 1) * .3));
        transition: transform 1.2s cubic-bezier(.2,.75,.2,1);
      }
      .world::after {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 29% 24%, rgb(255 255 255 / 62%), transparent 26%),
          radial-gradient(circle at 74% 77%, rgb(201 255 54 / 8%), transparent 27%);
        content: "";
      }
      .ring-system {
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(126vw, 1340px);
        aspect-ratio: 1;
        transform: translate(-50%, -50%) scale(var(--world-scale)) rotate(var(--ring-shift));
        transition: transform 1.2s cubic-bezier(.2,.75,.2,1);
      }
      .ring {
        position: absolute;
        border: 1px solid var(--line);
        border-radius: 50%;
        box-shadow: inset 0 0 50px rgb(255 255 255 / 8%);
        transition: border-color .7s ease, box-shadow .7s ease, opacity .7s ease;
      }
      .ring::before,
      .ring::after {
        position: absolute;
        border-radius: 50%;
        background: #868b80;
        content: "";
        transition: background .7s ease, box-shadow .7s ease, scale .7s ease;
      }
      .ring::before { top: -4px; left: 50%; width: 7px; height: 7px; }
      .ring::after { right: 12%; bottom: 13%; width: 4px; height: 4px; opacity: .5; }
      .ring-1 { inset: 40%; animation: breathe 5s ease-in-out infinite; }
      .ring-2 { inset: 31%; animation: orbit 48s linear infinite; }
      .ring-3 { inset: 22%; animation: orbit-reverse 64s linear infinite; }
      .ring-4 { inset: 12.8%; animation: orbit 82s linear infinite; }
      .ring-5 { inset: 3.5%; animation: orbit-reverse 102s linear infinite; }

      html[data-stage="0"] .ring-1,
      html[data-stage="1"] .ring-2,
      html[data-stage="2"] .ring-3,
      html[data-stage="3"] .ring-4,
      html[data-stage="4"] .ring-5 {
        border-color: rgb(113 148 0 / 72%);
        box-shadow: inset 0 0 60px rgb(201 255 54 / 7%), 0 0 24px rgb(201 255 54 / 13%);
      }
      html[data-stage="0"] .ring-1::before,
      html[data-stage="1"] .ring-2::before,
      html[data-stage="2"] .ring-3::before,
      html[data-stage="3"] .ring-4::before,
      html[data-stage="4"] .ring-5::before {
        background: var(--acid);
        box-shadow: 0 0 18px #9dca1d;
        scale: 1.5;
      }

      .axis {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1px;
        height: 45%;
        background: linear-gradient(rgb(17 19 15 / 18%), transparent);
        transform-origin: 50% 0;
      }
      .axis-1 { transform: rotate(72deg); }
      .axis-2 { transform: rotate(144deg); }
      .axis-3 { transform: rotate(216deg); }
      .axis-4 { transform: rotate(288deg); }

      .radial-nav {
        position: fixed;
        z-index: 30;
        top: 50%;
        left: 50%;
        width: min(126vw, 1340px);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        pointer-events: none;
      }
      .radial-nav a {
        position: absolute;
        display: grid;
        min-width: 92px;
        min-height: 42px;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 50%;
        color: #686d64;
        background: rgb(255 255 255 / 66%);
        font-family: "Space Mono", monospace;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .08em;
        text-decoration: none;
        text-transform: uppercase;
        backdrop-filter: blur(14px);
        pointer-events: auto;
        transition: color .4s ease, border-color .4s ease, background .4s ease, transform .4s ease;
      }
      .radial-nav a[aria-current="step"] {
        border-color: var(--ink);
        color: var(--ink);
        background: var(--acid);
        transform: scale(1.1);
      }
      .radial-nav a:nth-child(1) { top: 42%; left: 44%; }
      .radial-nav a:nth-child(2) { top: 24%; left: 25%; }
      .radial-nav a:nth-child(3) { top: 15%; right: 23%; }
      .radial-nav a:nth-child(4) { right: 3%; bottom: 31%; }
      .radial-nav a:nth-child(5) { bottom: 4%; left: 43%; }

      .journey { position: relative; z-index: 10; }
      .chapter {
        position: relative;
        display: grid;
        min-height: 100svh;
        place-items: center;
        padding: 112px 24px;
      }
      .lens {
        position: relative;
        display: flex;
        width: clamp(310px, 41vw, 570px);
        aspect-ratio: 1;
        align-items: center;
        justify-content: center;
        padding: clamp(42px, 6vw, 86px);
        overflow: hidden;
        border: 1px solid rgb(17 19 15 / 27%);
        border-radius: 50%;
        color: var(--ink);
        background: rgb(250 249 244 / 84%);
        box-shadow: 0 45px 130px rgb(29 33 25 / 15%);
        text-align: center;
        backdrop-filter: blur(24px) saturate(115%);
      }
      .lens::before {
        position: absolute;
        inset: 7%;
        border: 1px solid rgb(17 19 15 / 9%);
        border-radius: 50%;
        content: "";
      }
      .lens-copy { position: relative; z-index: 3; }
      .chapter-number,
      .chapter-eyebrow,
      .chapter-detail {
        font-family: "Space Mono", monospace;
        text-transform: uppercase;
      }
      .chapter-number {
        display: block;
        color: #658500;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .16em;
      }
      .chapter-eyebrow {
        margin: 16px 0 0;
        color: #767b71;
        font-size: 8px;
        letter-spacing: .11em;
      }
      .chapter h1,
      .chapter h2 {
        margin: 17px auto 0;
        max-width: 440px;
        font-size: clamp(43px, 5.5vw, 78px);
        font-weight: 500;
        letter-spacing: -.07em;
        line-height: .86;
      }
      .chapter h1 em,
      .chapter h2 em {
        display: inline-block;
        padding: 0 .07em .05em;
        color: var(--ink);
        background: var(--acid);
        font-family: "Playfair Display", serif;
        font-weight: 600;
        transform: rotate(-1deg);
      }
      .chapter-copy {
        max-width: 400px;
        margin: 24px auto 0;
        color: #5e635a;
        font-size: clamp(14px, 1.25vw, 17px);
        line-height: 1.65;
      }
      .chapter-detail {
        display: block;
        margin-top: 22px;
        color: #658500;
        font-size: 8px;
        letter-spacing: .1em;
      }
      .chapter-action {
        display: inline-grid;
        width: 100px;
        height: 100px;
        place-items: center;
        margin-top: 28px;
        border-radius: 50%;
        color: var(--ink);
        background: var(--acid);
        font-family: "Space Mono", monospace;
        font-size: 8px;
        font-weight: 700;
        line-height: 1.25;
        text-decoration: none;
        text-transform: uppercase;
        transition: transform .25s ease;
      }
      .chapter-action:hover { transform: rotate(8deg) scale(1.05); }

      .chapter-speak .lens {
        width: clamp(350px, 57vw, 760px);
        color: #fff;
        background: #0a0c09;
        border-color: rgb(255 255 255 / 16%);
      }
      .chapter-speak .lens::before { border-color: rgb(255 255 255 / 13%); }
      .portrait {
        position: absolute;
        z-index: 1;
        top: 0;
        right: -5%;
        width: 72%;
        height: 100%;
        object-fit: cover;
        object-position: center 13%;
        filter: saturate(.8) contrast(1.02);
        opacity: .88;
        mask-image: linear-gradient(90deg, transparent 0%, #000 38%, #000 100%);
      }
      .portrait-shade {
        position: absolute;
        z-index: 2;
        inset: 0;
        border-radius: 50%;
        background: linear-gradient(90deg, #090b08 0 41%, rgb(9 11 8 / 78%) 54%, transparent 79%);
      }
      .chapter-speak .lens-copy {
        width: 62%;
        margin-right: auto;
        text-align: left;
      }
      .chapter-speak .chapter-number,
      .chapter-speak .chapter-detail { color: var(--acid); }
      .chapter-speak .chapter-copy { margin-left: 0; color: #c7cbc3; }
      .chapter-speak h1 { margin-left: 0; color: #fff; font-size: clamp(52px, 7vw, 104px); }

      .chapter-connect .lens { translate: -15vw 0; }
      .chapter-influence .lens { translate: 17vw -2vh; }
      .chapter-build .lens { translate: -13vw 3vh; }
      .chapter-reputation .lens { width: clamp(360px, 55vw, 760px); }

      .satellite {
        position: absolute;
        display: grid;
        place-items: center;
        border: 1px solid rgb(17 19 15 / 25%);
        border-radius: 50%;
        color: #565b52;
        background: rgb(255 255 255 / 70%);
        font-family: "Space Mono", monospace;
        font-size: 8px;
        letter-spacing: .08em;
        text-align: center;
        text-transform: uppercase;
        backdrop-filter: blur(12px);
      }
      .satellite-a { top: 18%; right: 14%; width: 118px; height: 118px; }
      .satellite-b { right: 24%; bottom: 16%; width: 82px; height: 82px; }
      .satellite-c { bottom: 18%; left: 12%; width: 104px; height: 104px; }

      .ripple-word {
        position: absolute;
        color: rgb(17 19 15 / 10%);
        font-family: "Playfair Display", serif;
        font-size: clamp(54px, 11vw, 170px);
        font-style: italic;
        font-weight: 600;
        letter-spacing: -.08em;
        white-space: nowrap;
      }
      .word-one { top: 13%; left: -3%; }
      .word-two { right: -4%; bottom: 12%; }

      .practice-loop {
        position: absolute;
        top: 50%;
        right: 8%;
        width: 290px;
        aspect-ratio: 1;
        transform: translateY(-50%);
      }
      .practice-loop span {
        position: absolute;
        display: grid;
        width: 86px;
        height: 86px;
        place-items: center;
        border: 1px solid var(--ink);
        border-radius: 50%;
        background: rgb(255 255 255 / 78%);
        font-family: "Space Mono", monospace;
        font-size: 8px;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .practice-loop span:nth-child(1) { top: 0; left: 50%; transform: translateX(-50%); }
      .practice-loop span:nth-child(2) { right: 0; bottom: 10%; background: var(--acid); }
      .practice-loop span:nth-child(3) { bottom: 10%; left: 0; }
      .practice-loop::before {
        position: absolute;
        inset: 18%;
        border: 1px dashed rgb(17 19 15 / 36%);
        border-radius: 50%;
        content: "";
        animation: orbit 18s linear infinite;
      }

      .closing-orbits {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .closing-orbits span {
        position: absolute;
        border: 1px solid rgb(17 19 15 / 10%);
        border-radius: 50%;
      }
      .closing-orbits span:nth-child(1) { inset: 5%; }
      .closing-orbits span:nth-child(2) { inset: 13%; }
      .closing-orbits span:nth-child(3) { inset: 21%; }

      .scroll-cue {
        bottom: 22px;
        left: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #70756c;
        font-family: "Space Mono", monospace;
        font-size: 8px;
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .scroll-cue::before {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 50%;
        color: var(--ink);
        background: rgb(255 255 255 / 62%);
        content: "↓";
      }

      @keyframes orbit { to { rotate: 360deg; } }
      @keyframes orbit-reverse { to { rotate: -360deg; } }
      @keyframes breathe { 50% { scale: 1.08; opacity: .72; } }

      @media (max-width: 800px) {
        .brand,
        .experiment-picks { top: 14px; right: 14px; }
        .experiment-picks a { width: 52px; height: 52px; }
        .brand { left: 14px; font-size: 12px; }
        .experiment-picks a { font-size: 7px; }
        .ring-system,
        .radial-nav { width: 168vw; }
        .radial-nav a { min-width: 74px; min-height: 34px; font-size: 7px; }
        .radial-nav a:nth-child(1) { top: 43%; left: 45%; }
        .radial-nav a:nth-child(2) { top: 25%; left: 25%; }
        .radial-nav a:nth-child(3) { top: 19%; right: 25%; }
        .radial-nav a:nth-child(4) { right: 7%; bottom: 32%; }
        .radial-nav a:nth-child(5) { bottom: 9%; left: 44%; }
        .chapter { padding: 92px 14px; }
        .lens { width: min(88vw, 470px); padding: 42px; }
        .chapter-speak .lens,
        .chapter-reputation .lens { width: min(94vw, 560px); }
        .chapter-connect .lens,
        .chapter-influence .lens,
        .chapter-build .lens { translate: 0; }
        .chapter-speak .lens-copy { width: 65%; }
        .portrait { right: -17%; width: 89%; }
        .satellite-a { top: 12%; right: -15px; width: 82px; height: 82px; }
        .satellite-b { right: 3%; bottom: 11%; width: 64px; height: 64px; }
        .satellite-c { bottom: 12%; left: -12px; width: 72px; height: 72px; }
        .practice-loop { top: auto; right: 50%; bottom: 3%; width: 220px; transform: translateX(50%); opacity: .34; }
        .practice-loop span { width: 65px; height: 65px; font-size: 7px; }
        .ripple-word { font-size: 20vw; }
        .scroll-cue { bottom: 14px; left: 14px; }
      }

      @media (max-width: 430px) {
        .radial-nav { display: none; }
        .ring-system { width: 205vw; }
        .lens { width: 92vw; padding: 38px; }
        .chapter h1,
        .chapter h2 { font-size: 12vw; }
        .chapter-speak h1 { font-size: 14vw; }
        .chapter-speak .lens-copy { width: 74%; }
        .portrait { right: -33%; width: 112%; opacity: .72; }
        .chapter-copy { font-size: 14px; }
        .chapter-action { width: 86px; height: 86px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .ring,
        .practice-loop::before { animation: none !important; }
        .ring-system,
        .world::before { transition: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#speak">Skip to the journey</a>
    <a class="brand" href="/" aria-label="SpeakKai current homepage">Speak<span>Kai</span></a>
    <div class="experiment-picks" aria-label="Related homepage experiments">
      <a href="/tests/" aria-label="Open the SpeakKai experiment lab">Lab<br />1–4</a>
      <a href="/test16/" aria-label="Open Test 16">Test<br />16</a>
    </div>

    <div class="world" aria-hidden="true">
      <div class="ring-system">
        <span class="ring ring-5"></span>
        <span class="ring ring-4"></span>
        <span class="ring ring-3"></span>
        <span class="ring ring-2"></span>
        <span class="ring ring-1"></span>
        <i class="axis axis-1"></i>
        <i class="axis axis-2"></i>
        <i class="axis axis-3"></i>
        <i class="axis axis-4"></i>
      </div>
    </div>

    <nav class="radial-nav" aria-label="The five stages of the SpeakKai journey">
      {stages.map((stage, index) => (
        <a href={`#${stage.id}`} data-stage-link={index} aria-current={index === 0 ? "step" : undefined}>
          {stage.name}
        </a>
      ))}
    </nav>

    <main class="journey">
      <section class="chapter chapter-speak" id="speak" data-stage-section="0" aria-labelledby="speak-title">
        <div class="lens">
          <img
            class="portrait"
            src="/images/coach-kai-headshot.webp"
            width="1254"
            height="1254"
            alt="Coach Kai"
            fetchpriority="high"
            decoding="async"
          />
          <span class="portrait-shade" aria-hidden="true"></span>
          <div class="lens-copy">
            <span class="chapter-number">01 · Start here</span>
            <h1 id="speak-title">Your voice moves in <em>circles.</em></h1>
            <p class="chapter-copy">Start with a clear thought. Every ring after this is what that thought can reach.</p>
            <span class="chapter-detail">Scroll outward ↓</span>
          </div>
        </div>
      </section>

      {stages.slice(1).map((stage, offset) => {
        const index = offset + 1;
        return (
          <section
            class={`chapter chapter-${stage.id}`}
            id={stage.id}
            data-stage-section={index}
            aria-labelledby={`${stage.id}-title`}
          >
            {stage.id === "connect" && (
              <>
                <span class="satellite satellite-a">Listen</span>
                <span class="satellite satellite-b">Notice</span>
                <span class="satellite satellite-c">Include</span>
              </>
            )}
            {stage.id === "influence" && (
              <>
                <span class="ripple-word word-one">Ideas</span>
                <span class="ripple-word word-two">Action</span>
              </>
            )}
            {stage.id === "build" && (
              <div class="practice-loop" aria-hidden="true">
                <span>Prepare</span><span>Perform</span><span>Review</span>
              </div>
            )}
            <div class="lens">
              {stage.id === "reputation" && (
                <div class="closing-orbits" aria-hidden="true"><span></span><span></span><span></span></div>
              )}
              <div class="lens-copy">
                <span class="chapter-number">{stage.number} · {stage.name}</span>
                <p class="chapter-eyebrow">{stage.eyebrow}</p>
                <h2 id={`${stage.id}-title`}>{stage.title}</h2>
                <p class="chapter-copy">{stage.copy}</p>
                <span class="chapter-detail">{stage.detail}</span>
                {stage.id === "reputation" && (
                  <a class="chapter-action" href="/contact/">Start your<br />next ripple ↗</a>
                )}
              </div>
            </div>
          </section>
        );
      })}
    </main>

    <div class="scroll-cue" aria-hidden="true">Move through the rings</div>

    <script is:inline>
      const root = document.documentElement;
      const sections = [...document.querySelectorAll("[data-stage-section]")];
      const links = [...document.querySelectorAll("[data-stage-link]")];
      let current = -1;

      const setStage = (next) => {
        if (next === current) return;
        current = next;
        root.dataset.stage = String(next);
        links.forEach((link, index) => {
          if (index === next) link.setAttribute("aria-current", "step");
          else link.removeAttribute("aria-current");
        });
      };

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setStage(Number(visible.target.dataset.stageSection));
      }, { threshold: [0.35, 0.55, 0.72] });

      sections.forEach((section) => observer.observe(section));
      setStage(0);
    </script>
  </body>
</html>

---
import { ArrowDown, ArrowUpRight, Sparkles } from "@lucide/astro";
import TestSwitcher from "../components/TestSwitcher.astro";

const stages = [
  {
    name: "Speak",
    eyebrow: "Find the words",
    copy: "Shape what you think into a message people can understand and remember.",
  },
  {
    name: "Connect",
    eyebrow: "Reach the room",
    copy: "Turn delivery into attention, trust, and a real human connection.",
  },
  {
    name: "Influence",
    eyebrow: "Move the moment",
    copy: "Use story, evidence, and presence to help people see what you see.",
  },
  {
    name: "Build",
    eyebrow: "Make it repeatable",
    copy: "Strengthen the habits and systems that make confident communication last.",
  },
  {
    name: "Reputation",
    eyebrow: "Become known for it",
    copy: "Let every clear, credible interaction compound into the way people remember you.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A new SpeakKai homepage concept: speak, connect, influence, build, and earn a reputation that travels."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#061313" />
    <title>SpeakKai Test | Your Voice Travels</title>
    <style>
      :root {
        color-scheme: dark;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        --ink: #061313;
        --ink-soft: #0d2221;
        --paper: #f3f0e7;
        --paper-deep: #e8e2d5;
        --acid: #d9ff57;
        --mint: #55ddc7;
        --coral: #ff765b;
        --violet: #aa99ff;
        --gold: #ffd263;
        --muted: #a7b8b4;
      }

      * { box-sizing: border-box; }

      html {
        min-width: 320px;
        min-height: 100%;
        scroll-behavior: smooth;
      }

      body {
        min-height: 100%;
        margin: 0;
        overflow-x: hidden;
        background: var(--ink);
        color: #f7f9f5;
      }

      a { color: inherit; }
      button, a { -webkit-tap-highlight-color: transparent; }

      .announcement {
        display: flex;
        min-height: 34px;
        align-items: center;
        justify-content: center;
        padding: 7px 20px;
        background: var(--acid);
        color: #10201b;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .12em;
        text-align: center;
        text-transform: uppercase;
      }

      .site-header {
        position: relative;
        z-index: 10;
        display: flex;
        width: min(100% - 48px, 1240px);
        min-height: 82px;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
        margin: 0 auto;
        border-bottom: 1px solid rgb(222 255 242 / 15%);
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        font-size: 19px;
        font-weight: 950;
        letter-spacing: -.04em;
        text-decoration: none;
      }

      .wordmark-mark {
        display: grid;
        width: 32px;
        height: 32px;
        place-items: center;
        border: 1px solid rgb(217 255 87 / 58%);
        border-radius: 50%;
        color: var(--acid);
        font-size: 13px;
        letter-spacing: 0;
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: clamp(18px, 3vw, 38px);
      }

      .site-nav a {
        color: #bfd0cb;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
      }

      .site-nav a:hover { color: #fff; }

      .nav-cta {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        gap: 7px;
        padding: 10px 15px;
        border: 1px solid rgb(217 255 87 / 72%);
        border-radius: 999px;
        color: var(--acid) !important;
      }

      .hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
      }

      .hero::before {
        position: absolute;
        z-index: -2;
        top: -260px;
        left: -300px;
        width: 760px;
        height: 760px;
        border-radius: 50%;
        background: radial-gradient(circle, rgb(85 221 199 / 13%), transparent 68%);
        content: "";
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(320px, .86fr) minmax(480px, 1.14fr);
        width: min(100% - 48px, 1240px);
        min-height: calc(100vh - 116px);
        align-items: center;
        gap: clamp(20px, 3vw, 48px);
        margin: 0 auto;
        padding: clamp(54px, 7vw, 92px) 0 clamp(70px, 8vw, 112px);
      }

      .hero-copy { position: relative; z-index: 3; }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 20px;
        color: var(--mint);
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .12em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        width: 28px;
        height: 1px;
        background: currentColor;
        content: "";
      }

      h1, h2, h3, p { text-wrap: balance; }

      h1 {
        max-width: 670px;
        margin: 0;
        font-size: clamp(52px, 6.7vw, 96px);
        font-weight: 900;
        letter-spacing: -.072em;
        line-height: .9;
      }

      h1 em {
        color: var(--acid);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 500;
      }

      .hero-summary {
        max-width: 560px;
        margin: 30px 0 0;
        color: #b5c4c0;
        font-size: clamp(17px, 1.8vw, 21px);
        line-height: 1.65;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 36px;
      }

      .button {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 13px 19px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 900;
        text-decoration: none;
        transition: transform 180ms ease, background-color 180ms ease, color 180ms ease;
      }

      .button-primary { color: #122019; background: var(--acid); }
      .button-primary:hover { transform: translateY(-2px); background: #e7ff8b; }
      .button-secondary { border-color: rgb(232 247 241 / 28%); color: #f5faf7; }
      .button-secondary:hover { border-color: rgb(232 247 241 / 55%); transform: translateY(-2px); }

      .button:focus-visible,
      .site-nav a:focus-visible,
      .wordmark:focus-visible,
      .orbit-step:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 4px;
      }

      .micro-proof {
        display: flex;
        flex-wrap: wrap;
        gap: 9px 18px;
        margin-top: 35px;
        color: #7f9590;
        font-size: 12px;
        font-weight: 750;
      }

      .micro-proof span { display: flex; align-items: center; gap: 7px; }
      .micro-proof span::before { width: 4px; height: 4px; border-radius: 50%; background: var(--mint); content: ""; }

      .orbit-shell {
        position: relative;
        display: grid;
        width: min(100%, 690px);
        aspect-ratio: 1;
        place-items: center;
        justify-self: end;
      }

      .orbit-glow {
        position: absolute;
        inset: 18%;
        border-radius: 50%;
        background: radial-gradient(circle, rgb(217 255 87 / 16%), rgb(85 221 199 / 4%) 43%, transparent 72%);
        filter: blur(14px);
      }

      .ring {
        position: absolute;
        border: 1px solid rgb(212 246 236 / 22%);
        border-radius: 50%;
        transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
      }

      .ring::after {
        position: absolute;
        top: 50%;
        left: -3px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 18px currentColor;
        content: "";
        transform: translateY(-50%);
      }

      .ring-5 { inset: 2%; color: var(--gold); }
      .ring-4 { inset: 12%; color: var(--violet); }
      .ring-3 { inset: 22%; color: var(--coral); }
      .ring-2 { inset: 32%; color: var(--mint); }
      .ring-1 { inset: 42%; color: var(--acid); }

      .orbit[data-active="1"] .ring-1,
      .orbit[data-active="2"] .ring-2,
      .orbit[data-active="3"] .ring-3,
      .orbit[data-active="4"] .ring-4,
      .orbit[data-active="5"] .ring-5 {
        border-color: currentColor;
        box-shadow: 0 0 0 5px rgb(255 255 255 / 2%), 0 0 34px rgb(217 255 87 / 8%);
        transform: scale(1.012);
      }

      .orbit-core {
        position: absolute;
        z-index: 3;
        display: grid;
        width: 19%;
        aspect-ratio: 1;
        place-items: center;
        border: 1px solid rgb(217 255 87 / 65%);
        border-radius: 50%;
        background: var(--acid);
        box-shadow: 0 0 45px rgb(217 255 87 / 17%);
        color: #0b1b16;
        font-size: clamp(11px, 1.2vw, 15px);
        font-weight: 950;
        letter-spacing: -.04em;
        text-align: center;
      }

      .orbit-core small {
        display: block;
        margin-top: -18%;
        font-size: .58em;
        letter-spacing: .12em;
        text-transform: uppercase;
      }

      .orbit-step {
        position: absolute;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border: 1px solid rgb(241 255 250 / 18%);
        border-radius: 999px;
        color: #e9f5f1;
        background: rgb(6 19 19 / 87%);
        box-shadow: 0 7px 22px rgb(0 0 0 / 19%);
        cursor: pointer;
        font: inherit;
        font-size: clamp(10px, 1.1vw, 13px);
        font-weight: 850;
        transition: border-color 180ms ease, color 180ms ease, transform 180ms ease;
      }

      .orbit-step::before { width: 7px; height: 7px; border-radius: 50%; background: currentColor; content: ""; }
      .orbit-step:hover { transform: translateY(-2px); }
      .orbit-step[aria-pressed="true"] { border-color: currentColor; }

      .step-1 { top: 45%; left: 54%; color: var(--acid); }
      .step-2 { top: 58%; left: 63%; color: var(--mint); }
      .step-3 { top: 69%; left: 48%; color: var(--coral); }
      .step-4 { top: 22%; left: 63%; color: var(--violet); }
      .step-5 { top: 5%; left: 38%; color: var(--gold); }

      .orbit-note {
        position: absolute;
        z-index: 6;
        right: 2%;
        bottom: 3%;
        width: min(48%, 270px);
        padding: 15px 16px 16px;
        border: 1px solid rgb(235 250 244 / 16%);
        border-radius: 14px;
        background: rgb(11 30 29 / 88%);
        backdrop-filter: blur(12px);
      }

      .orbit-note span {
        display: block;
        color: var(--acid);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .orbit-note strong { display: block; margin-top: 5px; font-size: 18px; }
      .orbit-note p { margin: 7px 0 0; color: #aebfba; font-size: 12px; line-height: 1.55; }

      .framework {
        position: relative;
        overflow: hidden;
        padding: clamp(78px, 10vw, 132px) 0;
        background: var(--paper);
        color: #0b1d1b;
      }

      .framework::before {
        position: absolute;
        top: -160px;
        right: -100px;
        width: 520px;
        height: 520px;
        border: 1px solid rgb(6 19 19 / 10%);
        border-radius: 50%;
        box-shadow: 0 0 0 72px rgb(6 19 19 / 3%), 0 0 0 144px rgb(6 19 19 / 2%);
        content: "";
      }

      .framework-inner,
      .outcomes-inner,
      .closing-inner,
      .footer-inner {
        position: relative;
        width: min(100% - 48px, 1160px);
        margin: 0 auto;
      }

      .framework-intro {
        display: grid;
        grid-template-columns: minmax(260px, .7fr) minmax(320px, 1.3fr);
        align-items: end;
        gap: clamp(36px, 7vw, 100px);
      }

      .section-label {
        margin: 0 0 16px;
        color: #387568;
        font-size: 11px;
        font-weight: 950;
        letter-spacing: .13em;
        text-transform: uppercase;
      }

      h2 {
        margin: 0;
        font-size: clamp(40px, 6vw, 72px);
        letter-spacing: -.065em;
        line-height: .95;
      }

      .framework-intro > p {
        max-width: 610px;
        margin: 0;
        color: #53605c;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(21px, 2.7vw, 31px);
        line-height: 1.45;
      }

      .stage-list {
        display: grid;
        margin: clamp(58px, 8vw, 96px) 0 0;
        padding: 0;
        border-top: 1px solid #b9b6ac;
        list-style: none;
      }

      .stage-card {
        display: grid;
        grid-template-columns: 74px minmax(150px, .52fr) minmax(260px, 1fr);
        align-items: center;
        gap: clamp(18px, 4vw, 58px);
        padding: clamp(27px, 4vw, 43px) 0;
        border-bottom: 1px solid #b9b6ac;
      }

      .stage-number {
        color: #77817d;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .1em;
      }

      .stage-card h3 {
        margin: 0;
        font-size: clamp(31px, 4vw, 48px);
        letter-spacing: -.05em;
      }

      .stage-copy small {
        color: #277b69;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .stage-copy p { max-width: 610px; margin: 8px 0 0; color: #5b6460; font-size: 16px; line-height: 1.65; }

      .stage-card:nth-child(1) h3 { color: #5b7600; }
      .stage-card:nth-child(2) h3 { color: #167a6d; }
      .stage-card:nth-child(3) h3 { color: #b54531; }
      .stage-card:nth-child(4) h3 { color: #6250bb; }
      .stage-card:nth-child(5) h3 { color: #9a6610; }

      .outcomes {
        padding: clamp(74px, 9vw, 116px) 0;
        background: var(--ink-soft);
      }

      .outcomes-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 40px;
      }

      .outcomes-heading h2 { max-width: 780px; color: #f4f6f1; }
      .outcomes-heading p { max-width: 310px; margin: 0; color: #9aaca7; line-height: 1.6; }

      .outcome-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-top: 50px;
      }

      .outcome-card {
        min-height: 305px;
        padding: 28px;
        border: 1px solid rgb(225 250 242 / 13%);
        border-radius: 22px;
        background: rgb(6 19 19 / 40%);
      }

      .outcome-icon {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        border-radius: 50%;
        color: #14241d;
        background: var(--acid);
        font-size: 13px;
        font-weight: 950;
      }

      .outcome-card:nth-child(2) .outcome-icon { background: var(--mint); }
      .outcome-card:nth-child(3) .outcome-icon { background: var(--coral); }

      .outcome-card h3 { margin: 78px 0 0; font-size: 27px; letter-spacing: -.04em; }
      .outcome-card p { margin: 13px 0 0; color: #9eb0ab; font-size: 15px; line-height: 1.65; }

      .closing { padding: 18px; background: var(--paper); color: #0b1d1b; }

      .closing-inner {
        display: grid;
        min-height: 450px;
        place-items: center;
        padding: clamp(50px, 8vw, 90px);
        border-radius: 28px;
        background:
          radial-gradient(circle at 0 100%, rgb(85 221 199 / 34%), transparent 34%),
          var(--acid);
        text-align: center;
      }

      .closing-inner h2 { max-width: 820px; font-size: clamp(44px, 7vw, 86px); }
      .closing-inner p { max-width: 560px; margin: 24px 0 0; color: #344538; font-size: 17px; line-height: 1.65; }
      .closing .button { margin-top: 30px; color: #fff; background: var(--ink); }
      .closing .button:hover { color: var(--acid); }

      .site-footer { padding: 34px 0; background: var(--paper); color: #53605c; }
      .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; font-size: 12px; font-weight: 750; }
      .footer-inner a { text-underline-offset: 4px; }

      @media (max-width: 980px) {
        .hero-grid { grid-template-columns: 1fr; }
        .hero-copy { max-width: 760px; }
        .orbit-shell { width: min(100%, 680px); justify-self: center; }
        .framework-intro { grid-template-columns: 1fr; }
        .outcomes-heading { align-items: start; flex-direction: column; }
      }

      @media (max-width: 760px) {
        .site-header { width: min(100% - 30px, 640px); min-height: 70px; }
        .site-nav a:not(.nav-cta) { display: none; }
        .hero-grid, .framework-inner, .outcomes-inner, .closing-inner, .footer-inner { width: min(100% - 30px, 640px); }
        .hero-grid { min-height: auto; padding-top: 58px; }
        h1 { font-size: clamp(48px, 15.3vw, 75px); }
        .orbit-shell { width: min(112%, 610px); margin-right: -6%; margin-left: -6%; }
        .orbit-note { right: 0; bottom: -1%; width: 55%; }
        .stage-card { grid-template-columns: 48px minmax(0, 1fr); }
        .stage-copy { grid-column: 2; }
        .outcome-grid { grid-template-columns: 1fr; }
        .outcome-card { min-height: 245px; }
        .outcome-card h3 { margin-top: 48px; }
        .closing { padding: 10px; }
        .closing-inner { width: 100%; min-height: 410px; border-radius: 22px; }
      }

      @media (max-width: 480px) {
        .announcement { font-size: 9px; }
        .wordmark { font-size: 17px; }
        .nav-cta { min-height: 38px; padding: 8px 11px; font-size: 11px !important; }
        .hero-actions { align-items: stretch; flex-direction: column; }
        .button { width: 100%; }
        .orbit-step { padding: 6px 8px; font-size: 9px; }
        .orbit-note { position: relative; right: auto; bottom: auto; width: min(100% - 30px, 390px); margin-top: 68%; }
        .stage-card { grid-template-columns: 38px minmax(0, 1fr); gap: 12px; }
        .stage-copy p { font-size: 14px; }
        .footer-inner { align-items: flex-start; flex-direction: column; }
      }

      @media (prefers-reduced-motion: no-preference) {
        .ring-5 { animation: drift 18s linear infinite; }
        .ring-4 { animation: drift-reverse 15s linear infinite; }
        .ring-3 { animation: drift 12s linear infinite; }
        @keyframes drift { to { rotate: 360deg; } }
        @keyframes drift-reverse { to { rotate: -360deg; } }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .button, .ring, .orbit-step { transition: none; }
      }
    </style>
  </head>
  <body>
    <div class="announcement">Experimental homepage · built from Kai's original sketch</div>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label="SpeakKai home">
        <span class="wordmark-mark" aria-hidden="true">SK</span>
        <span>SpeakKai</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/about/">About</a>
        <a href="/schedule/">Schedule</a>
        <a href="/resources/">Resources</a>
        <a class="nav-cta" href="/contact/">Let's talk <ArrowUpRight size={15} /></a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><Sparkles size={15} aria-hidden="true" /> Communication coaching</p>
            <h1 id="hero-title">Your voice can <em>travel.</em></h1>
            <p class="hero-summary">
              Speaking is only the center. Learn to connect with people, influence
              the room, build something lasting, and earn a reputation that arrives
              before you do.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#framework">Start at the center <ArrowDown size={17} /></a>
              <a class="button button-secondary" href="/about/">Meet Coach Kai <ArrowUpRight size={17} /></a>
            </div>
            <div class="micro-proof" aria-label="Coaching formats">
              <span>Students</span>
              <span>Professionals</span>
              <span>Schools &amp; teams</span>
            </div>
          </div>

          <div class="orbit-shell">
            <div class="orbit-glow" aria-hidden="true"></div>
            <div class="orbit" data-active="1" data-stages={JSON.stringify(stages)} aria-label="The SpeakKai growth system">
              <span class="ring ring-5" aria-hidden="true"></span>
              <span class="ring ring-4" aria-hidden="true"></span>
              <span class="ring ring-3" aria-hidden="true"></span>
              <span class="ring ring-2" aria-hidden="true"></span>
              <span class="ring ring-1" aria-hidden="true"></span>

              <div class="orbit-core">SpeakKai<small>start here</small></div>

              {stages.map((stage, index) => (
                <button
                  class={`orbit-step step-${index + 1}`}
                  type="button"
                  data-stage={index + 1}
                  aria-pressed={index === 0 ? "true" : "false"}
                  aria-label={`Explore ${stage.name}`}
                >
                  {stage.name}
                </button>
              ))}

              <div class="orbit-note" aria-live="polite">
                <span id="orbit-eyebrow">{stages[0].eyebrow}</span>
                <strong id="orbit-name">{stages[0].name}</strong>
                <p id="orbit-copy">{stages[0].copy}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="framework" id="framework" aria-labelledby="framework-title">
        <div class="framework-inner">
          <div class="framework-intro">
            <div>
              <p class="section-label">The SpeakKai framework</p>
              <h2 id="framework-title">Growth moves outward.</h2>
            </div>
            <p>
              The sketch begins with a simple idea: your speaking skills ripple
              through every relationship, opportunity, and room you enter.
            </p>
          </div>

          <ol class="stage-list">
            {stages.map((stage, index) => (
              <li class="stage-card">
                <span class="stage-number">0{index + 1}</span>
                <h3>{stage.name}</h3>
                <div class="stage-copy">
                  <small>{stage.eyebrow}</small>
                  <p>{stage.copy}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="outcomes" aria-labelledby="outcomes-title">
        <div class="outcomes-inner">
          <div class="outcomes-heading">
            <h2 id="outcomes-title">Built for the moments that matter.</h2>

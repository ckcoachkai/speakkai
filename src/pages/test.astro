    <TestSwitcher current="test" tone="dark" />

    <script is:inline>
      const orbit = document.querySelector(".orbit");
      const stages = JSON.parse(orbit?.dataset.stages || "[]");
      const buttons = document.querySelectorAll(".orbit-step");
      const eyebrow = document.querySelector("#orbit-eyebrow");
      const name = document.querySelector("#orbit-name");
      const copy = document.querySelector("#orbit-copy");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const stageIndex = Number(button.dataset.stage) - 1;
          const stage = stages[stageIndex];
          if (!stage || !orbit || !eyebrow || !name || !copy) return;

          orbit.dataset.active = String(stageIndex + 1);
          buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
          eyebrow.textContent = stage.eyebrow;
          name.textContent = stage.name;
          copy.textContent = stage.copy;
        });
      });
    </script>

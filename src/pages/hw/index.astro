---
import SpatialSiteHeader from '../../components/SpatialSiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import data from '../../../public/data/homework.json';
import { validateHomework, visibleSessions, latestVisibleSession, classHeading, sortedClasses, formatSessionDate, shanghaiDate } from '../../lib/homework.mjs';
import type { ClassGroup, ClassSession } from '../../lib/homework-types';

validateHomework(data);
const today = shanghaiDate();
const groups: ClassGroup[] = sortedClasses(data.classes, today);
const sessionTitle = (session: ClassSession | null) => session ? `${formatSessionDate(session.date)} · ${session.time}` : 'No dated session recorded';
const copyKinds = [['content', 'Copy class content'], ['homework', 'Copy homework'], ['both', 'Copy both']];
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><meta name="description" content="Class content and homework by exact class date and time."/><link rel="canonical" href="https://speakkai.com/hw/"/><link rel="icon" href="/favicon.svg"/><title>Class homework | SpeakKai</title></head>
<body>
<SpatialSiteHeader />
<main aria-label="Class content and homework">
  <div class="toolbar"><label for="class-picker">Class date &amp; time<select id="class-picker"><option value="all">All classes</option>{groups.map((group) => <option value={group.id}>{classHeading(group, today)}</option>)}</select></label><button id="refresh" type="button">Check for updates</button></div>
  <p id="sync-status" role="status" aria-live="polite"></p>
  <div id="homework-list">
    {groups.map((group) => {
      const current: ClassSession | null = latestVisibleSession(group, today);
      const visible = visibleSessions(group, today);
      const older = visible[1] ?? null;
      return <article id={group.id} data-class={group.id} aria-labelledby={`${group.id}-heading`}>
        <header class="class-heading"><h2 id={`${group.id}-heading`}>{sessionTitle(current)}</h2><a href={`#${group.id}`} aria-label={`Link to ${sessionTitle(current)}`}>Class link ↗</a></header>
        {current ? <>
          <div class="session-nav"><button type="button" data-action="older" disabled={!older} aria-label="Show older class session">← Older</button><span class="session-position">{visible.length > 1 ? `1 of ${visible.length} sessions` : 'Current session'}</span><button type="button" data-action="newer" disabled aria-label="Show newer class session">Newer →</button></div>
          <div class="roster"><span>Students</span><div class="student-list">{current.students.map((student) => student.feedbackUrl ? <a href={student.feedbackUrl} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label={`Private feedback for ${student.name}`}>{student.name}</a> : <button type="button" data-action="feedback" data-student={student.name} aria-label={`No individual feedback recorded for ${student.name} for this class`}>{student.name}</button>)}</div></div>
          <section class="content-section"><h3>Class content</h3>{current.classContent.length ? <ul>{current.classContent.map((item) => <li>{item}</li>)}</ul> : <p class="empty">Not recorded for this class.</p>}</section>
          <section class="homework-section"><h3>Homework</h3>{current.homework ? <><h4>{current.homework.title}</h4><ol>{current.homework.steps.map((step) => <li>{step}</li>)}</ol><p class="prepare">Preparation: {current.homework.prepareFor}</p>{current.homework.note && <p class="note">{current.homework.note}</p>}</> : <p class="empty">Not recorded for this class.</p>}</section>
          <div class="copy-row" aria-label="Copy this session"><span class="copy-label">Copy</span>{copyKinds.map(([kind, label]) => <button type="button" data-action="copy" data-kind={kind}>{label}</button>)}</div>
          <textarea class="copy-fallback" hidden readonly aria-label="Copy text fallback"></textarea><p class="card-status" role="status" aria-live="polite"></p>
        </> : <p class="empty">No dated session has been recorded for this class.</p>}
      </article>;
    })}
  </div>
</main>
<SiteFooter />
<script is:inline type="application/json" id="homework-initial" set:html={JSON.stringify(data).replaceAll('<', '\\u003c')}></script>
<script>
import { validateHomework, visibleSessions, latestVisibleSession, formatSessionDate, serializeSession, sessionNavigation, shanghaiDate, sortedClasses } from '../../lib/homework.mjs';
import type { ClassSession, ClassGroup, HomeworkDocument } from '../../lib/homework-types';

const picker = document.querySelector<HTMLSelectElement>('#class-picker')!;
const list = document.querySelector<HTMLElement>('#homework-list')!;
const status = document.querySelector<HTMLElement>('#sync-status')!;
const refreshButton = document.querySelector<HTMLButtonElement>('#refresh')!;
const initialData = JSON.parse(document.querySelector('#homework-initial')!.textContent!);
let currentData: HomeworkDocument = validateHomework(initialData);
let lastPayload = '';
let loading = false;
const selectedSessions = new Map<string, string>();
const fmt = (session: ClassSession | null) => session ? `${formatSessionDate(session.date)} · ${session.time}` : 'No dated session recorded';
function node<K extends keyof HTMLElementTagNameMap>(tag: K, value = '', className = ''): HTMLElementTagNameMap[K] { const item = document.createElement(tag); item.textContent = value; if (className) item.className = className; return item; }

function setSelectedToVisible(data: HomeworkDocument) {
  const today = shanghaiDate();
  for (const group of data.classes) {
    const sessions: ClassSession[] = visibleSessions(group, today);
    const pinned = selectedSessions.get(group.id);
    if (pinned && !sessions.some((session) => session.id === pinned)) selectedSessions.delete(group.id);
  }
}

function renderCard(group: ClassGroup) {
  const today = shanghaiDate();
  const navigation = sessionNavigation(group, selectedSessions.get(group.id), today);
  const current: ClassSession | null = navigation.selected;
  const article = document.createElement('article');
  article.id = group.id;
  article.dataset.class = group.id;
  article.setAttribute('aria-labelledby', `${group.id}-heading`);
  const header = node('header', '', 'class-heading');
  const heading = node('h2', fmt(current));
  heading.id = `${group.id}-heading`;
  const anchor = node('a', 'Class link ↗');
  anchor.href = `#${group.id}`;
  anchor.setAttribute('aria-label', `Link to ${fmt(current)}`);
  header.append(heading, anchor);
  article.append(header);
  if (!current) { article.append(node('p', 'No dated session has been recorded for this class.', 'empty')); return article; }
  const navigationBar = node('div', '', 'session-nav');
  const olderButton = node('button', '← Older');
  olderButton.type = 'button'; olderButton.disabled = !navigation.older; olderButton.dataset.action = 'older'; olderButton.setAttribute('aria-label', 'Show older class session');
  const position = node('span', navigation.sessions.length > 1 ? `${navigation.sessions.indexOf(current) + 1} of ${navigation.sessions.length} sessions` : 'Current session', 'session-position');
  const newerButton = node('button', 'Newer →');
  newerButton.type = 'button'; newerButton.disabled = !navigation.newer; newerButton.dataset.action = 'newer'; newerButton.setAttribute('aria-label', 'Show newer class session');
  navigationBar.append(olderButton, position, newerButton); article.append(navigationBar);
  const roster = node('div', '', 'roster'); roster.append(node('span', 'Students'));
  const studentList = node('div', '', 'student-list');
  for (const student of current.students) {
    if (student.feedbackUrl) {
      const link = node('a', student.name); link.href = student.feedbackUrl; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.referrerPolicy = 'no-referrer'; link.setAttribute('aria-label', `Private feedback for ${student.name}`); studentList.append(link);
    } else {
      const button = node('button', student.name); button.type = 'button'; button.dataset.action = 'feedback'; button.dataset.student = student.name; button.setAttribute('aria-label', `No individual feedback recorded for ${student.name} for this class`); studentList.append(button);
    }
  }
  roster.append(studentList); article.append(roster);
  const content = node('section', '', 'content-section'); content.append(node('h3', 'Class content'));
  if (current.classContent.length) { const items = node('ul'); current.classContent.forEach((item) => items.append(node('li', item))); content.append(items); } else content.append(node('p', 'Not recorded for this class.', 'empty'));
  article.append(content);
  const homework = node('section', '', 'homework-section'); homework.append(node('h3', 'Homework'));
  if (current.homework) { homework.append(node('h4', current.homework.title)); const items = node('ol'); current.homework.steps.forEach((item) => items.append(node('li', item))); homework.append(items, node('p', `Preparation: ${current.homework.prepareFor}`, 'prepare')); if (current.homework.note) homework.append(node('p', current.homework.note, 'note')); } else homework.append(node('p', 'Not recorded for this class.', 'empty'));
  article.append(homework);
  const copyRow = node('div', '', 'copy-row'); copyRow.setAttribute('aria-label', 'Copy this session'); copyRow.append(node('span', 'Copy', 'copy-label'));
  for (const [kind, label] of [['content', 'Copy class content'], ['homework', 'Copy homework'], ['both', 'Copy both']]) { const button = node('button', label); button.type = 'button'; button.dataset.action = 'copy'; button.dataset.kind = kind; copyRow.append(button); }
  const fallback = node('textarea', '', 'copy-fallback'); fallback.hidden = true; fallback.readOnly = true; fallback.setAttribute('aria-label', 'Copy text fallback');
  const cardStatus = node('p', '', 'card-status'); cardStatus.setAttribute('role', 'status'); cardStatus.setAttribute('aria-live', 'polite');
  article.append(copyRow, fallback, cardStatus);
  return article;
}

function applyFilter() { list.querySelectorAll<HTMLElement>('[data-class]').forEach((card) => { card.hidden = picker.value !== 'all' && card.dataset.class !== picker.value; }); }
function fromHash() { const id = location.hash.slice(1); if ([...picker.options].some((option) => option.value === id)) { picker.value = id; applyFilter(); } }
function render(data: HomeworkDocument) { setSelectedToVisible(data); const fragment = document.createDocumentFragment(); for (const group of sortedClasses(data.classes, shanghaiDate())) fragment.append(renderCard(group)); list.replaceChildren(fragment); applyFilter(); fromHash(); }

setSelectedToVisible(currentData);
fromHash();

async function copyCurrent(card: HTMLElement, kind: string | undefined) {
  if (!currentData) return;
  const group = currentData.classes.find((item) => item.id === card.dataset.class);
  const session = group && sessionNavigation(group, selectedSessions.get(group.id), shanghaiDate()).selected;
  if (!session) return;
  const text = serializeSession(session, kind);
  const fallback = card.querySelector<HTMLTextAreaElement>('.copy-fallback')!;
  const message = card.querySelector<HTMLElement>('.card-status')!;
  try { if (!navigator.clipboard || !navigator.clipboard.writeText) throw Error('Clipboard unavailable'); await navigator.clipboard.writeText(text); fallback.hidden = true; message.textContent = `Copied ${kind === 'both' ? 'class content and homework' : kind === 'content' ? 'class content' : 'homework'} for ${formatSessionDate(session.date)}.`; }
  catch { fallback.value = text; fallback.hidden = false; fallback.focus(); fallback.select(); message.textContent = 'Clipboard access was unavailable. The text is selected below; press Ctrl+C or use your device’s copy command.'; }
}

list.addEventListener('click', (event) => {
  const button = event.target instanceof Element ? event.target.closest('button') : null; if (!button) return;
  const card = button.closest<HTMLElement>('[data-class]'); if (!card || !currentData) return;
  const group = currentData.classes.find((item) => item.id === card.dataset.class); if (!group) return;
  if (button.dataset.action === 'feedback') { card.querySelector<HTMLElement>('.card-status')!.textContent = `No individual feedback recorded for ${button.dataset.student} for this class.`; return; }
  if (button.dataset.action === 'copy') { copyCurrent(card, button.dataset.kind); return; }
  const navigation = sessionNavigation(group, selectedSessions.get(group.id), shanghaiDate());
  const target = button.dataset.action === 'older' ? navigation.older : navigation.newer;
  if (target) {
    if (button.dataset.action === 'newer' && target.id === navigation.sessions[0]?.id) selectedSessions.delete(group.id);
    else selectedSessions.set(group.id, target.id);
    render(currentData);
    const updated = document.getElementById(group.id)!;
    const direction = button.dataset.action;
    const nextControl = updated.querySelector<HTMLButtonElement>(`[data-action="${direction}"]:not(:disabled)`)
      || updated.querySelector<HTMLButtonElement>('.session-nav button:not(:disabled)');
    nextControl?.focus({ preventScroll: true });
    updated.querySelector<HTMLElement>('.card-status')!.textContent = `Showing ${fmt(target)}.`;
  }
});
picker.addEventListener('change', () => { applyFilter(); history.replaceState(null, '', picker.value === 'all' ? location.pathname : `#${picker.value}`); });
addEventListener('hashchange', fromHash);
async function refresh(manual = false) {
  if (loading) return; loading = true;
  try {
    const response = await fetch('/data/homework.json', { cache: 'no-store' }); if (!response.ok) throw Error('Unavailable');
    const data = validateHomework(await response.json()); const payload = `${JSON.stringify(data)}|${shanghaiDate()}`;
    if (payload !== lastPayload) { const selectedClass = picker.value; currentData = data; render(data); picker.replaceChildren(new Option('All classes', 'all')); for (const group of sortedClasses(data.classes, shanghaiDate())) picker.add(new Option(fmt(latestVisibleSession(group, shanghaiDate())), group.id)); picker.value = [...picker.options].some((option) => option.value === selectedClass) ? selectedClass : 'all'; applyFilter(); fromHash(); lastPayload = payload; }
    if (manual) status.textContent = 'You’re viewing the latest published class content and homework.';
  } catch { status.textContent = 'Could not check for updates. The last loaded class content and homework are still shown.'; }
  finally { loading = false; }
}
refresh(); refreshButton.addEventListener('click', () => refresh(true)); setInterval(() => { if (!document.hidden) refresh(); }, 60000); document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
</script>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f4f6fa;color:#18283e;font-family:Inter,system-ui,sans-serif;line-height:1.6}main{max-width:1440px;margin:auto;padding:20px 24px 40px}.toolbar{display:flex;align-items:end;gap:16px;margin:0 0 4px}.toolbar label{font-weight:650;flex:1}select,button{font:inherit;min-height:44px;border:1px solid #acbac9;border-radius:8px;background:white;color:#18283e;padding:9px 13px}select{display:block;width:100%;margin-top:6px}button{cursor:pointer;font-weight:650}button:hover:not(:disabled){background:#e5eff6}button:disabled{cursor:not-allowed;opacity:.45}:focus-visible{outline:3px solid #147bc1;outline-offset:3px}#sync-status{font-size:14px;min-height:22px;margin:8px 0}#homework-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:18px;align-items:start}article{background:white;border:1px solid #dbe2eb;border-top:5px solid #28769f;border-radius:16px;padding:20px;box-shadow:0 5px 16px #142c4810;scroll-margin-top:20px}.class-heading{display:flex;justify-content:space-between;align-items:start;gap:12px}.class-heading h2{font-size:20px;line-height:1.3;margin:2px 0 0}.class-heading a{color:#24698e;font-size:12px;white-space:nowrap;padding:3px 0}.session-label{font-size:12px;color:#526478;margin:12px 0 6px}.session-nav{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 0 14px}.session-nav button{font-size:13px;min-height:36px;padding:6px 10px}.session-position{font-size:12px;color:#526478;text-align:center}.roster{border-top:1px solid #e2e8ef;border-bottom:1px solid #e2e8ef;padding:10px 0;margin:0 0 14px}.roster>span{display:block;text-transform:uppercase;letter-spacing:.08em;font-size:11px;font-weight:750;color:#526478;margin-bottom:5px}.student-list{display:flex;flex-wrap:wrap;gap:6px}.student-list a,.student-list button{font-size:13px;min-height:30px;padding:4px 8px;color:#24698e;background:#edf5f9;border-color:#c2dce8;border-radius:999px}.student-list a{text-decoration:none}.student-list button{cursor:pointer}.student-list a:hover,.student-list button:hover{background:#d9edf5}h3{font-size:17px;margin:14px 0 7px}h4{font-size:16px;margin:0 0 6px}ul,ol{padding-left:22px;margin:0 0 10px;font-size:14px}li{padding:3px 0}.prepare{border-left:3px solid #28769f;padding:7px 12px;background:#eef6fa;font-size:13px;font-weight:650;margin:10px 0 0}.empty,.note{color:#526478;font-size:13px}.note{margin:10px 0 0}.copy-row{display:flex;flex-wrap:wrap;align-items:center;gap:6px;border-top:1px solid #e2e8ef;margin-top:17px;padding-top:14px}.copy-label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:750;color:#526478;margin-right:2px}.copy-row button{font-size:12px;min-height:34px;padding:6px 9px}.copy-fallback{display:block;width:100%;min-height:130px;margin-top:10px;padding:10px;border:1px solid #9fb3c1;border-radius:8px;background:#f9fbfc;color:#18283e;font:13px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}.card-status{font-size:12px;color:#24698e;min-height:18px;margin:8px 0 0}article[hidden]{display:none}@media(max-width:600px){main{padding:28px 16px 40px}.toolbar{align-items:stretch;flex-direction:column}.class-heading{flex-direction:column;gap:0}.class-heading a{margin-top:4px}.session-nav{margin-top:5px}}@media print{.spatial-site-header,.toolbar,#sync-status,.class-heading a,.session-nav,.copy-row,.copy-fallback,.card-status,.site-footer{display:none}body{background:white}main{padding:0}#homework-list{display:block}article{break-inside:avoid;margin-bottom:16px;box-shadow:none}}
.copy-fallback[hidden]{display:none}
article ul{list-style:disc}article ol{list-style:decimal}article h2,article h3,article h4{font-weight:700}
</style>
</body></html>

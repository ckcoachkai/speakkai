              <div>
                <h3><span class="lang-en">Photo credits</span><span class="lang-zh">图片版权</span></h3>
                <ul>
                  {photoCredits.map((credit) => (
                    <li><a href={credit.url} target="_blank" rel="noreferrer"><span class="lang-en">{credit.labelEn}</span><span class="lang-zh">{credit.labelZh}</span></a> · {credit.creator} · {credit.license}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3><span class="lang-en">Safety note</span><span class="lang-zh">安全说明</span></h3>
                <p><span class="lang-en">Opening hours, transport times, weather, air quality and event access can change. Re-check official pages and the family’s actual booking confirmations before each travel day.</span><span class="lang-zh">开放时间、交通时刻、天气、空气质量与活动入场安排都可能变化。每天出发前，请再次核对官方页面与家庭实际预订确认单。</span></p>
              </div>
            </div>
          </details>
        </section>
      </div>
    </main>

    <footer class="footer">
      <strong><span class="lang-en">Malaysia Family Trip · 2026</span><span class="lang-zh">2026 马来西亚家庭之旅</span></strong>
      <p><span class="lang-en">Prepared as an unlisted, noindex family guide on SpeakKai. Anyone with the link can view it.</span><span class="lang-zh">本页是 SpeakKai 上仅限链接访问、禁止搜索引擎索引的家庭旅行指南；任何获得链接的人都可以查看。</span></p>
    </footer>

    <dialog class="photo-lightbox" id="photo-lightbox" aria-labelledby="lightbox-title">
      <div class="lightbox-stage">
        <img id="lightbox-image" src="" alt="" />
        <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close photo" data-aria-en="Close photo" data-aria-zh="关闭照片">×</button>
        <button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="Previous photo" data-aria-en="Previous photo" data-aria-zh="上一张照片">←</button>
        <button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="Next photo" data-aria-en="Next photo" data-aria-zh="下一张照片">→</button>
      </div>
      <div class="lightbox-caption">
        <div>
          <strong id="lightbox-title"></strong>
          <p id="lightbox-place"></p>
        </div>
        <a id="lightbox-credit" href="#" target="_blank" rel="noreferrer"></a>
      </div>
    </dialog>

    <script is:inline>
      const root = document.documentElement;
      const languageButtons = document.querySelectorAll('[data-set-lang]');
      const images = document.querySelectorAll('img[data-alt-en]');
      const localizedLabels = document.querySelectorAll('[data-aria-en]');
      const externalLinks = document.querySelectorAll('a[target="_blank"]');
      const lightbox = document.getElementById('photo-lightbox');
      const lightboxImage = document.getElementById('lightbox-image');
      const lightboxTitle = document.getElementById('lightbox-title');
      const lightboxPlace = document.getElementById('lightbox-place');
      const lightboxCredit = document.getElementById('lightbox-credit');
      const galleryCards = Array.from(document.querySelectorAll('[data-gallery-card]'));
      const galleryButtons = Array.from(document.querySelectorAll('[data-gallery-open]'));
      const carousel = document.getElementById('travel-carousel');
      const carouselStage = carousel?.querySelector('[data-carousel-stage]');
      const carouselOpen = carousel?.querySelector('[data-carousel-open]');
      const carouselImage = carousel?.querySelector('[data-carousel-image]');
      const carouselPlaceEn = carousel?.querySelector('[data-carousel-place-en]');
      const carouselPlaceZh = carousel?.querySelector('[data-carousel-place-zh]');
      const carouselTitleEn = carousel?.querySelector('[data-carousel-title-en]');
      const carouselTitleZh = carousel?.querySelector('[data-carousel-title-zh]');
      const carouselCredit = carousel?.querySelector('[data-carousel-credit]');
      const carouselCount = carousel?.querySelector('[data-carousel-count]');
      const carouselProgress = carousel?.querySelector('[data-carousel-progress]');
      const carouselStatus = carousel?.querySelector('[data-carousel-status]');
      const carouselToggle = carousel?.querySelector('[data-carousel-toggle]');
      const carouselToggleIcon = carousel?.querySelector('[data-carousel-toggle-icon]');
      const carouselToggleEn = carousel?.querySelector('[data-carousel-toggle-en]');
      const carouselToggleZh = carousel?.querySelector('[data-carousel-toggle-zh]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const carouselInterval = 7000;
      let lightboxPosition = 0;
      let carouselPosition = 0;
      let carouselTimer = null;
      let carouselProgressFrame = 0;
      let carouselProgressInnerFrame = 0;
      let carouselInView = false;
      let carouselHovered = false;
      let carouselFocusWithin = false;
      let autoplayRequested = !reducedMotion.matches;
      let lastGalleryTrigger = null;
      let touchStartX = 0;
      let carouselTouchStartX = 0;
      let carouselTouchStartY = 0;

      function safeRead(key) {
        try { return window.localStorage.getItem(key); } catch { return null; }
      }

      function safeWrite(key, value) {
        try { window.localStorage.setItem(key, value); } catch {}
      }

      function getLanguage() {
        return root.dataset.lang === 'zh' ? 'zh' : 'en';
      }

      function getVisibleGalleryButtons() {
        return galleryButtons.filter((button) => !button.closest('[data-gallery-card]').hidden);
      }

      function getCarouselButtons() {
        return getVisibleGalleryButtons();
      }

      function updateCarouselToggle() {
        if (!carouselToggle) return;
        const motionBlocked = reducedMotion.matches;
        const isRequested = autoplayRequested && !motionBlocked;
        const labelEn = motionBlocked ? 'Autoplay disabled by reduced-motion preference' : isRequested ? 'Pause slideshow' : 'Play slideshow';
        const labelZh = motionBlocked ? '已根据减少动态偏好关闭自动轮播' : isRequested ? '暂停轮播' : '播放轮播';
        carouselToggle.dataset.ariaEn = labelEn;
        carouselToggle.dataset.ariaZh = labelZh;
        carouselToggle.setAttribute('aria-label', getLanguage() === 'zh' ? labelZh : labelEn);
        carouselToggle.setAttribute('aria-pressed', String(isRequested));
        carouselToggle.setAttribute('aria-disabled', String(motionBlocked));
        if (carouselToggleIcon) carouselToggleIcon.textContent = motionBlocked ? '—' : isRequested ? 'Ⅱ' : '▶';
        if (carouselToggleEn) carouselToggleEn.textContent = motionBlocked ? 'Motion reduced' : isRequested ? 'Pause' : 'Play';
        if (carouselToggleZh) carouselToggleZh.textContent = motionBlocked ? '减少动态' : isRequested ? '暂停' : '播放';
      }

      function syncCarouselLanguage() {
        const buttons = getCarouselButtons();
        const source = buttons[carouselPosition];
        if (!source) return;
        const language = getLanguage();
        if (carouselImage) {
          carouselImage.alt = source.dataset[language === 'zh' ? 'altZh' : 'altEn'] || '';
          carouselImage.dataset.altEn = source.dataset.altEn || '';
          carouselImage.dataset.altZh = source.dataset.altZh || '';
        }
        const openLabelEn = `Open photo: ${source.dataset.titleEn || ''}`;
        const openLabelZh = `打开照片：${source.dataset.titleZh || ''}`;
        if (carouselOpen) {
          carouselOpen.dataset.ariaEn = openLabelEn;
          carouselOpen.dataset.ariaZh = openLabelZh;
          carouselOpen.setAttribute('aria-label', language === 'zh' ? openLabelZh : openLabelEn);
        }
        if (carouselCredit) {
          const creditText = language === 'zh' ? `图片版权：${source.dataset.credit}` : `Photo: ${source.dataset.credit}`;
          carouselCredit.textContent = creditText;
          carouselCredit.setAttribute('aria-label', language === 'zh' ? `${creditText}（在新标签页打开）` : `${creditText} (opens in a new tab)`);
        }
        updateCarouselToggle();
      }

      function restartCarouselProgress(active) {
        if (!carouselProgress) return;
        cancelAnimationFrame(carouselProgressFrame);
        cancelAnimationFrame(carouselProgressInnerFrame);
        carouselProgress.style.transition = 'none';
        carouselProgress.style.width = '0';
        if (!active) return;
        carouselProgressFrame = requestAnimationFrame(() => {
          carouselProgressInnerFrame = requestAnimationFrame(() => {
            if (!canAutoplayCarousel()) return;
            carouselProgress.style.transition = `width ${carouselInterval}ms linear`;
            carouselProgress.style.width = '100%';
          });
        });
      }

      function canAutoplayCarousel() {
        return Boolean(
          autoplayRequested && !reducedMotion.matches && carouselInView && !carouselHovered &&
          !carouselFocusWithin && !document.hidden && !lightbox?.open
        );
      }

      function scheduleCarousel() {
        window.clearTimeout(carouselTimer);
        const canRun = canAutoplayCarousel();
        carousel?.classList.toggle('is-playing', canRun);
        restartCarouselProgress(canRun);
        if (!canRun) return;
        carouselTimer = window.setTimeout(() => {
          setCarouselPosition(carouselPosition + 1, false);
          scheduleCarousel();
        }, carouselInterval);
      }

      function setCarouselPosition(position, announce = false) {
        const buttons = getCarouselButtons();
        if (!buttons.length) return;
        carousel?.classList.remove('is-playing');
        carouselPosition = (position + buttons.length) % buttons.length;
        const source = buttons[carouselPosition];
        if (carouselImage) {
          carouselImage.src = source.dataset.fullSrc;
          carouselImage.srcset = `${source.dataset.thumbSrc} 720w, ${source.dataset.fullSrc} 1600w`;
          carouselImage.classList.remove('is-revealing');
          void carouselImage.offsetWidth;
          carouselImage.classList.add('is-revealing');
        }
        if (carouselPlaceEn) carouselPlaceEn.textContent = source.dataset.placeEn || '';
        if (carouselPlaceZh) carouselPlaceZh.textContent = source.dataset.placeZh || '';
        if (carouselTitleEn) carouselTitleEn.textContent = source.dataset.titleEn || '';
        if (carouselTitleZh) carouselTitleZh.textContent = source.dataset.titleZh || '';
        if (carouselCredit) carouselCredit.href = source.dataset.creditUrl;
        if (carouselCount) carouselCount.textContent = `${String(carouselPosition + 1).padStart(2, '0')} / ${String(buttons.length).padStart(2, '0')}`;
        syncCarouselLanguage();
        if (announce && carouselStatus) {
          const language = getLanguage();
          const title = source.dataset[language === 'zh' ? 'titleZh' : 'titleEn'] || '';
          carouselStatus.textContent = language === 'zh'
            ? `第${carouselPosition + 1}张，共${buttons.length}张：${title}`
            : `Slide ${carouselPosition + 1} of ${buttons.length}: ${title}`;
        }
        const nextSource = buttons[(carouselPosition + 1) % buttons.length];
        if (nextSource) {
          const nextImage = new Image();
          nextImage.src = nextSource.dataset.fullSrc;
        }
      }

      function moveCarousel(direction) {
        autoplayRequested = false;
        setCarouselPosition(carouselPosition + direction, true);
        updateCarouselToggle();
        scheduleCarousel();
      }

      function renderLightbox() {
        const visibleButtons = getVisibleGalleryButtons();
        if (!visibleButtons.length) return;
        lightboxPosition = (lightboxPosition + visibleButtons.length) % visibleButtons.length;
        const button = visibleButtons[lightboxPosition];
        const language = getLanguage();
        lightboxImage.src = button.dataset.fullSrc;
        lightboxImage.alt = button.dataset[language === 'zh' ? 'altZh' : 'altEn'] || '';
        lightboxTitle.textContent = button.dataset[language === 'zh' ? 'titleZh' : 'titleEn'] || '';
        lightboxPlace.textContent = button.dataset[language === 'zh' ? 'placeZh' : 'placeEn'] || '';
        lightboxCredit.href = button.dataset.creditUrl;
        const creditText = language === 'zh' ? `图片版权：${button.dataset.credit}` : `Photo: ${button.dataset.credit}`;
        lightboxCredit.textContent = creditText;
        lightboxCredit.setAttribute('aria-label', language === 'zh' ? `${creditText}（在新标签页打开）` : `${creditText} (opens in a new tab)`);
      }

      function setLanguage(language) {
        root.dataset.lang = language;
        root.lang = language === 'zh' ? 'zh-CN' : 'en';
        languageButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.setLang === language));
        });
        images.forEach((image) => {
          image.alt = image.getAttribute(language === 'zh' ? 'data-alt-zh' : 'data-alt-en') || '';
        });
        localizedLabels.forEach((element) => {
          element.setAttribute('aria-label', element.getAttribute(language === 'zh' ? 'data-aria-zh' : 'data-aria-en') || '');
        });
        externalLinks.forEach((link) => {
          const translatedText = link.querySelector(language === 'zh' ? '.lang-zh' : '.lang-en');
          const label = (translatedText?.textContent || link.textContent || '').trim();
          link.setAttribute('aria-label', language === 'zh' ? `${label}（在新标签页打开）` : `${label} (opens in a new tab)`);
        });
        document.title = language === 'zh' ? '2026马来西亚家庭之旅 | SpeakKai' : 'Malaysia Family Trip 2026 | SpeakKai';
        document.querySelector('meta[name="description"]')?.setAttribute('content', language === 'zh'
          ? '2026年8月29日至9月4日，吉隆坡、马六甲、布城与槟城双语家庭旅行指南。'
          : 'A bilingual family travel guide for Kuala Lumpur, Melaka, Putrajaya and Penang, 29 August–4 September 2026.');
        if (lightbox?.open) renderLightbox();
        syncCarouselLanguage();
        safeWrite('malatrip-language', language);
      }

      const savedLanguage = safeRead('malatrip-language');
      const preferredLanguage = savedLanguage === 'zh' || savedLanguage === 'en'
        ? savedLanguage
        : (navigator.language || '').toLowerCase().startsWith('zh') ? 'zh' : 'en';

      languageButtons.forEach((button) => {
        button.addEventListener('click', () => setLanguage(button.dataset.setLang));
      });
      setLanguage(preferredLanguage);

      document.querySelector('[data-action="print"]')?.addEventListener('click', () => window.print());

      const shareButton = document.querySelector('[data-action="share"]');
      shareButton?.addEventListener('click', async () => {
        const en = shareButton.querySelector('.lang-en');
        const zh = shareButton.querySelector('.lang-zh');
        const originalEn = en.textContent;
        const originalZh = zh.textContent;
        let shared = false;
        try {
          if (navigator.share && window.matchMedia('(pointer: coarse)').matches) {
            await navigator.share({ title: document.title, text: getLanguage() === 'zh' ? '马来西亚家庭旅行指南' : 'Malaysia family trip guide', url: window.location.href });
            shared = true;
          } else if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(window.location.href);
          } else {
            throw new Error('Clipboard unavailable');
          }
          en.textContent = shared ? 'Shared' : 'Link copied';
          zh.textContent = shared ? '已分享' : '链接已复制';
          shareButton.classList.add('is-complete');
        } catch {
          en.textContent = 'Copy unavailable';
          zh.textContent = '暂无法复制';
        }
        window.setTimeout(() => {
          en.textContent = originalEn;
          zh.textContent = originalZh;
          shareButton.classList.remove('is-complete');
        }, 1800);
      });

      const scrollProgress = document.getElementById('scroll-progress');
      const updateScrollProgress = () => {
        const available = document.documentElement.scrollHeight - window.innerHeight;
        const percentage = available > 0 ? Math.min(100, Math.max(0, (window.scrollY / available) * 100)) : 0;
        scrollProgress.style.width = `${percentage}%`;
      };
      updateScrollProgress();
      window.addEventListener('scroll', updateScrollProgress, { passive: true });

      const dayCards = Array.from(document.querySelectorAll('[data-date]'));
      const dayLinks = Array.from(document.querySelectorAll('[data-day-link]'));
      if ('IntersectionObserver' in window) {
        const dayObserver = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          dayLinks.forEach((link) => link.setAttribute('aria-current', String(link.dataset.dayLink === visible.target.dataset.date)));
        }, { rootMargin: '-18% 0px -62% 0px', threshold: [0.01, 0.2, 0.5] });
        dayCards.forEach((card) => dayObserver.observe(card));
      }

      document.querySelectorAll('[data-gallery-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.dataset.galleryFilter;
          galleryCards.forEach((card) => { card.hidden = filter !== 'all' && card.dataset.region !== filter; });
          document.querySelectorAll('[data-gallery-filter]').forEach((filterButton) => {
            filterButton.setAttribute('aria-pressed', String(filterButton === button));
          });
          autoplayRequested = false;
          setCarouselPosition(0, true);
          updateCarouselToggle();
          scheduleCarousel();
        });
      });

      function openGalleryButton(button, trigger = button) {
        const visibleButtons = getVisibleGalleryButtons();
        lightboxPosition = visibleButtons.indexOf(button);
        lastGalleryTrigger = trigger;
        renderLightbox();
        lightbox.showModal();
        scheduleCarousel();
      }

      galleryButtons.forEach((button) => {
        button.addEventListener('click', () => openGalleryButton(button));
      });

      carouselOpen?.addEventListener('click', () => {
        const button = getCarouselButtons()[carouselPosition];
        if (button) openGalleryButton(button, carouselOpen);
      });
      carouselToggle?.addEventListener('click', () => {
        if (reducedMotion.matches) return;
        autoplayRequested = !autoplayRequested;
        updateCarouselToggle();
        scheduleCarousel();
      });
      carousel?.querySelector('[data-carousel-prev]')?.addEventListener('click', () => moveCarousel(-1));
      carousel?.querySelector('[data-carousel-next]')?.addEventListener('click', () => moveCarousel(1));
      carousel?.addEventListener('mouseenter', () => { carouselHovered = true; scheduleCarousel(); });
      carousel?.addEventListener('mouseleave', () => { carouselHovered = false; scheduleCarousel(); });
      carousel?.addEventListener('focusin', () => { carouselFocusWithin = true; scheduleCarousel(); });
      carousel?.addEventListener('focusout', () => {
        window.setTimeout(() => {
          carouselFocusWithin = carousel.contains(document.activeElement);
          scheduleCarousel();
        }, 0);
      });
      carouselStage?.addEventListener('pointerdown', () => {
        autoplayRequested = false;
        updateCarouselToggle();
        scheduleCarousel();
      });
      carouselStage?.addEventListener('touchstart', (event) => {
        carouselTouchStartX = event.changedTouches[0]?.clientX || 0;
        carouselTouchStartY = event.changedTouches[0]?.clientY || 0;
      }, { passive: true });
      carouselStage?.addEventListener('touchend', (event) => {
        const distanceX = (event.changedTouches[0]?.clientX || 0) - carouselTouchStartX;
        const distanceY = (event.changedTouches[0]?.clientY || 0) - carouselTouchStartY;
        if (Math.abs(distanceX) > 45 && Math.abs(distanceX) > Math.abs(distanceY)) moveCarousel(distanceX > 0 ? -1 : 1);
      }, { passive: true });
      carousel?.addEventListener('keydown', (event) => {
        if (lightbox?.open) return;
        if (event.key === 'ArrowLeft') { event.preventDefault(); moveCarousel(-1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); moveCarousel(1); }
        if (event.key === 'Home') { event.preventDefault(); autoplayRequested = false; setCarouselPosition(0, true); updateCarouselToggle(); scheduleCarousel(); }
        if (event.key === 'End') { event.preventDefault(); autoplayRequested = false; setCarouselPosition(getCarouselButtons().length - 1, true); updateCarouselToggle(); scheduleCarousel(); }
      });

      if ('IntersectionObserver' in window && carousel) {
        const carouselObserver = new IntersectionObserver((entries) => {
          carouselInView = Boolean(entries[0]?.isIntersecting && entries[0]?.intersectionRatio >= 0.5);
          scheduleCarousel();
        }, { threshold: [0, 0.5, 1] });
        carouselObserver.observe(carousel);
      } else {
        carouselInView = true;
      }
      document.addEventListener('visibilitychange', scheduleCarousel);
      reducedMotion.addEventListener?.('change', () => {
        if (reducedMotion.matches) autoplayRequested = false;
        updateCarouselToggle();
        scheduleCarousel();
      });
      setCarouselPosition(0, false);
      updateCarouselToggle();
      scheduleCarousel();

      function moveLightbox(direction) {
        lightboxPosition += direction;
        renderLightbox();
      }

      document.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lightbox.close());
      document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => moveLightbox(-1));
      document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => moveLightbox(1));
      lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
      lightbox?.addEventListener('close', () => {
        lastGalleryTrigger?.focus();
        scheduleCarousel();
      });
      lightbox?.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0]?.clientX || 0; }, { passive: true });
      lightbox?.addEventListener('touchend', (event) => {
        const distance = (event.changedTouches[0]?.clientX || 0) - touchStartX;
        if (Math.abs(distance) > 45) moveLightbox(distance > 0 ? -1 : 1);
      }, { passive: true });
      document.addEventListener('keydown', (event) => {
        if (!lightbox?.open) return;
        if (event.key === 'ArrowLeft') moveLightbox(-1);
        if (event.key === 'ArrowRight') moveLightbox(1);
      });

      const dateParts = Object.fromEntries(
        new Intl.DateTimeFormat('en', {
          timeZone: 'Asia/Kuala_Lumpur',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).formatToParts(new Date()).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value])
      );
      const malaysiaDate = `${dateParts.year}-${dateParts.month}-${dateParts.day}`;
      const firstDate = '2026-08-29';
      const lastDate = '2026-09-04';
      const todayCard = document.querySelector(`[data-date="${malaysiaDate}"]`);
      const statusEn = document.getElementById('trip-status-en');
      const statusZh = document.getElementById('trip-status-zh');

      if (todayCard) {
        todayCard.classList.add('is-today');
        const dayNumber = Array.from(document.querySelectorAll('[data-date]')).indexOf(todayCard) + 1;
        statusEn.textContent = `Today · Day ${dayNumber} of 7`;
        statusZh.textContent = `今天 · 第 ${dayNumber} 天／共7天`;
      } else if (malaysiaDate < firstDate) {
        const daysUntil = Math.ceil((Date.parse(`${firstDate}T00:00:00+08:00`) - Date.now()) / 86400000);
        statusEn.textContent = daysUntil <= 1 ? 'Trip starts tomorrow' : `Trip starts in ${daysUntil} days`;
        statusZh.textContent = daysUntil <= 1 ? '旅程明天开始' : `距离出发还有 ${daysUntil} 天`;
      } else if (malaysiaDate > lastDate) {
        statusEn.textContent = 'Trip complete · 29 Aug—4 Sep 2026';
        statusZh.textContent = '旅程已完成 · 2026年8月29日—9月4日';
      }

      const checkboxes = Array.from(document.querySelectorAll('[data-check-id]'));
      const updateChecklistProgress = () => {
        const complete = checkboxes.filter((checkbox) => checkbox.checked).length;
        const percentage = checkboxes.length ? (complete / checkboxes.length) * 100 : 0;
        document.getElementById('check-progress-bar').style.width = `${percentage}%`;
        document.getElementById('check-progress-track').setAttribute('aria-valuenow', String(complete));
        document.getElementById('check-progress-output').textContent = `${complete} / ${checkboxes.length}`;
      };
      checkboxes.forEach((checkbox) => {
        const key = `malatrip-check-${checkbox.dataset.checkId}`;
        checkbox.checked = safeRead(key) === '1';
        checkbox.addEventListener('change', () => {
          safeWrite(key, checkbox.checked ? '1' : '0');
          updateChecklistProgress();
        });
      });
      updateChecklistProgress();

      window.addEventListener('beforeprint', () => {
        document.querySelectorAll('img[loading="lazy"]').forEach((image) => { image.loading = 'eager'; });
      });
    </script>
  </body>
</html>

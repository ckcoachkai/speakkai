  all: galleryItems.length,
  kl: galleryItems.filter((item) => item.region === "kl").length,
  melaka: galleryItems.filter((item) => item.region === "melaka").length,
  putrajaya: galleryItems.filter((item) => item.region === "putrajaya").length,
  penang: galleryItems.filter((item) => item.region === "penang").length,
};

const firstGalleryItem = galleryItems[0];

const photoCredits = galleryItems.map((item) => {
  const [creator, license] = item.credit.split(" · ");
  return {
    labelEn: item.placeEn,
    labelZh: item.placeZh,
    creator,
    license,
    url: item.creditUrl,
  };
});

---
import SpatialSiteHeader from '../../components/SpatialSiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import data from '../../../public/data/feedback.json';
import {validateFeedback,weekWindows,newestClass,sessionsInWindow,formatDate} from '../../lib/feedback.mjs';
import type {FeedbackDocument,FeedbackSession,FeedbackClass} from '../../lib/feedback-types';
validateFeedback(data);
const initial=data as FeedbackDocument;
const windows=weekWindows(data), current=windows[0];
const selected=newestClass(data);
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="SpeakKai student feedback, in English and Chinese, organised by class and week."/><link rel="canonical" href="https://speakkai.com/fb/"/><link rel="icon" href="/favicon.svg"/><title>Student feedback | SpeakKai</title></head>
<body><SpatialSiteHeader/><main>
  <header class="fb-heading"><h1 id="page-title">Student feedback</h1><div class="languages" aria-label="Feedback language"><button type="button" data-language="en" aria-pressed="true">EN</button><button type="button" data-language="zh" aria-pressed="false">CN</button></div></header>
  <div class="fb-filters">
    <label><span id="class-label">Class</span><select id="fb-class"><option value="all">All classes</option>{initial.classes.map(group=><option value={group.id} selected={group.id===selected}>{group.label.en}</option>)}</select></label>
    <label><span id="week-label">Week</span><select id="fb-week">{windows.map(window=><option value={window.id}>{window.id==='0'?'Latest 7 days · ':''}{formatDate(window.start)} – {formatDate(window.end)}</option>)}</select></label>
    <div class="week-buttons"><button type="button" id="fb-older" disabled={windows.length<2}>← Earlier</button><button type="button" id="fb-newer" disabled>Later →</button></div>
    <button type="button" id="fb-refresh">Refresh</button>
  </div>
  <p id="fb-status" role="status" aria-live="polite"></p>
  <div id="fb-content">{initial.classes.filter(group=>group.id===selected).map((group:FeedbackClass)=>{
    const sessions:FeedbackSession[]=sessionsInWindow(group,current);
    return sessions.map(session=><section class="fb-session"><header><h2>{formatDate(session.date)} · {session.time}</h2></header>{session.status==='cancelled'?<p>Class cancelled.</p>:<div class="feedback-grid">{session.students.map(student=><article id={`student-${student.id}`}><div class="student-heading"><h3>{student.name}</h3><button type="button" data-copy={student.id} data-session={session.id} disabled={!student.en}>Copy</button></div><p class="feedback-text">{student.en||'No individual feedback recorded for this class.'}</p></article>)}</div>}</section>);
  })}</div>
  <noscript><p>Enable JavaScript to change class, week, or language and use the copy buttons.</p></noscript>
  <dialog id="fb-copy-dialog"><h2 id="fallback-heading">Copy feedback</h2><p id="fallback-help">Clipboard access was unavailable. Select and copy the text below.</p><textarea readonly aria-label="Feedback to copy"></textarea><button type="button" id="fb-close-copy">Done</button></dialog>
</main><SiteFooter/>
<script is:inline type="application/json" id="fb-initial" set:html={JSON.stringify(data).replaceAll('<','\\u003c')}></script>
<script>import '../../lib/feedback-client';</script>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f3f6f9;color:#172b43;font-family:Inter,system-ui,sans-serif}main{max-width:1380px;margin:auto;padding:24px 24px 50px}.fb-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin:0 0 22px}.fb-heading h1{font-size:30px;font-weight:750;letter-spacing:-.03em;margin:0}.languages{display:flex;gap:4px;padding:4px;background:#e4ebf1;border-radius:12px}button,select{font:inherit;border:1px solid #b8c7d6;border-radius:8px;min-height:44px;padding:9px 13px;background:white;color:#193955}button{font-weight:650;cursor:pointer}button:hover:not(:disabled){background:#e3f0f7}button:disabled{opacity:.4;cursor:default}.languages button{border:0;background:transparent;min-width:54px}.languages button[aria-pressed=true]{background:#193955;color:white}.fb-filters{display:flex;gap:12px;align-items:end;flex-wrap:wrap}.fb-filters label{flex:1;min-width:230px;font-weight:650;font-size:13px}.fb-filters label span{display:block;margin-bottom:6px}select{width:100%;font-size:14px}.week-buttons{display:flex;gap:6px}#fb-status{font-size:14px;min-height:21px;color:#416580;margin:12px 0 18px}.fb-session{margin:0 0 30px}.fb-session>header{border-bottom:1px solid #d8e2eb;margin-bottom:14px;padding-bottom:12px}.fb-session h2{font-size:20px;font-weight:700;margin:0}.feedback-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:16px;align-items:start}.feedback-grid article{border:1px solid #d9e3ec;border-top:4px solid #267898;background:white;border-radius:14px;padding:19px;box-shadow:0 5px 15px #18375009;scroll-margin-top:24px}.student-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.student-heading h3{font-size:20px;font-weight:750;margin:0}.student-heading button{font-size:13px;min-width:65px}.feedback-text{font-size:15px;line-height:1.85;white-space:pre-wrap;margin:0}.feedback-text:lang(zh){line-height:1.95}#fb-copy-dialog{width:min(620px,calc(100% - 32px));border:1px solid #afc2d1;border-radius:15px;padding:22px;color:#172b43}#fb-copy-dialog::backdrop{background:#10233888}#fb-copy-dialog h2{font-size:21px;font-weight:700;margin:0 0 8px}#fb-copy-dialog p{font-size:14px}#fb-copy-dialog textarea{width:100%;min-height:270px;font:15px/1.6 system-ui;border:1px solid #a9bfce;border-radius:8px;padding:12px;margin:14px 0}button:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #0075ac;outline-offset:3px}.fb-empty{padding:28px;background:white;border:1px solid #dae3eb;border-radius:12px}@media(max-width:620px){main{padding:20px 16px 40px}.fb-heading h1{font-size:25px}.fb-filters label{flex-basis:100%}.week-buttons{flex:1}.week-buttons button{flex:1}.feedback-grid{grid-template-columns:1fr}.feedback-grid article{padding:18px}}@media print{.spatial-site-header,.site-footer,.fb-filters,.languages,#fb-status,.student-heading button{display:none}body{background:white}.feedback-grid{display:block}.feedback-grid article{break-inside:avoid;margin-bottom:15px;box-shadow:none}}
</style></body></html>

---
import SpatialSiteHeader from '../../components/SpatialSiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import data from '../../../public/data/feedback.json';
import {validateFeedback,weekWindows,sessionsInWindow,formatDate,sessionCompleteness} from '../../lib/feedback.mjs';
import type {FeedbackDocument,FeedbackSession,FeedbackClass} from '../../lib/feedback-types';
validateFeedback(data);
const initial=data as FeedbackDocument;
const windows=weekWindows(data), current=windows[0];
const selected='all';
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="SpeakKai student feedback, in English and Chinese, organised by class and week."/><link rel="canonical" href="https://speakkai.com/fb/"/><link rel="icon" href="/favicon.svg"/><title>Student feedback | SpeakKai</title></head>
<body><SpatialSiteHeader/><main>
  <header class="fb-heading"><h1 id="page-title">Student feedback</h1><div class="languages" aria-label="Feedback language"><button type="button" data-language="en" aria-pressed="true">EN</button><button type="button" data-language="zh" aria-pressed="false">CN</button></div></header>
  <p id="fb-intro">Choose a class to see its lesson, homework and individual feedback.</p>
  <div class="fb-filters">
    <label><span id="class-label">Class</span><select id="fb-class"><option value="all">All classes</option>{initial.classes.map(group=><option value={group.id} selected={group.id===selected}>{group.label.en}</option>)}</select></label>
    <label><span id="week-label">Dates</span><select id="fb-week">{windows.map(window=><option value={window.id}>{window.id==='all'?'All history':`${window.id==='0'?'Latest 14 days · ':''}${formatDate(window.start)} – ${formatDate(window.end)}`}</option>)}</select></label>
    <div class="week-buttons"><button type="button" id="fb-older" disabled={windows.length<2}>← Earlier</button><button type="button" id="fb-newer" disabled>Later →</button></div>
    <button type="button" id="fb-refresh">Refresh</button>
  </div>
  <p id="fb-status" role="status" aria-live="polite"></p>
  <div id="fb-content"><div class="overview-grid">{initial.classes.flatMap(group=>sessionsInWindow(group,current).map((session:FeedbackSession)=>({group,session}))).sort((a,b)=>b.session.date.localeCompare(a.session.date)||a.session.time.localeCompare(b.session.time)).map(({group,session})=>{
    const progress=sessionCompleteness(session);
    return <section class={`overview-card ${progress.state}`}><div><span class={`completion-badge ${progress.state}`}>{progress.state==='complete'?'✓ Complete':progress.state==='cancelled'?'Cancelled':'! Missing information'}</span><h2><a href={`?class=${group.id}&date=${session.date}`}>{group.label.en}</a></h2><p>{formatDate(session.date)} · {session.time}</p><p class="roster">{session.students.map(student=>student.name).join(' · ')||'No class held'}</p><a class="open-class" href={`?class=${group.id}&date=${session.date}`}>View class →</a></div><aside class="completion-note"><strong>{progress.state==='missing'?'What is missing':progress.state==='cancelled'?'No report required':'All recorded'}</strong><p>{progress.missing.join('\n')||(progress.state==='cancelled'?'Class cancelled.':'Class content, homework and feedback for every listed student are available in both languages.')}</p></aside></section>;
  })}</div></div>
  <noscript><p>Without JavaScript, all past recorded details are available below. Status indicates report completeness, not student performance.</p>{initial.classes.map((group:FeedbackClass)=>{
    const sessions:FeedbackSession[]=group.sessions.filter(session=>current.end >= session.date);
    return sessions.map(session=><section class="fb-session"><header><h2>{group.label.en} · {formatDate(session.date)} · {session.time}</h2></header><div class="class-summary">{(['classContent','homework'] as const).map(kind=><section class="class-section" data-section={kind}><div class="student-heading"><h3>{kind==='classContent'?'Class content':'Homework'}</h3><button type="button" data-copy-section={kind} data-session={session.id}>Copy</button></div><p class="feedback-text">{session[kind]?.en||'N/A'}</p></section>)}</div>{session.status==='cancelled'?<p>Class cancelled.</p>:<div class="feedback-grid">{session.students.map(student=><article id={`student-${student.id}`}><div class="student-heading"><h3>{student.name}</h3><button type="button" data-copy={student.id} data-session={session.id} disabled={!student.en}>Copy</button></div><p class="feedback-text">{student.en||'No individual feedback recorded for this class.'}</p></article>)}</div>}</section>);
  })}</noscript>
  <dialog id="fb-copy-dialog"><h2 id="fallback-heading">Copy feedback</h2><p id="fallback-help">Clipboard access was unavailable. Select and copy the text below.</p><textarea readonly aria-label="Feedback to copy"></textarea><button type="button" id="fb-close-copy">Done</button></dialog>
</main><SiteFooter/>
<script is:inline type="application/json" id="fb-initial" set:html={JSON.stringify(data).replaceAll('<','\\u003c')}></script>
<script>import '../../lib/feedback-client';</script>
<style is:global>
.timeline-date{font-size:20px;margin:20px 0 0}.timeline-empty{margin:0;padding:14px 18px;border:1px dashed #b8c7d6;border-radius:10px;color:#496078}
#fb-intro{color:#496078;margin:-8px 0 24px;line-height:1.6}.overview-grid{display:grid;gap:18px}.overview-card{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr);gap:24px;background:#fff;border:1px solid #d9e3ec;border-left:5px solid #16804c;border-radius:14px;padding:24px}.overview-card.missing{border-left-color:#bb3844}.overview-card.cancelled{border-left-color:#7c8997}.overview-card h2{font-size:21px;margin:13px 0 8px}.overview-card h2 a{color:inherit;text-decoration:none}.overview-card p{line-height:1.65;margin:8px 0}.roster{color:#496078}.completion-badge{display:inline-block;border-radius:20px;padding:5px 11px;font-size:13px;font-weight:700;background:#e5f5ec;color:#13663d}.completion-badge.missing{background:#ffedef;color:#9a2633}.completion-badge.cancelled{background:#eef1f4;color:#4d5e6f}.completion-note{padding:16px;border:1px solid #c7e6d5;border-radius:10px;background:#f0faf4;font-size:14px;align-self:start}.missing .completion-note{background:#fff5f5;border-color:#f0c8cd}.cancelled .completion-note{background:#f4f6f8;border-color:#dde3e8}.completion-note p{white-space:pre-line}.completion-note ul{padding-left:20px;margin-bottom:0;line-height:1.8}.open-class{display:inline-flex;align-items:center;min-height:44px;color:#155d7c;font-weight:700;margin-top:5px}.overview-stats{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px}.overview-stats span{padding:10px 14px;border-radius:9px;background:#e7edf3;font-size:14px}.overview-help{color:#496078;font-size:13px;line-height:1.6;margin-bottom:20px}.back-overview{margin-bottom:20px}.feedback-grid article.missing-feedback{border-top-color:#bb3844;background:#fff8f8}.student-link{color:inherit;text-decoration:underline;text-underline-offset:3px}.student-link.missing-feedback{color:#9a2633}a:focus-visible{outline:3px solid #0075ac;outline-offset:4px}@media(max-width:620px){.overview-card{grid-template-columns:1fr;gap:14px;padding:18px}.overview-card h2{font-size:19px}}
*{box-sizing:border-box}body{margin:0;background:#f3f6f9;color:#172b43;font-family:Inter,system-ui,sans-serif}main{max-width:1380px;margin:auto;padding:24px 24px 50px}.fb-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin:0 0 22px}.fb-heading h1{font-size:30px;font-weight:750;letter-spacing:-.03em;margin:0}.languages{display:flex;gap:4px;padding:4px;background:#e4ebf1;border-radius:12px}button,select{font:inherit;border:1px solid #b8c7d6;border-radius:8px;min-height:44px;padding:9px 13px;background:white;color:#193955}button{font-weight:650;cursor:pointer}button:hover:not(:disabled){background:#e3f0f7}button:disabled{opacity:.4;cursor:default}.languages button{border:0;background:transparent;min-width:54px}.languages button[aria-pressed=true]{background:#193955;color:white}.fb-filters{display:flex;gap:12px;align-items:end;flex-wrap:wrap}.fb-filters label{flex:1;min-width:230px;font-weight:650;font-size:13px}.fb-filters label span{display:block;margin-bottom:6px}select{width:100%;font-size:14px}.week-buttons{display:flex;gap:6px}#fb-status{font-size:14px;min-height:21px;color:#416580;margin:12px 0 18px}.fb-session{margin:0 0 30px}.fb-session>header{border-bottom:1px solid #d8e2eb;margin-bottom:14px;padding-bottom:12px}.fb-session h2{font-size:20px;font-weight:700;margin:0}.feedback-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,480px),1fr));gap:16px;align-items:start}.feedback-grid article{border:1px solid #d9e3ec;border-top:4px solid #267898;background:white;border-radius:14px;padding:19px;box-shadow:0 5px 15px #18375009;scroll-margin-top:24px}.student-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.student-heading h3{font-size:20px;font-weight:750;margin:0}.student-heading button{font-size:13px;min-width:65px}.feedback-text{font-size:15px;line-height:1.85;white-space:pre-wrap;margin:0}.feedback-text:lang(zh){line-height:1.95}#fb-copy-dialog{width:min(620px,calc(100% - 32px));border:1px solid #afc2d1;border-radius:15px;padding:22px;color:#172b43}#fb-copy-dialog::backdrop{background:#10233888}#fb-copy-dialog h2{font-size:21px;font-weight:700;margin:0 0 8px}#fb-copy-dialog p{font-size:14px}#fb-copy-dialog textarea{width:100%;min-height:270px;font:15px/1.6 system-ui;border:1px solid #a9bfce;border-radius:8px;padding:12px;margin:14px 0}button:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #0075ac;outline-offset:3px}.fb-empty{padding:28px;background:white;border:1px solid #dae3eb;border-radius:12px}@media(max-width:620px){main{padding:20px 16px 40px}.fb-heading h1{font-size:25px}.fb-filters label{flex-basis:100%}.week-buttons{flex:1}.week-buttons button{flex:1}.feedback-grid{grid-template-columns:1fr}.feedback-grid article{padding:18px}}@media print{.spatial-site-header,.site-footer,.fb-filters,.languages,#fb-status,.student-heading button{display:none}body{background:white}.feedback-grid{display:block}.feedback-grid article{break-inside:avoid;margin-bottom:15px;box-shadow:none}}
.class-summary{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;align-items:start}.class-section{background:#eaf1f6;border:1px solid #cbdce7;border-radius:14px;padding:19px}.class-section[data-section=homework]{background:#fff9e9;border-color:#e9d9af}.class-section .student-heading h3{font-size:17px}.class-section .feedback-text{font-size:14px;line-height:1.8}@media(max-width:620px){.class-summary{grid-template-columns:1fr}.class-section{padding:18px}}@media print{.class-summary{display:block}.class-section{break-inside:avoid;margin-bottom:14px}}
</style></body></html>

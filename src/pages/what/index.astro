---
import SpatialSiteHeader from '../../components/SpatialSiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><link rel="canonical" href="https://speakkai.com/what/"/><link rel="icon" href="/favicon.svg"/><title>Class calendar | SpeakKai</title></head>
<body><SpatialSiteHeader />
<main>
 <header class="intro"><div><p class="eyebrow">THE CLASSROOM RECORD</p><h1>What did we learn?</h1><p>Classes, students and homework, one day at a time.</p></div><a href="/hw/">Homework list ↗</a></header>
 <div class="tools"><div class="navigation"><button id="previous" aria-label="Previous month">←</button><h2 id="month-title"></h2><button id="next" aria-label="Next month">→</button><button id="today">This month</button></div><label>Jump to month <input id="month-picker" type="month"/></label><button id="refresh">Refresh</button></div>
 <p id="status" role="status" aria-live="polite">Loading class records…</p>
 <div class="workspace"><section class="calendar" aria-label="Class calendar"><div class="weekdays" aria-hidden="true">{['MON','TUE','WED','THU','FRI','SAT','SUN'].map(d=><span>{d}</span>)}</div><div id="days"></div><p class="hint">Hover to preview · Click to pin · Double-click to pop out. Only recorded classes appear.</p></section>
 <aside id="details" aria-label="Selected class details" tabindex="-1"><p class="eyebrow">CLASS DETAILS</p><h2>Select a class</h2><p>Explore a class to see the students, lesson and homework here.</p></aside></div>
 <dialog id="class-popout" aria-label="Class details pop-out"><button id="close-popout" type="button" autofocus>Close ✕</button><div id="popout-content"></div></dialog>
 <noscript>This calendar needs JavaScript. <a href="/hw/">Read the homework list instead.</a></noscript>
</main><SiteFooter />
<script is:inline>
(()=>{
 const $=id=>document.getElementById(id), now=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
 let month=now.slice(0,7), records=[], selected=null, pinned=null, busy=false;
 const node=(tag,text,cls)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e};
 const dateLabel=d=>new Intl.DateTimeFormat('en',{dateStyle:'full',timeZone:'UTC'}).format(new Date(d+'T12:00:00Z'));
 const groupLabel=id=>id.split('-').map(x=>({mon:'Monday',tue:'Tuesday',wed:'Wednesday',thu:'Thursday',fri:'Friday',sat:'Saturday',sun:'Sunday'})[x]||x).join(' · ');
 function select(r){selected=r.key;document.querySelectorAll('.class-event').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.key===selected)));const panel=$('details');panel.replaceChildren(node('p','CLASS DETAILS','eyebrow'),node('h2',groupLabel(r.classId)),node('p',dateLabel(r.date)+' · '+r.time,'date'));const roster=node('section');roster.append(node('h3','Students'));const names=node('div',undefined,'names');for(const z of r.students||[])names.append(node('span',z.name));if(!names.children.length)names.append(node('p','Students not recorded.'));roster.append(names);panel.append(roster);
 const content=node('section');content.append(node('h3','Class content'));for(const t of r.classContent||[])content.append(node('p',t,'prose'));if(!r.classContent?.length)content.append(node('p','Not recorded for this class.','missing'));panel.append(content);
 const homework=node('section');homework.append(node('h3','Homework'));if(r.homework){homework.append(node('h4',r.homework.title));const list=node('ol');for(const t of r.homework.steps||[])list.append(node('li',t));homework.append(list);if(r.homework.prepareFor)homework.append(node('p',r.homework.prepareFor,'prepare'));if(r.homework.note)homework.append(node('p',r.homework.note,'prose'));}else homework.append(node('p','Not recorded for this class.','missing'));panel.append(homework);
 const controls=node('div',undefined,'detail-controls');const pin=node('button',pinned===r.key?'Pinned · Release pin':'Pin these details');pin.type='button';pin.onclick=()=>{pinned=pinned===r.key?null:r.key;select(r)};const expand=node('button','Pop out ↗');expand.type='button';expand.onclick=()=>popout(r);controls.append(pin,expand);panel.prepend(controls);const link=node('a','Open homework list ↗');link.href='/hw/#'+encodeURIComponent(r.classId);panel.append(link);
 }
 function popout(r){pinned=r.key;select(r);const content=$('popout-content');content.replaceChildren();for(const child of $('details').children){if(!child.classList.contains('detail-controls'))content.append(child.cloneNode(true));}$('class-popout').showModal();}
 $('close-popout').onclick=()=>$('class-popout').close();$('class-popout').addEventListener('click',e=>{if(e.target===$('class-popout')){const rect=e.target.getBoundingClientRect();if(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom)e.target.close();}});
 function render(){const [y,m]=month.split('-').map(Number),start=new Date(Date.UTC(y,m-1,1)),offset=(start.getUTCDay()+6)%7,count=new Date(Date.UTC(y,m,0)).getUTCDate();$('month-title').textContent=new Intl.DateTimeFormat('en',{month:'long',year:'numeric',timeZone:'UTC'}).format(start);$('month-picker').value=month;const grid=$('days');grid.replaceChildren();for(let i=0;i<Math.ceil((offset+count)/7)*7;i++){const day=i-offset+1,cell=node('div',undefined,'day');if(day<1||day>count){cell.classList.add('outside');cell.setAttribute('aria-hidden','true');grid.append(cell);continue;}const date=month+'-'+String(day).padStart(2,'0'),num=node('div',String(day),'day-number');if(date===now){cell.classList.add('current');num.setAttribute('aria-label','Today, '+dateLabel(date));}cell.append(num);for(const r of records.filter(r=>r.date===date)){const b=node('button',undefined,'class-event');b.dataset.key=r.key;b.append(node('strong',r.time),node('span',groupLabel(r.classId)),node('small',(r.students||[]).map(x=>x.name).join(', ')));b.setAttribute('aria-label',dateLabel(date)+', '+r.time+', '+groupLabel(r.classId));b.setAttribute('aria-controls','details');b.setAttribute('aria-pressed',String(r.key===selected));b.addEventListener('mouseenter',()=>{if(!pinned&&matchMedia('(hover:hover)').matches)select(r)});b.addEventListener('focus',()=>{if(!pinned)select(r)});b.addEventListener('dblclick',()=>popout(r));b.addEventListener('click',()=>{pinned=r.key;select(r);});cell.append(b);}grid.append(cell);}const visible=records.filter(r=>r.date.startsWith(month));if(pinned&&!visible.some(r=>r.key===pinned))pinned=null;$('status').textContent=visible.length?visible.length+' recorded classes · Shanghai time':'No classes recorded for this month.';const r=visible.find(r=>r.key===selected)||visible.find(r=>r.date===now)||visible[visible.length-1];if(r)select(r);else{selected=null;$('details').replaceChildren(node('p','CLASS DETAILS','eyebrow'),node('h2','No recorded classes'),node('p','Choose another month to explore its class records.'));}}
 function shift(n){let [y,m]=month.split('-').map(Number);const d=new Date(Date.UTC(y,m-1+n,1));month=d.toISOString().slice(0,7);render();}
 async function load(){if(busy)return;busy=true;$('refresh').disabled=true;try{const response=await fetch('/data/homework.json',{cache:'no-store'});if(!response.ok)throw Error('read');const data=await response.json();if(!Array.isArray(data.classes))throw Error('format');records=data.classes.flatMap(c=>(c.sessions||[]).filter(s=>s.date<=now).map(s=>({...s,classId:c.id,key:c.id+'/'+s.date}))).sort((a,b)=>a.date.localeCompare(b.date)||a.time.localeCompare(b.time));render();}catch(e){$('status').textContent='Could not load class records. Please try Refresh.';}finally{busy=false;$('refresh').disabled=false;}}
 $('previous').onclick=()=>shift(-1);$('next').onclick=()=>shift(1);$('today').onclick=()=>{month=now.slice(0,7);render()};$('month-picker').onchange=e=>{if(/^\d{4}-\d{2}$/.test(e.target.value)){month=e.target.value;render()}};$('refresh').onclick=load;load();
})();
</script>
<style is:global>
body{margin:0;background:#f3f4f5;color:#193449;font-family:Arial,sans-serif}main{max-width:1560px;margin:auto;padding:44px 28px 70px}button,input,a{touch-action:manipulation}button,input{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #c16b43;outline-offset:3px}.intro{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:30px}.eyebrow{font-size:11px;letter-spacing:.16em;font-weight:700;color:#7a6253}h1{font-family:Georgia,serif;font-size:clamp(32px,4vw,54px);margin:10px 0}a{color:#154778}.intro>div>p:last-child{color:#576979}.tools{display:flex;flex-wrap:wrap;align-items:center;gap:16px;justify-content:space-between;margin-bottom:12px}.navigation{display:flex;align-items:center;gap:10px}.navigation h2{font:24px Georgia,serif;min-width:190px;margin:0}.tools button,.tools input{border:1px solid #c9d0d5;background:white;border-radius:6px;padding:10px 12px;color:#193449}.tools label{font-size:12px;display:flex;align-items:center;gap:8px}#status,.hint{color:#647581;font-size:12px}.workspace{display:grid;grid-template-columns:minmax(0,1fr) minmax(310px,380px);gap:24px;align-items:start}.calendar{min-width:0}.weekdays,#days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.weekdays{background:#193449;color:white;border-radius:8px 8px 0 0}.weekdays span{padding:14px 4px;text-align:center;font-size:10px;letter-spacing:.06em}#days{border-left:1px solid #d8dfe3;border-top:1px solid #d8dfe3}.day{min-height:132px;border-right:1px solid #d8dfe3;border-bottom:1px solid #d8dfe3;background:#fff;padding:8px;box-sizing:border-box}.outside{background:#e9edf0}.day-number{font-size:12px;font-weight:bold;margin:2px 0 10px}.current .day-number{color:#ac4928}.current{background:#fffaf5}.class-event{display:block;text-align:left;width:100%;border:0;border-left:3px solid #507b8b;border-radius:4px;background:#eaf0f4;color:#183449;padding:8px 6px;margin:5px 0;overflow-wrap:anywhere;transition:background .15s}.class-event strong,.class-event span,.class-event small{display:block}.class-event strong{font-size:11px}.class-event span{font-size:10px;margin-top:5px}.class-event small{font-size:10px;color:#5f7380;margin-top:5px;line-height:1.5}.class-event:hover,.class-event[aria-pressed=true]{background:#193449;color:white;border-left-color:#d8a477}.class-event[aria-pressed=true] small,.class-event:hover small{color:#dee6ec}#details{position:sticky;top:24px;border-top:4px solid #b26a44;background:white;padding:26px;max-height:calc(100dvh - 100px);overflow:auto;box-sizing:border-box;border-radius:4px;scroll-margin-top:24px}#details h2{font:28px Georgia,serif;margin:12px 0}#details .date{font-size:13px;color:#60717d;line-height:1.6}#details section{border-top:1px solid #e2e7eb;margin-top:22px;padding-top:14px}#details h3{font-size:15px;margin:8px 0 14px}#details h4{line-height:1.6}#details p,#details li{font-size:14px;line-height:1.8}.prose{white-space:pre-wrap}.names{display:flex;flex-wrap:wrap;gap:6px}.names span{background:#edf2f5;border-radius:20px;padding:5px 11px;font-size:12px}.missing{color:#74808a}.prepare{font-weight:bold}#details>a{display:inline-block;margin-top:20px;font-size:13px}#details ol{padding-left:21px}@media(max-width:1100px){main{padding:28px 16px}.workspace{grid-template-columns:minmax(0,1fr) 320px;gap:14px}.day{padding:5px}}@media(max-width:949px){.workspace{grid-template-columns:1fr}#details{position:static;max-height:none}.intro{align-items:start}.intro>a{font-size:12px;white-space:nowrap}.day{min-height:104px}.class-event small{display:none}.class-event span{font-size:9px}.class-event strong{font-size:9px}.navigation{flex-wrap:wrap}.navigation h2{font-size:22px;min-width:170px}.tools{gap:12px}.day{padding:3px}.class-event{padding:6px 3px;border-left-width:2px}.weekdays span{font-size:9px}.hint{line-height:1.6}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
.detail-controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}.detail-controls button,#close-popout{border:1px solid #c9d0d5;background:#edf2f5;color:#193449;padding:9px 12px;border-radius:5px;font:inherit;font-size:12px}#class-popout{width:min(720px,calc(100vw - 48px));max-height:85dvh;overflow:auto;box-sizing:border-box;border:0;border-top:4px solid #b26a44;border-radius:8px;padding:28px;color:#193449;background:white}#class-popout::backdrop{background:rgba(12,30,44,.6)}#close-popout{float:right}#popout-content{clear:both;padding-top:8px}#popout-content .prose{white-space:pre-wrap}#popout-content p,#popout-content li{line-height:1.8;font-size:14px}#popout-content section{border-top:1px solid #e2e7eb;margin-top:20px;padding-top:12px}
</style></body></html>

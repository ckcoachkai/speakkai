---
import SiteFooter from '../../components/SiteFooter.astro';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><link rel="canonical" href="https://speakkai.com/what/"/><link rel="icon" href="/favicon.svg"/><title>Class calendar | SpeakKai</title></head>
<body class="class-workspace"><header class="workspace-header"><a href="/" aria-label="SpeakKai home"><img src="/images/speakkai-logo-signature.svg" alt="SpeakKai" width="116" height="44"/></a><nav aria-label="Site"><a href="/schedule/">Schedule</a><a href="/fb/">Feedback</a><a href="/hw/">Homework</a></nav></header>
<main>
 <header class="intro"><h1>Class records</h1><a href="/hw/">Homework list ↗</a></header>
 <div class="toolbar"><div class="tools"><div class="navigation"><button id="previous" aria-label="Previous month">←</button><h2 id="month-title"></h2><button id="next" aria-label="Next month">→</button><button id="today">This month</button></div><label><span id="month-label" class="sr-only">Jump to month</span><input id="month-picker" type="month" aria-labelledby="month-label"/></label><button id="refresh">Refresh</button></div>
 <div class="reading-tools" aria-label="Reading preferences"><div class="control-group"><button id="language-en" type="button">English</button><button id="language-zh" type="button">中文</button></div><div class="control-group"><span id="calendar-size-label">Calendar</span><button id="calendar-minus" type="button" aria-label="Decrease calendar text size">−</button><output id="calendar-size"></output><button id="calendar-plus" type="button" aria-label="Increase calendar text size">+</button></div><div class="control-group"><span id="size-label">Details</span><button id="text-minus" type="button" aria-label="Decrease detail text size">−</button><output id="text-size"></output><button id="text-plus" type="button" aria-label="Increase detail text size">+</button></div></div></div>
 <p id="status" role="status" aria-live="polite">Loading class records…</p>
 <div class="workspace"><section class="calendar" aria-label="Class calendar"><div class="weekdays" aria-hidden="true">{['MON','TUE','WED','THU','FRI','SAT','SUN'].map(d=><span>{d}</span>)}</div><div id="days"></div><p class="hint">Hover to preview · Click to pin · Double-click to pop out. Only recorded classes appear.</p></section>
 <div id="panel-divider" role="separator" tabindex="0" aria-label="Resize calendar and details" aria-orientation="vertical" aria-valuemin="30" aria-valuemax="80" aria-valuenow="70" aria-controls="days details" title="Drag to resize · Double-click to reset"><span aria-hidden="true">↔</span></div>
 <aside id="details" aria-label="Selected class details" tabindex="-1"><p class="eyebrow">CLASS DETAILS</p><h2>Select a class</h2><p>Explore a class to see the students, lesson and homework here.</p></aside></div>
 <dialog id="class-popout" aria-label="Class details pop-out"><button id="close-popout" type="button" autofocus>Close ✕</button><button id="copy-popout" type="button">Copy class record</button><div id="popout-content"></div></dialog>
 <noscript>This calendar needs JavaScript. <a href="/hw/">Read the homework list instead.</a></noscript>
</main><SiteFooter />
<script is:inline>
(()=>{
 const $=id=>document.getElementById(id), now=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
 let lang='en',textSize=14,calendarSize=11;try{lang=localStorage.getItem('what-language')==='zh'?'zh':'en';textSize=Math.max(9,Math.min(24,Number(localStorage.getItem('what-text-size'))||14));calendarSize=Math.max(9,Math.min(18,Number(localStorage.getItem('what-calendar-size'))||11));}catch{}
 const translations={'Copy class record':'复制课堂记录','CLASS DETAILS':'课堂详情','Students':'学生','Class content':'课堂内容','Homework':'课后作业','Not recorded for this class.':'本次课堂暂无记录。','Students not recorded.':'学生名单暂无记录。','Pinned · Release pin':'已固定 · 取消固定','Pin these details':'固定课堂详情','Pop out ↗':'弹出详情 ↗','Open homework list ↗':'打开作业列表 ↗','No recorded classes':'暂无课堂记录','Choose another month to explore its class records.':'请选择其他月份查看课堂记录。'};const tr=t=>lang==='zh'?(translations[t]||t):t;
 let month=now.slice(0,7), records=[], selected=null, pinned=null, busy=false;
 const node=(tag,text,cls)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=tr(text);if(cls)e.className=cls;return e};
 const dateLabel=d=>new Intl.DateTimeFormat(lang==='zh'?'zh-CN':'en',{dateStyle:'full',timeZone:'UTC'}).format(new Date(d+'T12:00:00Z'));
 const groupLabel=id=>id.split('-').map(x=>(lang==='zh'?{mon:'周一',tue:'周二',wed:'周三',thu:'周四',fri:'周五',sat:'周六',sun:'周日',afternoon:'下午',later:'晚班',introductory:'入门',foundations:'基础',original:'原创',oratory:'演讲'}:{mon:'Monday',tue:'Tuesday',wed:'Wednesday',thu:'Thursday',fri:'Friday',sat:'Saturday',sun:'Sunday'})[x]||x).join(' · ');
 function select(r){selected=r.key;document.querySelectorAll('.class-event').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.key===selected)));const panel=$('details');panel.replaceChildren(node('p','CLASS DETAILS','eyebrow'),node('h2',groupLabel(r.classId)),node('p',dateLabel(r.date)+' · '+r.time,'date'));const roster=node('section');roster.append(node('h3','Students'));const names=node('div',undefined,'names');for(const z of r.students||[])names.append(node('span',z.name));if(!names.children.length)names.append(node('p','Students not recorded.'));roster.append(names);panel.append(roster);
 const content=node('section');content.append(node('h3','Class content'));for(const t of (lang==='zh'?(r.translation?.classContent?.zh?[r.translation.classContent.zh]:['暂无中文记录。',...(r.classContent||[])]):r.classContent)||[])content.append(node('p',t,'prose'));if(!(lang==='zh'&&r.translation?.classContent?.zh)&&!r.classContent?.length)content.append(node('p','Not recorded for this class.','missing'));panel.append(content);
 const homework=node('section');homework.append(node('h3','Homework'));if(lang==='zh'&&r.translation?.homework?.zh){homework.append(node('p',r.translation.homework.zh,'prose'));}else if(r.homework){if(lang==='zh')homework.append(node('p','暂无中文记录。以下为英文原文。','missing'));homework.append(node('h4',r.homework.title));const list=node('ol');for(const t of r.homework.steps||[])list.append(node('li',t));homework.append(list);if(r.homework.prepareFor)homework.append(node('p',r.homework.prepareFor,'prepare'));if(r.homework.note)homework.append(node('p',r.homework.note,'prose'));}else homework.append(node('p','Not recorded for this class.','missing'));panel.append(homework);
 const controls=node('div',undefined,'detail-controls');const pin=node('button',pinned===r.key?'Pinned · Release pin':'Pin these details');pin.type='button';pin.onclick=()=>{pinned=pinned===r.key?null:r.key;pin.textContent=tr(pinned===r.key?'Pinned · Release pin':'Pin these details')};const expand=node('button','Pop out ↗');expand.type='button';expand.onclick=()=>popout(r);const copy=node('button','Copy class record','copy-record');copy.type='button';copy.onclick=()=>copyRecord(r,copy);controls.append(copy,pin,expand);panel.prepend(controls);const link=node('a','Open homework list ↗');link.href='/hw/#'+encodeURIComponent(r.classId);panel.append(link);
 }
 function recordText(r){
 const zh=lang==='zh',lines=[groupLabel(r.classId),dateLabel(r.date)+' · '+r.time+' · '+(zh?'上海时间':'Shanghai time'),''];
 lines.push(tr('Students')+': '+((r.students||[]).map(z=>z.name).join(', ')||tr('Students not recorded.')),'',tr('Class content'));
 if(zh&&r.translation?.classContent?.zh)lines.push(r.translation.classContent.zh);
 else{if(zh&&r.classContent?.length)lines.push('暂无中文记录。以下为英文原文。');lines.push(...(r.classContent?.length?r.classContent:[tr('Not recorded for this class.')]));}
 lines.push('',tr('Homework'));
 if(zh&&r.translation?.homework?.zh)lines.push(r.translation.homework.zh);
 else if(r.homework){if(zh)lines.push('暂无中文记录。以下为英文原文。');if(r.homework.title)lines.push(r.homework.title);for(const [i,t] of (r.homework.steps||[]).entries())lines.push((i+1)+'. '+t);if(r.homework.prepareFor)lines.push(r.homework.prepareFor);if(r.homework.note)lines.push(r.homework.note);}
 else lines.push(tr('Not recorded for this class.'));
 return lines.join('\n');
 }
 async function copyRecord(r,button){const text=recordText(r);try{if(!navigator.clipboard?.writeText)throw Error('unavailable');await navigator.clipboard.writeText(text);button.textContent=lang==='zh'?'已复制 ✓':'Copied ✓';$('status').textContent=lang==='zh'?'课堂记录已复制，可粘贴给家长。':'Class record copied. Ready to paste for parents.';}catch{const host=$('class-popout').open?$('popout-content'):$('details');let fallback=host.querySelector('.copy-fallback');if(!fallback){fallback=node('textarea',undefined,'copy-fallback');fallback.readOnly=true;fallback.setAttribute('aria-label',lang==='zh'?'手动复制课堂记录':'Class record for manual copying');host.prepend(fallback);}fallback.value=text;fallback.focus();fallback.select();$('status').textContent=lang==='zh'?'无法自动复制。请手动复制已选中的完整记录。':'Automatic copy unavailable. Copy the selected complete record manually.';}}
 $('copy-popout').onclick=()=>{const r=records.find(r=>r.key===selected);if(r)copyRecord(r,$('copy-popout'));};
 function popout(r){pinned=r.key;select(r);const content=$('popout-content');$('copy-popout').textContent=tr('Copy class record');content.replaceChildren();for(const child of $('details').children){if(!child.classList.contains('detail-controls'))content.append(child.cloneNode(true));}$('class-popout').showModal();}
 $('close-popout').onclick=()=>$('class-popout').close();$('class-popout').addEventListener('click',e=>{if(e.target===$('class-popout')){const rect=e.target.getBoundingClientRect();if(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom)e.target.close();}});
 function render(){const [y,m]=month.split('-').map(Number),start=new Date(Date.UTC(y,m-1,1)),offset=(start.getUTCDay()+6)%7,count=new Date(Date.UTC(y,m,0)).getUTCDate();$('month-title').textContent=new Intl.DateTimeFormat(lang==='zh'?'zh-CN':'en',{month:'long',year:'numeric',timeZone:'UTC'}).format(start);$('month-picker').value=month;const grid=$('days');grid.replaceChildren();for(let i=0;i<Math.ceil((offset+count)/7)*7;i++){const day=i-offset+1,cell=node('div',undefined,'day');if(day<1||day>count){cell.classList.add('outside');cell.setAttribute('aria-hidden','true');grid.append(cell);continue;}const date=month+'-'+String(day).padStart(2,'0'),num=node('div',String(day),'day-number');if(date===now){cell.classList.add('current');num.setAttribute('aria-label','Today, '+dateLabel(date));}cell.append(num);for(const r of records.filter(r=>r.date===date)){const b=node('button',undefined,'class-event');b.style.setProperty('--class-color','#1557b0');b.dataset.key=r.key;b.append(node('strong',r.time),node('span',(r.students||[]).map(x=>x.name).join(', ')||tr('Students not recorded.')));b.setAttribute('aria-label',dateLabel(date)+', '+r.time+', '+groupLabel(r.classId));b.setAttribute('aria-controls','details');b.setAttribute('aria-pressed',String(r.key===selected));b.addEventListener('mouseenter',()=>{if(!pinned&&!document.body.classList.contains('resizing')&&matchMedia('(hover:hover)').matches)select(r)});b.addEventListener('focus',()=>{if(!pinned)select(r)});b.addEventListener('dblclick',()=>popout(r));b.addEventListener('click',()=>{pinned=r.key;select(r);});cell.append(b);}grid.append(cell);}const visible=records.filter(r=>r.date.startsWith(month));if(pinned&&!visible.some(r=>r.key===pinned))pinned=null;$('status').textContent=visible.length?(lang==='zh'?visible.length+' 节已记录课堂 · 上海时间':visible.length+' recorded classes · Shanghai time'):(lang==='zh'?'本月暂无课堂记录。':'No classes recorded for this month.');const r=visible.find(r=>r.key===selected)||visible.find(r=>r.date===now)||visible[visible.length-1];if(r)select(r);else{selected=null;$('details').replaceChildren(node('p','CLASS DETAILS','eyebrow'),node('h2','No recorded classes'),node('p','Choose another month to explore its class records.'));}}
 function shift(n){let [y,m]=month.split('-').map(Number);const d=new Date(Date.UTC(y,m-1+n,1));month=d.toISOString().slice(0,7);render();}
 async function load(){if(busy)return;busy=true;$('refresh').disabled=true;try{const response=await fetch('/data/homework.json',{cache:'no-store'});if(!response.ok)throw Error('read');const data=await response.json();let bilingual={classes:[]};try{const translated=await fetch('/data/feedback.json',{cache:'no-store'});if(translated.ok)bilingual=await translated.json();}catch{}const shared=new Map((bilingual.classes||[]).flatMap(c=>(c.sessions||[]).map(s=>[c.id+'/'+s.date,{classContent:s.classContent,homework:s.homework}])));if(!Array.isArray(data.classes))throw Error('format');records=data.classes.flatMap(c=>(c.sessions||[]).filter(s=>s.date<=now).map(s=>({...s,classId:c.id,key:c.id+'/'+s.date,translation:shared.get(c.id+'/'+s.date)}))).sort((a,b)=>a.date.localeCompare(b.date)||a.time.localeCompare(b.time));render();}catch(e){$('status').textContent=lang==='zh'?'无法加载课堂记录，请重试刷新。':'Could not load class records. Please try Refresh.';}finally{busy=false;$('refresh').disabled=false;}}
 let calendarShare=64,preferredShare=64;try{calendarShare=Number(localStorage.getItem('what-calendar-share'))||64;preferredShare=calendarShare}catch{}const divider=$('panel-divider'),workspace=document.querySelector('.workspace');let dragging=false;
 function resizePanels(value,save=true){const width=workspace.getBoundingClientRect().width;const min=Math.max(30,Math.min(50,420/width*100)),max=Math.min(80,(width-340-20)/width*100);calendarShare=Math.max(min,Math.min(max,value));workspace.style.setProperty('--calendar-share',calendarShare+'%');divider.setAttribute('aria-valuenow',String(Math.round(calendarShare)));divider.setAttribute('aria-valuemin',String(Math.ceil(min)));divider.setAttribute('aria-valuemax',String(Math.floor(max)));if(save){preferredShare=calendarShare;try{localStorage.setItem('what-calendar-share',preferredShare)}catch{}}}
 function moveDivider(e){if(dragging){const box=workspace.getBoundingClientRect();resizePanels((e.clientX-box.left)/box.width*100,false)}}
 divider.addEventListener('pointerdown',e=>{if(e.button!==0||innerWidth<950)return;e.preventDefault();dragging=true;divider.setPointerCapture(e.pointerId);document.body.classList.add('resizing');moveDivider(e)});divider.addEventListener('pointermove',moveDivider);function finishResize(){if(!dragging)return;dragging=false;document.body.classList.remove('resizing');resizePanels(calendarShare)}divider.addEventListener('pointerup',finishResize);divider.addEventListener('pointercancel',finishResize);divider.addEventListener('lostpointercapture',finishResize);divider.addEventListener('dblclick',()=>resizePanels(64));divider.addEventListener('keydown',e=>{const delta=e.shiftKey?5:2;if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();resizePanels(calendarShare+(e.key==='ArrowLeft'?-delta:delta))}else if(e.key==='Home'||e.key==='End'){e.preventDefault();resizePanels(e.key==='Home'?0:100)}});window.addEventListener('resize',()=>{if(innerWidth>=950)resizePanels(preferredShare,false)});if(innerWidth>=950)resizePanels(calendarShare,false);
 function preferences(){
 divider.setAttribute('aria-label',lang==='zh'?'调整日历与详情的宽度':'Resize calendar and details');divider.title=lang==='zh'?'拖动调整宽度 · 双击恢复默认':'Drag to resize · Double-click to reset';document.documentElement.lang=lang==='zh'?'zh-CN':'en';
 document.documentElement.style.setProperty('--detail-size',textSize+'px');document.documentElement.style.setProperty('--calendar-size',calendarSize+'px');
 for(const [prefix,value,min,max] of [['text',textSize,9,24],['calendar',calendarSize,9,18]]){ $(prefix+'-size').textContent=value+'px';$(prefix+'-minus').disabled=value<=min;$(prefix+'-plus').disabled=value>=max;for(const [suffix,en,zh] of [['minus','Decrease','缩小'],['plus','Increase','放大']])$(prefix+'-'+suffix).setAttribute('aria-label',lang==='zh'?zh+(prefix==='text'?'详情字号':'日历字号'):en+' '+(prefix==='text'?'detail':'calendar')+' text size');}
 $('language-en').setAttribute('aria-pressed',String(lang==='en'));$('language-zh').setAttribute('aria-pressed',String(lang==='zh'));$('size-label').textContent=lang==='zh'?'详情':'Details';$('calendar-size-label').textContent=lang==='zh'?'日历':'Calendar';document.querySelector('.intro h1').textContent=lang==='zh'?'课堂记录':'Class records';document.querySelector('.intro>a').textContent=lang==='zh'?'作业列表 ↗':'Homework list ↗';$('today').textContent=lang==='zh'?'本月':'This month';$('refresh').textContent=lang==='zh'?'刷新':'Refresh';$('close-popout').textContent=lang==='zh'?'关闭 ✕':'Close ✕';$('month-label').textContent=lang==='zh'?'选择月份':'Jump to month';$('previous').setAttribute('aria-label',lang==='zh'?'上个月':'Previous month');$('next').setAttribute('aria-label',lang==='zh'?'下个月':'Next month');document.querySelectorAll('.weekdays span').forEach((e,i)=>e.textContent=lang==='zh'?['一','二','三','四','五','六','日'][i]:['MON','TUE','WED','THU','FRI','SAT','SUN'][i]);document.querySelector('.hint').textContent=lang==='zh'?'悬停预览 · 点击固定 · 双击弹出。仅显示已记录的课堂。':'Hover to preview · Click to pin · Double-click to pop out. Only recorded classes appear.';
 try{localStorage.setItem('what-language',lang);localStorage.setItem('what-text-size',textSize);localStorage.setItem('what-calendar-size',calendarSize);}catch{}}
 $('text-minus').onclick=()=>{textSize=Math.max(9,textSize-1);preferences()};$('text-plus').onclick=()=>{textSize=Math.min(24,textSize+1);preferences()};$('calendar-minus').onclick=()=>{calendarSize=Math.max(9,calendarSize-1);preferences()};$('calendar-plus').onclick=()=>{calendarSize=Math.min(18,calendarSize+1);preferences()};for(const l of ['en','zh'])$('language-'+l).onclick=()=>{lang=l;preferences();render()};preferences();
 $('previous').onclick=()=>shift(-1);$('next').onclick=()=>shift(1);$('today').onclick=()=>{month=now.slice(0,7);render()};$('month-picker').onchange=e=>{if(/^\d{4}-\d{2}$/.test(e.target.value)){month=e.target.value;render()}};$('refresh').onclick=load;load();
})();
</script>
<style is:global>
*{box-sizing:border-box}body.class-workspace{margin:0;background:#fff;color:#193449;font:14px Arial,'Microsoft YaHei',sans-serif}.class-workspace .workspace-header{height:52px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 20px;border-bottom:1px solid #dce3ea;background:white}.workspace-header img{display:block;width:116px;height:44px;object-fit:contain}.workspace-header nav{display:flex;gap:20px}.workspace-header a{font:13px Arial,sans-serif;text-decoration:none;color:#154778}.class-workspace main{max-width:1560px;margin:auto;padding:12px 20px 40px}.class-workspace .intro{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 10px}.class-workspace h1{font:700 23px/1.2 Arial,sans-serif;margin:0}.intro>a{font-size:12px}.class-workspace a{color:#154778}button,input{font:inherit}button,input,a{touch-action:manipulation}button{cursor:pointer}button:disabled{opacity:.4;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,#panel-divider:focus-visible{outline:3px solid #b52330;outline-offset:2px}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px 16px;flex-wrap:wrap}.tools,.navigation,.reading-tools,.control-group{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.tools label{display:flex}.tools h2{font:700 17px/1.2 Arial,sans-serif;margin:0 4px;min-width:130px}.tools button,.tools input,.reading-tools button,.detail-controls button,#close-popout,#copy-popout{border:1px solid #c7d2dd;background:#fff;color:#154778;border-radius:5px;padding:6px 9px;min-height:32px;font:12px Arial,sans-serif}.tools input{width:145px}.reading-tools{gap:12px}.control-group{flex-wrap:nowrap;gap:5px}.control-group span,.control-group output{font-size:12px;white-space:nowrap}.control-group output{min-width:28px;text-align:center}.reading-tools button{padding:5px 8px}.reading-tools button[aria-pressed=true],.detail-controls .copy-record,#copy-popout{background:#1557b0;color:white;border-color:#1557b0}#status,.hint{font-size:11px;color:#647581;margin:8px 0;line-height:1.4}.workspace{display:grid;grid-template-columns:minmax(0,var(--calendar-share,64%)) 20px minmax(0,1fr);align-items:start;gap:0}.calendar{min-width:0;padding-right:8px}.weekdays,#days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.weekdays{background:#1557b0;color:#fff;border-radius:5px 5px 0 0}.weekdays span{text-align:center;font-size:10px;padding:7px 2px}#days{border-left:1px solid #d8dfe3;border-top:1px solid #d8dfe3}.calendar .day{min-height:76px;padding:4px;border-right:1px solid #d8dfe3;border-bottom:1px solid #d8dfe3;background:white}.day-number{font-size:11px;font-weight:bold;margin:1px 0 4px}.current .day-number{color:#b52330;text-decoration:underline;text-underline-offset:3px}.calendar .class-event{display:block;text-align:left;width:100%;border:0;border-radius:4px;background:var(--class-color);color:#fff;padding:5px;margin:3px 0;overflow-wrap:anywhere;line-height:1.3;font-size:var(--calendar-size,11px)}.class-event strong,.class-event span{display:block;font-size:inherit;line-height:1.3;letter-spacing:normal;text-transform:none}.class-event span{margin-top:3px;font-size:max(9px,calc(var(--calendar-size,11px) - 1px));line-height:1.3}.class-event small{display:none}.class-event[aria-pressed=true]{outline:2px solid #151515;outline-offset:1px}.class-event:focus-visible{outline:3px solid #111;outline-offset:2px}.eyebrow{font-size:10px!important;letter-spacing:.1em;color:#1557b0;font-weight:700}.class-workspace #details{position:sticky;top:12px;margin-left:8px;padding:14px;border:1px solid #dce3ea;border-top:3px solid #1557b0;border-radius:5px;max-height:calc(100dvh - 24px);overflow:auto;min-width:0;background:white}.class-workspace #details h2,#popout-content h2{font:700 20px/1.3 Arial,sans-serif;margin:8px 0}.class-workspace #details p,.class-workspace #details li,.class-workspace #details h4,#popout-content p,#popout-content li,#popout-content h4{font-size:var(--detail-size,14px);line-height:1.6}.date{color:#60717d}.class-workspace #details section,#popout-content section{border-top:1px solid #e2e7eb;margin-top:14px;padding-top:8px}.class-workspace #details h3,#popout-content h3{font:700 calc(var(--detail-size,14px) + 1px)/1.4 Arial,sans-serif;margin:5px 0 10px}h4{margin:8px 0}.prose{white-space:pre-wrap}.names{display:flex;gap:5px;flex-wrap:wrap}.names span{font-size:var(--detail-size,14px);border:1px solid #d0dcea;padding:3px 7px;border-radius:4px}.missing{color:#647581}.prepare{font-weight:bold}#details>a{display:inline-block;margin-top:14px;font-size:12px}ol{padding-left:22px}.detail-controls{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}.detail-controls button{font-size:11px}.copy-fallback{display:block;width:100%;height:220px;margin:8px 0;font:14px/1.5 Arial,sans-serif;white-space:pre-wrap}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}#class-popout{width:min(760px,calc(100vw - 24px));max-height:88dvh;overflow:auto;border:1px solid #dce3ea;border-top:3px solid #1557b0;border-radius:7px;padding:20px;color:#193449;background:#fff}#class-popout::backdrop{background:rgba(12,30,44,.6)}#close-popout{float:right}#popout-content{clear:both;padding-top:8px}#panel-divider{align-self:stretch;position:relative;cursor:col-resize;touch-action:none;min-height:140px;outline-offset:0}#panel-divider::before{content:'';position:absolute;top:0;bottom:0;left:9px;width:2px;background:#d0dcea}#panel-divider span{position:sticky;top:45vh;display:grid;place-items:center;width:20px;height:42px;background:#1557b0;color:white;border-radius:4px;font-size:17px}#panel-divider:hover span,#panel-divider:focus-visible span{background:#b52330}.resizing,.resizing *{cursor:col-resize!important;user-select:none!important}

---
import SpatialSiteHeader from '../components/SpatialSiteHeader.astro';
import { Mic, AudioLines, Volume2, Square, Headphones, ArrowUpRight } from '@lucide/astro';
import { DEFAULT_FILLERS, OPTIONAL_FILLERS } from '../scripts/speak/detector';
import '../styles/speak.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Practice speaking with live filler-word detection, red screen alerts, and an adjustable siren. A free SpeakKai practice tool." />
    <meta name="theme-color" content="#10224a" />
    <link rel="canonical" href="https://speakkai.com/speak/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Filler Alarm | SpeakKai Speaking Practice</title>
  </head>
  <body class="speak-page">
    <SpatialSiteHeader current="resources" compact />
    <main id="speak-app">
      <div class="app-heading"><div class="app-title"><AudioLines size={23} /><h1>Filler Alarm</h1><span>PRACTICE LAB</span></div><span class="language-note"><i></i>English · Live practice</span></div>
      <div class="workspace">
        <section class="practice" aria-label="Speaking practice">
          <div class="section-top"><p class="eyebrow">YOUR SPEAKING SPACE</p><span id="status" role="status">Checking browser…</span></div>
          <div class="stage" id="stage">
            <div class="stage-grid" aria-hidden="true"></div>
            <div class="stage-content">
              <div class="mic-orbit" id="mic-orbit"><Mic size={42} stroke-width={1.5} /></div>
              <p class="stage-kicker" id="stage-kicker">MAKE ROOM FOR THE PAUSE</p>
              <h2 id="stage-title">Speak with intention.</h2>
              <p class="stage-help" id="stage-help">Catch your fillers as you speak. One thought at a time.</p>
              <div class="level" id="level" aria-label="Microphone inactive">{Array.from({length:35}, () => <span></span>)}</div>
              <div class="main-actions"><button id="start" class="primary-button" disabled><Mic size={19} /><span>Start practice</span></button><button id="stop" class="primary-button stop-button" hidden><Square size={16} fill="currentColor" />End practice</button><button id="test-alert" class="secondary-button"><Volume2 size={18} />Test alert</button></div>
              <p class="permission-note" id="permission-note">Allow microphone access when prompted. Headphones recommended.</p>
            </div>
          </div>
          <div class="stats" aria-label="Session statistics"><div><span>SESSION TIME</span><strong id="elapsed">00:00</strong></div><div><span>DETECTED FILLERS</span><strong id="total">00</strong></div><div><span>FILLERS / MIN</span><strong id="rate">—</strong></div></div>
          <div id="error" class="error-box" role="alert" hidden></div>
          <section class="transcript-panel"><div class="section-top"><h2>Live transcript</h2><span class="subtle" id="transcript-state">Only for this session</span></div><div id="transcript" class="transcript empty" tabindex="0" aria-label="Live transcript">Your words will appear here when recognition starts. Fillers will be highlighted.</div><div class="transcript-footer"><span>Counts can change when the browser corrects its transcript.</span><button class="text-button" id="clear" hidden>Clear session</button></div></section>
        </section>
        <aside class="settings-panel" aria-label="Practice settings">
          <div class="panel-heading"><h2>Make it your practice.</h2><span>01 / SETUP</span></div>
          <section class="setting-group"><div class="row"><label for="siren">Siren alert</label><input type="checkbox" role="switch" class="toggle" id="siren" checked /></div><p>A short rising siren with each red alert.</p><div class="volume-label"><label for="volume">Volume</label><output id="volume-value" for="volume">35%</output></div><input type="range" id="volume" min="0" max="100" step="5" value="35" /><div class="headphone-note"><Headphones size={16} /><span>Use headphones to keep the siren out of your microphone.</span></div></section>
          <fieldset class="setting-group filler-group" id="filler-selection"><legend>Listen for</legend><p>Select the sounds you want to catch.</p><div class="chips">{DEFAULT_FILLERS.map(word => <button class="chip selected" data-filler={word} aria-pressed="true">{word}<span aria-hidden="true">−</span></button>)}</div><h3>Optional words & phrases</h3><p>These can be meaningful, too. Every selected occurrence will count.</p><div class="chips">{OPTIONAL_FILLERS.map(word => <button class="chip" data-filler={word} aria-pressed="false">{word}<span aria-hidden="true">+</span></button>)}</div><p id="selection-warning" hidden>Select at least one filler to begin.</p></fieldset>
          <section class="setting-group"><h3>This session</h3><div id="breakdown"><p>Your filler breakdown will appear here.</p></div></section>
          <div class="detection-note"><ArrowUpRight size={20} /><div><h3>A practice aid, still experimental.</h3><p>Browsers can omit “um” and “uh.” If a filler is missing from the transcript, it cannot trigger an alert. This version detects words, not raw hesitation sounds.</p></div></div>
        </aside>
      </div>
      <footer class="app-footer"><span><AudioLines size={17} />Fewer fillers. More space to think.</span><p>No audio recordings or session history are saved by this app. Your browser may send audio to its speech service. Internet access may be required.</p></footer>
      <div id="alert-announcement" class="sr-only" role="status" aria-live="polite"></div>
      <noscript><p class="error-box">Enable JavaScript to use live microphone detection.</p></noscript>
    </main>
    <script>import '../scripts/speak/app';</script>
  </body>
</html>

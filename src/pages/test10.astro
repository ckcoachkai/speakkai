---
import { ArrowRight, ArrowUpRight, Check, Quote } from "@lucide/astro";
import TestSwitcher from "../components/TestSwitcher.astro";
import "../styles/test10.css";

const stages = [
  { index: "01", name: "Speak", copy: "Find the thought, choose the words, and say them with control." },
  { index: "02", name: "Connect", copy: "Make the listener feel why the message matters." },
  { index: "03", name: "Influence", copy: "Turn attention into understanding—and understanding into action." },
  { index: "04", name: "Build", copy: "Use communication to create opportunity, leadership, and momentum." },
  { index: "05", name: "Reputation", copy: "Let repeated impact become the way people know and trust you." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SpeakKai homepage experiment: The Visible Ripple." />
    <meta name="robots" content="noindex, nofollow" />
    <title>SpeakKai Test 10 | The Visible Ripple</title>
  </head>
  <body class="t10-page">
    <header class="t10-header">
      <a class="t10-logo" href="/">SpeakKai<span>.</span></a>
      <p>Speech · Debate · Presentation</p>
      <nav aria-label="Main navigation">
        <a href="/about/">Coach</a>
        <a href="/resources/">Programs</a>
        <a class="t10-nav-cta" href="/contact/">Talk to Kai <ArrowUpRight size={14} /></a>
      </nav>
    </header>

    <main>
      <section class="t10-hero" aria-labelledby="t10-title">
        <img class="t10-portrait" src="/images/coach-kai-headshot.webp" alt="Coach Kai wearing a navy suit" width="1400" height="1400" loading="eager" decoding="async" fetchpriority="high" />
        <div class="t10-halo" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="t10-fade" aria-hidden="true"></div>
        <div class="t10-copy">
          <p class="t10-kicker">Communication coaching for moments that matter</p>
          <h1 id="t10-title">Make your message <mark>travel.</mark></h1>
          <p class="t10-deck">Speech, debate, and presentation coaching that turns clear thought into confident delivery—and confident delivery into lasting influence.</p>
          <div class="t10-actions">
            <a class="t10-primary" href="/contact/">Tell Kai what you’re preparing for <ArrowRight size={17} /></a>
            <a class="t10-secondary" href="#method">See the Ripple Method ↓</a>
          </div>
        </div>
        <div class="t10-signal" aria-hidden="true"><span></span><i></i><b></b></div>
        <p class="t10-caption">Kai Liu · Coach · Speaker · Educator</p>
      </section>

      <aside class="t10-proof" aria-label="Coach Kai experience">
        <span><strong>15+</strong> years in education</span>
        <span><strong>2,000+</strong> students trained</span>
        <span><strong>1,000+</strong> presentations delivered</span>
        <span><strong>7</strong> countries reached</span>
      </aside>

      <section class="t10-method" id="method" aria-labelledby="method-title">
        <header>
          <p>The SpeakKai Ripple Method</p>
          <h2 id="method-title">One voice.<br />Five widening effects.</h2>
          <p>Technique is only the center. The real goal is what your communication makes possible beyond the stage.</p>
        </header>
        <ol>
          {stages.map((stage) => (
            <li>
              <span>{stage.index}</span>
              <h3>{stage.name}</h3>
              <p>{stage.copy}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="t10-fit" aria-labelledby="fit-title">
        <div class="t10-fit-copy">
          <p>Coaching shaped around the speaker</p>
          <h2 id="fit-title">Serious progress can still feel human.</h2>
          <p>Clear structure, exact feedback, and enough room for personality. The work changes with the speaker; the standard does not.</p>
          <a href="/contact/">Find the right coaching path <ArrowRight size={17} /></a>
        </div>
        <div class="t10-fit-grid">
          <article><Check size={18} /><span>Young speakers</span><p>Build brave habits around ideas, story, and delivery.</p></article>
          <article><Check size={18} /><span>Teens &amp; competitors</span><p>Sharpen arguments, presence, and performance under pressure.</p></article>
          <article><Check size={18} /><span>Professionals</span><p>Prepare talks, interviews, pitches, and leadership moments.</p></article>
          <article><Check size={18} /><span>Schools &amp; teams</span><p>Create practical communication programs with visible progression.</p></article>
        </div>
      </section>

      <section class="t10-practice" aria-labelledby="practice-title">
        <figure><img src="/images/test/kids-speaking.webp" alt="Stylized illustration of young speakers sharing ideas in a colourful practice circle" width="1920" height="1075" loading="lazy" decoding="async" /></figure>
        <div>
          <p>Inside the practice room</p>
          <h2 id="practice-title">A voice grows by being used.</h2>
          <p>Try the idea. Hear the feedback. Shape it again. The energy stays high because every activity has a visible purpose.</p>
          <a href="/resources/">Explore practice tools <ArrowUpRight size={17} /></a>
        </div>
      </section>

      <section class="t10-close">
        <Quote size={30} />
        <blockquote>Speaking is the start. What people understand, remember, and trust is the ripple.</blockquote>
        <a href="/contact/">Start at the center <ArrowUpRight size={18} /></a>
      </section>
    </main>

    <TestSwitcher current="10" tone="light" />
  </body>
</html>

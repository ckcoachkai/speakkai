---
import FlagshipLayout from '../../layouts/FlagshipLayout.astro';
import { topics, topicPeriod, topicHref, illustrationHref } from '../../lib/topics';
import topicMethod from '../../data/topicMethod.json';
import '../../styles/topic-index.css';
const categories=[...new Set(topics.map(t=>t.category))].sort();
const rankedTopics=[...topics].sort((a,b)=>(a.ranks?.overall??Number.POSITIVE_INFINITY)-(b.ranks?.overall??Number.POSITIVE_INFINITY)||a.number-b.number);
const lensLabels={overall:'Overall',expository:'Expository',oratory:'Original oratory',logic:'Logic & impact',unusual:'Unusualness & impact'};
const factorLabels={impact:'Societal impact',weirdness:'Weirdness',accessibility:'Accessibility',expository:'Expository',oratory:'Original oratory',logic:'Logic & impact'};
const lensWeights=Object.entries(topicMethod.weights).map(([lens,weights])=>({name:lensLabels[lens as keyof typeof lensLabels]??lens,weights:Object.entries(weights).filter(([,weight])=>weight>0).map(([factor,weight])=>`${factorLabels[factor as keyof typeof factorLabels]??factor} ${Math.round(weight*100)}%`).join(' · ')}));
---
<FlagshipLayout title="100 Stories to Explore | SpeakKai Topics" description="Explore 100 illustrated September stories. Find an idea, understand the evidence, and develop an expository or original-oratory speech." current="resources">
  <div class="topic-library">
    <header class="topic-hero">
      <div><a class="topic-back" href="/resources/">← Practice resources</a><p class="topic-kicker">The topic library · {topicPeriod}</p><h1>A world of ideas.<br/><em>Find yours.</em></h1><p class="topic-lead">Unusual discoveries. Everyday systems. Questions with consequences. Explore a story, follow its sources, and find something worth explaining.</p></div>
      <div class="topic-hero-art"><img src={illustrationHref('education')} alt="Illustrated books, questions and learning tools" width="1536" height="1024" loading="eager" fetchpriority="high"/><span><strong>100</strong> stories to explore</span></div>
    </header>
    <div class="topic-introduction"><p><strong>One story. One page.</strong> The numbers 1–100 are stable chronological page identifiers. The ranking is separate: every story is scored across the coaching lenses and assigned a rank within this 100-story library.</p><p>Each page gives you a factual starting point, evidence limits, and ways to develop an expository or original-oratory speech for students 8–16. Change the lens below to see what rises to the top.</p></div>
    <details class="topic-jump"><summary>Jump to a story · 1–100 <span aria-hidden="true">+</span></summary><nav aria-label="All 100 story pages" class="topic-number-grid">{topics.map(t=><a href={topicHref(t.number)} aria-label={`Story ${t.number}: ${t.title}`}>{t.number}</a>)}</nav></details>
    <section aria-labelledby="browse-title" class="topic-browse">
      <div class="topic-section-heading"><div><p class="topic-kicker">Read. Question. Explain.</p><h2 id="browse-title">Choose a story.</h2></div><p id="topic-count" role="status">100 stories · September 1–14</p></div>
      <form id="topic-filters" class="topic-filters" role="search">
        <label>Search<input type="search" id="topic-search" placeholder="Story, place, or idea…" /></label>
        <label>Topic<select id="topic-category"><option value="">All topics</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label>
        <label>Student age<select id="topic-age"><option value="16">Up to age 16</option>{[8,9,10,11,12,13,14,15].map(a=><option value={a}>Age {a}</option>)}</select></label>
        <label>Explore by<select id="topic-sort"><option value="overall">Overall rank</option><option value="expository">Expository rank</option><option value="oratory">Original-oratory rank</option><option value="logic">Logic & impact rank</option><option value="unusual">Unusualness & impact rank</option><option value="number">Story number</option></select></label>
        <button type="reset">Reset</button>
      </form>
      <p class="topic-filter-note" id="topic-filter-note">Sorted by overall rank. Page numbers stay stable when you explore a different lens. Scores are coaching judgments.</p>
      <noscript><p>All 100 stories are available below. Search and filters require JavaScript.</p></noscript>
      <div class="topic-grid" id="topic-grid">{rankedTopics.map(t=><article class="topic-card" data-topic-card data-number={t.number} data-category={t.category} data-age={t.ageMin ?? 16} data-overall-rank={t.ranks?.overall} data-expository-rank={t.ranks?.expository} data-oratory-rank={t.ranks?.oratory} data-logic-rank={t.ranks?.logic} data-unusual-rank={t.ranks?.unusual} data-search={`${t.title} ${t.country} ${t.plainSummary}`.toLowerCase()}>
        <a class="topic-card-image" href={topicHref(t.number)} tabindex="-1" aria-hidden="true"><img src={illustrationHref(t.imageKey)} alt="" width="1536" height="1024" loading="lazy" decoding="async"/><span class="topic-number">{String(t.number).padStart(2,'0')}</span></a>
        <div class="topic-card-body"><p class="topic-card-meta">{t.category} <span>·</span> {t.date.slice(8)} September</p><p class="topic-card-rank" data-topic-rank>Overall rank #{t.ranks?.overall ?? '—'} <span>· page {t.number}</span></p><h3><a href={topicHref(t.number)}>{t.title}</a></h3><p class="topic-card-summary">{t.plainSummary}</p><div class="topic-card-footer"><span>Suggested age · {t.ageMin ?? 'context'}+</span><a href={topicHref(t.number)} aria-label={`Read story ${t.number}: ${t.title}`}>Read story <span aria-hidden="true">↗</span></a></div></div>
      </article>)}</div>
      <div id="topic-empty" class="topic-empty" hidden><h3>No stories match yet.</h3><p>Try a different word or reset the filters.</p></div>
    </section>
    <section class="topic-method" aria-labelledby="topic-method-title"><h2 id="topic-method-title">A headline is a starting point.</h2><div class="topic-method-grid"><div><h3>For expository</h3><p>Make a mechanism understandable. Define the important terms, show how the parts connect, and explain what the evidence can establish.</p></div><div><h3>For original oratory</h3><p>Develop your own idea. Use the topic's evidence, test the strongest objection, and keep the conclusion proportionate to what is known.</p></div><div><h3>For careful reading</h3><p>Each page separates the news from its limits. A proposal is not an enacted rule, a forecast is not an outcome, and one case is not proof of a general trend.</p></div></div>
    <details><summary>About this collection and the rankings</summary><p>Ten domain researchers assembled 135 candidates. Review passes covered explanation, original oratory, reasoning and societal impact, age suitability, and evidence. Duplicate reports were consolidated. This is a snapshot through September 14, 2026; a September publication may describe an earlier event, which is identified on the page.</p><p>All 100 stories receive competition-lens scores and ranks for overall potential, expository potential, original-oratory potential, logic and impact, and unusualness and impact. The lenses use coaching judgments, not official tournament rules or predictions of winning. Ties follow the deterministic ordering in the research data; page numbers remain stable.</p><ul class="topic-method-weights" aria-label="Ranking lens weights">{lensWeights.map(lens=><li><strong>{lens.name}</strong><span>{lens.weights}</span></li>)}</ul><p>Age guidance depends on context. Sensitive topics retain older age guidance. Students never need to disclose personal medical, family or traumatic experiences.</p><p>Illustrations are conceptual artwork, not photographs or reconstructions of the reported events. Sources are linked on each page. Some source access could not be repeated; those limits are noted. Publication reports, company claims and preliminary findings remain attributed.</p></details></section>
  </div>
</FlagshipLayout>
<script>
  const form=document.querySelector<HTMLFormElement>('#topic-filters');
  const search=document.querySelector<HTMLInputElement>('#topic-search')!;
  const category=document.querySelector<HTMLSelectElement>('#topic-category')!;
  const age=document.querySelector<HTMLSelectElement>('#topic-age')!;
  const sort=document.querySelector<HTMLSelectElement>('#topic-sort')!;
  const grid=document.querySelector<HTMLElement>('#topic-grid')!;
  const cards=[...document.querySelectorAll<HTMLElement>('[data-topic-card]')];
  function filterTopics(){
    const q=search.value.trim().toLowerCase();
    const rankKey=sort.value==='number'?null:`${sort.value}Rank`;
    const rankLabels={overall:'Overall',expository:'Expository',oratory:'Original-oratory',logic:'Logic & impact',unusual:'Unusualness & impact'} as const;
    const ordered=[...cards].sort((a,b)=>{
      if(!rankKey)return Number(a.dataset.number)-Number(b.dataset.number);
      return Number(a.dataset[rankKey]||999)-Number(b.dataset[rankKey]||999)||Number(a.dataset.number)-Number(b.dataset.number);
    });
    let count=0;
    for(const card of ordered){
      const visible=(!q||card.dataset.search?.includes(q))&&(!category.value||card.dataset.category===category.value)&&Number(card.dataset.age)<=Number(age.value);
      const rank=rankKey?Number(card.dataset[rankKey]||0):0;
      const rankEl=card.querySelector<HTMLElement>('[data-topic-rank]');
      if(rankEl)rankEl.textContent=rankKey?`${rankLabels[sort.value as keyof typeof rankLabels]} rank #${rank||'—'} · page ${card.dataset.number}`:`Page ${card.dataset.number} · ranked story`;
      card.hidden=!visible;if(visible)count++;grid.append(card);
    }
    document.querySelector('#topic-count')!.textContent=`${count} stories · September 1–14`;
    document.querySelector<HTMLElement>('#topic-empty')!.hidden=count!==0;
    document.querySelector('#topic-filter-note')!.textContent=rankKey?`${rankLabels[sort.value as keyof typeof rankLabels]} ranking · lower rank is higher in this library. Page numbers stay stable. Scores are coaching judgments.`:'Chronological page order. Page numbers stay stable; choose a ranking lens to compare stories.';
  }
  form?.addEventListener('submit',event=>event.preventDefault());form?.addEventListener('input',filterTopics);form?.addEventListener('change',filterTopics);form?.addEventListener('reset',()=>setTimeout(filterTopics,0));filterTopics();
</script>

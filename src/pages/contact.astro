---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import { schoolDirections } from "../lib/inquiry.mjs";
---

<FlagshipLayout
  title="Talk with Coach Kai | SpeakKai"
  description="Discuss student coaching, a school program, team training or a keynote with Kai. Prepare a short inquiry and connect directly on WeChat."
  current="contact"
  contactHref="#wechat"
>
  <section class="wrap contact-intro">
    <p class="eyebrow">A conversation is a good beginning</p>
    <h1>What are you<br /><em>working towards?</em></h1>
    <p>
      Tell Kai about your next speaking moment. A few details are enough to
      start.
    </p>
    <a class="text-link" href="#wechat"
      >Message Kai directly on WeChat <span aria-hidden="true">↓</span></a
    >
  </section>
  <div class="wrap inquiry-grid">
    <section class="inquiry-composer" aria-labelledby="compose-title" hidden>
      <p class="eyebrow">01 / Prepare your message</p>
      <h2 id="compose-title">Start with your goal.</h2>
      <p class="inquiry-help">
        Optional prompts to help you get started. Leave anything undecided
        blank.
      </p>
      <fieldset class="inquiry-fields">
        <legend class="sr-only">Your inquiry details</legend>
        <label for="inquiry-audience">Who is this for?</label>
        <select id="inquiry-audience">
          <option value="unsure">I’m exploring / something else</option>
          <option value="coaching">A student or my child</option>
          <option value="schools">A school or education team</option>
          <option value="companies">A company or event team</option>
        </select>
        <div id="school-direction-field" hidden>
          <label for="inquiry-school-direction">Program direction <span>(optional)</span></label>
          <select id="inquiry-school-direction">
            <option value="">Open to advice</option>
            {Object.entries(schoolDirections).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>
        <label for="inquiry-goal">What would you like to work on?</label>
        <textarea
          id="inquiry-goal"
          rows="3"
          maxlength="600"
          autocomplete="off"
          placeholder="For example: explaining ideas clearly in class"
          aria-describedby="details-privacy"></textarea>
        <p class="field-note" id="details-privacy">
          A general description is enough. Leave out student names, private
          records and confidential company information.
        </p>
        <label for="inquiry-group" id="group-label"
          >Who will take part? <span>(optional)</span></label
        >
        <input
          id="inquiry-group"
          type="text"
          maxlength="100"
          autocomplete="off"
          placeholder="Age range or approximate group size"
        />
        <div class="inquiry-field-pair">
          <div>
            <label for="inquiry-format">Delivery preference</label><select
              id="inquiry-format"
              ><option value="">Open to advice</option><option>Online</option
              ><option>In person</option><option>A mix of both</option></select>
          </div>
          <div>
            <label for="inquiry-timing">Timing <span>(optional)</span></label
            ><input
              id="inquiry-timing"
              type="text"
              maxlength="100"
              autocomplete="off"
              placeholder="Month or event deadline"
            />
          </div>
        </div>
      </fieldset>
      <button class="button" id="build-inquiry" type="button"
        >Create a message <span aria-hidden="true">↓</span></button
      >
      <section
        id="inquiry-result"
        class="inquiry-result"
        hidden
        aria-labelledby="preview-title"
      >
        <h3 id="preview-title">Make it yours.</h3>
        <label for="inquiry-preview">Review and edit your message</label>
        <textarea
          id="inquiry-preview"
          rows="9"
          maxlength="2000"
          autocomplete="off"
          aria-describedby="preview-help"></textarea>
        <p class="field-note" id="preview-help">
          Copy this message, then paste it into your WeChat conversation with
          Kai.
        </p>
        <div class="actions">
          <button id="copy-inquiry" class="button" type="button"
            >Copy message</button
          ><a class="text-link" href="#wechat">Find Kai on WeChat ↓</a>
        </div>
      </section>
      <p
        id="inquiry-status"
        class="inquiry-status"
        role="status"
        aria-live="polite"
      >
      </p>
      <p class="field-note">
        The website does not send or save your inquiry. You choose what to share
        in WeChat.
      </p>
    </section>
    <noscript
      ><p class="inquiry-help">
        To start a conversation, message Kai on WeChat with your speaking goal,
        the learner’s age or group size, and any timing preferences.
      </p></noscript
    >
    <aside class="wechat-panel" id="wechat" aria-labelledby="wechat-title">
      <p class="eyebrow">Connect directly</p>
      <h2 id="wechat-title">Say hello to Kai.</h2>
      <p>WeChat: <strong>CKcoachkai</strong></p>
      <a
        class="contact-qr-full"
        href="/images/coach-kai-wechat-qr.png"
        aria-label="Open full-size WeChat QR code"
        ><img
          src="/images/coach-kai-wechat-qr.png"
          width="938"
          height="1340"
          alt="Kai’s complete WeChat contact QR card"
        /></a
      >
      <p class="field-note">
        Scan with WeChat, or open and save the QR image to use from your phone.
        You can also search the handle above.
      </p>
      <p class="field-note">Xiaohongshu: <strong>CKcoachkai</strong></p>
      <div class="contact-next">
        <h3>What happens next</h3><ol>
          <li>Share your situation and goal.</li><li>
            Discuss a suitable approach with Kai.
          </li><li>Agree the scope, fees and schedule before booking.</li>
        </ol><a href="/schedule/" class="text-link"
          >Check the schedule <span aria-hidden="true">↗</span></a
        ><p class="field-note">
          An inquiry does not reserve a time. Kai confirms availability with
          you.
        </p>
      </div>
    </aside>
  </div>
</FlagshipLayout>
<script>
  import {
    normalizeAudience,
    normalizeSchoolDirection,
    buildInquiry,
    copyInquiry,
  } from "../lib/inquiry.mjs";
  const composer = document.querySelector<HTMLElement>(".inquiry-composer")!;
  const audience =
    document.querySelector<HTMLSelectElement>("#inquiry-audience")!;
  const group = document.querySelector<HTMLInputElement>("#inquiry-group")!;
  const goal = document.querySelector<HTMLTextAreaElement>("#inquiry-goal")!;
  const schoolDirection = document.querySelector<HTMLSelectElement>("#inquiry-school-direction")!;
  const preview =
    document.querySelector<HTMLTextAreaElement>("#inquiry-preview")!;
  const status = document.querySelector<HTMLElement>("#inquiry-status")!;
  const copyButton =
    document.querySelector<HTMLButtonElement>("#copy-inquiry")!;
  function updateAudience() {
    const label = document.querySelector<HTMLLabelElement>("#group-label")!;
    const kind = normalizeAudience(audience.value);
    document.querySelector<HTMLElement>("#school-direction-field")!.hidden = kind !== "schools";
    label.textContent =
      kind === "coaching"
        ? "Learner’s age or grade (optional)"
        : "Age range or group size (optional)";
    group.placeholder =
      kind === "coaching"
        ? "For example: Grade 2"
        : "For example: around 20 participants";
    goal.placeholder =
      kind === "coaching"
        ? "For example: explaining ideas clearly in class"
        : kind === "schools"
          ? "For example: a storytelling workshop for Grade 5"
          : kind === "companies"
            ? "For example: clearer client presentations for our team"
            : "What speaking moment would you like help with?";
  }
  audience.value = normalizeAudience(
    new URLSearchParams(window.location.search).get("audience"),
  );
  schoolDirection.value = audience.value === "schools"
    ? normalizeSchoolDirection(new URLSearchParams(window.location.search).get("schoolDirection"))
    : "";
  updateAudience();
  audience.addEventListener("change", updateAudience);
  document.querySelector("#build-inquiry")!.addEventListener("click", () => {
    preview.value = buildInquiry({
      audience: audience.value,
      schoolDirection: schoolDirection.value,
      goal: goal.value,
      group: group.value,
      format:
        document.querySelector<HTMLSelectElement>("#inquiry-format")!.value,
      timing:
        document.querySelector<HTMLInputElement>("#inquiry-timing")!.value,
    });
    document.querySelector<HTMLElement>("#inquiry-result")!.hidden = false;
    document.querySelector<HTMLButtonElement>("#build-inquiry")!.textContent =
      "Rebuild from these details";
    status.textContent =
      "Draft ready. Review it before copying. Rebuilding replaces any edits in the message.";
    preview.focus();
  });
  copyButton.addEventListener("click", async () => {
    copyButton.disabled = true;
    const result = await copyInquiry(preview.value, (text: string) =>
      navigator.clipboard.writeText(text),
    );
    status.textContent = result.message;
    if (!result.ok) {
      preview.focus();
      preview.select();
    }
    copyButton.disabled = false;
  });
  preview.addEventListener("input", () => {
    status.textContent = "Message edited. Copy again to use these changes.";
  });
  document.querySelector(".inquiry-fields")!.addEventListener("input", () => {
    if (!document.querySelector<HTMLElement>("#inquiry-result")!.hidden) {
      status.textContent = "Details changed. Your draft is unchanged. Rebuild to use these details; rebuilding replaces any message edits.";
    }
  });
  composer.hidden = false;
</script>
<style>
  .contact-intro {
    padding-block: 52px 38px;
  }
  .contact-intro .eyebrow {
    color: var(--blue);
  }
  .contact-intro h1 {
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 600;
    margin-top: 18px;
  }
  .contact-intro > p:not(.eyebrow) {
    max-width: 570px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 18px;
  }
  .contact-intro > a {
    margin-top: 18px;
  }
  .inquiry-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: clamp(28px, 6vw, 80px);
    padding-bottom: 76px;
    align-items: start;
  }
  .inquiry-composer {
    border-top: 3px solid var(--blue);
    padding-top: 26px;
  }
  [hidden] {
    display: none !important;
  }
  h2 {
    font-size: 32px;
    font-weight: 600;
    margin-top: 14px;
  }
  .inquiry-help {
    color: var(--muted);
    margin-top: 18px;
  }
  .inquiry-fields {
    border: 0;
    padding: 0;
    margin: 25px 0;
    min-width: 0;
  }
  label {
    display: block;
    font-size: 16px;
    font-weight: 600;
    margin: 22px 0 8px;
  }
  label span {
    font-weight: 400;
    color: var(--muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid #8491a8;
    background: white;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    padding: 12px;
    border-radius: 4px;
  }
  textarea {
    resize: vertical;
  }
  input,
  select {
    min-height: 50px;
  }
  .field-note {
    font-size: 14px;
    color: var(--muted);
    margin-top: 12px;
  }
  .inquiry-field-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  button {
    font-family: inherit;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }
  .inquiry-result {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  h3 {
    font-size: 23px;
    font-weight: 600;
  }
  .inquiry-result .actions {
    margin-top: 18px;
  }
  .inquiry-status {
    margin-top: 18px;
    font-size: 16px;
    font-weight: 600;
  }
  .wechat-panel {
    background: var(--wash);
    border-top: 3px solid var(--yellow);
    padding: 28px;
    scroll-margin-top: 24px;
  }
  .wechat-panel > p:not(.eyebrow) {
    margin-top: 18px;
  }
  .contact-qr-full {
    display: block;
    width: min(100%, 224px);
    margin-top: 22px;
  }
  .contact-qr-full img {
    width: 100%;
    height: auto;
  }
  .contact-next {
    border-top: 1px solid #c6cfde;
    margin-top: 26px;
    padding-top: 26px;
  }
  .contact-next ol {
    padding-left: 22px;
    margin-block: 22px;
  }
  .contact-next li + li {
    margin-top: 14px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 760px) {
    .inquiry-grid {
      grid-template-columns: 1fr;
      gap: 35px;
      padding-bottom: 45px;
    }
    .contact-intro {
      padding-top: 32px;
    }
    .wechat-panel {
      padding: 24px;
    }
  }
  @media (max-width: 430px) {
    .inquiry-field-pair {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  @media print {
    .inquiry-composer {
      display: none;
    }
  }
</style>

---
import ContactStrip from "../components/ContactStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SpatialSiteHeader from "../components/SpatialSiteHeader.astro";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/700.css";
import "@fontsource/space-mono/400.css";

const pageTitle = "Contact Coach Kai | SpeakKai";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Contact Coach Kai on WeChat or Xiaohongshu."
    />
    <link rel="canonical" href="https://speakkai.com/contact/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <style>
      :global(*) { box-sizing: border-box; }

      :global(html),
      :global(body) {
        min-width: 320px;
        min-height: 100%;
        margin: 0;
      }

      :global(body) {
        background: #10224a;
        font-family: "Manrope", Inter, system-ui, sans-serif;
      }

      .site-header {
        display: flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #d5deed;
        background: #fff;
      }

      .site-nav {
        display: flex;
        width: min(100%, 720px);
        align-items: center;
        justify-content: center;
        gap: clamp(18px, 3.5vw, 44px);
      }

      .site-nav a {
        padding: 14px 4px 12px;
        border-bottom: 2px solid transparent;
        color: #294568;
        font-size: 16px;
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
      }

      .site-nav a:hover,
      .site-nav a[aria-current="page"] {
        border-bottom-color: #19a9c5;
        color: #0a5f91;
      }

      .site-nav a:focus-visible {
        border-radius: 3px;
        outline: 3px solid #80d6d1;
        outline-offset: 2px;
      }

      @media (max-width: 640px) {
        .site-header { min-height: 46px; }
        .site-nav { width: 100%; gap: 0; }

        .site-nav a {
          flex: 1 1 16.666%;
          padding: 13px 2px 11px;
          font-size: clamp(10px, 3.2vw, 13px);
          text-align: center;
        }
      }

      .contact-spatial-shell {
        position: relative;
        min-height: calc(100vh - 78px);
        overflow: hidden;
        background: radial-gradient(circle at 72% 38%, #5e88c7 0, #28518d 38%, #10224a 78%);
      }

      .contact-spatial-shell::before,
      .contact-spatial-shell::after {
        position: absolute;
        width: min(72vw, 900px);
        aspect-ratio: 1;
        right: -18%;
        top: -42%;
        border: 1px solid rgb(183 211 255 / 28%);
        border-radius: 50%;
        content: "";
        pointer-events: none;
      }

      .contact-spatial-shell::after { inset: -18% -2% auto auto; width: min(48vw, 620px); }
    </style>
  </head>
  <body>
    <SpatialSiteHeader current="contact" />
    <main class="contact-spatial-shell"><ContactStrip variant="page" /></main>
    <SiteFooter />
  </body>
</html>

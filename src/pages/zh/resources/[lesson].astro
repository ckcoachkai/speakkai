---
import { getCollection } from "astro:content";
import FlagshipPracticePage from "../../../components/FlagshipPracticePage.astro";
import { practiceChinese } from "../../../data/practiceChinese";
import { publishedTranslatedPracticeSlugs } from "../../../lib/practiceAvailability.mjs";
export async function getStaticPaths() {
  const sources = await getCollection("practice", ({data}) => data.published);
  return sources.filter(source => publishedTranslatedPracticeSlugs.includes(source.id)).map(source => ({params:{lesson:source.id},props:{slug:source.id,data:practiceChinese[source.id]}}));
}
const {slug,data} = Astro.props;
---
<FlagshipPracticePage data={data} slug={slug} language="zh-CN" />

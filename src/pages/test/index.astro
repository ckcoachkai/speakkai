---
import ConceptLayout from "../../layouts/ConceptLayout.astro";

const concepts = [
  { id: "1", title: "Executive Editorial", note: "Quiet confidence · premium portrait framing", colors: ["#f3eee5", "#201e1b", "#ae7a43"] },
  { id: "2", title: "Kinetic Creator", note: "YouTube energy · oversized motion graphics", colors: ["#0b0b0d", "#ff3b22", "#ffe600"] },
  { id: "3", title: "Storybook Studio", note: "Kids-friendly · playful illustrated world", colors: ["#fff8dc", "#4f46e5", "#ff6b6b"] },
  { id: "4", title: "Glass Atelier", note: "Luminous blur · luxury digital atmosphere", colors: ["#0a1330", "#5be7ff", "#ad7cff"] },
  { id: "5", title: "Coach Kai Uncut", note: "Vlog documentary · human and immediate", colors: ["#eee8da", "#191919", "#ed4b2f"] },
  { id: "6", title: "Swiss Clarity", note: "Professional grid · evidence first", colors: ["#f4f2ec", "#0d2b52", "#e32636"] },
  { id: "7", title: "Center Stage", note: "Cinematic spotlight · transformation story", colors: ["#04070f", "#104f88", "#f0b84e"] },
  { id: "a", title: "Brave Ideas Club", note: "Cartoon poster · bold classroom energy", colors: ["#fbf52c", "#111111", "#19b394"] },
  { id: "9", title: "Field Notes", note: "Scrapbook collage · warm personal coaching", colors: ["#efe6d2", "#18382c", "#d2673c"] },
  { id: "10", title: "Signal / Influence", note: "Futurist interface · expanding impact", colors: ["#020617", "#15f4c0", "#6889ff"] },
];
---

<ConceptLayout
  title="Test — The Influence Loop"
  description="An interactive SpeakKai homepage concept inspired by the Speak, Connect, Influence, Build, Reputation sketch."
  current="test"
  themeColor="#07142f"
>
  <main class="lab-page">
    <header class="lab-nav">
      <a class="brand" href="/"><span>说开</span> SpeakKai</a>
      <p>Homepage exploration · 2026</p>
      <a class="return-link" href="/">Current site ↗</a>
    </header>

    <section class="orbit-hero">
      <div class="hero-copy">
        <p class="kicker">Test · Foundational concept</p>
        <h1>One voice.<br /><em>Expanding influence.</em></h1>
        <p class="summary">
          Communication is not a single performance. It is a ripple: learn to speak,
          connect with people, influence ideas, build momentum, and earn a reputation.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href="/contact/">Start the conversation</a>
          <a class="text-action" href="#concepts">Explore 10 directions ↓</a>
        </div>
      </div>

      <div class="orbit-stage" aria-label="SpeakKai influence journey: Speak, Connect, Influence, Build, Reputation">
        <div class="halo halo-five"><span>Reputation</span></div>
        <div class="halo halo-four"><span>Build</span></div>
        <div class="halo halo-three"><span>Influence</span></div>
        <div class="halo halo-two"><span>Connect</span></div>
        <div class="halo halo-one"><span>Speak</span></div>
        <div class="portrait-orb">
          <img src="/images/coach-kai-headshot.webp" alt="Coach Kai" />
          <b>SK</b>
        </div>
        <i class="spark spark-one"></i><i class="spark spark-two"></i><i class="spark spark-three"></i>
      </div>
    </section>

    <section class="idea-section">
      <div class="idea-photo-wrap">
        <img src="/images/concepts/speakkai-influence-sketch.png" loading="lazy" decoding="async" alt="A cleaned visual interpretation of Kai's original concentric website design sketch" />
        <div class="sketch-labels" aria-hidden="true"><span>Speak</span><span>Connect</span><span>Influence</span><span>Build</span><span>Reputation</span></div>
        <b>01 · Original thought</b>
      </div>
      <div class="idea-copy">
        <p class="kicker">From a hand-drawn map</p>
        <h2>The homepage becomes a journey, not a brochure.</h2>
        <p>
          The circles in the sketch become stages of growth. On screen they create depth,
          motion, navigation, and a story about what communication coaching makes possible.
        </p>
        <ul>
          <li><b>Speak</b><span>Find clarity and control.</span></li>
          <li><b>Connect</b><span>Make the audience feel included.</span></li>
          <li><b>Influence</b><span>Move thinking and action.</span></li>
          <li><b>Build</b><span>Turn skill into repeated results.</span></li>
          <li><b>Reputation</b><span>Become known for how you communicate.</span></li>
        </ul>
      </div>
    </section>

    <section class="concept-gallery" id="concepts">
      <div class="gallery-heading">
        <p class="kicker">Ten radically different art directions</p>
        <h2>Same coach. Different first impression.</h2>
        <p>Each page changes framing, visual rhythm, image treatment, and personality—not only the palette.</p>
      </div>
      <div class="concept-grid">
        {concepts.map((concept, index) => (
          <a class="concept-card" href={`/test${concept.id}/`} style={`--c1:${concept.colors[0]};--c2:${concept.colors[1]};--c3:${concept.colors[2]}`}>
            <div class="card-visual">
              <span class="shape shape-a"></span><span class="shape shape-b"></span>
              <img src="/images/coach-kai-headshot.webp" alt="" loading="lazy" />
              <b>{String(index + 1).padStart(2, "0")}</b>
            </div>
            <div class="card-copy"><strong>{concept.title}</strong><span>{concept.note}</span></div>
            <i>Open concept ↗</i>
          </a>
        ))}
      </div>
    </section>

    <section class="lab-footer">
      <p>Speak clearly. Connect deeply. Influence meaningfully.</p>
      <a href="/contact/">Build your voice with Coach Kai ↗</a>
    </section>
  </main>

  <style>
    .lab-page { overflow: hidden; padding-bottom: 94px; color: #eaf2ff; background: #07142f; }
    .lab-nav { position: relative; z-index: 20; display: grid; grid-template-columns: 1fr auto 1fr; width: min(100% - 48px, 1400px); min-height: 76px; align-items: center; margin: 0 auto; border-bottom: 1px solid rgb(255 255 255 / 13%); }
    .brand { display: inline-flex; width: fit-content; align-items: center; gap: 10px; color: #fff; font-size: 16px; font-weight: 950; text-decoration: none; }
    .brand span { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 50%; color: #07142f; background: #ffd32a; font-size: 12px; }
    .lab-nav p { margin: 0; color: #90a4c2; font-size: 11px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
    .return-link { justify-self: end; color: #cad8ed; font-size: 13px; font-weight: 750; text-decoration: none; }
    .orbit-hero { position: relative; display: grid; grid-template-columns: minmax(0, .78fr) minmax(520px, 1.22fr); min-height: 820px; align-items: center; gap: 20px; width: min(100% - 48px, 1400px); margin: 0 auto; }
    .orbit-hero::before { position: absolute; top: 12%; left: 25%; width: 700px; height: 700px; border-radius: 50%; background: #0969d6; filter: blur(180px); content: ""; opacity: .15; }
    .hero-copy { position: relative; z-index: 4; padding-left: clamp(0px, 3vw, 50px); }
    .kicker { margin: 0 0 16px; color: #5bd7ff; font-size: 11px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
    h1, h2 { margin: 0; letter-spacing: -.055em; }
    h1 { max-width: 650px; font-size: clamp(56px, 7.2vw, 108px); line-height: .86; }
    h1 em { color: #ffd32a; font-family: Georgia, serif; font-weight: 400; }
    .summary { max-width: 580px; margin: 30px 0 0; color: #b2c2d9; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.65; }
    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 34px; }
    .primary-action { display: inline-flex; min-height: 52px; align-items: center; padding: 12px 21px; border-radius: 99px; color: #07142f; background: #ffd32a; font-weight: 900; text-decoration: none; }
    .text-action { color: #fff; font-size: 14px; font-weight: 800; text-decoration-thickness: 1px; text-underline-offset: 5px; }
    .orbit-stage { position: relative; width: min(64vw, 760px); aspect-ratio: 1; justify-self: end; }
    .halo { position: absolute; top: 50%; left: 50%; border: 1px solid rgb(127 201 255 / 27%); border-radius: 50%; transform: translate(-50%, -50%); box-shadow: inset 0 0 45px rgb(25 117 223 / 5%); animation: breathe 6s ease-in-out infinite; }
    .halo::after { position: absolute; top: -4px; left: 50%; width: 8px; height: 8px; border-radius: 50%; background: #64ddff; box-shadow: 0 0 18px #64ddff; content: ""; }
    .halo span { position: absolute; top: 8%; left: 50%; padding: 5px 10px; border-radius: 99px; color: #d9ecff; background: #07142f; font-size: 10px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; transform: translateX(-50%); }
    .halo-five { width: 100%; height: 100%; }.halo-four { width: 80%; height: 80%; animation-delay: -.7s; }.halo-three { width: 61%; height: 61%; animation-delay: -1.4s; }.halo-two { width: 43%; height: 43%; animation-delay: -2.1s; }.halo-one { width: 27%; height: 27%; animation-delay: -2.8s; }
    .portrait-orb { position: absolute; z-index: 2; top: 50%; left: 50%; width: 19%; aspect-ratio: 1; overflow: hidden; border: 4px solid #ffd32a; border-radius: 50%; background: #0c2d5e; transform: translate(-50%, -50%); box-shadow: 0 20px 65px rgb(0 0 0 / 50%); }
    .portrait-orb img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
    .portrait-orb b { position: absolute; right: 8px; bottom: 8px; display: grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; color: #07142f; background: #ffd32a; font-size: 9px; }
    .spark { position: absolute; z-index: 3; width: 11px; height: 11px; border-radius: 50%; background: #ffd32a; box-shadow: 0 0 25px #ffd32a; }.spark-one { top: 15%; left: 13%; }.spark-two { right: 8%; bottom: 26%; background: #58dcff; }.spark-three { right: 32%; bottom: 5%; width: 6px; height: 6px; }
    .idea-section { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(360px, .9fr); gap: clamp(40px, 8vw, 120px); width: min(100% - 48px, 1260px); align-items: center; margin: 0 auto; padding: 130px 0; }
    .idea-photo-wrap { position: relative; transform: rotate(-2.5deg); }
    .idea-photo-wrap::before { position: absolute; inset: -18px; border: 1px solid rgb(255 255 255 / 14%); border-radius: 7px; content: ""; transform: rotate(4deg); }
    .idea-photo-wrap > img { display: block; width: 100%; max-height: 720px; object-fit: cover; border-radius: 5px; box-shadow: 0 45px 100px rgb(0 0 0 / 48%); filter: saturate(.7) contrast(1.08); }
    .idea-photo-wrap > b { position: absolute; right: -28px; bottom: 32px; padding: 10px 14px; color: #07142f; background: #ffd32a; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
    .sketch-labels { position: absolute; inset: 0; display: grid; place-content: center; gap: 6px; color: #1c2430; text-align: center; pointer-events: none; }
    .sketch-labels span { padding: 3px 8px; border-radius: 99px; background: rgb(255 255 255 / 55%); font: italic 13px Georgia; }
    .idea-copy h2, .gallery-heading h2 { font-size: clamp(42px, 5vw, 72px); line-height: .98; }
    .idea-copy > p:not(.kicker), .gallery-heading > p:last-child { color: #aebfd8; font-size: 17px; line-height: 1.7; }
    .idea-copy ul { margin: 30px 0 0; padding: 0; list-style: none; border-top: 1px solid rgb(255 255 255 / 14%); }
    .idea-copy li { display: grid; grid-template-columns: 115px 1fr; gap: 18px; padding: 15px 0; border-bottom: 1px solid rgb(255 255 255 / 14%); }
    .idea-copy li b { color: #ffd32a; }.idea-copy li span { color: #c2cee0; }
    .concept-gallery { width: min(100% - 48px, 1400px); margin: 0 auto; padding: 80px 0 130px; }
    .gallery-heading { display: grid; grid-template-columns: 1fr 1fr; column-gap: 60px; align-items: end; margin-bottom: 54px; }
    .gallery-heading .kicker { grid-column: 1 / -1; }.gallery-heading > p:last-child { margin: 0; }
    .concept-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
    .concept-card { position: relative; display: grid; grid-template-columns: 44% 1fr auto; min-height: 260px; overflow: hidden; border: 1px solid rgb(255 255 255 / 12%); border-radius: 24px; color: #fff; background: #0a1a39; text-decoration: none; transition: transform .35s ease, border-color .35s ease; }
    .concept-card:hover { border-color: rgb(255 211 42 / 65%); transform: translateY(-6px); }
    .card-visual { position: relative; overflow: hidden; background: var(--c1); }
    .card-visual img { position: absolute; z-index: 2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
    .card-visual b { position: absolute; z-index: 4; top: 18px; left: 18px; color: var(--c3); font-size: 46px; letter-spacing: -.07em; }
    .shape { position: absolute; z-index: 3; display: block; border-radius: 50%; background: var(--c3); mix-blend-mode: difference; }.shape-a { right: -25px; bottom: -35px; width: 130px; height: 130px; }.shape-b { top: 30px; right: 20px; width: 22px; height: 22px; }
    .card-copy { align-self: center; padding: 28px; }.card-copy strong { display: block; font-size: clamp(23px, 2vw, 32px); }.card-copy span { display: block; margin-top: 10px; color: #9db0ca; font-size: 13px; line-height: 1.5; }
    .concept-card > i { align-self: end; padding: 24px; color: #ffd32a; font-size: 11px; font-style: normal; font-weight: 900; white-space: nowrap; }
    .lab-footer { display: flex; width: min(100% - 48px, 1400px); align-items: center; justify-content: space-between; margin: 0 auto; padding: 50px 0 80px; border-top: 1px solid rgb(255 255 255 / 14%); }.lab-footer p { margin: 0; font-family: Georgia, serif; font-size: clamp(28px, 4vw, 50px); }.lab-footer a { color: #ffd32a; font-weight: 850; text-decoration: none; }
    @keyframes breathe { 50% { border-color: rgb(255 211 42 / 40%); transform: translate(-50%, -50%) scale(1.018); } }
    @media (max-width: 980px) {
      .orbit-hero { grid-template-columns: 1fr; padding: 90px 0; }.orbit-stage { width: min(92vw, 700px); justify-self: center; }.idea-section { grid-template-columns: 1fr; }.idea-photo-wrap { max-width: 700px; }.gallery-heading { display: block; }.gallery-heading > p:last-child { margin-top: 20px; }.concept-card { grid-template-columns: 40% 1fr; }.concept-card > i { display: none; }
    }
    @media (max-width: 680px) {
      .lab-page { padding-bottom: 82px; }.lab-nav { grid-template-columns: 1fr auto; width: min(100% - 28px, 620px); }.lab-nav p { display: none; }.orbit-hero, .idea-section, .concept-gallery, .lab-footer { width: min(100% - 28px, 620px); }.orbit-hero { min-height: 0; padding: 70px 0 100px; }.orbit-stage { width: 108vw; margin-left: -8vw; }.summary { font-size: 16px; }.idea-section { padding: 70px 0 90px; }.idea-photo-wrap > b { right: -4px; }.concept-grid { grid-template-columns: 1fr; }.concept-card { grid-template-columns: 42% 1fr; min-height: 200px; border-radius: 18px; }.card-copy { padding: 20px; }.lab-footer { align-items: flex-start; flex-direction: column; gap: 28px; }.hero-actions { align-items: flex-start; flex-direction: column; }
    }
  </style>
</ConceptLayout>

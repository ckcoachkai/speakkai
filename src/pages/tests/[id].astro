---
import ExperimentShell from "../../components/experiments-v4/ExperimentShell.astro";
import { activeExperimentsV4 } from "../../data/experimentLabV4";

export function getStaticPaths() {
  return activeExperimentsV4.map((experiment) => ({
    params: { id: String(experiment.number) },
    props: { experiment },
  }));
}

const { experiment } = Astro.props;
---

<ExperimentShell experiment={experiment} />

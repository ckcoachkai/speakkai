---
import { experimentsV4 } from "../../data/experimentLabV4";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/700.css";
import "@fontsource/archivo-black/400.css";
import "@fontsource/space-mono/400.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Compare four selected SpeakKai homepage directions." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Four Homepage Directions | SpeakKai</title>
    <style>
      :root { --navy:#0b1020; --blue:#2563eb; --yellow:#ffcc00; --paper:#f4f2ea; --ink:#10243a; }
      * { box-sizing:border-box; }
      body { margin:0; min-height:100vh; background:var(--paper); color:var(--ink); font-family:"Manrope",system-ui,sans-serif; }
      a { color:inherit; }
      .mast { min-height:34vh; padding:clamp(28px,5vw,76px); display:grid; grid-template-columns:1.25fr .75fr; gap:32px; align-items:end; background:var(--navy); color:white; overflow:hidden; position:relative; }
      .mast::after { content:"4"; position:absolute; right:1vw; top:-7vw; font:clamp(15rem,31vw,31rem)/.8 "Archivo Black",sans-serif; color:rgba(37,99,235,.2); letter-spacing:-.09em; }
      .mast-copy,.mast-note { position:relative; z-index:1; }
      .eyebrow { margin:0 0 14px; color:var(--yellow); font:11px "Space Mono",monospace; letter-spacing:.13em; text-transform:uppercase; }
      h1 { margin:0; max-width:12ch; font:clamp(3rem,6.5vw,7.4rem)/.84 "Archivo Black",sans-serif; letter-spacing:-.065em; text-transform:uppercase; }
      .mast-copy>p:last-child { max-width:62ch; color:#bdc9d9; line-height:1.6; }
      .mast-note { max-width:34rem; padding:22px; border:1px solid #53617a; background:rgba(12,21,43,.82); }
      .mast-note strong { display:block; color:var(--yellow); font:11px "Space Mono",monospace; text-transform:uppercase; }
      .mast-note p { margin-bottom:0; color:#cbd5e3; line-height:1.55; }
      main { padding:clamp(26px,4vw,64px); }
      .section-head { margin:0 0 22px; display:flex; align-items:end; justify-content:space-between; gap:18px; }
      .section-head h2 { margin:0; font:clamp(2rem,4vw,4.5rem)/.9 "Archivo Black",sans-serif; text-transform:uppercase; }
      .section-head p { max-width:50ch; margin:0; color:#5e6d7a; line-height:1.5; }
      .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
      .card { min-width:0; min-height:390px; display:grid; grid-template-columns:minmax(180px,38%) 1fr; border:1px solid #aeb8bf; background:white; text-decoration:none; overflow:hidden; transition:transform .2s ease,box-shadow .2s ease; }
      .card:hover,.card:focus-visible { transform:translateY(-4px); box-shadow:0 20px 45px rgba(17,37,56,.14); }
      .preview { position:relative; overflow:hidden; background:var(--navy); }
      .preview img { width:100%; height:100%; object-fit:cover; object-position:50% 24%; filter:saturate(.8) contrast(1.03); }
      .preview::after { content:attr(data-version); position:absolute; left:14px; bottom:2px; font:clamp(5rem,9vw,9rem)/.75 "Archivo Black",sans-serif; color:var(--yellow); letter-spacing:-.08em; text-shadow:0 4px 22px rgba(11,16,32,.45); }
      .card:nth-child(2) .preview { background:#07111f; }
      .card:nth-child(3) .preview { background:linear-gradient(150deg,#10223f,#3158a2); }
      .card:nth-child(3) .preview img { clip-path:circle(45% at 52% 48%); }
      .card:nth-child(4) .preview img { transform:perspective(700px) rotateY(-8deg) scale(.94); }
      .card-body { padding:clamp(20px,2.5vw,34px); display:flex; flex-direction:column; }
      .version { margin:0 0 14px; color:#2563eb; font:10px "Space Mono",monospace; letter-spacing:.12em; text-transform:uppercase; }
      .card h3 { margin:0; font-size:clamp(1.7rem,2.8vw,3rem); line-height:.98; letter-spacing:-.045em; }
      .audience { margin:14px 0 0; font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.08em; }
      .hypothesis { color:#5c6b78; font-size:13px; line-height:1.55; }
      .open { margin-top:auto; display:flex; justify-content:space-between; align-items:center; gap:12px; padding-top:18px; border-top:1px solid #d5dade; font-size:11px; font-weight:800; }
      .open span:last-child { color:#6b7782; font:9px "Space Mono",monospace; text-transform:uppercase; }
      :focus-visible { outline:3px solid #e3ad00; outline-offset:3px; }
      @media(max-width:900px){ .mast{grid-template-columns:1fr;min-height:auto}.grid{grid-template-columns:1fr}.card{min-height:360px} }
      @media(max-width:560px){ .card{grid-template-columns:1fr;grid-template-rows:220px 1fr}.section-head{align-items:start;flex-direction:column}.mast::after{opacity:.55} }
      @media(prefers-reduced-motion:reduce){*{transition:none!important}}
    </style>
  </head>
  <body>
    <header class="mast">
      <div class="mast-copy">
        <p class="eyebrow">SpeakKai Homepage Shortlist</p>
        <h1>Four directions. One final homepage.</h1>
        <p>These are the four selected designs. Open each version, compare the experience, and refine the strongest ideas into the final SpeakKai homepage.</p>
      </div>
      <aside class="mast-note">
        <strong>Current stage</strong>
        <p>The broad experiment phase is finished. Versions 1–4 are now the only active homepage directions in this lab.</p>
      </aside>
    </header>
    <main>
      <header class="section-head">
        <h2>Versions 1–4</h2>
        <p>Each direction keeps a different strength: warmth, cinematic personality, spatial clarity, or structured program exploration.</p>
      </header>
      <section class="grid" aria-label="Selected SpeakKai homepage directions">
        {experimentsV4.map((experiment) => (
          <a class="card" href={`/tests/${experiment.number}/`}>
            <div class="preview" data-version={experiment.number}>
              <img src="/images/coach-kai-headshot.webp" width="1400" height="1400" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="card-body">
              <p class="version">Version {experiment.number}</p>
              <h3>{experiment.title}</h3>
              <p class="audience">For {experiment.primaryStakeholder}</p>
              <p class="hypothesis">{experiment.hypothesis}</p>
              <div class="open"><span>Open Version {experiment.number} →</span><span>Single screen</span></div>
            </div>
          </a>
        ))}
      </section>
    </main>
  </body>
</html>

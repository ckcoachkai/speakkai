---
import { experimentsV4, version3Variants } from "../../data/experimentLabV4";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/700.css";
import "@fontsource/archivo-black/400.css";
import "@fontsource/space-mono/400.css";

const originals = experimentsV4.map((item) => ({ number: item.number, title: item.title, audience: item.primaryStakeholder, note: item.hypothesis, stage: "Original reference", parent: null, theme: ["atelier", "cinematic", "glass", "architecture"][item.number - 1] }));
const refinements = version3Variants.map((item) => ({ number: item.number, title: item.title, audience: item.primaryStakeholder, note: item.hypothesis, stage: "Version 3 refinement", parent: 3, theme: `glass-${item.number}` }));
const groups = [
  { eyebrow: "Reference set", title: "Versions 1–4", copy: "The four selected homepage directions remain available as references. Each includes a built-in mobile preview.", items: originals },
  { eyebrow: "Version 3 refinement lab", title: "Versions 5–14", copy: "Ten controlled variations of Version 3. They preserve its spatial layout and three-part rotation while testing color temperature, contrast, framing, and typography. Versions 7–9 use Version 1's palette most directly.", items: refinements },
];
---

<!doctype html><html lang="en"><head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><meta name="description" content="Compare SpeakKai homepage references and ten controlled refinements of Version 3."/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>Homepage Evolution Lab | SpeakKai</title>
  <style>
    :root{--navy:#0b1020;--blue:#2563eb;--yellow:#ffcc00;--paper:#f3f5f8;--ink:#10243a}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--paper);font-family:"Manrope",system-ui,sans-serif}a{color:inherit}.mast{min-height:48vh;display:grid;grid-template-columns:1.15fr .85fr;align-items:end;gap:42px;padding:clamp(38px,6vw,100px);color:white;background:radial-gradient(circle at 82% 18%,#264d9a 0,transparent 30%),var(--navy);overflow:hidden}.eyebrow{margin:0 0 14px;color:var(--yellow);font:10px "Space Mono",monospace;letter-spacing:.13em;text-transform:uppercase}h1{max-width:11ch;margin:0;font:clamp(3.8rem,7.5vw,9rem)/.84 "Archivo Black",sans-serif;letter-spacing:-.07em;text-transform:uppercase}.mast p:last-child{max-width:54ch;color:#bbc7d8;line-height:1.65}.map{display:grid;grid-template-columns:repeat(2,1fr);align-items:center}.map div{min-height:120px;padding:20px;border:1px solid #4c5d79}.map b{display:block;color:var(--yellow);font:clamp(1.6rem,3vw,3rem) "Archivo Black",sans-serif}.map span{color:#bac7da;font-size:11px}.map i{display:block;margin-top:10px;color:#75869f;font:9px "Space Mono",monospace}.catalog{padding:clamp(44px,6vw,92px)}.group{margin-bottom:clamp(64px,8vw,118px)}.group-head{display:grid;grid-template-columns:.8fr 1.2fr;align-items:end;gap:30px;margin-bottom:26px}.group-head h2{margin:0;font:clamp(2.4rem,5vw,5.4rem)/.9 "Archivo Black",sans-serif;letter-spacing:-.05em;text-transform:uppercase}.group-head>p{max-width:62ch;margin:0;color:#5f6d7c;line-height:1.6}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.card{min-height:400px;display:flex;flex-direction:column;border:1px solid #b9c3cf;background:white;text-decoration:none;overflow:hidden;transition:translate .18s ease,box-shadow .18s ease}.card:hover,.card:focus-visible{translate:0 -4px;box-shadow:0 22px 50px rgba(22,38,58,.14)}.preview{position:relative;height:180px;background:#ece5d7;overflow:hidden}.card[data-theme="cinematic"] .preview{background:#060a12}.card[data-theme="glass"] .preview{background:#173b81}.card[data-theme="architecture"] .preview{background:#dfeaf2}.card[data-theme="glass-5"] .preview{background:#28599f}.card[data-theme="glass-6"] .preview{background:#07142e}.card[data-theme="glass-7"] .preview{background:#e9dac0}.card[data-theme="glass-8"] .preview{background:#f4ead8}.card[data-theme="glass-9"] .preview{background:linear-gradient(135deg,#f2eadb 0 58%,#ffcc00 58%)}.card[data-theme="glass-10"] .preview{background:#3b9ec9}.card[data-theme="glass-11"] .preview{background:#0b1020}.card[data-theme="glass-12"] .preview{background:#d8eafd}.card[data-theme="glass-13"] .preview{background:linear-gradient(135deg,#14264f 0 66%,#f7f8fa 66%)}.card[data-theme="glass-14"] .preview{background:#2563eb}.preview img{width:100%;height:100%;object-fit:contain;object-position:70% 28%;filter:saturate(.78)}.preview b{position:absolute;left:12px;bottom:-13px;color:var(--yellow);font:clamp(5rem,8vw,8rem)/.8 "Archivo Black",sans-serif;letter-spacing:-.08em;text-shadow:0 4px 20px rgba(11,16,32,.35)}.card[data-theme="glass-7"] .preview b,.card[data-theme="glass-8"] .preview b{color:#273d5b}.body{flex:1;display:flex;flex-direction:column;padding:22px}.stage{margin:0 0 11px;color:var(--blue);font:9px "Space Mono",monospace;letter-spacing:.1em;text-transform:uppercase}.body h3{margin:0;font-size:1.6rem;line-height:.98;letter-spacing:-.045em}.audience{font-size:10px;font-weight:800;text-transform:uppercase}.note{color:#637180;font-size:12px;line-height:1.55}.open{margin-top:auto;padding-top:15px;border-top:1px solid #d6dce3;font-size:11px;font-weight:800}.open small{display:block;margin-top:4px;color:#7b8792;font:9px "Space Mono",monospace}footer{padding:30px;text-align:center;color:#95a2b4;background:var(--navy);font-size:11px}:focus-visible{outline:3px solid #dba900;outline-offset:3px}@media(max-width:1100px){.grid{grid-template-columns:repeat(2,1fr)}.mast{grid-template-columns:1fr}.map{max-width:680px}}@media(max-width:650px){.mast,.catalog{padding:36px 18px}.group-head{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.card{min-height:360px}.map{grid-template-columns:1fr}.map div{min-height:0}.preview{height:220px}}
  </style>
</head><body>
  <header class="mast"><div><p class="eyebrow">SpeakKai Homepage Evolution Lab</p><h1>Version 3, refined ten ways.</h1><p>Keep Versions 1–4 as references, then compare ten controlled adjustments to the spatial glass direction. Every page includes a mobile preview.</p></div><div class="map" aria-label="Active design set"><div><b>1–4</b><span>Reference directions</span><i>Preserved for comparison</i></div><div><b>5–14</b><span>Version 3 refinements</span><i>Desktop + mobile preview</i></div></div></header>
  <main class="catalog">{groups.map((group) => <section class="group"><header class="group-head"><div><p class="eyebrow">{group.eyebrow}</p><h2>{group.title}</h2></div><p>{group.copy}</p></header><div class="grid">{group.items.map((item) => <a class="card" data-theme={item.theme} href={`/tests/${item.number}/`}><div class="preview"><img src="/images/coach-kai-headshot.webp" width="1400" height="1400" alt="" loading="lazy" decoding="async"/><b>{item.number}</b></div><div class="body"><p class="stage">{item.stage}</p><h3>{item.title}</h3><p class="audience">For {item.audience}</p><p class="note">{item.note}</p><div class="open">Open Version {item.number} →{item.parent && <small>Based on Version {item.parent}</small>}</div></div></a>)}</div></section>)}</main>
  <footer>SpeakKai design lab · experiments are noindex and separate from the public homepage</footer>
</body></html>

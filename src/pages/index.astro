---
import HomepageV5 from "../components/HomepageV5.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import "../styles/experiment-lab-v4.css";

const title = "SpeakKai | Speech, Debate and Communication Coaching";
const description = "Speech, debate, storytelling, presentation, and communication coaching for students and professionals in Shanghai and online.";
const canonical = "https://speakkai.com/";
const socialImage = "https://speakkai.com/images/coach-kai-headshot.webp";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10224A" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SpeakKai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="v4-page v4-family-modern v4-version-5 v4-source-41 production-home">
    <header class="production-header">
      <a class="production-brand" href="/" aria-label="SpeakKai home">SpeakKai</a>
      <SiteNavigation current="home" compact />
    </header>
    <main class="v4-main production-main">
      <HomepageV5 />
    </main>
  </body>
</html>

<style is:global>
  .production-header {
    position: relative;
    z-index: 100;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    height: 52px;
    align-items: center;
    gap: clamp(18px, 3vw, 48px);
    padding: 0 clamp(16px, 2.2vw, 38px);
    border-bottom: 1px solid rgba(14, 31, 50, .14);
    background: rgba(248, 250, 252, .98);
  }

  .production-brand {
    color: #10224a;
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -.035em;
    text-decoration: none;
  }

  .production-header .site-nav { justify-self: end; }
  .production-v5 { height: 100%; }

  @media (max-width: 900px) {
    .production-header {
      position: sticky;
      top: 0;
      height: 56px;
      grid-template-columns: 1fr;
      padding: 0 8px;
    }

    .production-brand { display: none; }
    .production-header .site-nav { justify-self: stretch; }
  }
</style>

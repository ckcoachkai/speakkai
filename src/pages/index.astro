---
import ContactStrip from "../components/ContactStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Speech, debate, storytelling, and presentation coaching for students and professionals in Shanghai and online."
    />
    <meta name="theme-color" content="#07142f" />
    <title>SpeakKai | Speech, Debate and Communication Coaching</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        background: #f5f7fa;
        color: #071b3d;
      }

      * { box-sizing: border-box; }

      html {
        min-width: 320px;
        min-height: 100%;
        scroll-behavior: smooth;
      }

      body {
        min-height: 100%;
        margin: 0;
        background: #f5f7fa;
      }

      main { min-height: 100vh; }

      .coach-banner {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 1;
        overflow: hidden;
        background: #020b20;
      }

      .coach-banner picture,
      .coach-banner img {
        display: block;
        width: 100%;
        height: 100%;
      }

      .coach-banner img { object-fit: contain; }

      .site-header {
        display: flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #d5deed;
        background: #fff;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: clamp(64px, 9vw, 108px) 0;
        background:
          radial-gradient(circle at 85% 20%, rgb(36 118 214 / 14%), transparent 32%),
          linear-gradient(145deg, #ffffff 0%, #f2f7fd 58%, #e8f2fc 100%);
      }

      .hero::after {
        position: absolute;
        right: -110px;
        bottom: -190px;
        width: 420px;
        height: 420px;
        border: 1px solid rgb(11 95 199 / 16%);
        border-radius: 50%;
        box-shadow: 0 0 0 52px rgb(11 95 199 / 4%), 0 0 0 104px rgb(11 95 199 / 3%);
        content: "";
        pointer-events: none;
      }

      .hero-inner,
      .section-inner {
        position: relative;
        z-index: 1;
        width: min(100% - 40px, 1120px);
        margin: 0 auto;
      }

      .hero-inner { max-width: 980px; }

      .eyebrow {
        margin: 0 0 14px;
        color: #087c98;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3 { color: #10284d; letter-spacing: -0.025em; }

      h1 {
        max-width: 900px;
        margin: 0;
        font-size: clamp(44px, 7vw, 78px);
        line-height: 0.98;
      }

      .hero-summary {
        max-width: 760px;
        margin: 26px 0 0;
        color: #42546b;
        font-size: clamp(18px, 2.2vw, 23px);
        line-height: 1.55;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 34px;
      }

      .button {
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        padding: 13px 20px;
        border: 2px solid #0b5fc7;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 850;
        text-decoration: none;
        transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
      }

      .button-primary { color: #fff; background: #0b5fc7; }
      .button-primary:hover { border-color: #074a9f; background: #074a9f; transform: translateY(-2px); }
      .button-secondary { color: #0b5fc7; background: #fff; }
      .button-secondary:hover { color: #074a9f; border-color: #074a9f; transform: translateY(-2px); }
      .button:focus-visible { outline: 3px solid #ffbf47; outline-offset: 3px; }

      .audience-note {
        margin: 22px 0 0;
        color: #5e6e83;
        font-size: 14px;
        font-weight: 700;
      }

      .proof-strip {
        border-top: 1px solid #c7d4e5;
        border-bottom: 1px solid #c7d4e5;
        background: #fff;
      }

      .proof-list {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        width: min(100%, 1120px);
        margin: 0 auto;
      }

      .proof-list div { padding: 24px clamp(18px, 3vw, 34px); }
      .proof-list div + div { border-left: 1px solid #d5deed; }

      .proof-list dt {
        color: #0b5fc7;
        font-size: clamp(25px, 3.6vw, 35px);
        font-weight: 900;
        line-height: 1;
      }

      .proof-list dd {
        margin: 7px 0 0;
        color: #52647b;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.45;
      }

      .coaching,
      .process,
      .resource-callout { scroll-margin-top: 54px; }

      .coaching { padding: clamp(62px, 8vw, 96px) 0; background: #f5f7fa; }
      .process { padding: clamp(62px, 8vw, 96px) 0; background: #0b1831; }

      .section-heading { max-width: 760px; }
      .section-heading h2 { margin: 0; font-size: clamp(34px, 5vw, 52px); line-height: 1.08; }
      .section-heading > p:last-child { margin: 17px 0 0; color: #5b6b80; font-size: 17px; line-height: 1.7; }

      .audience-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-top: 42px;
      }

      .audience-card {
        display: flex;
        min-height: 310px;
        flex-direction: column;
        padding: 28px;
        border: 1px solid #cbd7e7;
        border-radius: 9px;
        background: #fff;
        box-shadow: 0 16px 38px rgb(27 57 91 / 9%);
      }

      .card-number {
        display: inline-grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border-radius: 50%;
        color: #fff;
        background: #0b5fc7;
        font-size: 13px;
        font-weight: 900;
      }

      .audience-card h3 { margin: 22px 0 0; font-size: 25px; line-height: 1.15; }
      .audience-card p { margin: 15px 0 0; color: #5b6b80; font-size: 15px; line-height: 1.65; }

      .text-link {
        display: inline-flex;
        width: fit-content;
        margin-top: auto;
        padding-top: 24px;
        color: #0b5fc7;
        font-weight: 850;
        text-underline-offset: 4px;
      }

      .text-link:hover { color: #074a9f; }
      .text-link:focus-visible { border-radius: 3px; outline: 3px solid #80d6d1; outline-offset: 3px; }

      .process .eyebrow { color: #67d2e7; }
      .process .section-heading h2 { color: #fff; }
      .process .section-heading > p:last-child { color: #b8c7dc; }

      .process-list {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1px;
        margin: 42px 0 0;
        padding: 0;
        list-style: none;
        background: #2a405f;
      }

      .process-list li {
        min-height: 190px;
        padding: 25px 21px;
        background: #102442;
      }

      .step-number { color: #ffcc00; font-size: 13px; font-weight: 900; }
      .process-list strong { display: block; margin-top: 28px; color: #fff; font-size: 19px; }
      .process-list p { margin: 10px 0 0; color: #b8c7dc; font-size: 14px; line-height: 1.55; }

      .resource-callout { padding: clamp(56px, 7vw, 82px) 0; background: #fff; }
      .resource-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 28px;
        padding: clamp(30px, 5vw, 54px);
        border: 1px solid #c5d5e8;
        border-radius: 10px;
        background: #edf5fe;
      }

      .resource-panel h2 { margin: 0; font-size: clamp(29px, 4vw, 42px); line-height: 1.1; }
      .resource-panel p { max-width: 680px; margin: 14px 0 0; color: #52647b; line-height: 1.65; }

      @media (max-width: 820px) {
        .proof-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .proof-list div:nth-child(3) { border-left: 0; border-top: 1px solid #d5deed; }
        .proof-list div:nth-child(4) { border-top: 1px solid #d5deed; }
        .audience-grid { grid-template-columns: 1fr; }
        .audience-card { min-height: 0; }
        .process-list { grid-template-columns: 1fr; }
        .process-list li { min-height: 0; }
        .process-list strong { margin-top: 16px; }
        .resource-panel { grid-template-columns: 1fr; }
      }

      @media (max-width: 640px) {
        .coach-banner { aspect-ratio: 1683 / 935; }
        .site-header { min-height: 46px; }
        .hero { padding: 52px 0 62px; }
        .hero-inner, .section-inner { width: min(100% - 30px, 560px); }
        h1 { font-size: clamp(40px, 13vw, 58px); }
        .hero-actions { align-items: stretch; flex-direction: column; }
        .button { width: 100%; }
        .proof-list { width: 100%; }
        .proof-list div { padding: 20px 16px; }
        .audience-card { padding: 24px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .button { transition: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="coach-banner" aria-label="Coach Kai">
        <picture>
          <source
            media="(max-width: 640px)"
            srcset="/images/coach-kai-banner-mobile.png"
            width="1683"
            height="935"
          />
          <img
            src="/images/coach-kai-banner-desktop.png"
            width="2508"
            height="627"
            alt="Coach Kai"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </section>

      <header class="site-header">
        <SiteNavigation current="home" />
      </header>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-inner">
          <p class="eyebrow">Speech · Debate · Storytelling · Presentations</p>
          <h1 id="hero-title">Speak clearly. Think critically. Lead confidently.</h1>
          <p class="hero-summary">
            Practical communication coaching for students and professionals in
            Shanghai and online.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/contact/">Discuss your goals</a>
            <a class="button button-secondary" href="#coaching">Explore coaching</a>
          </div>
          <p class="audience-note">For students, families, professionals, schools, and organizations.</p>
        </div>
      </section>

      <section class="proof-strip" aria-label="Coach Kai experience">
        <dl class="proof-list">
          <div><dt>15+</dt><dd>Years in education and communication training</dd></div>
          <div><dt>2,000+</dt><dd>Students trained in speaking, debate, and confidence</dd></div>
          <div><dt>1,000+</dt><dd>Presentations delivered</dd></div>
          <div><dt>7</dt><dd>Countries reached through speaking and training</dd></div>
        </dl>
      </section>

      <section class="coaching" id="coaching" aria-labelledby="coaching-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="eyebrow">Choose your path</p>
            <h2 id="coaching-title">Coaching built around how you need to perform</h2>
            <p>
              Develop the structure, confidence, reasoning, and delivery needed for
              classrooms, competitions, interviews, presentations, and professional stages.
            </p>
          </div>

          <div class="audience-grid">
            <article class="audience-card">
              <span class="card-number" aria-hidden="true">01</span>
              <h3>Students and families</h3>
              <p>Build confident speaking, organized ideas, storytelling skills, and competition readiness.</p>
              <a class="text-link" href="/contact/">Discuss a student's goals</a>
            </article>
            <article class="audience-card">
              <span class="card-number" aria-hidden="true">02</span>
              <h3>Professionals</h3>
              <p>Strengthen presentations, business storytelling, persuasion, interviews, and leadership communication.</p>
              <a class="text-link" href="/contact/">Discuss professional coaching</a>
            </article>
            <article class="audience-card">
              <span class="card-number" aria-hidden="true">03</span>
              <h3>Schools and organizations</h3>
              <p>Plan practical workshops and training in speaking, debate, presentation skills, and communication.</p>
              <a class="text-link" href="/contact/">Discuss a training program</a>
            </article>
          </div>
        </div>
      </section>

      <section class="process" id="process" aria-labelledby="process-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="eyebrow">A focused coaching process</p>
            <h2 id="process-title">Turn feedback into deliberate progress</h2>
            <p>Each stage connects the learner's goal to practical preparation and real performance.</p>
          </div>
          <ol class="process-list">
            <li><span class="step-number">01</span><strong>Assess</strong><p>Clarify goals, context, strengths, and the next important challenge.</p></li>
            <li><span class="step-number">02</span><strong>Structure</strong><p>Organize ideas, arguments, stories, and supporting evidence.</p></li>
            <li><span class="step-number">03</span><strong>Practice</strong><p>Rehearse with focused exercises and realistic performance conditions.</p></li>
            <li><span class="step-number">04</span><strong>Refine</strong><p>Apply specific feedback to content, delivery, reasoning, and presence.</p></li>
            <li><span class="step-number">05</span><strong>Perform</strong><p>Communicate with greater clarity, confidence, and control.</p></li>
          </ol>
        </div>
      </section>

      <section class="resource-callout" aria-labelledby="resources-title">
        <div class="section-inner">
          <div class="resource-panel">
            <div>
              <h2 id="resources-title">Practice with free speaking and classroom tools</h2>
              <p>Explore interactive tools for participation, speech timing, debate practice, and classroom activities.</p>
            </div>
            <a class="button button-primary" href="/resources/">Explore free resources</a>
          </div>
        </div>
      </section>

      <ContactStrip id="contact" />
    </main>
    <SiteFooter />
  </body>
</html>

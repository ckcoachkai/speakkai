---
import ContactStrip from "../components/ContactStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Coach Kai's schedule and WeChat contact." />
    <title>SpeakKai | Coach Kai</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        background: #f5f7fa;
        color: #071b3d;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
        margin: 0;
      }

      body {
        background: #f5f7fa;
      }

      main {
        min-height: 100vh;
      }

      .coach-banner {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 1;
        overflow: hidden;
        background: #020b20;
      }

      .coach-banner picture,
      .coach-banner img {
        display: block;
        width: 100%;
        height: 100%;
      }

      .coach-banner img {
        object-fit: contain;
      }

      .site-header {
        display: flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #d5deed;
        background: #fff;
      }

      .site-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(22px, 4vw, 52px);
      }

      .site-nav a {
        padding: 14px 4px 12px;
        border-bottom: 2px solid transparent;
        color: #294568;
        font-size: 16px;
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
      }

      .site-nav a:hover,
      .site-nav a[aria-current="page"] {
        border-bottom-color: #19a9c5;
        color: #0a5f91;
      }

      .site-nav a:focus-visible {
        border-radius: 3px;
        outline: 3px solid #80d6d1;
        outline-offset: 2px;
      }

      .home-intro {
        display: grid;
        place-items: center;
        padding: clamp(56px, 8vw, 104px) 24px;
        background:
          radial-gradient(circle at 78% 18%, rgb(37 99 235 / 16%), transparent 28rem),
          #0b1020;
        color: #fff;
      }

      .intro-copy {
        width: min(100%, 940px);
        text-align: center;
      }

      .eyebrow {
        margin: 0 0 18px;
        color: #a8c7ff;
        font-size: clamp(0.78rem, 1.5vw, 0.95rem);
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .home-intro h1 {
        max-width: 820px;
        margin: 0 auto;
        font-size: clamp(2.7rem, 7vw, 5.8rem);
        line-height: 0.98;
        letter-spacing: -0.055em;
      }

      .home-intro h1 span {
        color: #ffcc00;
      }

      .intro-lede {
        max-width: 700px;
        margin: 28px auto 0;
        color: #d8e3f6;
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        line-height: 1.65;
      }

      .home-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
        margin-top: 34px;
      }

      .home-actions a {
        display: inline-flex;
        min-height: 54px;
        align-items: center;
        justify-content: center;
        min-width: 180px;
        padding: 14px 24px;
        border: 2px solid transparent;
        border-radius: 999px;
        font-weight: 800;
        text-decoration: none;
        transition:
          background-color 160ms ease,
          border-color 160ms ease,
          color 160ms ease,
          transform 160ms ease;
      }

      .home-actions a:hover {
        transform: translateY(-2px);
      }

      .primary-cta {
        background: #2563eb;
        color: #fff;
      }

      .primary-cta:hover {
        background: #1d4ed8;
      }

      .secondary-cta {
        border-color: #59749c !important;
        background: rgb(255 255 255 / 4%);
        color: #fff;
      }

      .secondary-cta:hover {
        border-color: #a8c7ff !important;
        background: rgb(255 255 255 / 9%);
      }

      .home-actions a:focus-visible {
        outline: 3px solid #ffcc00;
        outline-offset: 4px;
      }

      @media (max-width: 640px) {
        .coach-banner {
          aspect-ratio: 1683 / 935;
        }

        .site-header {
          min-height: 46px;
        }

        .site-nav {
          width: 100%;
          gap: 0;
        }

        .site-nav a {
          flex: 1 1 16.666%;
          padding: 13px 2px 11px;
          font-size: clamp(10px, 3.2vw, 13px);
          text-align: center;
        }

        .home-intro {
          padding: 48px 20px 56px;
        }

        .home-actions {
          display: grid;
        }

        .home-actions a {
          width: min(100%, 320px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .home-actions a {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="coach-banner" aria-label="Coach Kai social media">
        <picture>
          <source
            media="(max-width: 640px)"
            srcset="/images/coach-kai-banner-mobile.png"
          />
          <img
            src="/images/coach-kai-banner-desktop.png"
            width="2508"
            height="627"
            alt="Coach Kai"
          />
        </picture>
      </section>

      <header class="site-header">
        <SiteNavigation current="home" />
      </header>

      <section class="home-intro" aria-labelledby="home-title">
        <div class="intro-copy">
          <p class="eyebrow">Communication coaching · Shanghai &amp; online</p>
          <h1 id="home-title">Speak with clarity.<br /><span>Lead with confidence.</span></h1>
          <p class="intro-lede">
            Public speaking, speech and debate, and practical communication
            coaching for students, adults, and teams.
          </p>
          <div class="home-actions" aria-label="Start here">
            <a class="primary-cta" href="/contact/">Work with Kai</a>
            <a class="secondary-cta" href="/schedule/">View schedule</a>
          </div>
        </div>
      </section>

      <ContactStrip id="contact" />
    </main>
    <SiteFooter />
  </body>
</html>

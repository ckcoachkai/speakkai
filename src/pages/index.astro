---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import AudienceGateway from "../components/AudienceGateway.astro";
import "../styles/smiley-home.css";

const links = [
  { label: "Start Here", href: "#work", side: "left", row: 1, kind: "start" },
  { label: "Bio", href: "#story", side: "right", row: 1, kind: "bio" },
  { label: "Games", href: "/tools/", side: "left", row: 2, kind: "games" },
  { label: "WeChat", href: "/images/coach-kai-wechat-qr.png", side: "right", row: 2, kind: "wechat" },
  { label: "Practice", href: "/resources/", side: "left", row: 3, kind: "practice" },
  { label: "Schedule", href: "/schedule/", side: "right", row: 3, kind: "schedule" },
  { label: "Speaking Topics", href: "/topic/", side: "left", row: 4, kind: "topics" },
  { label: "Contact", href: "/contact/", side: "right", row: 4, kind: "contact" },
];
---

<FlagshipLayout>
  <section class="smiley-home" aria-label="SpeakKai homepage">
    <div class="smiley-stage">
      <canvas class="smiley-arms" aria-hidden="true"></canvas>
      <button class="smiley-face" type="button" aria-label="Play the smiley’s woo-woo sound">
        <img src="/images/home-smiley/selected-pixel.png" alt="" width="2022" height="1656" fetchpriority="high" draggable="false" />
      </button>
      <nav class="smiley-links" aria-label="Explore SpeakKai">
        {links.map(({label,href,side,row,kind}) => (
          <a class:list={["smiley-link", side, kind]} href={href} style={`--row:${row}`} data-arm data-side={side} data-row={row}>
            {kind === "wechat" && <img src="/images/coach-kai-wechat-qr.png" alt="QR code for Coach Kai’s WeChat" width="90" height="90" />}
            <span>{label}</span>
            {kind !== "wechat" && <span class="smiley-arrow" aria-hidden="true">↗</span>}
          </a>
        ))}
      </nav>
      <div class="smiley-sparks" aria-hidden="true"></div>
    </div>
  </section>
  <div class="gateway-shell"><AudienceGateway /></div>
</FlagshipLayout>

<script>
  import "../scripts/smiley-home";
</script>

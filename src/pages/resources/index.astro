---
import ToolsGallery from "../../components/ToolsGallery.astro";
import ResourceLayout from "../../layouts/ResourceLayout.astro";
---

<ResourceLayout
  pageTitle="Resources | SpeakKai"
  description="Interactive classroom and speaking tools from Coach Kai."
>
  <header class="page-heading">
    <h1>Resources</h1>
    <p>Classroom tools for participation, practice, and playful learning.</p>
  </header>

  <ToolsGallery />

  <style>
    .page-heading { position: relative; display: grid; max-width: none; min-height: 156px; align-content: center; gap: 6px; margin: calc(clamp(34px, 6vw, 68px) * -1) calc((100vw - min(100vw - 40px, 1120px)) / -2) 24px; padding: 24px max(24px, calc((100vw - 1120px) / 2)); overflow: hidden; color: white; background: radial-gradient(circle at 72% 34%, #5e88c7 0, #28518d 38%, #10224a 78%); }
    .page-heading::before, .page-heading::after { position: absolute; width: min(40vw, 460px); aspect-ratio: 1; right: -4%; top: -120%; border: 1px solid rgb(183 211 255 / 28%); border-radius: 50%; content: ""; }
    .page-heading::after { width: min(28vw, 320px); right: 12%; top: -82%; }
    .page-heading > * { position: relative; z-index: 1; }
    h1 { max-width: 10ch; margin: 0; color: white; font-size: clamp(2.5rem, 4vw, 4.25rem); line-height: .92; letter-spacing: -.06em; }
    .page-heading p { max-width: 56ch; margin: 2px 0 0; color: #d6e3f5; font-size: 15px; line-height: 1.45; }
    @media (max-width: 720px) { .page-heading { min-height: 132px; margin-inline: -14px; padding: 20px 18px; } .page-heading p { font-size: 14px; } }
  </style>
</ResourceLayout>

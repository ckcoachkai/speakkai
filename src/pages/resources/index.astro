---
import ToolsGallery from "../../components/ToolsGallery.astro";
import ResourceLayout from "../../layouts/ResourceLayout.astro";
---

<ResourceLayout
  pageTitle="Resources | SpeakKai"
  description="Interactive classroom and speaking tools from Coach Kai."
>
  <header class="page-heading">
    <span class="eyebrow">Interactive collection</span>
    <h1>Resources</h1>
    <p>Classroom tools for participation, practice, and playful learning.</p>
  </header>

  <ToolsGallery />

  <style>
    .page-heading { position: relative; display: grid; max-width: none; min-height: 310px; align-content: center; gap: 12px; margin: calc(clamp(34px, 6vw, 68px) * -1) calc((100vw - min(100vw - 40px, 1120px)) / -2) 34px; padding: clamp(42px, 7vw, 76px) max(24px, calc((100vw - 1120px) / 2)); overflow: hidden; color: white; background: radial-gradient(circle at 72% 34%, #5e88c7 0, #28518d 38%, #10224a 78%); }
    .page-heading::before, .page-heading::after { position: absolute; width: min(64vw, 760px); aspect-ratio: 1; right: -10%; top: -105%; border: 1px solid rgb(183 211 255 / 28%); border-radius: 50%; content: ""; }
    .page-heading::after { width: min(42vw, 520px); right: 5%; top: -72%; }
    .page-heading > * { position: relative; z-index: 1; }
    .eyebrow { color: #ffcc00; font: 700 11px "Space Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
    h1 { max-width: 10ch; margin: 0; color: white; font-size: clamp(3.4rem, 7vw, 7rem); line-height: .86; letter-spacing: -.07em; }
    .page-heading p { max-width: 56ch; margin: 10px 0 0; color: #d6e3f5; font-size: 17px; line-height: 1.6; }
    @media (max-width: 720px) { .page-heading { min-height: 270px; margin-inline: -14px; padding-inline: 18px; } .page-heading p { font-size: 16px; } }
  </style>
</ResourceLayout>

---
import { getCollection } from "astro:content";
import ToolsGallery from "../../components/ToolsGallery.astro";
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipChineseCourseEntry from "../../components/FlagshipChineseCourseEntry.astro";
const audienceOrder = { coaching: 0, schools: 1, companies: 2 };
const audienceLabels = { coaching: "Students & parents", schools: "Schools & educators", companies: "Adults & teams" };
const lessons = (await getCollection("practice", ({ data }) => data.published)).sort((a, b) => audienceOrder[a.data.followUp] - audienceOrder[b.data.followUp] || a.data.title.localeCompare(b.data.title));
---

<FlagshipLayout
  title="Free Speaking Practice for Students, Schools & Teams | SpeakKai"
  description="Choose a free speaking activity for a child, a classroom or a workplace team. Follow short practice steps, use a printable sheet, or explore classroom tools."
  current="resources"
  contactHref="/contact/"
>
  <section class="wrap resource-intro">
    <p class="eyebrow">Put an idea into practice</p><h1>
      Make your next<br /><em>attempt count.</em>
    </h1><p>
      Choose a practice for your child, your class or your team. Each one includes a guided round and a printable sheet.
    </p>
    <FlagshipChineseCourseEntry />
  </section>
  <section class="wrap resource-lessons" aria-labelledby="practice-library-title">
    <h2 id="practice-library-title">Find your starting point.</h2>
    <div class="lesson-grid">
      {lessons.map(lesson => <article class="resource-feature" aria-labelledby={`lesson-${lesson.id}`}>
        <div><p class="eyebrow">{audienceLabels[lesson.data.followUp]}</p><h3 id={`lesson-${lesson.id}`}>{lesson.data.title}.</h3><p>{lesson.data.introduction}</p><span class="resource-meta">About {lesson.data.minutes} minutes · {lesson.data.steps.length} steps</span></div>
        <a class="button" href={`/resources/${lesson.id}/`} aria-label={`Try the activity: ${lesson.data.title}`}>Try the activity <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </section>
  <section class="wrap resource-voice" aria-labelledby="voice-tool">
    <div>
      <p class="eyebrow">Listen to your delivery</p><h2 id="voice-tool">
        Filler Alarm
      </h2><p>
        Explore the existing speaking practice tool and its on-device detection
        options.
      </p>
    </div><a class="text-link" href="/speak/"
      >Open Filler Alarm <span aria-hidden="true">↗</span></a>
  </section>
  <section class="wrap resource-tools" aria-labelledby="tools-title">
    <div class="section-heading">
      <p class="eyebrow">For practice and participation</p><h2 id="tools-title">
        Tools for the room.
      </h2><p>
        Timers, prompts and name pickers for speakers, teachers and groups.
      </p>
    </div><ToolsGallery headingLevel="h3" />
  </section>
  <section class="wrap resource-next">
    <h2>Looking for a learning plan?</h2><p>
      Explore the Fall course for Grades 1–2 or discuss another speaking goal
      with Kai.
    </p><div class="actions">
      <a class="button" href="/coaching/young-competition-speakers/"
        >Explore the Fall course <span aria-hidden="true">↗</span></a
      ><a class="text-link" href="/contact/">Talk with Kai</a>
    </div>
  </section>
</FlagshipLayout>
<style>
  .resource-intro {
    padding-block: 52px 38px;
  }
  .resource-intro .eyebrow,
  .resource-feature .eyebrow,
  .resource-voice .eyebrow {
    color: var(--blue);
  }
  h1 {
    font-size: clamp(44px, 5.5vw, 74px);
    font-weight: 600;
    margin-top: 18px;
  }
  .resource-intro > p:last-child {
    font-size: 18px;
    color: var(--muted);
    max-width: 590px;
    margin-top: 22px;
  }
  .resource-lessons > h2 { font-size: 26px; margin-bottom: 24px; }
  .lesson-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .resource-feature {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: start;
    gap: 24px;
    background: var(--wash);
    border-top: 3px solid var(--yellow);
    padding: 28px;
  }
  .resource-feature > div {
    max-width: 600px;
  }
  .resource-feature h3 {
    font-size: 30px;
    margin-top: 14px;
  }
  .resource-feature p:not(.eyebrow) {
    margin-top: 20px;
  }
  .resource-meta {
    display: block;
    font-size: 14px;
    color: var(--muted);
    margin-top: 18px;
  }
  .resource-feature .button {
    flex-shrink: 0;
  }
  .resource-voice {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: center;
    padding-block: 35px;
    border-bottom: 1px solid var(--line);
  }
  .resource-voice h2 {
    font-size: 28px;
    margin-top: 12px;
  }
  .resource-voice p:not(.eyebrow) {
    margin-top: 16px;
    color: var(--muted);
  }
  .resource-tools {
    padding-block: 64px;
  }
  .resource-tools :global(.tool-card) {
    box-shadow: none;
    border-color: var(--line);
  }
  .resource-tools :global(.tool-card:hover) {
    translate: none;
    box-shadow: none;
  }
  .resource-next {
    padding-block: 36px 64px;
    border-top: 1px solid var(--line);
  }
  .resource-next h2 {
    font-size: 32px;
  }
  .resource-next > p {
    margin-top: 18px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .lesson-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .resource-feature,
    .resource-voice {
      flex-direction: column;
      align-items: start;
      gap: 24px;
    }
    .resource-feature {
      padding: 24px;
    }
    .resource-feature h3 {
      font-size: 30px;
    }
    .resource-intro {
      padding-top: 32px;
    }
    .resource-tools {
      padding-block: 48px;
    }
  }
</style>

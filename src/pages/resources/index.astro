---
import ToolsGallery from "../../components/ToolsGallery.astro";
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
---

<FlagshipLayout
  title="Free Speaking Practice & Classroom Tools | SpeakKai"
  description="Try a guided speaking activity, practise with speech timers, or bring playful participation into your classroom with free SpeakKai resources."
  current="resources"
  contactHref="/contact/"
>
  <section class="wrap resource-intro">
    <p class="eyebrow">Put an idea into practice</p><h1>
      Make your next<br /><em>attempt count.</em>
    </h1><p>
      Start with a short speaking activity, or choose a tool for the room you’re
      teaching.
    </p>
  </section>
  <section class="wrap resource-feature" aria-labelledby="featured-lesson">
    <div>
      <p class="eyebrow">Guided practice · about 10 minutes</p><h2
        id="featured-lesson"
      >
        The one-object story.
      </h2><p>
        Choose an everyday object. Tell one real moment. Ask a listener for one
        useful next step.
      </p><span class="resource-meta"
        >Early speakers · parent or partner · printable sheet</span>
    </div><a class="button" href="/resources/one-object-story/"
      >Try the activity <span aria-hidden="true">↗</span></a>
  </section>
  <section class="wrap resource-voice" aria-labelledby="voice-tool">
    <div>
      <p class="eyebrow">Listen to your delivery</p><h2 id="voice-tool">
        Filler Alarm
      </h2><p>
        Explore the existing speaking practice tool and its on-device detection
        options.
      </p>
    </div><a class="text-link" href="/speak/"
      >Open Filler Alarm <span aria-hidden="true">↗</span></a>
  </section>
  <section class="wrap resource-tools" aria-labelledby="tools-title">
    <div class="section-heading">
      <p class="eyebrow">For practice and participation</p><h2 id="tools-title">
        Tools for the room.
      </h2><p>
        Timers, prompts and name pickers for speakers, teachers and groups.
      </p>
    </div><ToolsGallery headingLevel="h3" />
  </section>
  <section class="wrap resource-next">
    <h2>Looking for a learning plan?</h2><p>
      Explore the Fall course for Grades 1–2 or discuss another speaking goal
      with Kai.
    </p><div class="actions">
      <a class="button" href="/coaching/young-competition-speakers/"
        >Explore the Fall course <span aria-hidden="true">↗</span></a
      ><a class="text-link" href="/contact/">Talk with Kai</a>
    </div>
  </section>
</FlagshipLayout>
<style>
  .resource-intro {
    padding-block: 52px 38px;
  }
  .resource-intro .eyebrow,
  .resource-feature .eyebrow,
  .resource-voice .eyebrow {
    color: var(--blue);
  }
  h1 {
    font-size: clamp(44px, 5.5vw, 74px);
    font-weight: 600;
    margin-top: 18px;
  }
  .resource-intro > p:last-child {
    font-size: 18px;
    color: var(--muted);
    max-width: 590px;
    margin-top: 22px;
  }
  .resource-feature {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 34px;
    background: var(--wash);
    border-top: 3px solid var(--yellow);
    padding: 34px;
  }
  .resource-feature > div {
    max-width: 600px;
  }
  .resource-feature h2 {
    font-size: 34px;
    margin-top: 14px;
  }
  .resource-feature p:not(.eyebrow) {
    margin-top: 20px;
  }
  .resource-meta {
    display: block;
    font-size: 14px;
    color: var(--muted);
    margin-top: 18px;
  }
  .resource-feature .button {
    flex-shrink: 0;
  }
  .resource-voice {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: center;
    padding-block: 35px;
    border-bottom: 1px solid var(--line);
  }
  .resource-voice h2 {
    font-size: 28px;
    margin-top: 12px;
  }
  .resource-voice p:not(.eyebrow) {
    margin-top: 16px;
    color: var(--muted);
  }
  .resource-tools {
    padding-block: 64px;
  }
  .resource-tools :global(.tool-card) {
    box-shadow: none;
    border-color: var(--line);
  }
  .resource-tools :global(.tool-card:hover) {
    translate: none;
    box-shadow: none;
  }
  .resource-next {
    padding-block: 36px 64px;
    border-top: 1px solid var(--line);
  }
  .resource-next h2 {
    font-size: 32px;
  }
  .resource-next > p {
    margin-top: 18px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .resource-feature,
    .resource-voice {
      flex-direction: column;
      align-items: start;
      gap: 24px;
    }
    .resource-feature {
      padding: 24px;
    }
    .resource-feature h2 {
      font-size: 30px;
    }
    .resource-intro {
      padding-top: 32px;
    }
    .resource-tools {
      padding-block: 48px;
    }
  }
</style>

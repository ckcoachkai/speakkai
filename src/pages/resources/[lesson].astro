---
import { getCollection } from "astro:content";
import FlagshipPracticePage from "../../components/FlagshipPracticePage.astro";
export async function getStaticPaths() {
  const lessons = await getCollection("practice", ({ data }) => data.published);
  return lessons.map(lesson => ({ params: { lesson: lesson.id }, props: { lesson } }));
}
const { lesson } = Astro.props;
---
<FlagshipPracticePage data={lesson.data} slug={lesson.id} />

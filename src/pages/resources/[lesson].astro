---
import { getCollection } from "astro:content";
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipBreadcrumbs from "../../components/FlagshipBreadcrumbs.astro";
import PracticeGuide from "../../components/PracticeGuide";
export async function getStaticPaths() {
  const lessons = await getCollection("practice", ({ data }) => data.published);
  return lessons.map(lesson => ({ params: { lesson: lesson.id }, props: { lesson } }));
}
const { lesson } = Astro.props;
const { data } = lesson;
const nextSteps = {
  coaching: { href: "/coaching/young-competition-speakers/", label: "Explore the Fall course" },
  schools: { href: "/contact/?audience=schools", label: "Discuss a school program" },
  companies: { href: "/contact/?audience=companies", label: "Discuss team training" },
};
const nextStep = nextSteps[data.followUp];
---
<FlagshipLayout title={`${data.title} · Free Speaking Practice | SpeakKai`} description={data.summary} contactHref={`/contact/?audience=${data.followUp}`} breadcrumb={data.title}>
  <article class="wrap practice-sheet">
    <FlagshipBreadcrumbs label={data.title} />
    <header class="sheet-intro">
      <p class="eyebrow">Free practice · about {data.minutes} minutes</p>
      <h1>{data.title}<em>.</em></h1>
      <p>{data.introduction}</p>
      <div class="sheet-meta"><span>{data.audience}</span><span>{data.setting}</span><span>You need: {data.materials}</span></div>
      <p class="sheet-note">Suggested activity. Adapt the time and language to your learners.</p>
    </header>
    <PracticeGuide title={data.title} steps={data.steps} client:load />
    <div class="sheet-tools no-print">
      <a class="text-link" href="#practice-steps">Read all {data.steps.length} steps <span aria-hidden="true">↓</span></a>
      <button class="text-link" id="print-practice" type="button" hidden>Print practice sheet <span aria-hidden="true">↗</span></button>
    </div>
    <ol id="practice-steps" class="practice-steps" tabindex="-1" aria-label="Complete practice steps">
      {data.steps.map((step, index) => <li><div class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div><div><p class="step-time">{step.minutes} min</p><h2>{step.title}</h2><p>{step.detail}</p></div></li>)}
    </ol>
    <section class="story-frame">
      <div><p class="eyebrow">Prompts to remember</p><h2>{data.frameTitle}</h2><p>{data.prompts.map(prompt => <span class="speaking-prompt">“{prompt}”</span>)}</p><p class="sheet-note">Prompts are starting points. The speaker can use their own words.</p></div>
      <div class="listener-note"><h3>For the listener</h3><p>{data.listenerGuide}</p><p><strong>Try:</strong> “{data.feedbackExample}”</p><p class="sheet-note">Keep the next change small. Speaking again should feel achievable.</p></div>
    </section>
    <section class="reflection"><h2>One thing I will try next time</h2><p>Say it aloud or write a few words here.</p><div class="writing-lines" aria-hidden="true"><div></div><div></div></div></section>
    <footer class="sheet-footer"><p>SpeakKai · speakkai.com/resources/{lesson.id}/</p><p>This standalone practice is not a test or a full course lesson.</p><div class="actions no-print"><a class="button" href={nextStep.href}>{nextStep.label} <span aria-hidden="true">↗</span></a><a class="text-link" href="/resources/">All practice resources</a></div></footer>
  </article>
</FlagshipLayout>
<script>
  const printButton = document.querySelector<HTMLButtonElement>("#print-practice")!;
  printButton.hidden = false;
  printButton.addEventListener("click", () => window.print());
</script>
<style>
  .speaking-prompt { display: block; }
  .sheet-tools { display: flex; flex-wrap: wrap; gap: 16px 30px; align-items: center; margin-bottom: 24px; }
  .sheet-tools button { background: none; border: 0; padding-block: 12px; }
  h1 { max-width: 800px; }
  .practice-sheet {
    max-width: 960px;
    padding-block: 36px 72px;
  }
  .sheet-intro {
    padding-block: 20px;
  }
  .sheet-intro .eyebrow {
    color: var(--blue);
  }
  h1 {
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 600;
    margin-top: 18px;
  }
  .sheet-intro > p:not(.eyebrow) {
    margin-top: 16px;
    max-width: 640px;
    font-size: 17px;
    color: var(--muted);
  }
  .sheet-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 600;
  }
  .sheet-intro > p.sheet-note,
  .sheet-note {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }
  button {
    font-family: inherit;
    cursor: pointer;
  }
  [hidden] {
    display: none !important;
  }
  .practice-steps {
    padding: 0;
    list-style: none;
    margin: 12px 0 40px;
  }
  .practice-steps li {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 25px;
    border-top: 1px solid var(--line);
    padding-block: 28px;
    break-inside: avoid;
  }
  .step-number {
    color: var(--blue);
    font-size: 22px;
    font-weight: 600;
  }
  .step-time {
    font-size: 14px;
    color: var(--muted);
  }
  h2 {
    font-size: 28px;
    font-weight: 600;
  }
  .practice-steps h2 {
    margin-top: 8px;
  }
  .practice-steps li > div > p:last-child {
    margin-top: 14px;
    max-width: 650px;
  }
  .story-frame {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    background: var(--wash);
    padding: 32px;
  }
  .story-frame h2 {
    margin-top: 16px;
  }
  .story-frame p:not(.eyebrow) {
    margin-top: 18px;
  }
  .listener-note {
    border-left: 3px solid var(--yellow);
    padding-left: 24px;
  }
  .listener-note h3 {
    font-size: 22px;
    font-weight: 600;
  }
  .reflection {
    padding-top: 40px;
    break-inside: avoid;
  }
  .reflection > p {
    margin-top: 14px;
    color: var(--muted);
  }
  .writing-lines {
    max-width: 700px;
  }
  .writing-lines div {
    height: 40px;
    border-bottom: 1px solid #b5bfd1;
  }
  .sheet-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .sheet-footer > p {
    font-size: 14px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  @media (max-width: 650px) {
    .story-frame {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 24px;
    }
    .practice-steps li {
      grid-template-columns: 32px 1fr;
      gap: 14px;
    }
    .practice-steps h2 {
      font-size: 25px;
    }
    .practice-sheet {
      padding-top: 24px;
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .no-print,
    :global(.breadcrumbs) {
      display: none !important;
    }
    :global(body.flagship) {
      font-size: 11pt;
      color: #111;
      background: white;
    }
    .practice-sheet {
      width: 100%;
      max-width: none;
      padding: 0;
    }
    .sheet-intro {
      padding: 0 0 12px;
    }
    h1 {
      font-size: 30pt;
      margin-top: 10px;
    }
    .sheet-intro > p:not(.eyebrow) {
      font-size: 11pt;
      margin-top: 10px;
    }
    .sheet-meta {
      margin-top: 10px;
    }
    .sheet-intro .sheet-note,
    .sheet-note {
      font-size: 9pt;
    }
    .practice-steps {
      margin: 6px 0 16px;
    }
    .practice-steps li {
      padding-block: 12px;
      grid-template-columns: 30px 1fr;
      gap: 14px;
    }
    .practice-steps h2,
    h2 {
      font-size: 16pt;
    }
    .practice-steps li > div > p:last-child {
      margin-top: 6px;
    }
    .step-time,
    .step-number {
      font-size: 10pt;
    }
    .story-frame {
      padding: 16px;
      gap: 24px;
      break-inside: avoid;
    }
    .listener-note h3 {
      font-size: 14pt;
    }
    .reflection {
      padding-top: 20px;
    }
    .sheet-footer {
      margin-top: 16px;
      padding-top: 10px;
    }
    .sheet-footer > p {
      font-size: 9pt;
    }
  }
</style>

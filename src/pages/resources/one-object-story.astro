---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipBreadcrumbs from "../../components/FlagshipBreadcrumbs.astro";
const steps = [
  {
    time: "2 min",
    title: "Choose one object",
    detail:
      "Pick something familiar: a pencil, a toy, a book or a small keepsake. Tell your listener why you chose it.",
  },
  {
    time: "2 min",
    title: "Find one moment",
    detail:
      "Think of a time you used it, found it or shared it. What happened? Choose one detail your listener could picture.",
  },
  {
    time: "1 min",
    title: "Tell the story",
    detail:
      "Name the object, tell the moment and finish with why it matters. Aim for 30–60 seconds. A shorter attempt is fine.",
  },
  {
    time: "2 min",
    title: "Listen for one thing",
    detail:
      "The listener names one clear detail, then asks one useful question. Choose a single change to try.",
  },
  {
    time: "3 min",
    title: "Try it again",
    detail:
      "Retell the story with that change. Talk about what became clearer. Finish with something the speaker wants to try next time.",
  },
];
---

<FlagshipLayout
  title="The One-Object Story · Free Speaking Practice | SpeakKai"
  description="A free 10-minute speaking activity for early speakers and a parent or partner. Choose an object, tell a moment, listen and try one change."
  contactHref="/contact/?audience=coaching"
  breadcrumb="The one-object story"
>
  <article class="wrap practice-sheet">
    <FlagshipBreadcrumbs label="The one-object story" />
    <header class="sheet-intro">
      <p class="eyebrow">Free practice · about 10 minutes</p><h1>
        The one-object<br /><em>story.</em>
      </h1><p>
        A familiar object. One real moment. A listener who helps you find the
        next step.
      </p><div class="sheet-meta">
        <span>For early speakers</span><span
          >With a parent, teacher or partner</span
        ><span>You need: one everyday object</span>
      </div><p class="sheet-note">
        This is a suggested practice activity. Adjust the length and language to
        the learner; it is not a test or a full course lesson.
      </p><div class="actions no-print">
        <button class="button" id="print-practice" type="button" hidden
          >Print practice sheet <span aria-hidden="true">↗</span></button
        ><a class="text-link" href="#practice-steps"
          >Start the activity <span aria-hidden="true">↓</span></a>
      </div>
    </header>
    <ol id="practice-steps" class="practice-steps">
      {
        steps.map((step, index) => (
          <li>
            <>
              <div class="step-number" aria-hidden="true">
                0{index + 1}
              </div>
              <div>
                <>
                  <p class="step-time">{step.time}</p>
                  <h2>{step.title}</h2>
                  <p>{step.detail}</p>
                </>
              </div>
            </>
          </li>
        ))
      }
    </ol>
    <section class="story-frame">
      <div>
        <p class="eyebrow">Three prompts to remember</p><h2>
          Object. Moment. Meaning.
        </h2><p>
          “I chose…”<br />“One time…”<br />“It matters to me because…”
        </p><p class="sheet-note">
          Prompts are starting points. The speaker can use their own words.
        </p>
      </div><div class="listener-note">
        <h3>For the listener</h3><p>
          Give them time to finish. Name something specific you understood, then
          ask one question.
        </p><p>
          <strong>Try:</strong> “I could picture the bright blue cover. What happened
          when you opened the book?”
        </p><p class="sheet-note">
          Keep the next change small. Speaking again should feel achievable.
        </p>
      </div>
    </section>
    <section class="reflection">
      <h2>One thing I will try next time</h2><p>
        Say it aloud or write a few words here.
      </p><div class="writing-lines" aria-hidden="true">
        <div></div><div></div>
      </div>
    </section>
    <footer class="sheet-footer">
      <p>SpeakKai · speakkai.com/resources/one-object-story/</p><div
        class="actions no-print"
      >
        <a class="button" href="/coaching/young-competition-speakers/"
          >Explore the Fall course <span aria-hidden="true">↗</span></a
        ><a class="text-link" href="/resources/">All practice resources</a>
      </div>
    </footer>
  </article>
</FlagshipLayout>
<script>
  const printButton =
    document.querySelector<HTMLButtonElement>("#print-practice")!;
  printButton.hidden = false;
  printButton.addEventListener("click", () => window.print());
</script>
<style>
  .practice-sheet {
    max-width: 960px;
    padding-block: 36px 72px;
  }
  .sheet-intro {
    padding-block: 32px;
  }
  .sheet-intro .eyebrow {
    color: var(--blue);
  }
  h1 {
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 600;
    margin-top: 18px;
  }
  .sheet-intro > p:not(.eyebrow) {
    margin-top: 22px;
    max-width: 640px;
    font-size: 19px;
    color: var(--muted);
  }
  .sheet-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 600;
  }
  .sheet-intro .sheet-note,
  .sheet-note {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }
  button {
    font-family: inherit;
    cursor: pointer;
  }
  [hidden] {
    display: none !important;
  }
  .practice-steps {
    padding: 0;
    list-style: none;
    margin: 12px 0 40px;
  }
  .practice-steps li {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 25px;
    border-top: 1px solid var(--line);
    padding-block: 28px;
    break-inside: avoid;
  }
  .step-number {
    color: var(--blue);
    font-size: 22px;
    font-weight: 600;
  }
  .step-time {
    font-size: 14px;
    color: var(--muted);
  }
  h2 {
    font-size: 28px;
    font-weight: 600;
  }
  .practice-steps h2 {
    margin-top: 8px;
  }
  .practice-steps li > div > p:last-child {
    margin-top: 14px;
    max-width: 650px;
  }
  .story-frame {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    background: var(--wash);
    padding: 32px;
  }
  .story-frame h2 {
    margin-top: 16px;
  }
  .story-frame p:not(.eyebrow) {
    margin-top: 18px;
  }
  .listener-note {
    border-left: 3px solid var(--yellow);
    padding-left: 24px;
  }
  .listener-note h3 {
    font-size: 22px;
    font-weight: 600;
  }
  .reflection {
    padding-top: 40px;
    break-inside: avoid;
  }
  .reflection > p {
    margin-top: 14px;
    color: var(--muted);
  }
  .writing-lines {
    max-width: 700px;
  }
  .writing-lines div {
    height: 40px;
    border-bottom: 1px solid #b5bfd1;
  }
  .sheet-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .sheet-footer > p {
    font-size: 14px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  @media (max-width: 650px) {
    .story-frame {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 24px;
    }
    .practice-steps li {
      grid-template-columns: 32px 1fr;
      gap: 14px;
    }
    .practice-steps h2 {
      font-size: 25px;
    }
    .practice-sheet {
      padding-top: 24px;
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .no-print,
    :global(.breadcrumbs) {
      display: none !important;
    }
    :global(body.flagship) {
      font-size: 11pt;
      color: #111;
      background: white;
    }
    .practice-sheet {
      width: 100%;
      max-width: none;
      padding: 0;
    }
    .sheet-intro {
      padding: 0 0 12px;
    }
    h1 {
      font-size: 30pt;
      margin-top: 10px;
    }
    .sheet-intro > p:not(.eyebrow) {
      font-size: 11pt;
      margin-top: 10px;
    }
    .sheet-meta {
      margin-top: 10px;
    }
    .sheet-intro .sheet-note,
    .sheet-note {
      font-size: 9pt;
    }
    .practice-steps {
      margin: 6px 0 16px;
    }
    .practice-steps li {
      padding-block: 12px;
      grid-template-columns: 30px 1fr;
      gap: 14px;
    }
    .practice-steps h2,
    h2 {
      font-size: 16pt;
    }
    .practice-steps li > div > p:last-child {
      margin-top: 6px;
    }
    .step-time,
    .step-number {
      font-size: 10pt;
    }
    .story-frame {
      padding: 16px;
      gap: 24px;
      break-inside: avoid;
    }
    .listener-note h3 {
      font-size: 14pt;
    }
    .reflection {
      padding-top: 20px;
    }
    .sheet-footer {
      margin-top: 16px;
      padding-top: 10px;
    }
    .sheet-footer > p {
      font-size: 9pt;
    }
  }
</style>

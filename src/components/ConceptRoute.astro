---
import HomepageConcept from "./HomepageConcept.astro";
import ConceptLayout from "../layouts/ConceptLayout.astro";

interface Props { id: "1" | "2" | "3" | "4" | "5" | "6" | "7" | "a" | "9" | "10"; }
const { id } = Astro.props;
const meta: Record<Props["id"], { title: string; description: string; color: string; light: boolean }> = {
  "1": { title: "Test 1 — Executive Editorial", description: "A premium editorial SpeakKai homepage concept for executive and professional coaching.", color: "#f3eee5", light: true },
  "2": { title: "Test 2 — Kinetic Creator", description: "A bold, kinetic, high-contrast SpeakKai homepage concept inspired by creator graphics.", color: "#0b0b0d", light: false },
  "3": { title: "Test 3 — Storybook Studio", description: "A playful, child-friendly SpeakKai homepage concept for young speakers and families.", color: "#fff9df", light: true },
  "4": { title: "Test 4 — Glass Atelier", description: "An atmospheric glass-and-aurora SpeakKai homepage concept with premium digital depth.", color: "#080f28", light: false },
  "5": { title: "Test 5 — Coach Kai Uncut", description: "A candid vlog and documentary-inspired SpeakKai homepage concept.", color: "#eee8da", light: true },
  "6": { title: "Test 6 — Swiss Clarity", description: "A structured Swiss editorial SpeakKai homepage concept centered on clarity and evidence.", color: "#f4f2ec", light: true },
  "7": { title: "Test 7 — Center Stage", description: "A cinematic SpeakKai homepage concept built around the emotional moment of performance.", color: "#04070f", light: false },
  "a": { title: "Test A — Brave Ideas Club", description: "A cartoonish, animated poster-style SpeakKai homepage concept for brave young speakers.", color: "#fbf52c", light: true },
  "9": { title: "Test 9 — Field Notes", description: "A warm, human scrapbook-style SpeakKai homepage concept focused on personal coaching.", color: "#efe6d2", light: true },
  "10": { title: "Test 10 — Signal / Influence", description: "A futuristic interface-inspired SpeakKai homepage concept for amplified communication.", color: "#020617", light: false },
};
const page = meta[id];
---

<ConceptLayout
  title={page.title}
  description={page.description}
  current={id}
  themeColor={page.color}
  lightSwitcher={page.light}
  bodyClass={`concept-body concept-body-${id}`}
>
  <HomepageConcept id={id} />
</ConceptLayout>

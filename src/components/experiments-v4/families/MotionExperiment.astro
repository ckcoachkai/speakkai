---
import type { ExperimentV4 } from "../../../data/experimentLabV4";
import Portrait from "../Portrait.astro";

interface Props { experiment: ExperimentV4; }
const { experiment } = Astro.props;
const { content } = experiment;
const panelId = (index: number) => `v4-${experiment.number}-panel-${index}`;
---

<article
  class:list={["v4-experiment", "v4-motion", `layout-${experiment.slug}`]}
  data-qa="experiment-root"
  data-qa-ready="true"
  data-test-number={experiment.number}
  data-family={experiment.family}
  data-single-screen="true"
>
  {experiment.number === 31 && (
    <div class="skill-galaxy" data-interaction data-active={panelId(0)}>
      <section class="galaxy-message" data-qa="primary-message"><p class="v4-kicker">Skill Galaxy / Test 31</p><h1>{content.headline}</h1><p>{content.summary}</p></section>
      <div class="galaxy-system">
        <div class="galaxy-rings" aria-hidden="true"></div>
        <Portrait treatment="portrait-planet" label="Coach Kai" />
        <div class="galaxy-nodes" role="tablist" aria-label="Speaking skill nodes">
          {content.panels.map((item, index) => (
            <button style={`--orbit-index:${index}`} type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}><span aria-hidden="true">✦</span>{item.label}</button>
          ))}
        </div>
      </div>
      <aside class="galaxy-mission">
        <span>Selected skill</span>
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><h2>{item.title}</h2><p>{item.copy}</p></section>)}
        <div class="v4-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
      </aside>
      <footer class="v4-boundary">{content.boundary}</footer>
    </div>
  )}

  {experiment.number === 32 && (
    <div class="stage-quest" data-interaction data-active={panelId(0)}>
      <header data-qa="primary-message"><p class="v4-kicker">Stage Quest / no scores, no ranks</p><h1>{content.headline}</h1><p>{content.summary}</p></header>
      <div class="quest-path" role="tablist" aria-label="Speaking practice levels">
        <div class="quest-line" aria-hidden="true"></div>
        {content.panels.map((item, index) => (
          <button style={`--level:${index}`} type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}><span>LEVEL {index + 1}</span><strong>{item.label}</strong></button>
        ))}
      </div>
      <Portrait treatment="portrait-guide" label="Guide / Coach Kai" />
      <aside class="quest-inspector">
        <span>Practice card</span>
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><h2>{item.title}</h2><p>{item.copy}</p></section>)}
        <div class="v4-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
        <small>{content.boundary}</small>
      </aside>
    </div>
  )}

  {experiment.number === 33 && (
    <div class="comic-lab" data-interaction data-active={panelId(0)}>
      <header class="comic-title" data-qa="primary-message"><span>NEW!</span><h1>{content.headline}</h1><p>{content.summary}</p></header>
      <Portrait treatment="portrait-comic" label="COACH KAI SAYS: TRY IT OUT LOUD." />
      <div class="comic-panels" role="tablist" aria-label="Speech story panels">
        {content.panels.map((item, index) => (
          <button class={`comic-panel comic-${index + 1}`} type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}><span>0{index + 1}</span><strong>{item.title}</strong><small>{item.label}</small></button>
        ))}
      </div>
      <aside class="comic-bubble">
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><b>{item.label}</b><h2>{item.title}</h2><p>{item.copy}</p></section>)}
      </aside>
      <div class="v4-actions comic-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
      <footer class="v4-boundary">{content.boundary}</footer>
    </div>
  )}

  {experiment.number === 34 && (
    <div class="kinetic-jam" data-interaction data-active={panelId(0)}>
      <div class="kinetic-word" aria-hidden="true"><span>VOICE</span><span>CHOICE</span></div>
      <section class="kinetic-message" data-qa="primary-message"><p class="v4-kicker">Kinetic Type Jam / Test 34</p><h1>{content.headline}</h1><p>{content.summary}</p></section>
      <Portrait treatment="portrait-type" label="Coach Kai / delivery choices" />
      <div class="kinetic-controls" role="tablist" aria-label="Delivery cues">
        {content.panels.map((item, index) => <button type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}><span>0{index + 1}</span>{item.label}</button>)}
      </div>
      <aside class="kinetic-prompt">
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><h2>{item.title}</h2><p>{item.copy}</p></section>)}
        <div class="v4-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
        <small>{content.boundary}</small>
      </aside>
    </div>
  )}

  {experiment.number === 35 && (
    <div class="speaking-hud" data-interaction data-active={panelId(0)}>
      <header data-qa="primary-message"><span>SK // PRACTICE MODE</span><h1>{content.headline}</h1><p>{content.summary}</p></header>
      <Portrait treatment="portrait-player" label="PLAYER GUIDE / COACH KAI" />
      <div class="hud-modules" role="tablist" aria-label="Practice missions">
        {content.panels.map((item, index) => (
          <button type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}><i aria-hidden="true"></i><span>MISSION 0{index + 1}</span><strong>{item.label}</strong></button>
        ))}
      </div>
      <aside class="hud-mission">
        <p>ACTIVE PRACTICE MISSION</p>
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><h2>{item.title}</h2><p>{item.copy}</p></section>)}
        <div class="v4-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
        <small>{content.boundary}</small>
      </aside>
    </div>
  )}

  {experiment.number === 36 && (
    <div class="sticker-studio" data-interaction data-active={panelId(0)}>
      <div class="sticker-bg" aria-hidden="true"><span>SAY IT</span><span>YOUR WAY</span><span>TRY AGAIN</span></div>
      <Portrait treatment="portrait-cutout" label="COACH KAI" />
      <section data-qa="primary-message"><p class="v4-kicker">Sticker Cutout Studio</p><h1>{content.headline}</h1><p>{content.summary}</p></section>
      <div class="functional-stickers" role="tablist" aria-label="Speaking direction stickers">
        {content.panels.map((item, index) => <button class={`sticker sticker-${index + 1}`} type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}>{item.label}<span aria-hidden="true">✦</span></button>)}
      </div>
      <aside class="sticker-note">
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><h2>{item.title}</h2><p>{item.copy}</p></section>)}
        <div class="v4-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
        <small>{content.boundary}</small>
      </aside>
    </div>
  )}

  {experiment.number === 37 && (
    <div class="desk-world" data-interaction data-active={panelId(0)}>
      <section class="desk-intro" data-qa="primary-message"><p class="v4-kicker">Classroom Desk World / parent + student</p><h1>{content.headline}</h1><p>{content.summary}</p></section>
      <Portrait treatment="portrait-polaroid" label="Coach Kai / practice guide" />
      <div class="desk-surface" role="tablist" aria-label="Practice desk objects">
        <div class="desk-lines" aria-hidden="true"></div>
        {content.panels.map((item, index) => <button class={`desk-object object-${index + 1}`} type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}><span>OPEN</span><strong>{item.label}</strong></button>)}
      </div>
      <aside class="desk-note">
        <span>Practice note</span>
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><h2>{item.title}</h2><p>{item.copy}</p></section>)}
        <div class="v4-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
        <small>{content.boundary}</small>
      </aside>
    </div>
  )}

  {experiment.number === 38 && (
    <div class="voice-visualizer" data-interaction data-active={panelId(0)}>
      <section data-qa="primary-message"><p class="v4-kicker">Rhythm & Voice Visualizer / no microphone</p><h1>{content.headline}</h1><p>{content.summary}</p></section>
      <Portrait treatment="portrait-wave" label="Coach Kai / voice choices" />
      <div class="wave-field" aria-hidden="true">{Array.from({ length: 32 }, (_, index) => <i style={`--bar:${index}`}></i>)}</div>
      <div class="voice-controls" role="tablist" aria-label="Voice practice choices">
        {content.panels.map((item, index) => <button type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}><span aria-hidden="true">●</span>{item.label}</button>)}
      </div>
      <aside class="voice-prompt">
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><h2>{item.title}</h2><p>{item.copy}</p></section>)}
        <div class="v4-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
        <small>{content.boundary}</small>
      </aside>
    </div>
  )}

  {experiment.number === 39 && (
    <div class="practice-flipbook" data-interaction data-active={panelId(0)}>
      <header data-qa="primary-message"><p class="v4-kicker">Transformation Flipbook / process, not promise</p><h1>{content.headline}</h1><p>{content.summary}</p></header>
      <Portrait treatment="portrait-margin-note" label="Coach Kai / annotate the next attempt" />
      <div class="flipbook-stack">
        {content.panels.map((item, index) => <article id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><span>FRAME {String(index + 1).padStart(2, "0")}</span><h2>{item.title}</h2><p>{item.copy}</p><b>{item.label}</b></article>)}
      </div>
      <div class="flipbook-controls" role="tablist" aria-label="Practice process frames">
        {content.panels.map((item, index) => <button type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}>0{index + 1}<span>{item.label}</span></button>)}
        <label>Frame<input data-range-deck type="range" min="0" max={content.panels.length - 1} step="1" value="0" aria-label="Choose practice frame" /></label>
      </div>
      <div class="v4-actions flipbook-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
      <footer class="v4-boundary">{content.boundary}</footer>
    </div>
  )}

  {experiment.number === 40 && (
    <div class="motion-poster" data-interaction data-active={panelId(0)}>
      <div class="poster-type" aria-hidden="true"><span>SPEAK</span><span>KAI</span></div>
      <Portrait treatment="portrait-poster" label="COACH KAI / COMMUNICATION IN PRACTICE" />
      <section class="poster-message" data-qa="primary-message"><p class="v4-kicker">Motion Poster Festival / Test 40</p><h1>{content.headline}</h1><p>{content.summary}</p></section>
      <div class="poster-strips" role="tablist" aria-label="Speaking poster themes">
        {content.panels.map((item, index) => <button class={`poster-strip strip-${index + 1}`} type="button" role="tab" data-v4-control data-qa="interaction-trigger" data-target={panelId(index)} aria-controls={panelId(index)} aria-selected={index === 0 ? "true" : "false"}><span>0{index + 1}</span>{item.title}</button>)}
      </div>
      <aside class="poster-caption">
        {content.panels.map((item, index) => <section id={panelId(index)} role="tabpanel" data-v4-panel data-qa="interaction-panel" hidden={index !== 0}><b>{item.label}</b><h2>{item.title}</h2><p>{item.copy}</p></section>)}
      </aside>
      <div class="v4-actions poster-actions"><a href={experiment.primaryHref} data-qa="primary-cta">{experiment.primaryCta}</a><a href={content.secondaryHref}>{content.secondaryCta}</a></div>
      <footer class="v4-boundary">{content.boundary}</footer>
    </div>
  )}
</article>

---
import { experimentsV4, version3Variants } from "../../data/experimentLabV4";

interface Props {
  current: number;
}

const { current } = Astro.props;
const navigationItems = current <= 4 ? experimentsV4 : version3Variants;
const currentIndex = navigationItems.findIndex((experiment) => experiment.number === current);
const previous = navigationItems[(currentIndex - 1 + navigationItems.length) % navigationItems.length];
const next = navigationItems[(currentIndex + 1) % navigationItems.length];
const groupLabel = current <= 4 ? "Four reference directions" : "Ten Version 3 refinements";
---

<nav class="v4-nav" aria-label="Homepage experiment navigation" data-qa="test-switcher">
  <a class="v4-brand" href="/tests/" data-qa="brand" aria-label="SpeakKai Experiment Lab gallery">
    <span class="v4-brand-mark" aria-hidden="true">SK</span>
    <span>SpeakKai Lab</span>
  </a>
  <div class="v4-stepper" aria-label={`Current homepage direction: Version ${current}`}>
    <a href={`/tests/${previous.number}/`} aria-label={`Previous: Version ${previous.number}`}>← {previous.number}</a>
    <strong>Version {current}</strong>
    <a href={`/tests/${next.number}/`} aria-label={`Next: Version ${next.number}`}>{next.number} →</a>
  </div>
  <div class="v4-nav-tools">
    <button class="v4-mobile-preview" type="button" data-mobile-preview>Mobile preview</button>
    <details class="v4-jump">
      <summary>Jump to</summary>
      <div class="v4-jump-panel">
        <p>{groupLabel}</p>
        <ol>
          {navigationItems.map((experiment) => (
            <li>
              <a href={`/tests/${experiment.number}/`} aria-current={experiment.number === current ? "page" : undefined}>
                <span>V{experiment.number}</span>
                {experiment.title}
              </a>
            </li>
          ))}
        </ol>
        <a class="v4-gallery-link" href="/tests/">Compare all versions</a>
      </div>
    </details>
  </div>
</nav>

<dialog class="v4-mobile-dialog" data-mobile-dialog aria-labelledby="mobile-preview-title">
  <header>
    <div><span>390 × 844</span><strong id="mobile-preview-title">Version {current} on mobile</strong></div>
    <button type="button" data-mobile-close aria-label="Close mobile preview">Close</button>
  </header>
  <div class="v4-phone-frame">
    <iframe data-mobile-frame data-mobile-src={`/tests/${current}/?mobile-preview=1`} title={`Mobile preview of Version ${current}`}></iframe>
  </div>
</dialog>

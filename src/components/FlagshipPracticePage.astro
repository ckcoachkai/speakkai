---
import type { CollectionEntry } from "astro:content";
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipBreadcrumbs from "./FlagshipBreadcrumbs.astro";
import PracticeGuide from "./PracticeGuide";
import { practiceLabels, storyLanguages, type PracticeLanguage } from "../data/practiceLanguage";
interface Props { data: CollectionEntry<"practice">["data"]; slug: string; language?: PracticeLanguage; }
const { data, slug, language = "en" } = Astro.props;
const copy = practiceLabels[language];
const chinese = language === "zh-CN";
const alternates = slug === "one-object-story" ? storyLanguages : [];
const path = `${chinese ? "/zh" : ""}/resources/${slug}/`;
const contactHref = chinese ? "/zh/coaching/young-competition-speakers/#course-contact" : `/contact/?audience=${data.followUp}`;
const nextSteps = {
  coaching: { href: `${chinese ? "/zh" : ""}/coaching/young-competition-speakers/`, label: copy.course },
  schools: { href: "/contact/?audience=schools", label: "Discuss a school program" },
  companies: { href: "/contact/?audience=companies", label: "Discuss team training" },
};
const nextStep = nextSteps[data.followUp];
---
<FlagshipLayout title={`${data.title} · ${copy.pageTitle} | SpeakKai`} description={data.summary} contactHref={contactHref} breadcrumb={data.title} language={language} alternates={alternates}>
  <article class="wrap practice-sheet">
    <FlagshipBreadcrumbs label={data.title} language={language} labelLanguage={language} />
    {alternates.length > 0 && <div class="practice-language no-print"><nav aria-label={copy.language}>{alternates.map(item => <a href={item.href} lang={item.lang} hreflang={item.lang} aria-current={language === item.lang ? "page" : undefined}>{item.label}</a>)}</nav><p>{copy.reset}</p></div>}
    <header class="sheet-intro">
      <p class="eyebrow">{copy.free} · {copy.about} {data.minutes} {copy.minutes}</p>
      <h1>{data.title}{!chinese && <em>.</em>}</h1>
      <p>{data.introduction}</p>
      <div class="sheet-meta"><span>{data.audience}</span><span>{data.setting}</span><span>{copy.need} {data.materials}</span></div>
      <p class="sheet-note">{copy.adapt}</p>
    </header>
    <PracticeGuide title={data.title} steps={data.steps} language={language} client:load />
    <div class="sheet-tools no-print">
      <a class="text-link" href="#practice-steps">{copy.readAll} <span aria-hidden="true">↓</span></a>
      <button class="text-link" id="print-practice" type="button" hidden>{copy.print} <span aria-hidden="true">↗</span></button>
    </div>
    <ol id="practice-steps" class="practice-steps" tabindex="-1" aria-label={copy.allSteps}>
      {data.steps.map((step, index) => <li><div class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div><div><p class="step-time">{step.minutes} {copy.min}</p><h2>{step.title}</h2><p>{step.detail}</p></div></li>)}
    </ol>
    <section class="story-frame">
      <div><p class="eyebrow">{copy.prompts}</p><h2>{data.frameTitle}</h2><p>{data.prompts.map(prompt => <span class="speaking-prompt">“{prompt}”</span>)}</p><p class="sheet-note">{copy.ownWords}</p></div>
      <div class="listener-note"><h3>{copy.listener}</h3><p>{data.listenerGuide}</p><p><strong>{copy.try}</strong> “{data.feedbackExample}”</p><p class="sheet-note">{copy.small}</p></div>
    </section>
    <section class="reflection"><h2>{copy.reflection}</h2><p>{copy.reflectionNote}</p><div class="writing-lines" aria-hidden="true"><div></div><div></div></div></section>
    <footer class="sheet-footer"><p lang="en">SpeakKai · speakkai.com{path}</p><p>{copy.boundary}</p><div class="actions no-print"><a class="button" href={nextStep.href}>{nextStep.label} <span aria-hidden="true">↗</span></a><a class="text-link" href="/resources/">{copy.allResources}</a></div></footer>
  </article>
</FlagshipLayout>
<script>
  const printButton = document.querySelector<HTMLButtonElement>("#print-practice")!;
  printButton.hidden = false;
  printButton.addEventListener("click", () => window.print());
</script>
<style>
  .practice-language { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; margin-top: 12px; }
  .practice-language nav { display: flex; gap: 12px; }
  .practice-language a { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 12px; text-underline-offset: 5px; }
  .practice-language [aria-current="page"] { background: var(--wash); font-weight: 700; }
  .practice-language p { font-size: 14px; color: var(--muted); }
  :global(html[lang="zh-CN"]) h1 { font-size: clamp(32px, 4.5vw, 58px); }
  .speaking-prompt { display: block; }
  .sheet-tools { display: flex; flex-wrap: wrap; gap: 16px 30px; align-items: center; margin-bottom: 24px; }
  .sheet-tools button { background: none; border: 0; padding-block: 12px; }
  h1 { max-width: 800px; }
  .practice-sheet {
    max-width: 960px;
    padding-block: 36px 72px;
  }
  .sheet-intro {
    padding-block: 20px;
  }
  .sheet-intro .eyebrow {
    color: var(--blue);
  }
  h1 {
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 600;
    margin-top: 18px;
  }
  .sheet-intro > p:not(.eyebrow) {
    margin-top: 16px;
    max-width: 640px;
    font-size: 17px;
    color: var(--muted);
  }
  .sheet-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 600;
  }
  .sheet-intro > p.sheet-note,
  .sheet-note {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }
  button {
    font-family: inherit;
    cursor: pointer;
  }
  [hidden] {
    display: none !important;
  }
  .practice-steps {
    padding: 0;
    list-style: none;
    margin: 12px 0 40px;
  }
  .practice-steps li {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 25px;
    border-top: 1px solid var(--line);
    padding-block: 28px;
    break-inside: avoid;
  }
  .step-number {
    color: var(--blue);
    font-size: 22px;
    font-weight: 600;
  }
  .step-time {
    font-size: 14px;
    color: var(--muted);
  }
  h2 {
    font-size: 28px;
    font-weight: 600;
  }
  .practice-steps h2 {
    margin-top: 8px;
  }
  .practice-steps li > div > p:last-child {
    margin-top: 14px;
    max-width: 650px;
  }
  .story-frame {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    background: var(--wash);
    padding: 32px;
  }
  .story-frame h2 {
    margin-top: 16px;
  }
  .story-frame p:not(.eyebrow) {
    margin-top: 18px;
  }
  .listener-note {
    border-left: 3px solid var(--yellow);
    padding-left: 24px;
  }
  .listener-note h3 {
    font-size: 22px;
    font-weight: 600;
  }
  .reflection {
    padding-top: 40px;
    break-inside: avoid;
  }
  .reflection > p {
    margin-top: 14px;
    color: var(--muted);
  }
  .writing-lines {
    max-width: 700px;
  }
  .writing-lines div {
    height: 40px;
    border-bottom: 1px solid #b5bfd1;
  }
  .sheet-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .sheet-footer > p {
    font-size: 14px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  @media (max-width: 650px) {
    .story-frame {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 24px;
    }
    .practice-steps li {
      grid-template-columns: 32px 1fr;
      gap: 14px;
    }
    .practice-steps h2 {
      font-size: 25px;
    }
    .practice-sheet {
      padding-top: 24px;
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .no-print,
    :global(.breadcrumbs) {
      display: none !important;
    }
    :global(body.flagship) {
      font-size: 11pt;
      color: #111;
      background: white;
    }
    .practice-sheet {
      width: 100%;
      max-width: none;
      padding: 0;
    }
    .sheet-intro {
      padding: 0 0 12px;
    }
    h1 {
      font-size: 30pt;
      margin-top: 10px;
    }
    .sheet-intro > p:not(.eyebrow) {
      font-size: 11pt;
      margin-top: 10px;
    }
    .sheet-meta {
      margin-top: 10px;
    }
    .sheet-intro .sheet-note,
    .sheet-note {
      font-size: 9pt;
    }
    .practice-steps {
      margin: 6px 0 16px;
    }
    .practice-steps li {
      padding-block: 12px;
      grid-template-columns: 30px 1fr;
      gap: 14px;
    }
    .practice-steps h2,
    h2 {
      font-size: 16pt;
    }
    .practice-steps li > div > p:last-child {
      margin-top: 6px;
    }
    .step-time,
    .step-number {
      font-size: 10pt;
    }
    .story-frame {
      padding: 16px;
      gap: 24px;
      break-inside: avoid;
    }
    .listener-note h3 {
      font-size: 14pt;
    }
    .reflection {
      padding-top: 20px;
    }
    .sheet-footer {
      margin-top: 16px;
      padding-top: 10px;
    }
    .sheet-footer > p {
      font-size: 9pt;
    }
  }
</style>


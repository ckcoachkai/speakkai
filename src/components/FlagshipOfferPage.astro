---
import type { Offer } from "../data/flagshipOffers";
import { getCollection } from "astro:content";
import FlagshipCurrentProgram from "./FlagshipCurrentProgram.astro";
import FlagshipBreadcrumbs from "./FlagshipBreadcrumbs.astro";
interface Props {
  offer: Offer;
}
const { offer } = Astro.props;
const lessons = await getCollection("practice", ({ data }) => data.published && data.followUp === offer.slug);
---

<section class="offer-hero wrap">
  <FlagshipBreadcrumbs label={offer.audience} />
  <p class="eyebrow">{offer.audience}</p>
  <h1>{offer.headline}<br /><em>{offer.emphasis}</em></h1>
  <p class="hero-lead">{offer.introduction}</p>
  <div class="actions">
    <a class="button" href="#next-step"
      >{offer.label}<span aria-hidden="true">↗</span></a
    ><a class="text-link" href="#formats"
      >Explore the formats <span aria-hidden="true">↓</span></a
    >
  </div>
</section>
<section class="fit-section">
  <div class="wrap fit-grid">
    <div>
      <p class="eyebrow">Is this the right fit?</p><h2>{offer.fitTitle}</h2>
    </div><ul>{offer.fit.map((item) => <li>{item}</li>)}</ul>
  </div>
</section>
<section class="section wrap" id="formats">
  <div class="section-heading">
    <p class="eyebrow">Ways to work together</p><h2>
      Choose a direction.<br /><span class="muted"
        >Shape the details with Kai.</span
      >
    </h2>
  </div><div class="offer-grid">
    {
      offer.formats.map((format, index) => (
        <article class="offer">
          <>
            <span class="index">0{index + 1}</span>
            <h3>{format.title}</h3>
            <p>{format.detail}</p>
          </>
        </article>
      ))
    }
  </div><p class="section-note">
    Scope, delivery, fees and availability are confirmed in conversation.
  </p>
</section>
{offer.slug === "coaching" && <FlagshipCurrentProgram />}
<section class="practice-section">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">What the practice develops</p><h2>
        Progress you can<br /><em>put into practice.</em>
      </h2>
    </div><ol class="method-grid">
      {
        offer.outcomes.map((outcome, index) => (
          <li>
            <>
              <span class="index">0{index + 1}</span>
              <h3>{outcome.title}</h3>
              <p>{outcome.detail}</p>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</section>
<section class="section wrap exercise-section">
  <div>
    <p class="eyebrow">Try a speaking prompt</p><h2>{offer.example.title}</h2><p
    >
      {offer.example.prompt}
    </p><p class="section-note">
      Try it aloud, then choose one thing to make clearer.
    </p>
    {lessons.length > 0 && <nav aria-label="Related practice">{lessons.map(lesson => <p class="section-note"><a class="text-link" href={`/resources/${lesson.id}/`}>Free activity: {lesson.data.title} <span aria-hidden="true">↗</span></a></p>)}</nav>}
  </div><ol>{offer.example.steps.map((step) => <li>{step}</li>)}</ol>
</section>
<section class="faq-section wrap" aria-labelledby="faq-title">
  <div class="section-heading">
    <p class="eyebrow">Before you decide</p><h2 id="faq-title">
      A few useful answers.
    </h2>
  </div><div class="faq-list">
    {
      offer.questions.map((faq) => (
        <details>
          <>
            <summary>
              {faq.question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{faq.answer}</p>
          </>
        </details>
      ))
    }
  </div>
</section>
<section class="connect-section" id="next-step">
  <div class="wrap connect-grid">
    <div>
      <p class="eyebrow">Talk through the fit</p><h2>
        Bring the goal.<br />We’ll start there.
      </h2><p>{offer.nextStep}</p><a
        class="button button-yellow"
        href={`/contact/?audience=${offer.slug}`}
        >Prepare your inquiry <span aria-hidden="true">↗</span></a
      ><p class="contact-note">
        WeChat: <strong>CKcoachkai</strong> · <a href="/schedule/"
          >View the schedule</a
        >
      </p>
    </div><aside class="contact-aside">
      <p class="eyebrow">What happens next</p><ol class="next-steps">
        <li>Share your situation and goal.</li><li>
          Discuss a suitable approach with Kai.
        </li><li>Agree the scope, fees and schedule before booking.</li>
      </ol><a class="text-link" href="/resources/"
        >Explore free practice resources <span aria-hidden="true">↗</span></a
      >
    </aside>
  </div>
</section>

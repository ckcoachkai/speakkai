---
import { experiments } from "../data/experimentLab";

interface Props {
  current: number;
}

const { current } = Astro.props;
const index = experiments.findIndex((experiment) => experiment.id === current);
const previous = experiments[index - 1];
const next = experiments[index + 1];
---

<nav class="experiment-nav" aria-label="Homepage experiment navigation">
  <a class="gallery-link" href="/tests/">All tests</a>
  <div class="step-links">
    {previous ? <a href={`/tests/${previous.id}/`} aria-label={`Previous: Test ${previous.id}`}>← {previous.id}</a> : <span aria-hidden="true">←</span>}
    <strong>Test {current}</strong>
    {next ? <a href={`/tests/${next.id}/`} aria-label={`Next: Test ${next.id}`}>{next.id} →</a> : <span aria-hidden="true">→</span>}
  </div>
  <details>
    <summary>Jump to</summary>
    <ol>
      {experiments.map((experiment) => (
        <li>
          <a href={`/tests/${experiment.id}/`} aria-current={experiment.id === current ? "page" : undefined}>
            <span>{experiment.id}</span>{experiment.name}
          </a>
        </li>
      ))}
    </ol>
  </details>
</nav>

<style>
  .experiment-nav {
    position: relative;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 52px;
    align-items: center;
    gap: 18px;
    padding: 7px clamp(14px, 2.5vw, 34px);
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    color: inherit;
    background: color-mix(in srgb, var(--lab-bg, #0b1020) 88%, transparent);
    backdrop-filter: blur(16px);
    font: 800 12px/1.2 ui-sans-serif, system-ui, sans-serif;
  }

  a { color: inherit; text-decoration: none; }
  .gallery-link { justify-self: start; }
  .step-links { display: flex; align-items: center; gap: 13px; }
  .step-links a, .step-links span { min-width: 32px; text-align: center; }
  .step-links strong { color: var(--lab-accent, #ffcc00); }
  details { position: relative; justify-self: end; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  details[open] summary { color: var(--lab-accent, #ffcc00); }
  ol {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(150px, 1fr));
    width: min(430px, calc(100vw - 28px));
    max-height: min(560px, calc(100vh - 90px));
    margin: 0;
    padding: 10px;
    overflow: auto;
    border: 1px solid color-mix(in srgb, var(--lab-accent, #ffcc00) 45%, transparent);
    border-radius: 14px;
    background: var(--lab-bg, #0b1020);
    box-shadow: 0 24px 60px rgb(0 0 0 / 32%);
    list-style: none;
  }
  li a { display: flex; gap: 9px; padding: 9px; border-radius: 8px; font-size: 10px; }
  li a span { color: var(--lab-accent, #ffcc00); }
  li a:hover, li a:focus-visible, li a[aria-current="page"] { background: color-mix(in srgb, var(--lab-accent, #ffcc00) 14%, transparent); }
  a:focus-visible, summary:focus-visible { outline: 3px solid var(--lab-accent, #ffcc00); outline-offset: 3px; }

  @media (max-width: 600px) {
    .experiment-nav { grid-template-columns: auto 1fr auto; gap: 8px; }
    .gallery-link { font-size: 0; }
    .gallery-link::after { font-size: 12px; content: "Gallery"; }
    ol { grid-template-columns: 1fr; }
  }
</style>

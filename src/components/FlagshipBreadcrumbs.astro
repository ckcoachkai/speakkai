---
interface Props {
  label: string;
  language?: "en" | "zh-CN";
}
const { label, language = "en" } = Astro.props;
---

<nav class="breadcrumbs" aria-label={language === "zh-CN" ? "当前位置" : "Breadcrumb"}>
  <a href="/">{language === "zh-CN" ? "首页（英文）" : "Home"}</a><span aria-hidden="true">/</span><span aria-current="page" lang="en"
    >{label}</span>
</nav>
<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
    padding-block: 8px;
  }
  .breadcrumbs a {
    padding-block: 4px;
    text-underline-offset: 4px;
  }
</style>

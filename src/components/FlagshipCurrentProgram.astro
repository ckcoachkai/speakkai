---
import { currentProgram as program } from "../data/currentProgram";
---

<section class="current-program wrap" aria-labelledby="current-program-title">
  <div>
    <p class="eyebrow">
      {program.season} · {program.audience} · {program.classes} classes
    </p>
    <h2 id="current-program-title">{program.name}</h2>
    <p>
      Short, achievable speaking challenges. {program.description}
    </p>
  </div>
  <a class="button" href={program.href}
    >Explore the course <span aria-hidden="true">↗</span></a
  >
</section>

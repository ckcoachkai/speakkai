---
import FlagshipCurrentProgram from "./FlagshipCurrentProgram.astro";
import FlagshipChineseCourseEntry from "./FlagshipChineseCourseEntry.astro";
import FlagshipMethodExamples from "./FlagshipMethodExamples.astro";
import { homeCopy, type SiteLanguage } from "../data/homeCopy";
import { localizedPath, destinationLabel } from "../lib/siteLanguage.mjs";
interface Props { language?: SiteLanguage }
const { language = "en" } = Astro.props;
const copy = homeCopy[language];
const chinese = language === "zh-CN";
const link = (path: string) => localizedPath(path, language);
const label = (text: string, path: string) => destinationLabel(text, path, language);
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{copy.identity}</p>
    <h1 id="hero-title">{copy.headline[0]}<br /><em>{copy.headline[1]}</em></h1>
    <p class="hero-lead">{copy.lead}</p>
    <div class="actions"><a class="button" href="#work">{copy.start}<span aria-hidden="true">↗</span></a><a class="text-link" href="#story">{copy.meet}<span aria-hidden="true">↓</span></a></div>
    {!chinese && <FlagshipChineseCourseEntry />}
    <nav class="audience-shortcuts" aria-label={copy.audienceLabel}>
      {copy.offers.map((offer,index)=><a href={link(offer.href)}>{label(copy.shortcuts[index],offer.href)} <span aria-hidden="true">↗</span></a>)}
    </nav>
    <p class="hero-location">{copy.scope}<br />{copy.location}</p>
  </div>
  <figure class="hero-portrait">
    <img src="/images/coach-kai-headshot.webp" srcset="/images/coach-kai-headshot-360.webp 360w, /images/coach-kai-headshot-720.webp 720w, /images/coach-kai-headshot-1080.webp 1080w, /images/coach-kai-headshot.webp 1400w" sizes="(max-width: 720px) calc(100vw - 44px), (max-width: 1000px) calc((90vw - 28px) / 2.25), 500px" alt={copy.portraitAlt} width="1400" height="1400" fetchpriority="high" loading="eager" />
    <figcaption><span>{copy.portraitCaption[0]}</span><strong>{copy.portraitCaption[1]}</strong></figcaption>
  </figure>
</section>
<section class="experience-bar" aria-label={copy.experienceLabel}>
  <div class="wrap">{copy.experience.map(item=><p><strong>{item[0]}</strong><span>{item[1]}</span></p>)}<a href="#story">{copy.experienceLink}<span aria-hidden="true">↗</span></a></div>
</section>
<section class="section wrap" id="work" aria-labelledby="work-title">
  <div class="section-heading"><p class="eyebrow">{copy.workLabel}</p><h2 id="work-title">{copy.workTitle[0]}<br /><span class="muted">{copy.workTitle[1]}</span></h2></div>
  <div class="offer-grid">{copy.offers.map((offer,index)=><article class="offer"><div class="offer-top"><span class="index">0{index+1}</span><span>{offer.audience}</span></div><h3>{offer.title}</h3><p>{offer.copy}</p><p class="offer-detail">{offer.detail}</p><a class="text-link" href={link(offer.href)}>{label(offer.action,offer.href)}<span aria-hidden="true">↗</span></a></article>)}</div>
</section>
<FlagshipCurrentProgram language={language} />
<section class="story-section" id="story" aria-labelledby="story-title">
  <div class="wrap story-grid">
    <figure class="stage-photo"><img src="/images/test-business/kai-training-stage.webp" width="668" height="606" loading="lazy" alt={copy.stageAlt} /><figcaption>{copy.stageCaption}</figcaption></figure>
    <div class="story-copy"><p class="eyebrow">{copy.storyLabel}</p><h2 id="story-title">{copy.storyTitle[0]}<br /><em>{copy.storyTitle[1]}</em></h2>{copy.story.map(text=><p>{text}</p>)}<a class="text-link" href="#connect">{copy.storyAction}<span aria-hidden="true">↗</span></a></div>
  </div>
</section>
<section class="section wrap method" aria-labelledby="method-title">
  <div class="section-heading"><p class="eyebrow">{copy.methodLabel}</p><h2 id="method-title">{copy.methodTitle[0]}<br /><span class="muted">{copy.methodTitle[1]}</span></h2><p>{copy.methodIntro}</p></div>
  <ol class="method-grid">{copy.method.map((step,index)=><li><span class="index">0{index+1} / {step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p></li>)}</ol>
  <FlagshipMethodExamples language={language} />
</section>
<section class="connect-section" id="connect" aria-labelledby="connect-title">
  <div class="wrap connect-grid">
    <div><p class="eyebrow">{copy.connectLabel}</p><h2 id="connect-title">{copy.connectTitle[0]}<br />{copy.connectTitle[1]}</h2><p>{copy.connectIntro}</p>
      <a class="button button-yellow" href={link('/contact/')}>{copy.contactAction}<span aria-hidden="true">↗</span></a>
      <p class="contact-note"><span lang="en">WeChat: <strong>CKcoachkai</strong></span> · <a href="/schedule/">{label(copy.scheduleAction,'/schedule/')}</a></p>
    </div>
    <div class="contact-aside"><a href="/images/coach-kai-wechat-qr.png" class="home-qr" aria-label={copy.qrLabel}><img src="/images/coach-kai-wechat-qr.png" width="938" height="1340" loading="lazy" alt={copy.qrAlt} /></a>
      <span class="eyebrow">{copy.before}</span><p>{copy.brief}</p><p>{copy.confirmation}</p><a class="text-link" href={link('/resources/')}>{copy.practiceAction}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

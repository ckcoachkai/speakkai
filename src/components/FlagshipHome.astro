---
import FlagshipCurrentProgram from "./FlagshipCurrentProgram.astro";
const offers = [
  {
    number: "01",
    audience: "Students & parents",
    title: "A voice of their own.",
    copy: "Help your child organize ideas, tell stories and speak with growing independence. Coaching for everyday confidence and important speaking moments.",
    detail: "Speech · Storytelling · Debate",
    action: "Explore student coaching",
    href: "/coaching/",
  },
  {
    number: "02",
    audience: "Schools & educators",
    title: "A culture of speaking.",
    copy: "Bring purposeful speaking practice into your school. Discuss custom curricula and workshops that connect classroom learning to the moments students need to be heard.",
    detail: "Curricula · Workshops · Teacher training",
    action: "Explore school programs",
    href: "/schools/",
  },
  {
    number: "03",
    audience: "Companies & event teams",
    title: "Ideas that move a room.",
    copy: "Make presentations clearer and conversations more effective. Explore a keynote, practical team workshop or coaching for a high-stakes presentation.",
    detail: "Keynotes · Team training · Executive coaching",
    action: "Explore talks & training",
    href: "/companies/",
  },
];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span> Kai Liu · Communication
      coach & speaker
    </p><h1 id="hero-title">Make yourself<br /><em>understood.</em></h1><p
      class="hero-lead"
    >
      Great ideas deserve to be heard. Build the clarity, confidence and
      connection to make yours matter.
    </p><div class="actions">
      <a class="button" href="#work"
        >Find your starting point <span aria-hidden="true">↗</span></a
      ><a class="text-link" href="#story"
        >Meet your coach <span aria-hidden="true">↓</span></a
      >
    </div>
    <nav class="audience-shortcuts" aria-label="Choose your audience">
      <a href="/coaching/">For students <span aria-hidden="true">↗</span></a>
      <a href="/schools/">For schools <span aria-hidden="true">↗</span></a>
      <a href="/companies/">For companies <span aria-hidden="true">↗</span></a>
    </nav>
    <p class="hero-location">
      Public speaking education · Keynotes · Team training<br />Shanghai, online
      & by arrangement
    </p>
  </div><figure class="hero-portrait">
    <img
      src="/images/coach-kai-headshot.webp"
      alt="Kai Liu, communication coach at SpeakKai"
      width="1400"
      height="1400"
      fetchpriority="high"
    /><figcaption>
      <span>More than a polished speech.</span><strong
        >A stronger speaker.</strong
      >
    </figcaption>
  </figure>
</section>
<section class="experience-bar" aria-label="Kai’s published career experience">
  <div class="wrap">
    <p><strong>15+ years</strong><span>in education & communication</span></p><p
    >
      <strong>1,000+</strong><span>presentations across 7 countries</span>
    </p><p><strong>2,000+</strong><span>students trained</span></p><a
      href="#story"
      >The person behind the practice <span aria-hidden="true">↗</span></a
    >
  </div>
</section>
<section class="section wrap" id="work" aria-labelledby="work-title">
  <div class="section-heading">
    <p class="eyebrow">Your next speaking moment</p><h2 id="work-title">
      Different rooms.<br /><span class="muted"
        >The same human need to connect.</span
      >
    </h2>
  </div><div class="offer-grid">
    {
      offers.map((offer) => (
        <article class="offer">
          <>
            <div class="offer-top">
              <>
                <span class="index">{offer.number}</span>
                <span>{offer.audience}</span>
              </>
            </div>
            <h3>{offer.title}</h3>
            <p>{offer.copy}</p>
            <p class="offer-detail">{offer.detail}</p>
            <a class="text-link" href={offer.href}>
              {offer.action}
              <span aria-hidden="true">↗</span>
            </a>
          </>
        </article>
      ))
    }
  </div>
</section>
<FlagshipCurrentProgram />
<section class="story-section" id="story" aria-labelledby="story-title">
  <div class="wrap story-grid">
    <figure class="stage-photo">
      <img
        src="/images/test-business/kai-training-stage.webp"
        width="668"
        height="606"
        loading="lazy"
        alt="Kai leading a professional training session in front of an audience"
      /><figcaption>On stage. In the classroom. In your corner.</figcaption>
    </figure><div class="story-copy">
      <p class="eyebrow">Meet Kai Liu</p><h2 id="story-title">
        The coach who had to<br /><em>find his own voice.</em>
      </h2><p>
        A stutter. A fear of public speaking. The frustration of having
        something to say and struggling to say it.
      </p><p>
        As a first-generation Chinese American, Kai knows those moments
        personally. Teaching in China helped him find his voice. Coaching became
        the way he helps others find theirs.
      </p><p>
        His work spans education, speech and debate, competition preparation,
        and professional communication. The goal stays the same: help people
        think clearly, practise purposefully and connect with the audience in
        front of them.
      </p><a class="text-link" href="#connect"
        >Start a conversation with Kai <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</section>
<section class="section wrap method" aria-labelledby="method-title">
  <div class="section-heading">
    <p class="eyebrow">The SpeakKai approach</p><h2 id="method-title">
      Build the speaker.<br /><span class="muted">Not just the speech.</span>
    </h2><p>
      Progress comes from choices you can understand, practise and use again.
    </p>
  </div><ol class="method-grid">
    <li>
      <span class="index">01 / Think</span><h3>Find the real message.</h3><p>
        Start with your audience, your purpose and the one idea worth
        remembering.
      </p>
    </li><li>
      <span class="index">02 / Practise</span><h3>Make it work aloud.</h3><p>
        Shape your structure, voice and delivery under realistic speaking
        conditions.
      </p>
    </li><li>
      <span class="index">03 / Grow</span><h3>Know what to try next.</h3><p>
        Turn specific feedback into one useful adjustment. Then test it again.
      </p>
    </li>
  </ol>
</section>
<section class="connect-section" id="connect" aria-labelledby="connect-title">
  <div class="wrap connect-grid">
    <div>
      <p class="eyebrow">A conversation is a good beginning</p><h2
        id="connect-title"
      >
        What do you want<br />your voice to do?
      </h2><p>
        Tell Kai who is speaking, what they are preparing for, and what feels
        difficult. Together, you can discuss the right next step.
      </p><a class="button button-yellow" href="/contact/"
        >Open WeChat contact <span aria-hidden="true">↗</span></a
      ><p class="contact-note">
        WeChat: <strong>CKcoachkai</strong> · <a href="/schedule/"
          >View the schedule</a
        >
      </p>
    </div><div class="contact-aside">
      <a
        href="/images/coach-kai-wechat-qr.png"
        class="home-qr"
        aria-label="Open full-size WeChat contact QR"
        ><img
          src="/images/coach-kai-wechat-qr.png"
          width="938"
          height="1340"
          loading="lazy"
          alt="Complete WeChat contact card and QR code for Coach Kai"
        /></a
      ><span class="eyebrow">Before you get in touch</span><p>
        Share your audience, goal, preferred format and timing.
      </p><p>
        Program scope, fees and availability are agreed directly with Kai.
      </p><a class="text-link" href="/resources/"
        >Try a practice resource first <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</section>

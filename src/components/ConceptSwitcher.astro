---
interface Props {
  current: string;
  light?: boolean;
}

const { current, light = false } = Astro.props;
const concepts = [
  { id: "test", label: "Test", href: "/test/" },
  ...["1", "2", "3", "4", "5", "6", "7", "a", "9", "10"].map((id) => ({
    id,
    label: id === "a" ? "Test A" : `Test ${id}`,
    href: `/test${id}/`,
  })),
];
---

<aside class:list={["concept-switcher", { light }]} aria-label="Homepage concept switcher">
  <a class="lab-mark" href="/test/" aria-label="Return to the concept gallery">
    <span>SK</span><b>Concept Lab</b>
  </a>
  <nav aria-label="Choose a homepage concept">
    {concepts.map((concept) => (
      <a href={concept.href} aria-current={current === concept.id ? "page" : undefined}>
        {concept.label}
      </a>
    ))}
  </nav>
</aside>

<style>
  .concept-switcher {
    position: fixed;
    z-index: 1000;
    right: 18px;
    bottom: 18px;
    left: 18px;
    display: flex;
    min-height: 54px;
    align-items: center;
    gap: 18px;
    padding: 8px 10px;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 18px;
    background: rgb(5 10 25 / 84%);
    box-shadow: 0 18px 55px rgb(0 0 0 / 26%);
    color: #fff;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    backdrop-filter: blur(20px) saturate(150%);
  }
  .concept-switcher.light {
    border-color: rgb(10 28 62 / 12%);
    background: rgb(255 255 255 / 88%);
    box-shadow: 0 18px 55px rgb(12 29 61 / 16%);
    color: #10213d;
  }
  .lab-mark {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  .lab-mark span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 11px;
    color: #07142f;
    background: #ffd32a;
    font-size: 12px;
    font-weight: 950;
  }
  .lab-mark b { font-size: 12px; white-space: nowrap; }
  nav {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    gap: 5px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar { display: none; }
  nav a {
    display: inline-flex;
    min-height: 34px;
    flex: 1 0 auto;
    align-items: center;
    justify-content: center;
    padding: 7px 10px;
    border-radius: 10px;
    color: inherit;
    font-size: 11px;
    font-weight: 850;
    text-decoration: none;
    white-space: nowrap;
    opacity: .72;
  }
  nav a:hover { background: rgb(255 255 255 / 9%); opacity: 1; }
  .light nav a:hover { background: rgb(12 31 66 / 7%); }
  nav a[aria-current="page"] { color: #07142f; background: #ffd32a; opacity: 1; }
  nav a:focus-visible, .lab-mark:focus-visible { outline: 3px solid #55c7ff; outline-offset: 2px; }
  @media (max-width: 720px) {
    .concept-switcher { right: 9px; bottom: 9px; left: 9px; gap: 8px; border-radius: 15px; }
    .lab-mark b { display: none; }
    nav a { flex: 0 0 auto; }
  }
</style>

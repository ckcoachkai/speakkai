---
interface Props { inverse?: boolean; compact?: boolean; }
const { inverse = false, compact = false } = Astro.props;
---
<span class:list={["brand-081", { inverse, compact }]} data-brand="signature">
  <img src="/images/speakkai-logo-signature.svg" srcset="/images/speakkai-logo-signature.svg 1x, /images/speakkai-logo-signature.svg 2x" sizes={compact ? "145px" : "(max-width:760px) 175px, 220px"} width="440" height="172" alt="SpeakKai" loading="eager" />
</span>
<style>
  .brand-081 { display:inline-flex;align-items:center;width:220px;height:76px;vertical-align:middle;flex-shrink:0; }
  .brand-081 img { display:block;width:100%;height:100%;object-fit:contain; }
  .brand-081.inverse img { filter:brightness(0) invert(1); }
  .brand-081.compact { width:145px;height:50px; }
  @media(max-width:760px) { .brand-081:not(.compact) {width:175px;height:60px;} }
</style>

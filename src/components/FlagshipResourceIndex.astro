---
import { getCollection } from 'astro:content';
import ToolsGallery from './ToolsGallery.astro';
import FlagshipLayout from '../layouts/FlagshipLayout.astro';
import { practiceChinese } from '../data/practiceChinese';
import { localizedPath, destinationLabel } from '../lib/siteLanguage.mjs';
import { ArrowUpRight, BookOpen, MessageCircle, Presentation, Layers, Images } from '@lucide/astro';
interface Props { language?: 'en' | 'zh-CN'; }
const {language='en'}=Astro.props;
const zh=language==='zh-CN';
const tr=(en:string,cn:string)=>zh?cn:en;
const link=(path:string)=>localizedPath(path,language);
const audienceOrder={coaching:0,schools:1,companies:2};
const lessons=(await getCollection('practice',({data})=>data.published)).sort((a,b)=>audienceOrder[a.data.followUp]-audienceOrder[b.data.followUp]).map(lesson=>({...lesson,data:zh&&practiceChinese[lesson.id]?practiceChinese[lesson.id]:lesson.data}));
const icons={coaching:MessageCircle,schools:Layers,companies:Presentation};
---
<FlagshipLayout title={tr('Games, Apps & Speaking Resources | SpeakKai','游戏、应用与表达练习资源 | SpeakKai')} description={tr('Play free classroom games, choose a name picker, practice speaking or open a timer. Browse visual previews and launch in one click.','浏览免费的课堂游戏、点名器、表达练习和计时器。通过图片预览，快速打开。')} current="resources" language={language} contactHref={link('/contact/')}>
  <div class="resource-page" data-resources-version="visual-20261005">
    <div class="wrap resource-library">
      <header class="library-heading"><div><p class="eyebrow">{tr('THE SPEAKKAI PLAYBOOK','SPEAKKAI 练习工具箱')}</p><h1>{tr('Less scrolling.','轻松找到。')} <em>{tr('More doing.','马上开始。')}</em></h1><p class="intro-line">{tr('Pick something. Open it. Make your next turn count.','选一个，打开它，让下一次表达更精彩。')}</p></div><a class="practice-jump" href="#practice"><BookOpen size={18} aria-hidden="true" />{tr('Lessons & reading','练习与阅读')} <span aria-hidden="true">↓</span></a></header>
      <section aria-label={tr('Browse games and apps','浏览游戏与应用')}><ToolsGallery language={language} /></section>
      <section class="practice-section" id="practice" aria-labelledby="practice-library-title">
        <div class="section-title"><h2 id="practice-library-title">{tr('A little more practice.','再多练习一点。')}</h2><span>{tr('Guided activities · Printable sheets','分步活动 · 可打印练习单')}</span></div>
        <div class="lesson-grid">{lessons.map(lesson=>{const Icon=icons[lesson.data.followUp];return <a class="lesson-card" href={link('/resources/'+lesson.id+'/')} aria-label={destinationLabel(tr('Try the activity: '+lesson.data.title,'开始练习：'+lesson.data.title),'/resources/'+lesson.id+'/',language)}><span class:list={['lesson-art',lesson.data.followUp]}><Icon size={34} stroke-width={1.4} aria-hidden="true" /></span><div><span class="lesson-time">{tr(lesson.data.minutes+' min · '+lesson.data.steps.length+' steps',lesson.data.minutes+'分钟 · '+lesson.data.steps.length+'个步骤')}</span><h3>{lesson.data.title}</h3></div><ArrowUpRight size={21} aria-hidden="true" /></a>;})}</div>
        <div class="discovery-grid"><a class="discovery-card topics" href="/topic/"><BookOpen size={32} stroke-width={1.5} aria-hidden="true" /><div><span>{tr('Illustrated news · September 2026','图解新闻 · 2026年9月')}</span><h3>{tr('100 stories to explore','100个故事等你探索')}</h3></div><ArrowUpRight size={23} aria-hidden="true" /></a><a class="discovery-card visuals" href={link('/watch/')}><Images size={32} stroke-width={1.5} aria-hidden="true" /><div><span>{tr('Animations · Picture stories','动画 · 图片故事')}</span><h3>{tr('See it. Say it.','看见，然后表达。')}</h3></div><ArrowUpRight size={23} aria-hidden="true" /></a></div>
      </section>
      <div class="resource-next"><span>{tr('Want a learning plan?','想制定学习计划？')}</span><a href={link('/coaching/young-competition-speakers/')}>{tr('Explore the Fall course','了解秋季课程')} ↗</a><a href={link('/contact/')}>{tr('Talk with Kai','联系 Kai')} ↗</a></div>
    </div>
  </div>
</FlagshipLayout>

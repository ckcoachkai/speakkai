---
import { getCollection } from "astro:content";
import ToolsGallery from "./ToolsGallery.astro";
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipChineseCourseEntry from "./FlagshipChineseCourseEntry.astro";
import { practiceChinese } from "../data/practiceChinese";
import { localizedPath, destinationLabel } from "../lib/siteLanguage.mjs";
interface Props { language?: "en" | "zh-CN"; }
const {language = "en"} = Astro.props;
const chinese = language === "zh-CN";
const tr = (en: string, zh: string) => chinese ? zh : en;
const link = (path: string) => localizedPath(path,language);
const audienceOrder = { coaching: 0, schools: 1, companies: 2 };
const audienceLabels = { coaching: tr("Students & parents","学生与家长"), schools: tr("Schools & educators","学校与教育工作者"), companies: tr("Adults & teams","成人与职场团队") };
const lessons = (await getCollection("practice", ({ data }) => data.published)).sort((a, b) => audienceOrder[a.data.followUp] - audienceOrder[b.data.followUp] || a.data.title.localeCompare(b.data.title)).map(lesson => ({...lesson,data:chinese && practiceChinese[lesson.id] ? practiceChinese[lesson.id] : lesson.data}));
---

<FlagshipLayout
  title={tr("Free Speaking Practice for Students, Schools & Teams | SpeakKai", "学生、学校与团队的免费表达练习 | SpeakKai")}
  description={tr("Choose a free speaking activity for a child, a classroom or a workplace team. Follow short practice steps, use a printable sheet, or explore classroom tools.", "为孩子、课堂或职场团队选择一个免费的表达活动。按步骤练习，使用可打印的练习单，或探索课堂工具。")}
  language={language}
  current="resources"
  contactHref={chinese ? "/zh/#connect" : "/contact/"}
>
  <section class="wrap resource-intro">
    <p class="eyebrow">{tr("Put an idea into practice", "把一个想法说出来")}</p><h1>
      {tr("Make your next", "让下一次尝试")}<br /><em>{tr("attempt count.", "有一个明确的方向。")}</em>
    </h1><p>
      {tr("Choose a practice for your child, your class or your team. Each one includes a guided round and a printable sheet.", "为孩子、班级或团队选一个练习。每项活动都包含分步引导，以及可打印的完整练习单。")}
    </p>
    {!chinese && <FlagshipChineseCourseEntry />}
  </section>
  <section class="wrap resource-lessons" aria-labelledby="practice-library-title">
    <h2 id="practice-library-title">{tr("Find your starting point.", "找到适合你的起点。")}</h2>
    <div class="lesson-grid">
      {lessons.map(lesson => <article class="resource-feature" aria-labelledby={`lesson-${lesson.id}`}>
        <div><p class="eyebrow">{audienceLabels[lesson.data.followUp]}</p><h3 id={`lesson-${lesson.id}`}>{lesson.data.title}{!chinese && "."}</h3><p>{lesson.data.introduction}</p><span class="resource-meta">{chinese ? `约 ${lesson.data.minutes} 分钟 · ${lesson.data.steps.length} 个步骤` : `About ${lesson.data.minutes} minutes · ${lesson.data.steps.length} steps`}</span></div>
        <a class="button" href={link(`/resources/${lesson.id}/`)} aria-label={destinationLabel(chinese ? `开始练习：${lesson.data.title}` : `Try the activity: ${lesson.data.title}`,`/resources/${lesson.id}/`,language)}>{destinationLabel(tr("Try the activity","开始练习"),`/resources/${lesson.id}/`,language)} <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </section>
  <section class="wrap resource-voice" aria-labelledby="voice-tool">
    <div>
      <p class="eyebrow">{tr("Listen to your delivery", "听听自己的表达")}</p><h2 id="voice-tool" lang="en">
        Filler Alarm
      </h2><p>
        {tr("Explore the existing speaking practice tool and its on-device detection options.", "了解现有的表达练习工具，以及在设备上进行检测的选项。工具界面为英文。")}
      </p>
    </div><a class="text-link" href="/speak/"
      >{tr("Open Filler Alarm", "打开 Filler Alarm（英文）")} <span aria-hidden="true">↗</span></a>
  </section>
  <section class="wrap resource-tools" aria-labelledby="tools-title">
    <div class="section-heading">
      <p class="eyebrow">{tr("For practice and participation", "用于练习与参与")}</p><h2 id="tools-title">
        {tr("Tools for the room.", "课堂与活动工具。")}
      </h2><p>
        {tr("Timers, prompts and name pickers for speakers, teachers and groups.", "适合表达者、教师与小组的计时器、提示与随机点名工具。工具界面为英文。")}
      </p>
    </div><ToolsGallery headingLevel="h3" language={language} />
  </section>
  <section class="wrap resource-next">
    <h2>{tr("Looking for a learning plan?", "希望制定学习计划？")}</h2><p>
      {tr("Explore the Fall course for Grades 1–2 or discuss another speaking goal with Kai.", "了解面向 1–2 年级的秋季课程，或与 Kai 讨论其他表达目标。")}
    </p><div class="actions">
      <a class="button" href={link("/coaching/young-competition-speakers/")}
        >{tr("Explore the Fall course", "了解秋季课程")} <span aria-hidden="true">↗</span></a
      ><a class="text-link" href={chinese ? "/zh/#connect" : "/contact/"}>{tr("Talk with Kai", "联系 Kai")}</a>
    </div>
  </section>
</FlagshipLayout>
<style>
  .resource-intro {
    padding-block: 52px 38px;
  }
  .resource-intro .eyebrow,
  .resource-feature .eyebrow,
  .resource-voice .eyebrow {
    color: var(--blue);
  }
  h1 {
    font-size: clamp(44px, 5.5vw, 74px);
    font-weight: 600;
    margin-top: 18px;
  }
  .resource-intro > p:last-child {
    font-size: 18px;
    color: var(--muted);
    max-width: 590px;
    margin-top: 22px;
  }
  .resource-lessons > h2 { font-size: 26px; margin-bottom: 24px; }
  .lesson-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .resource-feature {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: start;
    gap: 24px;
    background: var(--wash);
    border-top: 3px solid var(--yellow);
    padding: 28px;
  }
  .resource-feature > div {
    max-width: 600px;
  }
  .resource-feature h3 {
    font-size: 30px;
    margin-top: 14px;
  }
  .resource-feature p:not(.eyebrow) {
    margin-top: 20px;
  }
  .resource-meta {
    display: block;
    font-size: 14px;
    color: var(--muted);
    margin-top: 18px;
  }
  .resource-feature .button {
    flex-shrink: 0;
  }
  .resource-voice {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: center;
    padding-block: 35px;
    border-bottom: 1px solid var(--line);
  }
  .resource-voice h2 {
    font-size: 28px;
    margin-top: 12px;
  }
  .resource-voice p:not(.eyebrow) {
    margin-top: 16px;
    color: var(--muted);
  }
  .resource-tools {
    padding-block: 64px;
  }
  .resource-tools :global(.tool-card) {
    box-shadow: none;
    border-color: var(--line);
  }
  .resource-tools :global(.tool-card:hover) {
    translate: none;
    box-shadow: none;
  }
  .resource-next {
    padding-block: 36px 64px;
    border-top: 1px solid var(--line);
  }
  .resource-next h2 {
    font-size: 32px;
  }
  .resource-next > p {
    margin-top: 18px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .lesson-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .resource-feature,
    .resource-voice {
      flex-direction: column;
      align-items: start;
      gap: 24px;
    }
    .resource-feature {
      padding: 24px;
    }
    .resource-feature h3 {
      font-size: 30px;
    }
    .resource-intro {
      padding-top: 32px;
    }
    .resource-tools {
      padding-block: 48px;
    }
  }
</style>

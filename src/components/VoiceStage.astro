---
const { words = ['THINK','SPEAK','CONNECT'], chinese = false } = Astro.props;
---
<figure class="portrait-scene" data-reveal>
  <div class="portrait-frame"><img src="/images/coach-kai-seated-960.webp" srcset="/images/coach-kai-seated-480.webp 480w, /images/coach-kai-seated-960.webp 960w" sizes="(max-width:720px) 90vw, 45vw" width="960" height="1280" fetchpriority="high" alt={chinese?'沟通教练 Kai Liu':'Kai Liu, communication coach at SpeakKai'}/><span class="portrait-corner" aria-hidden="true">↗</span></div>
  <figcaption><span>KAI LIU / SPEAKKAI</span><strong>{words.join(' · ')}</strong></figcaption>
</figure>

---
import {
  ArrowRight,
  Disc3,
  Drama,
  Gamepad2,
  Swords,
  Timer,
} from "@lucide/astro";
interface Props {
  headingLevel?: "h2" | "h3";
  language?: "en" | "zh-CN";
}
const { headingLevel = "h2", language = "en" } = Astro.props;
const chinese = language === "zh-CN";
const Heading = headingLevel;

const sections = [
  {
    title: "Games",
    zhTitle: "游戏",
    description: "Playable browser games and larger game projects created for classes, practice, or personal design work.",
    zhDescription: "为课堂、练习或个人设计项目制作的浏览器游戏与大型游戏项目。",
    tools: [
      {name: "Keeperfall", zhName: "Keeperfall 地牢游戏", description: "A complete local dungeon-building and automatic-raiding game with a persistent keeper, creatures, loot and rivals.", zhDescription: "完整的本地地牢经营与自动远征游戏，包含守护者、伙伴、装备和对手。", href: "/games/keeperfall/", image: "/images/game-previews/keeperfall.png", imageAlt: "Keeperfall dungeon game interface", zhImageAlt: "Keeperfall 地牢游戏界面", label: "Browser game", zhLabel: "浏览器游戏", icon: Gamepad2},
      {name: "Mouse House", zhName: "Mouse House 点名追逐", description: "A cartoon maze chase where mice, cheese and a cat pick the next student through a simulated race.", zhDescription: "用老鼠、奶酪和猫的迷宫追逐，模拟选出下一位学生。", href: "/games/mouse-house/", image: "/images/game-previews/mouse-house.png", imageAlt: "Mouse House maze chase name picker", zhImageAlt: "Mouse House 迷宫追逐点名器", label: "Classroom game", zhLabel: "课堂游戏", icon: Gamepad2},
      {name: "Class Charades", zhName: "课堂比划猜词", description: "Run fast-paced charades rounds with prompts, a timer, and live team scoring.", zhDescription: "使用提示、计时器和实时小组计分，组织快速的比划猜词活动。", href: "/tools/class-charades/", image: "/images/class-charades-preview.png", imageAlt: "Class Charades game arena preview", zhImageAlt: "课堂比划猜词游戏界面预览", label: "Classroom game", zhLabel: "课堂游戏", icon: Drama},
    ],
  },
  {
    title: "Name Pickers",
    zhTitle: "点名器",
    description: "Randomizers and participation games for choosing the next speaker without a plain list.",
    zhDescription: "用随机器和参与型游戏选择下一位发言者，而不是只看名单。",
    tools: [
      {name: "The Hungry Forest", zhName: "森林点名游戏", description: "A lively name picker with dancing characters, banana boosts and a new turn for every student.", zhDescription: "选择会跳舞的角色，让学生在香蕉加速的趣味赛跑中轮流参与。", href: "/forest/", image: "/forest/preview.webp", imageAlt: "Moonlit forest for The Hungry Forest classroom name picker", zhImageAlt: "森林点名游戏的月光森林场景", label: "Name picker", zhLabel: "点名器", icon: Gamepad2},
      {name: "Ice Drop", zhName: "Ice Drop 冰面点名", description: "A dramatic 3D name picker where students stand on melting ice and the first fall chooses the turn.", zhDescription: "学生站在融化冰面上的 3D 点名器，先掉落者进入本轮。", href: "/games/ice-drop/", image: "/images/game-previews/ice-drop.png", imageAlt: "Ice Drop 3D classroom name picker", zhImageAlt: "Ice Drop 3D 课堂点名器", label: "3D name picker", zhLabel: "3D 点名器", icon: Gamepad2},
      {name: "Marble Name Picker", zhName: "弹珠点名器", description: "Release player marbles and let the physics board choose the next participant.", zhDescription: "释放代表参与者的弹珠，让物理轨道选出下一位参与者。", href: "/tools/marble-name-picker/", image: "/images/marble-name-picker-preview.png", imageAlt: "Marble Name Picker physics board preview", zhImageAlt: "弹珠点名器物理轨道预览", label: "Name picker", zhLabel: "点名器", icon: Gamepad2},
      {name: "Wheel of Doom", zhName: "随机点名转盘", description: "Choose the next participant with a colorful, customizable random wheel.", zhDescription: "用可自定义的彩色随机转盘，选择下一位参与者。", href: "/tools/wheel-of-doom/", image: "/images/wheel-of-doom-preview.png", imageAlt: "Wheel of Doom random name picker preview", zhImageAlt: "随机点名转盘预览", label: "Name picker", zhLabel: "点名器", icon: Disc3},
    ],
  },
  {
    title: "Apps",
    zhTitle: "应用",
    description: "Small classroom and speaking utilities that are useful during lessons, meetings and practice.",
    zhDescription: "适合课堂、会议和练习时使用的小型工具。",
    tools: [
      {name: "Kai Class Time", zhName: "Kai 课堂计时器", description: "A classroom clock with schedule awareness, reset cues and simple controls for live teaching.", zhDescription: "面向现场教学的课堂时钟，带课程表、提醒和简洁控制。", href: "/apps/classroom-timer/", image: "/images/game-previews/classroom-timer.png", imageAlt: "Kai Class Time classroom timer app", zhImageAlt: "Kai 课堂计时器应用", label: "Classroom app", zhLabel: "课堂应用", icon: Timer},
      {name: "Toastmasters Speech Timer", zhName: "Toastmasters 演讲计时器", description: "Time speeches, evaluations, and Table Topics with clear timing signals.", zhDescription: "用清晰的计时信号，为演讲、点评与即兴演讲计时。", href: "/tools/toastmasters-timer/", image: "/images/toastmasters-timer-preview.png", imageAlt: "Toastmasters Speech Timer preview", zhImageAlt: "Toastmasters 演讲计时器预览", label: "Speaking app", zhLabel: "表达应用", icon: Timer},
      {name: "Speech & Debate Timer", zhName: "演讲与辩论计时器", description: "Competition and classroom timing for speech and debate events.", zhDescription: "用于演讲与辩论竞赛及课堂活动的计时。", href: "/tools/speech-debate-timer/", image: "/images/speech-debate-timer-preview.png", imageAlt: "Student Speech and Debate Timer preview", zhImageAlt: "学生演讲与辩论计时器预览", label: "Competition app", zhLabel: "竞赛应用", icon: Swords},
    ],
  },
];
---

<div class="tools-sections" aria-label={chinese ? "游戏、点名器和应用" : "Games, name pickers and apps"}>
  {
    sections.map((section) => {
      return (
        <section class="tools-section" aria-labelledby={`tools-${section.title.toLowerCase().replaceAll(" ", "-")}`}>
          <header class="tools-section-header">
            <Heading id={`tools-${section.title.toLowerCase().replaceAll(" ", "-")}`}>
              {chinese ? section.zhTitle : section.title}
            </Heading>
            <p>{chinese ? section.zhDescription : section.description}</p>
          </header>
          <div class="tools-grid">
            {section.tools.map((tool) => {
              const Icon = tool.icon;
              return (
                <article class="tool-card">
                  <img
                    class="tool-preview"
                    src={tool.image}
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                    alt={chinese ? tool.zhImageAlt : tool.imageAlt}
                  />
                  <div class="tool-content">
                    <span class="tool-label">
                      <Icon size={16} stroke-width={2.2} aria-hidden="true" />
                      {chinese ? tool.zhLabel : tool.label}
                    </span>
                    <h3 class="tool-title">{chinese ? tool.zhName : tool.name}</h3>
                    <p>{chinese ? tool.zhDescription : tool.description}</p>
                    <a class="tool-link" href={tool.href}>
                      {chinese ? "打开（英文）" : "Open"}
                      <ArrowRight size={17} stroke-width={2.2} aria-hidden="true" />
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })
  }
</div>

<style>
  .tools-sections {
    display: grid;
    gap: clamp(28px, 5vw, 48px);
  }

  .tools-section {
    display: grid;
    gap: 18px;
  }

  .tools-section-header {
    display: grid;
    max-width: 760px;
    gap: 8px;
  }

  .tools-section-header :global(h2),
  .tools-section-header :global(h3) {
    margin: 0;
    color: #142b50;
    font-size: clamp(25px, 3vw, 34px);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .tools-section-header p {
    margin: 0;
    color: #5b6b80;
    font-size: 16px;
    line-height: 1.6;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .tool-card {
    overflow: hidden;
    border: 1px solid #b8cbe2;
    border-radius: 0;
    background: rgb(255 255 255 / 94%);
    box-shadow: 0 20px 46px rgb(16 34 74 / 11%);
    transition:
      translate 0.2s ease,
      box-shadow 0.2s ease;
  }

  .tool-card:hover {
    translate: 0 -5px;
    box-shadow: 0 28px 58px rgb(16 34 74 / 16%);
  }

  .tool-preview {
    display: block;
    width: 100%;
    height: 190px;
    object-fit: cover;
    object-position: center top;
    border-bottom: 1px solid #d7e0ec;
    background: #0b111b;
  }

  .tool-content {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 13px;
    padding: 20px;
  }

  .tool-label {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 7px;
    color: #28518d;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .tool-title {
    margin: 0;
    color: #142b50;
    font-size: 23px;
    line-height: 1.15;
    letter-spacing: 0;
  }

  p {
    margin: 0;
    color: #5b6b80;
    font-size: 15px;
    line-height: 1.6;
  }

  .tool-link {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    align-items: center;
    gap: 9px;
    margin-top: 3px;
    padding: 11px 16px;
    border: 1px solid #d4a900;
    border-radius: 999px;
    background: #ffcc00;
    color: #10224a;
    font-size: 15px;
    font-weight: 850;
    text-decoration: none;
  }

  .tool-link:hover {
    background: #ffdf57;
  }
  .tool-link:focus-visible {
    outline: 3px solid #10224a;
    outline-offset: 3px;
  }

  @media (max-width: 920px) {
    .tools-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
    .tool-preview {
      height: clamp(150px, 42vw, 175px);
    }
  }
</style>

---
import resourceStyles from "../styles/resources.css?url";
import tools from '../data/resourceTools.json';
import { Search, Gamepad2, Mic, Timer, Users, Heart, Grid2X2 } from '@lucide/astro';
interface Props { headingLevel?: 'h2' | 'h3'; language?: 'en' | 'zh-CN'; }
const { language = 'en' } = Astro.props;
const zh = language === 'zh-CN';
const filters = [
  {id:'all',label:zh?'课堂资源':'All classroom',icon:Grid2X2},
  {id:'pickers',label:zh?'点名器':'Name pickers',icon:Users},
  {id:'speaking',label:zh?'表达练习':'Speaking',icon:Mic},
  {id:'timers',label:zh?'计时器':'Timers',icon:Timer},
  {id:'games',label:zh?'游戏与工具':'Games & apps',icon:Gamepad2},
  {id:'adults',label:zh?'成人 18+':'Adults 18+',icon:Heart},
];
---
<link rel="stylesheet" href={resourceStyles} />
<div class="resource-catalog" data-filter="all" data-language={language}>
  <div class="catalog-controls">
    <div class="filter-list" role="group" aria-label={zh?'选择类别':'Choose a category'}>
      {filters.map(({id,label,icon:Icon})=><button type="button" class="filter" data-category={id} aria-pressed={id==='all'}><Icon size={17} aria-hidden="true" />{label}<span>{id==='all'?tools.filter(t=>!('adult' in t)).length:tools.filter(t=>t.category===id).length}</span></button>)}
    </div>
    <label class="catalog-search"><Search size={18} aria-hidden="true" /><input type="search" placeholder={zh?'搜索…':'Find a game or app…'} aria-label={zh?'搜索游戏和应用':'Search games and apps'} /></label>
  </div>
  <div class="catalog-meta"><p class="catalog-count" aria-live="polite" aria-atomic="true">{zh?'15 个课堂游戏与应用':'15 classroom games & apps'}</p><span>{zh?'免费 · 浏览器打开':'Free · Open in your browser'}</span></div>
  <div class="tools-grid">
    {tools.map((tool,index)=><article class:list={['tool-card',{'adult-card':'adult' in tool}]} data-category={tool.category} data-search={[tool.name,tool.zhName,tool.label].join(' ').toLowerCase()}>
      <a class="tool-link" href={tool.href} aria-label={zh?'打开 '+tool.zhName+'（英文）':'Open '+tool.name}>
        <div class="preview-frame"><img class="tool-preview" src={tool.image} width="640" height="400" loading={index<3?'eager':'lazy'} decoding="async" alt={zh?tool.zhImageAlt:tool.imageAlt} /><span class="open-icon" aria-hidden="true">↗</span>{'note' in tool && <span class="preview-note">{zh?tool.zhNote:tool.note}</span>}</div>
        <div class="tool-content"><span class="tool-label">{zh?tool.zhLabel:tool.label}</span><h3 class="tool-title">{zh?tool.zhName:tool.name}</h3><p>{zh?tool.zhDescription:tool.description}</p></div>
      </a>
    </article>)}
  </div>
  <div class="catalog-empty" hidden><h3>{zh?'没有匹配结果':'No matches yet'}</h3><p>{zh?'试试其他词，或重置筛选。':'Try another word or clear the filters.'}</p><button type="button" class="clear-search">{zh?'重置筛选':'Clear filters'}</button></div>
  <noscript><p>{zh?'成人对话工具：':'Adult conversation tools: '}<a href="/tools/would-you-though/">Would you, though? · 18+</a> · <a href="/tools/two-perspectives/">Two Perspectives · 18+</a></p></noscript>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.resource-catalog').forEach(catalog=>{
    const input=catalog.querySelector<HTMLInputElement>('input[type="search"]')!;
    const buttons=catalog.querySelectorAll<HTMLButtonElement>('.filter');
    const cards=catalog.querySelectorAll<HTMLElement>('.tool-card');
    const count=catalog.querySelector<HTMLElement>('.catalog-count')!;
    const empty=catalog.querySelector<HTMLElement>('.catalog-empty')!;
    const zh=catalog.dataset.language==='zh-CN';
    function update(){
      const category=catalog.dataset.filter||'all';
      const query=input.value.trim().toLowerCase();let visible=0;
      cards.forEach(card=>{const categoryMatch=category==='all'?card.dataset.category!=='adults':card.dataset.category===category;card.hidden=!(categoryMatch&&(card.dataset.search||'').includes(query));if(!card.hidden)visible++;});
      buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.category===category)));
      count.textContent=zh?visible+' 个'+(category==='adults'?'成人':'课堂')+'游戏与应用':visible+' '+(category==='adults'?'adult conversation tools':'games & apps');
      empty.hidden=visible!==0;
    }
    buttons.forEach(button=>button.addEventListener('click',()=>{catalog.dataset.filter=button.dataset.category;update();}));
    input.addEventListener('input',update);
    catalog.querySelector('.clear-search')?.addEventListener('click',()=>{input.value='';catalog.dataset.filter='all';update();input.focus();});
    update();
  });
</script>

---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import { schoolDirections, schoolDirectionsChinese } from "../lib/inquiry.mjs";
interface Props { language?: "en" | "zh-CN"; }
const {language = "en"} = Astro.props;
const chinese = language === "zh-CN";
const tr = (en: string, zh: string) => chinese ? zh : en;
const formCopy = {
  groupLabels: [tr("Learner’s age or grade (optional)","学生年龄或年级（可选）"),tr("Age range or group size (optional)","年龄范围或大致人数（可选）")],
  groupExamples: [tr("For example: Grade 2","例如：二年级"),tr("For example: around 20 participants","例如：约 20 人")],
  goalExamples: {coaching:tr("For example: explaining ideas clearly in class","例如：在课堂上清楚地表达想法"),schools:tr("For example: a storytelling workshop for Grade 5","例如：面向五年级的故事讲述工作坊"),companies:tr("For example: clearer client presentations for our team","例如：让团队面向客户的演示更清晰"),unsure:tr("What speaking moment would you like help with?","你希望在哪种表达情境中获得帮助？")},
  rebuild: tr("Rebuild from these details","根据这些信息重新生成"),
  ready: tr("Draft ready. Review it before copying. Rebuilding replaces any edits in the message.","咨询稿已生成。复制前请先检查。重新生成会替换你对咨询稿的修改。"),
  edited: tr("Message edited. Copy again to use these changes.","咨询稿已修改。请重新复制，以使用最新内容。"),
  changed: tr("Details changed. Your draft is unchanged. Rebuild to use these details; rebuilding replaces any message edits.","信息已改变，咨询稿尚未更新。重新生成后才会使用这些信息，并替换你对咨询稿的修改。"),
};
---

<FlagshipLayout
  title={tr("Talk with Coach Kai | SpeakKai", "联系 Kai 教练 | SpeakKai")}
  description={tr("Discuss student coaching, a school program, team training or a keynote with Kai. Prepare a short inquiry and connect directly on WeChat.", "与 Kai 讨论学生辅导、学校项目、团队培训或主题演讲。准备一段简短咨询内容，再通过微信直接联系。")}
  language={language}
  current="contact"
  contactHref="#wechat"
>
  <section class="wrap contact-intro">
    <p class="eyebrow">{tr("A conversation is a good beginning", "一次交流，是一个好的开始")}</p>
    <h1>{tr("What are you", "你希望通过表达")}<br /><em>{tr("working towards?", "实现什么？")}</em></h1>
    <p>
      {tr("Tell Kai about your next speaking moment. A few details are enough to start.", "告诉 Kai 你下一次需要表达的情境。简单介绍几句，就可以开始交流。")}
    </p>
    <a class="text-link" href="#wechat"
      >{tr("Message Kai directly on WeChat", "通过微信直接联系 Kai")} <span aria-hidden="true">↓</span></a
    >
  </section>
  <div class="wrap inquiry-grid">
    <section class="inquiry-composer" aria-labelledby="compose-title" hidden>
      <p class="eyebrow">01 / {tr("Prepare your message", "准备咨询内容")}</p>
      <h2 id="compose-title">{tr("Start with your goal.", "从你的目标开始。")}</h2>
      <p class="inquiry-help">
        {tr("Optional prompts to help you get started. Leave anything undecided blank.", "以下提示都可以选填。还没有确定的内容，留空即可。")}
      </p>
      <fieldset class="inquiry-fields">
        <legend class="sr-only">{tr("Your inquiry details", "咨询信息")}</legend>
        <label for="inquiry-audience">{tr("Who is this for?", "为谁咨询？")}</label>
        <select id="inquiry-audience">
          <option value="unsure">{tr("I’m exploring / something else", "还在了解 / 其他需求")}</option>
          <option value="coaching">{tr("A student or my child", "学生或我的孩子")}</option>
          <option value="schools">{tr("A school or education team", "学校或教育团队")}</option>
          <option value="companies">{tr("A company or event team", "企业或活动团队")}</option>
        </select>
        <div id="school-direction-field" hidden>
          <label for="inquiry-school-direction">{tr("Program direction", "项目方向")} <span>{tr("(optional)", "（可选）")}</span></label>
          <select id="inquiry-school-direction">
            <option value="">{tr("Open to advice", "希望听取建议")}</option>
            {Object.entries(chinese ? schoolDirectionsChinese : schoolDirections).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>
        <label for="inquiry-goal">{tr("What would you like to work on?", "希望练习或改善什么？")} <span>{tr("(optional)", "（可选）")}</span></label>
        <textarea
          id="inquiry-goal"
          rows="3"
          maxlength="600"
          autocomplete="off"
          placeholder={formCopy.goalExamples.coaching}
          aria-describedby="details-privacy"></textarea>
        <p class="field-note" id="details-privacy">
          {tr("A general description is enough. Leave out student names, private records and confidential company information.", "提供一般情况即可。请勿填写学生姓名、私人记录或公司机密信息。")}
        </p>
        <label for="inquiry-group" id="group-label"
          >{tr("Who will take part?", "谁会参加？")} <span>{tr("(optional)", "（可选）")}</span></label
        >
        <input
          id="inquiry-group"
          type="text"
          maxlength="100"
          autocomplete="off"
          placeholder={tr("Age range or approximate group size", "年龄范围或大致人数")}
        />
        <div class="inquiry-field-pair">
          <div>
            <label for="inquiry-format">{tr("Delivery preference", "形式偏好")} <span>{tr("(optional)", "（可选）")}</span></label><select
              id="inquiry-format"
              ><option value="">{tr("Open to advice", "希望听取建议")}</option><option value="Online">{tr("Online", "线上")}</option
              ><option value="In person">{tr("In person", "线下")}</option><option value="A mix of both">{tr("A mix of both", "线上与线下结合")}</option></select>
          </div>
          <div>
            <label for="inquiry-timing">{tr("Timing", "时间范围")} <span>{tr("(optional)", "（可选）")}</span></label
            ><input
              id="inquiry-timing"
              type="text"
              maxlength="100"
              autocomplete="off"
              placeholder={tr("Month or event deadline", "月份或活动截止时间")}
            />
          </div>
        </div>
      </fieldset>
      <button class="button" id="build-inquiry" type="button"
        >{tr("Create a message", "生成咨询稿")} <span aria-hidden="true">↓</span></button
      >
      <section
        id="inquiry-result"
        class="inquiry-result"
        hidden
        aria-labelledby="preview-title"
      >
        <h3 id="preview-title">{tr("Make it yours.", "改成你想说的话。")}</h3>
        <label for="inquiry-preview">{tr("Review and edit your message", "检查并修改咨询稿")}</label>
        <textarea
          id="inquiry-preview"
          rows="9"
          maxlength="2000"
          autocomplete="off"
          aria-describedby="preview-help"></textarea>
        <p class="field-note" id="preview-help">
          {tr("Copy this message, then paste it into your WeChat conversation with Kai.", "复制这段内容，再粘贴到你与 Kai 的微信聊天中。")}
        </p>
        <div class="actions">
          <button id="copy-inquiry" class="button" type="button"
            >{tr("Copy message", "复制中文咨询稿")}</button
          ><a class="text-link" href="#wechat">{tr("Find Kai on WeChat", "在微信上找到 Kai")} ↓</a>
        </div>
      </section>
      <p
        id="inquiry-status"
        class="inquiry-status"
        role="status"
        aria-live="polite"
      >
      </p>
      <p class="field-note">
        {tr("The website does not send or save your inquiry. You choose what to share in WeChat.", "网站不会发送或保存咨询，也不会确认预订。由你决定在微信中分享什么。")}
      </p>
    </section>
    <noscript
      ><p class="inquiry-help">
        {tr("To start a conversation, message Kai on WeChat with your speaking goal, the learner’s age or group size, and any timing preferences.", "请通过微信联系 Kai，说明表达目标、学生年龄或大致人数，以及时间偏好，即可开始交流。")}
      </p></noscript
    >
    <aside class="wechat-panel" id="wechat" aria-labelledby="wechat-title">
      <p class="eyebrow">{tr("Connect directly", "直接联系")}</p>
      <h2 id="wechat-title">{tr("Say hello to Kai.", "和 Kai 打个招呼。")}</h2>
      <p>{tr("WeChat:", "微信：")} <strong lang="en">CKcoachkai</strong></p>
      <a
        class="contact-qr-full"
        href="/images/coach-kai-wechat-qr.png"
        aria-label={tr("Open full-size WeChat QR code", "打开完整微信二维码")}
        ><img
          src="/images/coach-kai-wechat-qr.png"
          width="938"
          height="1340"
          alt={tr("Kai’s complete WeChat contact QR card", "Kai 的完整微信联系卡及二维码")}
        /></a
      >
      <p class="field-note">
        {tr("Scan with WeChat, or open and save the QR image to use from your phone. You can also search the handle above.", "用微信扫一扫，或打开并保存二维码图片，在手机上使用。也可以搜索上方微信号。")}
      </p>
      <p class="field-note">{tr("Xiaohongshu:", "小红书：")} <strong lang="en">CKcoachkai</strong></p>
      <div class="contact-next">
        <h3>{tr("What happens next", "接下来怎么做")}</h3><ol>
          <li>{tr("Share your situation and goal.", "介绍你的情况与目标。")}</li><li>
            {tr("Discuss a suitable approach with Kai.", "与 Kai 讨论适合的方式。")}
          </li><li>{tr("Agree the scope, fees and schedule before booking.", "预订前商定范围、费用与时间。")}</li>
        </ol><a href="/schedule/" class="text-link"
          >{tr("Check the schedule", "查看时间安排（英文）")} <span aria-hidden="true">↗</span></a
        ><p class="field-note">
          {tr("An inquiry does not reserve a time. Kai confirms availability with you.", "咨询不会保留时间。Kai 会与你确认可安排时间。")}
        </p>
      </div>
    </aside>
  </div>
<script id="inquiry-copy" type="application/json" is:inline set:html={JSON.stringify(formCopy).replaceAll("<", "\\u003c")} />
</FlagshipLayout>
<script>
  import {
    normalizeAudience,
    normalizeSchoolDirection,
    buildInquiry,
    copyInquiry,
  } from "../lib/inquiry.mjs";
  const composer = document.querySelector<HTMLElement>(".inquiry-composer")!;
  const language = document.documentElement.lang;
  const labels = JSON.parse(document.querySelector("#inquiry-copy")!.textContent!);
  const audience =
    document.querySelector<HTMLSelectElement>("#inquiry-audience")!;
  const group = document.querySelector<HTMLInputElement>("#inquiry-group")!;
  const goal = document.querySelector<HTMLTextAreaElement>("#inquiry-goal")!;
  const schoolDirection = document.querySelector<HTMLSelectElement>("#inquiry-school-direction")!;
  const preview =
    document.querySelector<HTMLTextAreaElement>("#inquiry-preview")!;
  const status = document.querySelector<HTMLElement>("#inquiry-status")!;
  const copyButton =
    document.querySelector<HTMLButtonElement>("#copy-inquiry")!;
  function updateAudience() {
    const label = document.querySelector<HTMLLabelElement>("#group-label")!;
    const kind = normalizeAudience(audience.value);
    document.querySelector<HTMLElement>("#school-direction-field")!.hidden = kind !== "schools";
    label.textContent = labels.groupLabels[kind === "coaching" ? 0 : 1];
    group.placeholder = labels.groupExamples[kind === "coaching" ? 0 : 1];
    goal.placeholder = labels.goalExamples[kind];
  }
  audience.value = normalizeAudience(
    new URLSearchParams(window.location.search).get("audience"),
  );
  schoolDirection.value = audience.value === "schools"
    ? normalizeSchoolDirection(new URLSearchParams(window.location.search).get("schoolDirection"))
    : "";
  updateAudience();
  audience.addEventListener("change", updateAudience);
  document.querySelector("#build-inquiry")!.addEventListener("click", () => {
    preview.value = buildInquiry({
      audience: audience.value,
      schoolDirection: schoolDirection.value,
      goal: goal.value,
      group: group.value,
      format:
        document.querySelector<HTMLSelectElement>("#inquiry-format")!.value,
      timing:
        document.querySelector<HTMLInputElement>("#inquiry-timing")!.value,
    }, language);
    document.querySelector<HTMLElement>("#inquiry-result")!.hidden = false;
    document.querySelector<HTMLButtonElement>("#build-inquiry")!.textContent =
      labels.rebuild;
    status.textContent = labels.ready;
    preview.focus();
  });
  copyButton.addEventListener("click", async () => {
    copyButton.disabled = true;
    const result = await copyInquiry(preview.value, (text: string) => navigator.clipboard.writeText(text), language);
    status.textContent = result.message;
    if (!result.ok) {
      preview.focus();
      preview.select();
    }
    copyButton.disabled = false;
  });
  preview.addEventListener("input", () => {
    status.textContent = labels.edited;
  });
  document.querySelector(".inquiry-fields")!.addEventListener("input", () => {
    if (!document.querySelector<HTMLElement>("#inquiry-result")!.hidden) {
      status.textContent = labels.changed;
    }
  });
  composer.hidden = false;
</script>
<style>
  .contact-intro {
    padding-block: 52px 38px;
  }
  .contact-intro .eyebrow {
    color: var(--blue);
  }
  .contact-intro h1 {
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 600;
    margin-top: 18px;
  }
  .contact-intro > p:not(.eyebrow) {
    max-width: 570px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 18px;
  }
  .contact-intro > a {
    margin-top: 18px;
  }
  .inquiry-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: clamp(28px, 6vw, 80px);
    padding-bottom: 76px;
    align-items: start;
  }
  .inquiry-composer {
    border-top: 3px solid var(--blue);
    padding-top: 26px;
  }
  [hidden] {
    display: none !important;
  }
  h2 {
    font-size: 32px;
    font-weight: 600;
    margin-top: 14px;
  }
  .inquiry-help {
    color: var(--muted);
    margin-top: 18px;
  }
  .inquiry-fields {
    border: 0;
    padding: 0;
    margin: 25px 0;
    min-width: 0;
  }
  label {
    display: block;
    font-size: 16px;
    font-weight: 600;
    margin: 22px 0 8px;
  }
  label span {
    font-weight: 400;
    color: var(--muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid #8491a8;
    background: white;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    padding: 12px;
    border-radius: 4px;
  }
  textarea {
    resize: vertical;
  }
  input,
  select {
    min-height: 50px;
  }
  .field-note {
    font-size: 14px;
    color: var(--muted);
    margin-top: 12px;
  }
  .inquiry-field-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  button {
    font-family: inherit;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }
  .inquiry-result {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  h3 {
    font-size: 23px;
    font-weight: 600;
  }
  .inquiry-result .actions {
    margin-top: 18px;
  }
  .inquiry-status {
    margin-top: 18px;
    font-size: 16px;
    font-weight: 600;
  }
  .wechat-panel {
    background: var(--wash);
    border-top: 3px solid var(--yellow);
    padding: 28px;
    scroll-margin-top: 24px;
  }
  .wechat-panel > p:not(.eyebrow) {
    margin-top: 18px;
  }
  .contact-qr-full {
    display: block;
    width: min(100%, 224px);
    margin-top: 22px;
  }
  .contact-qr-full img {
    width: 100%;
    height: auto;
  }
  .contact-next {
    border-top: 1px solid #c6cfde;
    margin-top: 26px;
    padding-top: 26px;
  }
  .contact-next ol {
    padding-left: 22px;
    margin-block: 22px;
  }
  .contact-next li + li {
    margin-top: 14px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 760px) {
    .inquiry-grid {
      grid-template-columns: 1fr;
      gap: 35px;
      padding-bottom: 45px;
    }
    .contact-intro {
      padding-top: 32px;
    }
    .wechat-panel {
      padding: 24px;
    }
  }
  @media (max-width: 430px) {
    .inquiry-field-pair {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  @media print {
    .inquiry-composer {
      display: none;
    }
  }
</style>

---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipStagePractice from "./FlagshipStagePractice.astro";
import FlagshipStoryPrompt from "./FlagshipStoryPrompt.astro";
import { localizedPath } from "../lib/siteLanguage.mjs";
interface Props {language?: "en" | "zh-CN"}
const {language="en"}=Astro.props;
const chinese=language==="zh-CN";
const tr=(en:string,zh:string)=>chinese?zh:en;
const code=chinese?"zh":"en";
const steps=chinese ? [
  ["重点","我们去图书馆见面吧。","先说出你希望对方理解的想法。"],
  ["例子","昨天午饭后，那里很安静。","用一个具体细节说明你的意思。"],
  ["确认","这个安排适合你吗？","给对方回应或提问的机会。"],
] : [
  ["Point","Let’s meet in the library.","Say the idea you want the listener to understand."],
  ["Example","Yesterday, it was quiet after lunch.","Make your meaning concrete with one specific detail."],
  ["Check","Would that work for you?","Give the listener room to respond or ask a question."],
];
---
<FlagshipLayout title={tr("Point, Example, Check: a Visual Speaking Lesson | SpeakKai","重点、例子、确认：看得见的表达练习 | SpeakKai")} description={tr("Watch an 18-second silent example of a clear idea, a concrete detail and a listener check. Read the complete text and try your own version.","观看一段 18 秒的无旁白示例：一个重点、一个具体细节，再给倾听者回应的机会。也可以阅读完整文字，试着说出自己的版本。")} language={language} current="resources" contactHref={localizedPath('/contact/',language)}>
  <section class="wrap watch-intro">
    <a class="text-link" href={localizedPath('/resources/',language)}>← {tr("Practice resources","练习资源")}</a>
    <p class="eyebrow">{tr("A small idea. A clear shape.","小小的想法，清楚的表达。")}</p>
    <h1>{tr("See an idea", "让一个想法")}<br/><em>{tr("take shape.", "变得具体。")}</em></h1>
    <p>{tr("A suggestion, a detail, a question. Watch this fictional example, then try it in your own words.","一个建议、一个细节、一个问题。看看这个虚构示例，再试着用你自己的话表达。")}</p>
  </section>
  <section class="wrap watch-grid" aria-labelledby="watch-title">
    <figure>
      <video controls playsinline muted preload="none" width="1080" height="1080" poster={`/media/point-example-check-${code}.webp`} aria-label={tr("Play the silent Point, Example, Check animation","播放无旁白的重点、例子、确认动画")} aria-describedby="video-description">
        <source src={`/media/point-example-check-${code}.mp4`} type="video/mp4" />
        {tr("Video unavailable. The complete example follows in text.","视频无法播放。下方有完整文字示例。")}
      </video>
      <figcaption id="video-description">{tr("18 seconds · Silent animation · English text","18 秒 · 无旁白动画 · 中文文字")}<br/>{tr("Original fictional example. No real class or learner is shown.","原创虚构练习示例，未展示真实课堂或学习者。")}</figcaption>
    </figure>
    <div class="watch-text">
      <p class="eyebrow">{tr("Read at your own pace","按自己的节奏阅读")}</p>
      <h2 id="watch-title">{tr("Point. Example. Check.","重点。例子。确认。")}</h2>
      <ol class="watch-steps">{steps.map(([label,quote,help],index)=><li><span class="eyebrow">0{index+1} / {label}</span><blockquote>{quote}</blockquote><p>{help}</p></li>)}</ol>
    </div>
  </section>
  <FlagshipStagePractice language={language} />
  <FlagshipStoryPrompt language={language} />
  <section class="wrap watch-next">
    <h2>{tr("Your turn to make it real.","轮到你试一试。")}</h2>
    <p>{tr("Choose an everyday suggestion. Say the point, add a true detail and ask a question. Listen to the answer before trying again.","选择一个日常建议。说出重点，补充一个真实细节，再问一个问题。听完对方的回答，再尝试一次。")}</p>
    <a class="button" href={localizedPath('/resources/',language)}>{tr("Choose a complete practice","选择一个完整练习")} ↗</a>
  </section>
</FlagshipLayout>
<style>
  .watch-intro{padding-block:40px}.watch-intro .eyebrow{margin-top:32px;color:var(--blue)}h1{font-size:clamp(42px,5.5vw,76px);margin-top:18px}.watch-intro>p:last-child{max-width:650px;font-size:20px;color:var(--muted);margin-top:24px}.watch-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,72px);align-items:start;padding-bottom:60px}video{display:block;width:100%;height:auto;aspect-ratio:1;background:#102348;border-radius:6px}figcaption{font-size:14px;color:var(--muted);margin-top:16px;line-height:1.7}.watch-text h2{font-size:clamp(28px,3vw,40px);margin-top:15px}.watch-steps{list-style:none;padding:0}.watch-steps li{border-top:1px solid var(--line);padding-top:22px;margin-top:24px}.watch-steps blockquote{font-size:26px;font-weight:600;margin:10px 0;line-height:1.4}.watch-steps p{color:var(--muted)}.watch-next{border-top:1px solid var(--line);padding-block:36px 64px}.watch-next h2{font-size:32px}.watch-next p{max-width:720px;margin-top:18px;color:var(--muted)}.watch-next .button{margin-top:24px}@media(max-width:760px){.watch-grid{grid-template-columns:1fr}.watch-intro{padding-top:24px}}@media print{video{display:none}.watch-grid{display:block}}
</style>

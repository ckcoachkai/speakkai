---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  portrait?: boolean;
  compact?: boolean;
}

const { eyebrow, title, summary, portrait = false, compact = false } = Astro.props;
---

<section class:list={["spatial-page-hero", { "has-portrait": portrait, "is-compact": compact }]}>
  <div class="spatial-hero-orbit" aria-hidden="true"></div>
  <div class="spatial-hero-copy">
    <p>{eyebrow}</p>
    <h1>{title}</h1>
    <div class="spatial-summary">{summary}</div>
    <slot />
  </div>
  {portrait && (
    <figure>
      <img src="/images/coach-kai-headshot.webp" width="1400" height="1400" alt="Coach Kai" decoding="async" />
      <figcaption>Coach Kai / communication coach</figcaption>
    </figure>
  )}
</section>

<style>
  .spatial-page-hero {
    position: relative;
    min-height: clamp(310px, 43vw, 520px);
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    padding: clamp(42px, 7vw, 86px) max(24px, calc((100vw - 1120px) / 2));
    color: white;
    background: radial-gradient(circle at 68% 42%, #5e88c7 0, #28518d 37%, #10224a 78%);
  }

  .spatial-page-hero.has-portrait { grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); }
  .spatial-page-hero.is-compact { min-height: 220px; padding-block: clamp(34px, 5vw, 58px); }
  .spatial-hero-orbit { position: absolute; width: min(72vw, 920px); aspect-ratio: 1; right: -12%; top: -85%; border: 1px solid rgb(183 211 255 / 30%); border-radius: 50%; box-shadow: 0 0 100px rgb(37 99 235 / 14%); }
  .spatial-hero-orbit::before, .spatial-hero-orbit::after { position: absolute; inset: 13%; border: 1px solid rgb(183 211 255 / 22%); border-radius: 50%; content: ""; }
  .spatial-hero-orbit::after { inset: 31%; }
  .spatial-hero-copy { position: relative; z-index: 2; max-width: 760px; }
  .spatial-hero-copy > p { margin: 0 0 16px; color: #ffcc00; font: 700 11px/1.2 "Space Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .spatial-hero-copy h1 { max-width: 11ch; margin: 0; color: white; font: clamp(3.2rem, 7vw, 7.2rem)/.86 "Manrope", system-ui, sans-serif; letter-spacing: -.07em; }
  .spatial-summary { max-width: 58ch; margin-top: 22px; color: #d6e3f5; font-size: clamp(15px, 1.4vw, 18px); line-height: 1.6; }
  figure { position: relative; z-index: 2; width: min(100%, 390px); height: min(37vw, 430px); margin: 0 0 0 auto; }
  figure::before { position: absolute; inset: -18px; border: 1px solid rgb(255 255 255 / 28%); border-radius: 50% 50% 18px 18px; content: ""; }
  figure img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; border: 1px solid rgb(255 255 255 / 62%); border-radius: 50% 50% 14px 14px; background: #f8f9fb; }
  figcaption { position: absolute; right: 12px; bottom: 12px; left: 12px; padding: 10px 12px; color: white; background: rgb(11 16 32 / 86%); font-size: 11px; font-weight: 800; }

  @media (max-width: 760px) {
    .spatial-page-hero, .spatial-page-hero.has-portrait { grid-template-columns: 1fr; gap: 34px; min-height: 0; padding: 44px 18px; }
    .spatial-page-hero.is-compact { padding-block: 34px; }
    .spatial-hero-copy h1 { font-size: clamp(3rem, 14vw, 5rem); }
    figure { width: 100%; height: min(105vw, 470px); margin: 0; }
  }
</style>

---
import { currentProgram as program } from "../data/currentProgram";
import { courseCopy } from "../data/courseCopy";
const copy = courseCopy["zh-CN"];
---
<div class="chinese-course-entry" lang="zh-CN">
  <a href={`/zh${program.href}`} hreflang="zh-CN">
    <strong>中文课程介绍 <span aria-hidden="true">↗</span></strong>
    <span>{copy.season} · {copy.audience}</span>
  </a>
</div>
<style>
  .chinese-course-entry { margin-top: 16px; }
  a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    min-height: 44px;
    max-width: 100%;
    padding-block: 8px;
    text-decoration: none;
    font-size: 14px;
    line-height: 1.65;
  }
  strong { color: var(--blue); text-decoration: underline; text-underline-offset: 5px; }
  a > span { color: var(--muted); }
  a:hover strong { text-decoration-thickness: 2px; }
</style>

---
import ExperimentNavigator from "../ExperimentNavigator.astro";
import type { Experiment } from "../../data/experimentLabV3Archive";
import "../../styles/archive/experiment-lab-v3.css";

interface Props {
  experiment: Experiment;
}

const { experiment } = Astro.props;
const style = `--lab-accent:${experiment.accent};--lab-accent-2:${experiment.accent2};--lab-bg:${experiment.background};--lab-ink:${experiment.ink};`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={experiment.summary} />
    <meta name="theme-color" content={experiment.background} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{`Test ${experiment.id}: ${experiment.name} | SpeakKai`}</title>
  </head>
  <body
    class:list={["lab-page", `mode-${experiment.mode}`, { "is-single-screen": experiment.singleScreen }]}
    data-primary={experiment.primary.toLowerCase()}
    style={style}
  >
    <ExperimentNavigator current={experiment.id} />
    <main>
      <section class="lab-stage" aria-labelledby="experiment-title">
        <div class="hero-copy">
          <div class="stakeholder-line">
            <span>{experiment.eyebrow}</span>
            <span>Primary: {experiment.primary}</span>
            <span>Secondary: {experiment.secondary}</span>
          </div>
          <p class="test-label">Test {experiment.id} / {experiment.name}</p>
          <h1 id="experiment-title">{experiment.headline}</h1>
          <p class="hero-summary">{experiment.summary}</p>
          <div class="hero-actions">
            <a class="primary-action" href={experiment.ctaHref}>{experiment.cta}</a>
            <a class="secondary-action" href={experiment.altHref}>{experiment.altCta}</a>
          </div>
          <p class="hypothesis"><strong>Hypothesis</strong>{experiment.hypothesis}</p>
        </div>

        <figure class="hero-visual">
          <div class="visual-grid" aria-hidden="true"></div>
          <div class="visual-orbit" aria-hidden="true"></div>
          <img
            src={experiment.image}
            width="1200"
            height="900"
            alt={experiment.imageAlt}
            loading="eager"
            decoding="async"
          />
          <figcaption>
            <span>{experiment.primary}-first direction</span>
            <strong>{experiment.name}</strong>
          </figcaption>
        </figure>

        <section class="concept-cards" id="skills" aria-label={`${experiment.name} content paths`}>
          {experiment.cards.map((item, index) => (
            experiment.singleScreen ? (
              <article style={`--card-index:${index}`}>
                <span>{item.label}</span>
                <h2>{item.title}</h2>
                <p>{item.copy}</p>
              </article>
            ) : (
              <details open={index === 0} style={`--card-index:${index}`}>
                <summary>
                  <span>{item.label}</span>
                  <strong>{item.title}</strong>
                </summary>
                <p>{item.copy}</p>
              </details>
            )
          ))}
        </section>

        <footer class="lab-footer">
          <p><strong>Factual boundary:</strong> {experiment.limitation}</p>
          <div id="paths">
            {experiment.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </footer>
      </section>
    </main>
  </body>
</html>

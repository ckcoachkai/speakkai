---
interface Props { person?: 'gong' | 'man' | 'liu' }
const { person } = Astro.props;
const profiles = {
  gong: { name: 'Gong Xiongqi', chinese: '龚雄麒', slug: 'gong-xiongqi', image: 'gong-portrait.jpg', subtitle: 'A life in pharmaceutical science', intro: 'Born in Chongming in 1925, according to his memoir. A pharmaceutical researcher whose name appears across decades of scientific publications.', caption: 'An early portrait of Gong Xiongqi reproduced in his memoir', credit: 'Family memoir · p. 9', sources: ['memoir','patent','patent2','paper1962','paper1993','paper1999','paper2011'], images: ['family-1955.jpg','early-couple.jpg','pharmacy-class.jpg','research-colleagues.jpg','new-york.jpg'] },
  man: { name: 'Man Tienan', chinese: '满铁男', slug: 'man-tienan', image: 'geology-paper.png', subtitle: 'Understanding the ground below', intro: 'A government researcher remembered by the family for a life in geology. His 1985 paper gives that memory a precise place in the published record.', caption: 'First page of Man Tienan’s 1985 geology paper', credit: '中国岩溶 · 1985', sources: ['memoir','geology','institute'], images: ['family-1955.jpg'] },
  liu: { name: 'Liu Tiehu', chinese: '刘铁虎', slug: 'liu-tiehu', image: 'liu-portrait.jpg', subtitle: 'A legal career across borders', intro: 'From Hebei to university in Beijing, then Canada, the United States and a legal career in Hong Kong and Shanghai.', caption: 'An early photograph of Liu Tiehu published by UIBE', credit: 'UIBE alumni profile · 2021', sources: ['liu','legal500','wang','jessup','ranking'], images: ['queens.jpg','liu-lawyer.jpg'] },
};
const profile = person ? profiles[person] : undefined;
const canonical = 'https://speakkai.com/history/' + (profile ? profile.slug + '/' : '');
const root = '/media/history/';
const sources = [
  {id:'memoir', title:'A Life of Hardship and Joy', detail:'龚雄麒 · 苦乐人生——我的回忆录 · February 2015', note:'Family-held memoir. Photographs and recollections are attributed to the memoir, not treated as independent records. Page 23 names Gong Ruifeng and her husband Man Tienan.'},
  {id:'geology', title:'A geologist’s published work', detail:'满铁男 · 中国岩溶 · 1985 · pp. 117–123', url:'http://zgyr.karst.ac.cn/article/id/19850011', note:'利用地质规律 解放下组煤层. The author affiliation is the Ministry of Geology and Mineral Resources’ Geological Technical and Economic Research Centre. The online issue label differs from the printed combined issue.'},
  {id:'institute', title:'An institution through changing names', detail:'China Academy of Natural Resources Economics · institutional history', url:'http://www.canre.org.cn/dwgk/dwjj.htm', note:'The official history connects the 1982 research centre with the later geological, land-resources and natural-resources economics institutes. It describes Beijing and Yanjiao office areas.'},
  {id:'patent', title:'The American patent record', detail:'US5633259A · granted 27 May 1997', url:'https://patents.google.com/patent/US5633259A/en', note:'Names Xiong-qi Gong and Bo-yi Qin among the inventors. The name, collaborator and dihydroetorphine research closely match the memoir. Patent claims are not proof of medical effectiveness.'},
  {id:'patent2', title:'A related American patent', detail:'US5624932A · granted 29 April 1997', url:'https://patents.google.com/patent/US5624932A/en', note:'A related patent, not an unrelated invention. The assignment history records interests assigned to United Biomedical and Albert Einstein College of Medicine.'},
  {id:'paper1962', title:'An early scientific collaboration', detail:'原子能科学技术 · 1962 · issue 10', url:'https://mall.cnki.net/magazine/Article/YZJS196210007.htm', note:'几种C¹⁴-氨基酸的合成 lists 龚雄麒 with 王世真 and other researchers.'},
  {id:'paper1993', title:'Research on targeted drug delivery', detail:'中国药物化学杂志 · 1993 · issue 1', url:'https://mall.cnki.net/magazine/Article/ZGYH199301001.htm', note:'抗体导向药物的研究—Ⅰ lists 仲伯华、龚雄麒、王亚平 and 张其楷.'},
  {id:'paper1999', title:'The institute in the publication record', detail:'药学进展 · 1999 · issue 4 · pp. 237–240', url:'https://www.zhangqiaokeyan.com/academic-journal-cn_progress-pharmaceutical-sciences_thesis/0201241623883.html', note:'A bibliographic record for a paper by 何军林 and 龚雄麒 lists both at 军事医学科学院毒物药物研究所.'},
  {id:'paper2011', title:'A name still in the literature', detail:'同位素 · 2011 · supplement S1', url:'https://mall.cnki.net/magazine/Article/TWSZ2011S1018.htm', note:'氘标记盐酸苯环壬酯的合成 lists 龚雄麒 with 陈家骏 and 仲伯华. Publication in 2011 does not establish continued employment.'},
  {id:'liu', title:'“3D看铁虎” — a life in law', detail:'UIBE Law School · 25 October 2021', url:'https://law.uibe.edu.cn/xwzx/xyxw/aa75b791781748108e23a25ef1dc557a.htm', note:'University alumni profile of 刘铁虎, bachelor’s class of 1984 and master’s class of 1987. Source of the Liu portraits and Queen’s University photograph on this page. Career details are historical accounts.'},
  {id:'legal500', title:'Gaw Capital’s legal team', detail:'The Legal 500 · GC Powerlist · Hong Kong Teams 2019', url:'https://www.legal500.com/gc-powerlist/hong-kong-teams-2019/gaw-capital/', note:'Identifies Tiehu Liu as chief legal counsel and compliance officer. This is a 2019 record, not confirmation of his current role.'},
  {id:'wang', title:'The teammate’s recollection', detail:'UIBE Law School · 1 September 2021', url:'https://law.uibe.edu.cn/xygz/xyfc/5527de76d1cd41c2b1ad1a294110699f.htm', note:'Names Liu Tiehu and Wang Xuehua as teammates. The text says 1986, while Wang’s pictured certificate is dated 1987. The two UIBE profiles may share source material.'},
  {id:'jessup', title:'Jessup, Boston, 1987', detail:'International Law Students Association · organiser’s archive', url:'https://www.ilsa.org/jessup-year/jessup-1987/', note:'Lists Boston Park Plaza & Towers and 11 April 1987. The 1986 event was in Washington, D.C. This makes 1987 the stronger match for the Boston recollection.'},
  {id:'ranking', title:'The contemporary competition results', detail:'1987 Jessup · Overall Ranking — International', url:'https://www.ilsa.org/History/Jessup%201987/IntlRank.pdf', note:'Lists the PRC team 25th of 26 international entries, with a 0–4 record. This conflicts with a semifinal finish for that entry. The document names countries, not individual team members.'},
];
const moments = [
  {year:'1925', who:'gong', label:'Gong Xiongqi', title:'An island childhood', text:'Born near Shenjiazhen in Chongming, according to his memoir. A life beginning beside the Yangtze.', kind:'Memoir', source:'memoir'},
  {year:'1955', who:'family', label:'The Gong family', title:'Everyone in one photograph', text:'The memoir records a gathering at Shanghai’s International Hotel to celebrate his parents’ sixtieth birthdays.', kind:'Memoir', source:'memoir'},
  {year:'1962', who:'gong', label:'Gong Xiongqi', title:'A name in the scientific record', text:'A paper on isotope-labelled amino acids places Gong alongside Wang Shizhen and other researchers.', kind:'Published record', source:'paper1962'},
  {year:'1979', who:'liu', label:'Liu Tiehu', title:'A journey into law begins', text:'The UIBE profile records his entry into the university’s international trade programme.', kind:'University account', source:'liu'},
  {year:'1984–85', who:'liu', label:'Liu Tiehu', title:'Beijing to Queen’s University', text:'After his undergraduate degree, he studied in Canada before returning to complete his master’s at UIBE.', kind:'University account', source:'liu'},
  {year:'1985', who:'man', label:'Man Tienan', title:'Reading the ground beneath us', text:'His coal-geology paper appears in 中国岩溶, with his government research-centre affiliation.', kind:'Published record', source:'geology'},
  {year:'1987', who:'liu', label:'Liu Tiehu', title:'The Boston chapter', text:'The organiser’s archive and his teammate’s certificate point to 1987. The exact team roster and the later semifinal claim remain unresolved.', kind:'Evidence differs', source:'ranking'},
  {year:'1992', who:'family', label:'A family connection', title:'A sister. A brother-in-law.', text:'A 2 October gathering in the memoir names Gong’s sister 龚瑞凤 and her husband 满铁男.', kind:'Memoir', source:'memoir'},
  {year:'1997', who:'gong', label:'Gong Xiongqi', title:'Research crosses an ocean', text:'Two related US patents name Xiong-qi Gong and Bo-yi Qin among their inventors.', kind:'Patent record', source:'patent'},
  {year:'2006', who:'liu', label:'Liu Tiehu', title:'A new chapter in Shanghai', text:'The UIBE account dates the start of his Shanghai chief legal counsel role to 2006.', kind:'University account', source:'liu'},
  {year:'2011', who:'gong', label:'Gong Xiongqi', title:'A continuing publication trail', text:'A paper in 同位素 carries his name with Chen Jiajun and Zhong Bohua, both also named in his memoir.', kind:'Published record', source:'paper2011'},
  {year:'2015', who:'family', label:'The family archive', title:'A lifetime, written down', text:'Gong dates his memoir February 2015. Its photographs and recollections give the public records a family context.', kind:'Memoir', source:'memoir'},
];
const gallery = [
  {image:'family-1955.jpg', title:'A family gathered, 1955', caption:'Shanghai International Hotel. The memoir identifies this as the celebration of the author’s parents’ sixtieth birthdays.', credit:'Family memoir · p. 23', wide:true},
  {image:'early-couple.jpg', title:'An early portrait together', caption:'A photograph of the author and his wife, preserved in the memoir.', credit:'Family memoir · p. 10'},
  {image:'pharmacy-class.jpg', title:'A farewell to a teacher', caption:'The photograph’s caption dates this National College of Pharmacy gathering to July 1949.', credit:'Family memoir · p. 7'},
  {image:'queens.jpg', title:'The Queen’s University years', caption:'UIBE identifies Liu Tiehu as third from the left with teachers during his time in Canada in the mid-1980s.', credit:'UIBE alumni profile · 2021'},
  {image:'research-colleagues.jpg', title:'The scientific community', caption:'An institutional group photograph from the memoir, captioned Beijing, August 1988. Individual positions have not been independently identified.', credit:'Family memoir · p. 18'},
  {image:'liu-lawyer.jpg', title:'The American legal chapter', caption:'UIBE presents this photograph in its account of Liu Tiehu’s work as a trial lawyer in the United States.', credit:'UIBE alumni profile · 2021'},
  {image:'new-york.jpg', title:'Far from Chongming', caption:'The memoir’s later-life photographs include the author and his wife beside the Statue of Liberty.', credit:'Family memoir · p. 21'},
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile ? profile.name + " — Family Archive | SpeakKai" : "Our History — A Family Archive | SpeakKai"}</title>
    <meta name="description" content={profile?.intro || "Three connected lives, told through family photographs, scientific papers, a memoir and a journey into law. Explore Kai’s family archive."} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={profile ? profile.name + " — Family Archive" : "Our History — A Family Archive"} /><meta property="og:description" content="The people behind the papers. The stories behind the photographs." /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={"https://speakkai.com/media/history/" + (profile?.image || "family-1955.jpg")} />
    <meta name="theme-color" content="#202921" />
    <link rel="icon" type="image/svg+xml" href="/media/history/archive-mark.svg" />
  </head>
  <body data-profile={person || "all"}>
    <a class="skip" href="#main">Skip to the archive</a>
    <header class="masthead">
      <a href="/history/" class="brand">SpeakKai<span> / </span><strong>Family archive</strong></a>
      <nav aria-label="Page navigation"><a href={profile ? "/history/#people" : "#people"}>The people</a><a href="#timeline">The years</a><a href="#photographs">Photographs</a><a href="#sources">Sources <span aria-hidden="true">↗</span></a></nav><button class="language-switch" id="language-switch" aria-label="Choose language" hidden>中文 / EN</button>
    </header>
    <main id="main">
      {profile ? <section class="hero person-hero" aria-labelledby="page-title"><div class="hero-copy"><a href="/history/" class="eyebrow">← Back to the family archive</a><h1 id="page-title"><span lang="zh-CN">{profile.chinese}</span><small>{profile.name}</small></h1><p class="intro">{profile.subtitle}</p><p class="hero-note">{profile.intro}</p><a href={'#'+person} class="button">Explore this life <span aria-hidden="true">↓</span></a></div><figure class="hero-photo"><button class="photo-open" data-image={profile.image} data-caption={profile.caption} aria-label={'Enlarge: '+profile.name}><img src={root+profile.image} alt={profile.caption} fetchpriority="high"/><span class="enlarge" aria-hidden="true">↗</span></button><figcaption>{profile.credit}</figcaption></figure></section> : (<section class="hero" aria-labelledby="page-title">
        <div class="hero-copy"><p class="eyebrow"><span class="spark">✳</span> A living family archive</p><h1 id="page-title">Our family history</h1><p class="intro">The people behind the papers.<br/>The stories behind the photographs.</p><p class="hero-note">From an island childhood to scientific laboratories and courtrooms across oceans. Tracing Kai’s family through the things they left on the record.</p><a href="#people" class="button">Meet the family <span aria-hidden="true">↓</span></a><div class="hero-index"><span>01 — 03</span><span>Three lives.<br/>One connected story.</span></div></div>
        <figure class="hero-photo"><button class="photo-open" data-image="family-1955.jpg" data-caption="Shanghai International Hotel, 1955. The memoir records a gathering for the author’s parents’ sixtieth birthdays. Family memoir, page 23." aria-label="Enlarge the 1955 family photograph"><img src={root+'family-1955.jpg'} alt="A multigenerational family group in a black-and-white photograph from the memoir" width="617" height="572" fetchpriority="high" /><span class="enlarge" aria-hidden="true">↗</span></button><figcaption><span>SHANGHAI, 1955</span><span>A moment kept.</span></figcaption><div class="archive-stamp" aria-hidden="true">THE FAMILY<br/>COLLECTION<br/><b>家 · 史</b></div></figure>
      </section>)}
      {profile && <div class="profile-navigation" aria-label="Family biographies"><a href="/history/">Family archive</a>{Object.entries(profiles).map(([key,p])=><a href={'/history/'+p.slug+'/'} aria-current={key===person ? 'page' : undefined}>{p.name} <span lang="zh-CN">{p.chinese}</span></a>)}</div>}
      {!person && <div class="chapter-strip"><span>Chongming</span><i>—</i><span>Beijing</span><i>—</i><span>Yanjiao</span><i>—</i><span>Across oceans</span><small>Places across different lives · not one shared itinerary</small></div>}

      {(!person) && (<section id="people" class="section people-section">
        <div class="section-heading"><p class="eyebrow">01 / The people</p><h2>People and family connections</h2><p>A memoir, a scientific paper, a university profile. Each opens a different door into the same family.</p></div>
        <div class="people-grid">
          <a class="person-card gong" href="/history/gong-xiongqi/"><div class="person-image"><img src={root+'gong-portrait.jpg'} alt="An early portrait of Gong Xiongqi reproduced in his memoir" loading="lazy" /><span class="person-number">01</span></div><div class="person-text"><p>THE GREAT-UNCLE · 药物研究</p><h3>Gong Xiongqi <span>龚雄麒</span></h3><div class="card-bottom">A life in pharmaceutical science <span aria-hidden="true">↗</span></div></div></a>
          <a class="person-card man" href="/history/man-tienan/"><div class="person-image paper"><img src={root+'geology-paper.png'} alt="First page of Man Tienan’s 1985 geology paper" loading="lazy" /><span class="person-number">02</span><span class="document-tag">HIS WORK, IN PRINT</span></div><div class="person-text"><p>THE GRANDFATHER · 地质研究</p><h3>Man Tienan <span>满铁男</span></h3><div class="card-bottom">Understanding the ground below <span aria-hidden="true">↗</span></div></div></a>
          <a class="person-card liu" href="/history/liu-tiehu/"><div class="person-image"><img src={root+'liu-portrait.jpg'} alt="An early photograph of Liu Tiehu published by UIBE" loading="lazy" /><span class="person-number">03</span></div><div class="person-text"><p>THE FATHER · 法律</p><h3>Liu Tiehu <span>刘铁虎</span></h3><div class="card-bottom">A legal career across borders <span aria-hidden="true">↗</span></div></div></a>
        </div>
        <div class="family-link"><p class="eyebrow">How the stories meet</p><div class="family-chain"><span><strong>Gong Xiongqi</strong><small>龚雄麒</small></span><b>his sister →</b><span><strong>Gong Ruifeng</strong><small>龚瑞凤 · married to 满铁男</small></span><b>her daughter →</b><span><strong>Man Yanqing</strong><small>满燕青 · Kai’s mother</small></span><b>next generation →</b><span><strong>Kai</strong><small>Son of 满燕青 and 刘铁虎</small></span></div><p class="fine">The memoir names Gong Ruifeng and Man Tienan. The subsequent parent–child connections come from the family’s account.</p></div>
      </section>)}

      {(!person || person === 'gong') && (<section id="gong" class="story story-dark">
        <div class="story-title">{!person && <a class="profile-link" href="/history/gong-xiongqi/">View full profile ↗</a>}<p class="eyebrow">01 / Gong Xiongqi · 龚雄麒</p><h2>Gong Xiongqi’s research career</h2><p>Born in Chongming in 1925, according to his memoir. A pharmaceutical researcher whose name appears across decades of scientific publications.</p><a class="source-link" href="#source-paper1962">Explore the publication trail ↗</a></div>
        <div class="gong-collage"><figure class="couple-photo"><button class="photo-open" data-image="gong-couple.jpg" data-caption="The author and his wife in uniform, as pictured in the memoir. This photograph does not independently establish either person’s military rank. Family memoir, page 14." aria-label="Enlarge Gong and his wife’s portrait"><img src={root+'gong-couple.jpg'} alt="Gong Xiongqi and his wife pictured in uniform in the memoir" loading="lazy" /><span class="enlarge" aria-hidden="true">↗</span></button><figcaption>A shared life · from the memoir</figcaption></figure><figure class="patent-photo"><button class="photo-open" data-image="patent.png" data-caption="US Patent 5,633,259, granted 27 May 1997. Xiong-qi Gong and Bo-yi Qin are among the named inventors. Source: original US patent document." aria-label="Read the US patent front page"><img src={root+'patent.png'} alt="US Patent 5,633,259 naming Xiong-qi Gong among the inventors" loading="lazy" /><span class="enlarge" aria-hidden="true">↗</span></button><figcaption>THE RECORD / 27 MAY 1997</figcaption></figure></div>
        <div class="story-notes"><article><span class="note-year">1962 → 2011</span><h3>A publication trail</h3><p>Isotope-labelled compounds, targeted drug delivery and pharmacology. Published records connect Gong with the mentor and students named in his memoir.</p><a href="#source-paper2011">See the records ↗</a></article><article><span class="note-year">1997</span><h3>A connection beyond China</h3><p>Two related American patents list Xiong-qi Gong and Bo-yi Qin among the inventors, closely matching the research partnership described in the memoir.</p><a href="#source-patent">See the patent ↗</a></article><article><span class="note-year">2015</span><h3>A life in his own words</h3><p><em>A Life of Hardship and Joy</em> brings the scientific record back to childhood, family, colleagues and the ordinary moments between achievements.</p><a href="#source-memoir">About the memoir ↗</a></article></div>
      </section>)}

      {(!person || person === 'man') && (<section id="man" class="story geology-story">
        <div class="geology-art" aria-hidden="true"><span class="geology-label">READING THE LAYERS</span><svg viewBox="0 0 600 550" role="presentation"><defs><pattern id="lines" width="18" height="18" patternUnits="userSpaceOnUse" patternTransform="rotate(28)"><path d="M0 0 V18" stroke="#c69a67" stroke-width="2"/></pattern></defs><path d="M0 115Q110 180 250 125T600 100V220Q440 185 300 240T0 215Z" fill="#bcbba5"/><path d="M0 215Q155 290 300 240T600 220V310Q400 310 270 340T0 285Z" fill="#d5b085"/><path d="M0 285Q130 375 270 340T600 310V355Q420 350 270 390T0 330Z" fill="#343d33"/><path d="M0 330Q135 422 270 390T600 355V460Q410 455 270 495T0 425Z" fill="url(#lines)"/><path d="M0 425Q135 525 270 495T600 460V550H0Z" fill="#aab9aa"/><path d="M380 85L328 535" stroke="#f2eee5" stroke-width="13"/><path d="M380 85L328 535" stroke="#9b513d" stroke-width="2" stroke-dasharray="6 6"/><circle cx="355" cy="306" r="9" fill="#e5a268"/></svg><span class="art-note">An illustrative geological cross-section<br/>Not a reconstruction of a particular mine</span></div>
        <div class="story-title">{!person && <a class="profile-link" href="/history/man-tienan/">View full profile ↗</a>}<p class="eyebrow">02 / Man Tienan · 满铁男</p><h2>Man Tienan’s work in geology</h2><p>A government researcher remembered by the family for a life in geology. His 1985 paper gives that memory a precise place in the published record.</p><div class="paper-quote"><span>中国岩溶 / 1985</span><h3 lang="zh">利用地质规律<br/>解放下组煤层</h3><p>Applying geological understanding to make lower coal seams accessible.</p><a href="#source-geology">Read the source note ↗</a></div><p class="fine">The paper discusses coal geology and mine-water hazards. Its study locations do not, by themselves, prove his personal travels.</p></div>
        <div class="institution"><p class="eyebrow">One institutional thread</p><div><span><b>1982</b>Geological Technical & Economic Research Centre</span><i>→</i><span><b>1998</b>China Academy of Land & Resources Economics</span><i>→</i><span><b>2018</b>China Academy of Natural Resources Economics</span></div><p>The institute’s published history connects these names and its Beijing and Yanjiao office areas. This supports the institutional link; a complete personal employment history is still to be found. <a href="#source-institute">Source ↗</a></p></div>
      </section>)}

      {(!person || person === 'liu') && (<section id="liu" class="story law-story">
        <figure class="law-photo"><button class="photo-open" data-image="liu-lawyer.jpg" data-caption="Liu Tiehu during his American legal career, as presented in the UIBE alumni profile of 25 October 2021." aria-label="Enlarge Liu Tiehu’s American legal career photograph"><img src={root+'liu-lawyer.jpg'} alt="Liu Tiehu pictured during his American legal career in the UIBE profile" loading="lazy" /><span class="enlarge" aria-hidden="true">↗</span></button><figcaption>From the UIBE alumni archive · published 2021</figcaption></figure>
        <div class="story-title">{!person && <a class="profile-link" href="/history/liu-tiehu/">View full profile ↗</a>}<p class="eyebrow">03 / Liu Tiehu · 刘铁虎</p><h2>Liu Tiehu’s legal career</h2><p>From Hebei to university in Beijing, then Canada, the United States and a legal career in Hong Kong and Shanghai.</p><p class="body-copy">UIBE’s alumni profile records degrees in 1984 and 1987, study at Queen’s University, and later legal education in the United States. It describes work as a prosecutor, trial lawyer and corporate legal counsel.</p><div class="route"><span>Beijing</span><span>Canada</span><span>United States</span><span>Hong Kong & Shanghai</span></div><a class="source-link" href="#source-liu">Read the university account ↗</a></div>
        <details class="research-note"><summary><span class="status disputed">Evidence differs</span><strong>The Boston chapter: what the documents tell us</strong><span class="toggle" aria-hidden="true">+</span></summary><div class="research-body"><div><h3>A story worth checking carefully.</h3><p>Two UIBE profiles describe Liu Tiehu and Wang Xuehua as moot-court teammates in Boston. Their text points to 1986; Wang’s pictured certificate and the organiser’s Boston archive point to <strong>1987</strong>.</p><p>The organiser’s 1987 results list the PRC team 25th of 26 international entries, with a 0–4 record. That does not support a semifinal finish for that entry. The results name countries, not individuals; a contemporary roster naming Liu is still missing.</p><p>The family story remains here alongside the documentary uncertainty. We do not know why the accounts differ.</p><a href="#source-jessup">Organiser’s archive ↗</a> · <a href="#source-ranking">Original results ↗</a></div><button class="photo-open ranking-image" data-image="jessup-ranking.png" data-caption="1987 Jessup Overall Ranking — International. The PRC entry is listed 25th of 26, with a 0–4 record. This is a country-team result, not Liu Tiehu’s individual score. Source: ILSA archive." aria-label="Enlarge the original 1987 Jessup ranking"><img src={root+'jessup-ranking.png'} alt="Original 1987 Jessup international ranking sheet" loading="lazy" /><span class="enlarge" aria-hidden="true">↗</span></button></div></details>
      </section>)}

      <section id="timeline" class="section timeline-section"><div class="section-heading"><p class="eyebrow">02 / The years</p><h2>A family timeline</h2><p>Follow one life, or see the years together. Every moment includes the kind of evidence behind it.</p></div>{!person && <div class="filters" role="group" aria-label="Filter the timeline"><button class="active" data-filter="all" aria-pressed="true">All lives</button><button data-filter="gong" aria-pressed="false">Gong Xiongqi</button><button data-filter="man" aria-pressed="false">Man Tienan</button><button data-filter="liu" aria-pressed="false">Liu Tiehu</button><button data-filter="family" aria-pressed="false">Family moments</button></div>}<p id="timeline-count" class="sr-only" aria-live="polite">{moments.filter(m => !person || m.who === person || (person !== "liu" && m.who === "family")).length} moments shown</p><div class="timeline">{moments.filter(m => !person || m.who === person || (person !== 'liu' && m.who === 'family')).map(m=><article class="moment" data-person={m.who}><div class="moment-year">{m.year}<span class={'dot '+m.who}></span></div><div class="moment-content"><p class="eyebrow">{m.label}</p><h3>{m.title}</h3><p>{m.text}</p><a href={'#source-'+m.source} class={'status '+(m.kind==='Evidence differs'?'disputed':'')}>{m.kind} <span aria-hidden="true">↗</span></a></div></article>)}</div></section>

      <section id="photographs" class="section gallery-section"><div class="section-heading"><p class="eyebrow">03 / The photographs</p><h2>Photographs from the archive</h2><p>Original photographs, preserved with their age and texture. Select an image to look closer.</p></div><div class="gallery">{gallery.filter(g => !profile || profile.images.includes(g.image)).map(g=><figure class:list={['gallery-item',g.wide&&'wide']}><button class="photo-open" data-image={g.image} data-caption={g.caption+' '+g.credit+'.'} aria-label={'Enlarge: '+g.title}><img src={root+g.image} alt={g.caption} loading="lazy" /><span class="enlarge" aria-hidden="true">↗</span></button><figcaption><h3>{g.title}</h3><p>{g.caption}</p><small>{g.credit}</small></figcaption></figure>)}</div></section>

      <section id="sources" class="section sources-section"><div class="section-heading"><p class="eyebrow">04 / The sources</p><h2>Sources and research notes</h2><p>Some things are in print. Some come from the family. Some are still open questions. Those distinctions belong to the story.</p></div><div class="source-key"><span><i class="key-dot"></i>Public records</span><span><i class="key-dot memoir"></i>Memoir & family accounts</span><span><i class="key-dot uncertain"></i>Unresolved evidence</span></div><div class="source-list">{sources.filter(s => !profile || profile.sources.includes(s.id)).map((s,i)=><details id={'source-'+s.id}><summary><span class="source-number">{String(i+1).padStart(2,'0')}</span><span><strong>{s.title}</strong><small>{s.detail}</small></span><span class="toggle" aria-hidden="true">+</span></summary><div class="source-detail"><p>{s.note}</p>{s.url?<a href={s.url} target="_blank" rel="noopener noreferrer">Open original source <span aria-hidden="true">↗</span></a>:<p class="fine">Selected images reproduced from the family-held memoir. The complete private document is not hosted here.</p>}</div></details>)}</div><p class="editorial-note">An evolving family archive · Research reviewed October 2026.<br/>Photographs are credited to the family memoir and UIBE. The geological illustration is explanatory artwork. Names identify the people described in the sources; no identification is based on facial recognition.</p></section>
    </main>
    <footer><a class="brand" href="/">SpeakKai</a><p>The family archive</p><a href="#main">Back to the beginning ↑</a></footer>
    <dialog id="language-dialog" aria-labelledby="language-title" data-no-translate>
      <span class="language-mark" aria-hidden="true">家 · 史</span><p class="eyebrow">THE FAMILY ARCHIVE · 家族档案</p>
      <h2 id="language-title">Choose your language<span lang="zh-CN">请选择语言</span></h2>
      <p class="language-note">Every life, in your language.<br/><span lang="zh-CN">用熟悉的语言，走近家人的故事。</span></p>
      <div class="language-options"><button data-language="en" lang="en"><strong>English</strong><small>Explore the archive →</small></button><button data-language="zh-CN" lang="zh-CN"><strong>中文</strong><small>走进家族档案 →</small></button></div>
      <p class="language-hint">You can switch anytime · 随时可以切换语言</p>
    </dialog>
    <dialog id="photo-dialog" aria-label="Photograph viewer"><div class="viewer-top"><span>THE FAMILY ARCHIVE</span><button id="close-photo" autofocus aria-label="Close photograph">Close <span aria-hidden="true">×</span></button></div><div class="viewer-image"><img id="viewer-photo" src="" alt="" /></div><p id="viewer-caption"></p></dialog>
    <script>
      import { initializeLanguage } from './language';
      initializeLanguage();
      const dialog = document.querySelector<HTMLDialogElement>('#photo-dialog')!;
      const viewer = document.querySelector<HTMLImageElement>('#viewer-photo')!;
      const caption = document.querySelector('#viewer-caption')!;
      document.querySelectorAll<HTMLButtonElement>('.photo-open').forEach(button => {
        button.addEventListener('click', () => {
          viewer.src = '/media/history/' + button.dataset.image;
          viewer.alt = button.dataset.caption || '';
          caption.textContent = button.dataset.caption || '';
          dialog.showModal(); document.body.classList.add('viewing');
        });
      });
      document.querySelector('#close-photo')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', e => {if (e.target === dialog) {const r = dialog.getBoundingClientRect(); if(e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dialog.close();}});
      dialog.addEventListener('close', () => document.body.classList.remove('viewing'));
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b => {const active = b === button; b.classList.toggle('active', active); b.setAttribute('aria-pressed', String(active));});
        let count=0; document.querySelectorAll<HTMLElement>('.moment').forEach(row => {row.hidden = button.dataset.filter !== 'all' && row.dataset.person !== button.dataset.filter; if(!row.hidden) count++;});
        document.querySelector('#timeline-count')!.textContent = document.documentElement.lang === "zh-CN" ? `显示 ${count} 个时刻` : `${count} moments shown`;
      }));
      const openSource = () => {const id=decodeURIComponent(location.hash.slice(1)); if(id.startsWith('source-')) {const el=document.getElementById(id); if(el instanceof HTMLDetailsElement) el.open=true;}};
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#source-"]').forEach(a=>a.addEventListener('click',()=>{const el=document.querySelector(a.getAttribute('href')!);if(el instanceof HTMLDetailsElement) el.open=true;}));
      window.addEventListener('hashchange', openSource); openSource();
    </script>
    <style is:global>@import "./reading.css";</style>
  </body>
</html>

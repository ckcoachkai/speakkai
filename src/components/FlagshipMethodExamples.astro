---
import { getCollection } from "astro:content";
import { localizedPath, destinationLabel } from "../lib/siteLanguage.mjs";
interface Props { language?: "en" | "zh-CN" }
const { language = "en" } = Astro.props;
const chinese = language === "zh-CN";
const publishedPractices = await getCollection("practice", ({ data }) => data.published);
const schoolPractice = publishedPractices.find(lesson => lesson.id === "explain-then-swap");
---

<nav class="method-examples" aria-labelledby="method-examples-title">
    <h3 id="method-examples-title">{chinese ? "看看如何练习。" : "See the practice."}</h3>
    <p>{chinese ? "查看具体示例，或尝试一个免费活动。" : "Open a worked example or try a free activity."}</p>
    <ul>
      <li>
        <p class="eyebrow">{chinese ? "学生与家长" : "Students & parents"}</p>
        <a class="text-link" href={localizedPath("/coaching/young-competition-speakers/#feedback-example",language)}>{chinese ? "加一处停顿，再试一次" : "Pause, then try again"} <span aria-hidden="true">↗</span></a>
        <p>{chinese ? "虚构故事 · 一项练习调整" : "Fictional story · one coaching adjustment"}</p>
        {!chinese && <a class="example-language" href="/zh/coaching/young-competition-speakers/#feedback-example" lang="zh-CN">中文示例 <span aria-hidden="true">↗</span></a>}
      </li>
      {schoolPractice && <li>
        <p class="eyebrow">{chinese ? "学校与教育团队" : "Schools & educators"}</p>
        <a class="text-link" href={localizedPath(`/resources/${schoolPractice.id}/`,language)}>{destinationLabel(chinese ? "解释一个想法，再交换角色" : schoolPractice.data.title,`/resources/${schoolPractice.id}/`,language)} <span aria-hidden="true">↗</span></a>
        <p>{chinese ? `免费双人活动 · ${schoolPractice.data.minutes} 分钟` : `Free paired activity · ${schoolPractice.data.minutes} minutes`}</p>
      </li>}
      <li>
        <p class="eyebrow">{chinese ? "企业与活动团队" : "Companies & event teams"}</p>
        <a class="text-link" href={localizedPath("/companies/#brief-example",language)}>{destinationLabel(chinese ? "让结尾有一个明确目的" : "Give the ending a purpose","/companies/",language)} <span aria-hidden="true">↗</span></a>
        <p>{chinese ? "虚构简报 · 只调整结尾" : "Fictional briefing · one revised ending"}</p>
      </li>
    </ul>
  </nav>

<style>
  .method-examples { border-top: 1px solid var(--line); margin-top: 42px; padding-top: 30px; }
  .method-examples h3 { font-size: 26px; font-weight: 600; }
  .method-examples > p { color: var(--muted); margin-top: 8px; }
  .method-examples ul { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; }
  .method-examples .text-link { display: flex; margin-top: 14px; min-height: 44px; gap: 12px; }
  .method-examples li > p:not(.eyebrow) { color: var(--muted); font-size: 14px; margin-top: 12px; }
  .example-language { display: inline-flex; align-items: center; min-height: 44px; color: var(--blue); text-underline-offset: 4px; margin-top: 8px; }
  @media (max-width: 760px) { .method-examples ul { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
</style>

---
import { getCollection } from "astro:content";
const publishedPractices = await getCollection("practice", ({ data }) => data.published);
const schoolPractice = publishedPractices.find(lesson => lesson.id === "explain-then-swap");
---

<nav class="method-examples" aria-labelledby="method-examples-title">
    <h3 id="method-examples-title">See the practice.</h3>
    <p>Open a worked example or try a free activity.</p>
    <ul>
      <li>
        <p class="eyebrow">Students & parents</p>
        <a class="text-link" href="/coaching/young-competition-speakers/#feedback-example">Pause, then try again <span aria-hidden="true">↗</span></a>
        <p>Fictional story · one coaching adjustment</p>
        <a class="example-language" href="/zh/coaching/young-competition-speakers/#feedback-example" lang="zh-CN">中文示例 <span aria-hidden="true">↗</span></a>
      </li>
      {schoolPractice && <li>
        <p class="eyebrow">Schools & educators</p>
        <a class="text-link" href={`/resources/${schoolPractice.id}/`}>{schoolPractice.data.title} <span aria-hidden="true">↗</span></a>
        <p>Free paired activity · {schoolPractice.data.minutes} minutes</p>
      </li>}
      <li>
        <p class="eyebrow">Companies & event teams</p>
        <a class="text-link" href="/companies/#brief-example">Give the ending a purpose <span aria-hidden="true">↗</span></a>
        <p>Fictional briefing · one revised ending</p>
      </li>
    </ul>
  </nav>

<style>
  .method-examples { border-top: 1px solid var(--line); margin-top: 42px; padding-top: 30px; }
  .method-examples h3 { font-size: 26px; font-weight: 600; }
  .method-examples > p { color: var(--muted); margin-top: 8px; }
  .method-examples ul { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; }
  .method-examples .text-link { display: flex; margin-top: 14px; min-height: 44px; gap: 12px; }
  .method-examples li > p:not(.eyebrow) { color: var(--muted); font-size: 14px; margin-top: 12px; }
  .example-language { display: inline-flex; align-items: center; min-height: 44px; color: var(--blue); text-underline-offset: 4px; margin-top: 8px; }
  @media (max-width: 760px) { .method-examples ul { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
</style>

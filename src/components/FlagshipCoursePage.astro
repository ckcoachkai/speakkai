---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipBreadcrumbs from "./FlagshipBreadcrumbs.astro";
import ChineseCourseInquiry from "./ChineseCourseInquiry.astro";
import { currentProgram as program } from "../data/currentProgram";
import { courseCopy, courseLanguages } from "../data/courseCopy";
interface Props { language?: "en" | "zh-CN"; }
const { language = "en" } = Astro.props;
const copy = courseCopy[language];
const chinese = language === "zh-CN";
const inquiry = chinese ? "#course-contact" : "/contact/?audience=coaching";
---
<FlagshipLayout title={copy.title} description={copy.description} language={language} alternates={courseLanguages} contactHref={inquiry} breadcrumb={program.name}>
  <section class="wrap course-intro">
    <div class="course-topline">
      <FlagshipBreadcrumbs label={program.name} language={language} />
      <nav class="language-switch" aria-label={chinese ? "课程语言" : "Course language"}>
        {courseLanguages.map(item => <a href={item.href} lang={item.lang} hreflang={item.lang} aria-current={language === item.lang ? "page" : undefined}>{item.label}</a>)}
      </nav>
    </div>
    <p class="eyebrow">{copy.season} · {copy.audience}</p>
    <h1>{copy.headline[0]}<br /><em>{copy.headline[1]}</em></h1>
    <p class="course-name" lang="en">{program.name}</p>
    <p class="hero-lead">{copy.introduction}</p>
    <div class="actions">
      <a class="button" href={inquiry}>{copy.ask} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={chinese ? "/zh/resources/one-object-story/" : "/resources/one-object-story/"}>{copy.try} <span aria-hidden="true">↗</span></a>
    </div>
    <dl class="course-facts">
      {copy.factLabels.map((label, index) => <div><dt>{label}</dt><dd>{copy.factValues[index]}</dd></div>)}
    </dl>
  </section>
  <section class="practice-section">
    <div class="wrap">
      <div class="section-heading"><p class="eyebrow">{copy.cycleLabel}</p><h2>{copy.cycleTitle}</h2><p>{copy.cycleIntro}</p></div>
      <ol class="method-grid">{copy.sequence.map((step, index) => <li><span class="index">0{index + 1}</span><h3>{step.title}</h3><p>{step.detail}</p></li>)}</ol>
    </div>
  </section>
  <section class="wrap section course-worlds">
    <div><p class="eyebrow">{copy.worldsLabel}</p><h2>{copy.worldsTitle[0]}<br />{copy.worldsTitle[1]}</h2><p>{copy.worldsIntro}</p><ul>{copy.themes.map(theme => <li>{theme}</li>)}</ul></div>
    <div><h3>{copy.rolesTitle}</h3><p>{copy.rolesIntro}</p><ul class="role-list">{copy.roles.map(role => <li>{role}</li>)}</ul><p class="section-note">{copy.rangeNote}</p></div>
  </section>
  <section class="practice-section">
    <div class="wrap feedback-example">
      <div><p class="eyebrow">{copy.feedbackLabel}</p><h2>{copy.feedbackTitle[0]}<br /><em>{copy.feedbackTitle[1]}</em></h2><p>{copy.feedbackIntro}</p></div>
      <div class="feedback-card"><p class="example-label">{copy.exampleLabel}</p><p>{copy.example}</p><p class="field-note">{copy.retry}</p></div>
    </div>
  </section>
  <section class="wrap section course-decide">
    <div><p class="eyebrow">{copy.decideLabel}</p><h2>{copy.decideTitle[0]}<br />{copy.decideTitle[1]}</h2><p>{copy.decideIntro}</p><p>{copy.limits}</p>
      <div class="actions"><a class="button" href={inquiry}>{copy.parentInquiry} <span aria-hidden="true">↗</span></a><a class="text-link" href="/coaching/">{copy.allCoaching}</a></div>
    </div>
    <aside><h3>{copy.starterTitle}</h3><p>{copy.starterIntro}</p><a class="text-link" href={chinese ? "/zh/resources/one-object-story/" : "/resources/one-object-story/"}>{copy.sheet} <span aria-hidden="true">↗</span></a><p class="section-note">{copy.starterNote}</p></aside>
  </section>
  <section class="practice-section" id="course-contact" aria-labelledby="course-contact-title">
    <div class="wrap course-direct-contact">
      <div><p class="eyebrow">{copy.contactLabel}</p><h2 id="course-contact-title">{copy.contactTitle}</h2><p>{copy.contactIntro}</p><p><strong><span lang="en">WeChat</span> / <span lang="zh-CN">微信</span>: <span lang="en">CKcoachkai</span></strong></p><p class="section-note">{copy.contactNote}</p></div>
      <a href="/images/coach-kai-wechat-qr.png" class="course-qr"><img src="/images/coach-kai-wechat-qr.png" width="938" height="1340" alt="" loading="lazy" /><span>{copy.qr} ↗</span></a>
    </div>
    {chinese && <div class="wrap"><ChineseCourseInquiry /></div>}
  </section>
</FlagshipLayout>
<style>
  .course-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .language-switch {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .language-switch a {
    padding: 10px 12px;
    min-height: 44px;
    text-underline-offset: 5px;
  }
  .language-switch [aria-current="page"] {
    background: var(--wash);
    font-weight: 700;
  }
  .course-direct-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: center;
  }
  .course-direct-contact h2 { font-size: clamp(28px, 3vw, 40px); margin-block: 16px; }
  .course-direct-contact p + p { margin-top: 16px; }
  .course-qr { display: grid; gap: 12px; max-width: 240px; text-underline-offset: 4px; }
  .course-qr img { width: 200px; height: auto; }
  .course-name { overflow-wrap: anywhere; }
  .course-intro {
    padding-block: 36px 60px;
  }
  .course-intro > .eyebrow {
    margin-top: 32px;
    color: var(--blue);
  }
  h1 {
    font-size: clamp(40px, 5.1vw, 70px);
    margin-top: 18px;
    font-weight: 600;
  }
  :global(html[lang="zh-CN"]) h1 {
    font-size: clamp(30px, 4.3vw, 62px);
  }
  .course-name {
    font-size: 22px;
    font-weight: 600;
    margin-top: 24px;
  }
  .hero-lead {
    max-width: 670px;
    margin-top: 14px;
  }
  .course-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    margin: 44px 0 0;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  dt {
    font-size: 14px;
    color: var(--muted);
  }
  dd {
    margin: 8px 0 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
  }
  .course-worlds,
  .feedback-example,
  .course-decide {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
  }
  .course-worlds h2,
  .feedback-example h2,
  .course-decide h2 {
    font-size: clamp(32px, 3.3vw, 46px);
    margin-top: 18px;
    font-weight: 600;
  }
  .course-worlds p,
  .feedback-example p,
  .course-decide p {
    margin-top: 20px;
    color: var(--muted);
  }
  .course-worlds h3,
  .course-decide h3 {
    font-size: 26px;
    font-weight: 600;
  }
  .course-worlds ul {
    padding-left: 22px;
    display: grid;
    gap: 14px;
    margin-top: 24px;
  }
  .role-list {
    grid-template-columns: 1fr 1fr;
  }
  .feedback-card {
    padding: 30px;
    border-left: 4px solid var(--yellow);
    background: white;
  }
  .feedback-card .example-label {
    font-size: 14px;
    margin: 0;
  }
  .feedback-card > p:nth-child(2) {
    font-size: 22px;
    color: var(--ink);
    line-height: 1.6;
  }
  .feedback-card .field-note {
    font-size: 14px;
  }
  .course-decide aside {
    background: var(--wash);
    padding: 30px;
    align-self: start;
  }
  .course-decide aside .text-link {
    margin-top: 24px;
  }
  @media (max-width: 760px) {
    .course-direct-contact { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .course-facts {
      grid-template-columns: 1fr 1fr;
      gap: 24px 16px;
    }
    dd {
      font-size: 18px;
    }
    .course-worlds,
    .feedback-example,
    .course-decide {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .role-list {
      grid-template-columns: 1fr 1fr;
    }
    .course-intro {
      padding-top: 24px;
    }
  }
</style>

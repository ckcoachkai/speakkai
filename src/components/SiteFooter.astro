---
import BrandLogo from "./BrandLogo.astro";
---
<footer class="site-footer">
  <a href="/" aria-label="SpeakKai home"><BrandLogo inverse compact /></a><span>&copy; 2026</span>
</footer>

<style>
  .site-footer {
    display: flex;
    width: 100%;
    height: 48px;
    flex: 0 0 48px;
    align-items: center;
    gap: 12px;
    justify-content: center;
    padding: 4px 16px;
    border-top: 1px solid #365785;
    background: #10224a;
    color: #d6e3f5;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
  }
</style>
